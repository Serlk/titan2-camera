+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, serlk <22211586+Serlk@users.noreply.github.com>
+ *
+ * Lens shading correction for the GPU software ISP
+ */
+
+#pragma once
+
+#include <array>
+#include <utility>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Lsc : public Algorithm
+{
+public:
+	Lsc() = default;
+	~Lsc() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	static constexpr unsigned int kGrid = 17;
+	using Grid = std::array<double, kGrid * kGrid>;
+
+	struct Slot {
+		double ct;
+		std::array<Grid, 3> gains; /* r, g, b over the reference frame */
+	};
+
+	static double sample(const Grid &grid, double u, double v);
+	double strength(double lv) const;
+	void build(IPAContext &context, double ct, double s, DebayerParams *params);
+
+	std::vector<Slot> slots_;
+	std::vector<std::pair<double, double>> strength_;
+
+	/* Mode crop in the reference (active area) frame, normalised */
+	double u0_ = 0.0, v0_ = 0.0, du_ = 1.0, dv_ = 1.0;
+
+	bool valid_ = false;
+	double lastMired_ = -1.0;
+	double lastStrength_ = -1.0;
+	uint32_t sequence_ = 0;
+	std::array<uint8_t, kGrid * kGrid * 4> table_ = {};
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
