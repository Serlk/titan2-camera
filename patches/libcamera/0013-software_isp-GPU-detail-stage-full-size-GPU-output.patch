+/*
+ * Detail stage (Titan 2): x = sharpening, y = denoise, z = noise threshold.
+ * hp is a same-colour high-pass of the raw sample (centre minus the mean of
+ * its four neighbours at distance 2). Small differences are taken as noise
+ * and removed (coring, strength y), larger ones as edges and boosted
+ * (unsharp mask, strength x). Added equally to R, G and B: luminance only.
+ */
+uniform vec3 detail;
+
+vec3 apply_detail(vec3 rgb, float hp)
+{
+	float w = mix(-detail.y, detail.x,
+				  smoothstep(detail.z, 2.0 * detail.z, abs(hp)));
+	return rgb + vec3(w * hp);
+}
