diff --git a/src/ipa/simple/algorithms/detail.cpp b/src/ipa/simple/algorithms/detail.cpp
new file mode 100644
index 0000000..35a82e0
--- /dev/null
+++ b/src/ipa/simple/algorithms/detail.cpp
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, serlk <22211586+Serlk@users.noreply.github.com>
+ *
+ * Detail: denoise and sharpening strengths for the GPU debayer
+ */
+
+#include "detail.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftDetail)
+
+/*
+ * Tuning: piecewise linear curves over the analogue gain, as lists of
+ * [gain, value] pairs in increasing gain order (a single number is a
+ * constant):
+ *
+ *   - Detail:
+ *       sharpen:   [ [1.0, 0.6], [16.0, 0.2] ]   # unsharp mask strength
+ *       denoise:   [ [1.0, 0.2], [16.0, 0.8] ]   # coring strength, 0 .. 1
+ *       threshold: [ [1.0, 0.004], [16.0, 0.02] ] # noise level, raw 0 .. 1
+ *
+ * The CPU debayer has no detail stage and ignores these values.
+ */
+int Detail::readCurve(const ValueNode &node, Curve &curve, double def)
+{
+	curve.clear();
+
+	if (node.isValue()) {
+		curve.emplace_back(1.0, node.get<double>().value_or(def));
+		return 0;
+	}
+
+	if (node.isList()) {
+		for (const ValueNode &point : node.asList()) {
+			auto gain = point[0].get<double>();
+			auto value = point[1].get<double>();
+			if (!gain || !value)
+				return -EINVAL;
+			if (!curve.empty() && *gain <= curve.back().first)
+				return -EINVAL;
+			curve.emplace_back(*gain, *value);
+		}
+	}
+
+	if (curve.empty())
+		curve.emplace_back(1.0, def);
+
+	return 0;
+}
+
+double Detail::eval(const Curve &curve, double gain)
+{
+	if (gain <= curve.front().first)
+		return curve.front().second;
+	if (gain >= curve.back().first)
+		return curve.back().second;
+
+	for (size_t i = 1; i < curve.size(); i++) {
+		if (gain > curve[i].first)
+			continue;
+		const auto &[g0, v0] = curve[i - 1];
+		const auto &[g1, v1] = curve[i];
+		return v0 + (v1 - v0) * (gain - g0) / (g1 - g0);
+	}
+
+	return curve.back().second;
+}
+
+int Detail::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	if (readCurve(tuningData["sharpen"], sharpen_, 0.0) ||
+	    readCurve(tuningData["denoise"], denoise_, 0.0) ||
+	    readCurve(tuningData["threshold"], threshold_, 0.01)) {
+		LOG(IPASoftDetail, Error) << "Invalid Detail tuning curves";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+void Detail::prepare(IPAContext &context,
+		     [[maybe_unused]] const uint32_t frame,
+		     [[maybe_unused]] IPAFrameContext &frameContext,
+		     DebayerParams *params)
+{
+	const double gain = context.activeState.agc.again;
+
+	params->sharpen = std::clamp(eval(sharpen_, gain), 0.0, 4.0);
+	params->denoise = std::clamp(eval(denoise_, gain), 0.0, 1.0);
+	params->noiseThreshold = std::clamp(eval(threshold_, gain), 0.0, 1.0);
+}
+
+REGISTER_IPA_ALGORITHM(Detail, "Detail")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
