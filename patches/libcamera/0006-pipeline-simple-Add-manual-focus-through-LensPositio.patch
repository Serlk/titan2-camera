 	std::vector<Configuration> configs_;
 	std::map<PixelFormat, std::vector<const Configuration *>> formats_;
 
@@ -690,9 +703,79 @@ int SimpleCameraData::init()
 		frameStartEmitter_ = video_;
 	}
 
+	initLens();
+
 	return 0;
 }
 
+/*
+ * Expose manual focus when the sensor has a focus lens: the LensPosition
+ * control in dioptres, mapped linearly to the lens driver's
+ * V4L2_CID_FOCUS_ABSOLUTE. The map comes from the configuration file
+ * (pipelines.simple.lens.<sensor model>, else pipelines.simple.lens:
+ * infinity, steps_per_dioptre, default) as the simple pipeline has no
+ * lens tuning. There is no autofocus.
+ */
+void SimpleCameraData::initLens()
+{
+	CameraLens *lens = sensor_->focusLens();
+	if (!lens)
+		return;
+
+	const ControlInfoMap &lensControls = lens->controls();
+	auto it = lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == lensControls.end())
+		return;
+
+	lensMin_ = it->second.min().get<int32_t>();
+	lensMax_ = it->second.max().get<int32_t>();
+
+	const GlobalConfiguration &configuration =
+		pipe()->cameraManager()->_d()->configuration();
+	/* Per sensor model (lens.<model>), else the common entry (lens). */
+	const ValueNode &lensCfg =
+		configuration.configuration()["pipelines"]["simple"]["lens"];
+	const ValueNode &cfg = lensCfg.contains(sensor_->model())
+				       ? lensCfg[sensor_->model()]
+				       : lensCfg;
+	lensInfinity_ = cfg["infinity"].get<double>().value_or(lensMin_);
+	lensStepsPerDioptre_ =
+		cfg["steps_per_dioptre"].get<double>().value_or(100.0);
+	if (lensStepsPerDioptre_ <= 0.0) {
+		LOG(SimplePipeline, Error)
+			<< "Invalid lens steps_per_dioptre, manual focus disabled";
+		return;
+	}
+
+	float maxDioptres = std::max(0.0, (lensMax_ - lensInfinity_) /
+					       lensStepsPerDioptre_);
+	lensDefault_ = std::clamp<float>(cfg["default"].get<double>().value_or(1.0),
+					 0.0f, maxDioptres);
+
+	ControlInfoMap::Map ctrls(controlInfo_.begin(), controlInfo_.end());
+	ctrls[&controls::LensPosition] = ControlInfo(0.0f, maxDioptres,
+						     lensDefault_);
+	controlInfo_ = ControlInfoMap(std::move(ctrls), controls::controls);
+
+	lens_ = lens;
+	lensPosition_ = lensDefault_;
+
+	LOG(SimplePipeline, Debug)
+		<< "Manual focus on lens '" << lens->model() << "': 0 .. "
+		<< maxDioptres << " dioptres, infinity at " << lensInfinity_
+		<< ", " << lensStepsPerDioptre_ << " steps per dioptre";
+}
+
+void SimpleCameraData::setLensPosition(float dioptres)
+{
+	int32_t steps = std::lround(lensInfinity_ +
+				    dioptres * lensStepsPerDioptre_);
+	steps = std::clamp(steps, lensMin_, lensMax_);
+
+	if (lens_->setFocusPosition(steps) == 0)
+		lensPosition_ = (steps - lensInfinity_) / lensStepsPerDioptre_;
+}
+
 /*
  * Generate a list of supported pipeline configurations for a sensor media bus
  * code and size.
