From e2f5c8dbe036a65a12d2cf6210fa3323a4139c43 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Sun, 8 Nov 2026 22:56:53 +0300
Subject: [PATCH 06/26] pipeline: simple: Add manual focus through LensPosition

The simple pipeline handler opens the focus lens of the sensor (ancillary
link) but offers no way to move it, so the lens stays wherever the driver
left it, typically at the far end.

When the sensor has a focus lens with V4L2_CID_FOCUS_ABSOLUTE, expose the
LensPosition control (dioptres) and map it linearly to the lens position:
position = infinity + dioptres * steps_per_dioptre. The simple pipeline
has no lens tuning, so the map comes from the configuration file, per
sensor model, with a common fallback:

  configuration:
    pipelines:
      simple:
        lens:
          hi847:
            infinity: 100          # lens steps at 0 dioptres
            steps_per_dioptre: 90
            default: 1.0           # dioptres, applied at start

LensPosition can be set at start and in any request, and is reported in
the request metadata. There is no autofocus algorithm.

Signed-off-by: serlk <22211586+Serlk@users.noreply.github.com>
---
 src/libcamera/pipeline/simple/simple.cpp | 103 ++++++++++++++++++++++-
 1 file changed, 101 insertions(+), 2 deletions(-)

diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index d6ec5ce..50b7d98 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -7,6 +7,7 @@
  */
 
 #include <algorithm>
+#include <cmath>
 #include <iterator>
 #include <list>
 #include <map>
@@ -33,6 +34,7 @@
 #include <libcamera/stream.h>
 
 #include "libcamera/internal/camera.h"
+#include "libcamera/internal/camera_lens.h"
 #include "libcamera/internal/camera_manager.h"
 #include "libcamera/internal/camera_sensor.h"
 #include "libcamera/internal/camera_sensor_properties.h"
@@ -345,6 +347,17 @@ public:
 	V4L2VideoDevice *video_;
 	V4L2Device *frameStartEmitter_;
 
+	/* Manual focus: LensPosition (dioptres) mapped linearly to the VCM */
+	CameraLens *lens_ = nullptr;
+	double lensInfinity_ = 0.0;
+	double lensStepsPerDioptre_ = 1.0;
+	int32_t lensMin_ = 0;
+	int32_t lensMax_ = 0;
+	float lensDefault_ = 0.0f;
+	float lensPosition_ = 0.0f;
+	void initLens();
+	void setLensPosition(float dioptres);
