+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, serlk <22211586+Serlk@users.noreply.github.com>
+ *
+ * Contrast autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <vector>
+
+#include <libcamera/control_ids.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase {
+		Idle,
+		Coarse,
+		Fine,
+		Focused,
+	};
+
+	void startScan(IPAContext &context, uint32_t frame);
+	void moveTo(IPAContext &context, uint32_t frame, double position);
+	void finishScan(IPAContext &context, uint32_t frame);
+
+	/* Tuning */
+	unsigned int coarseSteps_ = 11;
+	double fineStep_ = 0.04;
+	unsigned int settleFrames_ = 4;
+	double minContrast_ = 0.05;
+	double rescanDrop_ = 0.3;
+	unsigned int rescanFrames_ = 3;
+	double defaultPosition_ = 0.2;
+
+	/* State */
+	int32_t mode_ = controls::AfModeContinuous;
+	int32_t state_ = controls::AfStateIdle;
+	Phase phase_ = Phase::Idle;
+	double position_ = 0.0;
+	uint32_t settleUntil_ = 0;
+
+	std::vector<double> scanPositions_;
+	size_t scanIndex_ = 0;
+	double bestPosition_ = 0.0;
+	double bestMeasure_ = 0.0;
+	double worstMeasure_ = 0.0;
+	double focusedMeasure_ = 0.0;
+	unsigned int dropCount_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
