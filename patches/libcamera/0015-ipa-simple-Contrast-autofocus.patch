diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..e65da2c
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,230 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, serlk <22211586+Serlk@users.noreply.github.com>
+ *
+ * Contrast autofocus for the software ISP
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+/**
+ * \class Af
+ * \brief Contrast autofocus
+ *
+ * The focus measure is the sum of the absolute differences between
+ * neighbouring green samples in the central third of the image, divided by
+ * the sum of the samples (SwIspStats::afSharpness / afSum), so that it does
+ * not follow the exposure. The lens position is normalised, 0.0 at the far
+ * end (infinity) and 1.0 at the near end; the pipeline handler maps it to
+ * the lens driver (the LensPosition map of the configuration file).
+ *
+ * A scan steps the lens over the whole range (coarse), then around the
+ * best position (fine), and stops at the sharpest one. In AfModeContinuous
+ * a scan runs at start and again when the measure drops for a few
+ * consecutive statistics; in AfModeAuto it runs on AfTriggerStart.
+ * AfModeManual leaves the lens to LensPosition.
+ *
+ * Tuning (all optional):
+ *   steps: coarse positions over the range (11)
+ *   fine_step: fine step around the best coarse position (0.04)
+ *   settle_frames: frames to wait after a move before measuring (4)
+ *   min_contrast: (best - worst) / best below which the scan fails (0.05)
+ *   rescan_drop: relative drop of the measure that restarts a scan (0.3)
+ *   default: position after a failed scan (0.2)
+ */
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	coarseSteps_ = std::clamp(tuningData["steps"].get<unsigned int>().value_or(11u), 3u, 64u);
+	fineStep_ = std::clamp(tuningData["fine_step"].get<double>().value_or(0.04), 0.005, 0.2);
+	settleFrames_ = std::min(tuningData["settle_frames"].get<unsigned int>().value_or(4u), 30u);
+	minContrast_ = std::clamp(tuningData["min_contrast"].get<double>().value_or(0.05), 0.0, 1.0);
+	rescanDrop_ = std::clamp(tuningData["rescan_drop"].get<double>().value_or(0.3), 0.05, 0.9);
+	defaultPosition_ = std::clamp(tuningData["default"].get<double>().value_or(0.2), 0.0, 1.0);
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues,
+			    ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	phase_ = Phase::Idle;
+	state_ = controls::AfStateIdle;
+	settleUntil_ = 0;
+	dropCount_ = 0;
+
+	if (mode_ == controls::AfModeContinuous)
+		startScan(context, 0);
+
+	return 0;
+}
+
+void Af::moveTo(IPAContext &context, uint32_t frame, double position)
+{
+	position_ = std::clamp(position, 0.0, 1.0);
+	context.activeState.af.position = position_;
+	context.activeState.af.changed = true;
+	settleUntil_ = frame + settleFrames_;
+}
+
+void Af::startScan(IPAContext &context, uint32_t frame)
+{
+	scanPositions_.clear();
+	for (unsigned int i = 0; i < coarseSteps_; i++)
+		scanPositions_.push_back(static_cast<double>(i) / (coarseSteps_ - 1));
+
+	scanIndex_ = 0;
+	bestMeasure_ = -1.0;
+	worstMeasure_ = std::numeric_limits<double>::max();
+	phase_ = Phase::Coarse;
+	state_ = controls::AfStateScanning;
+	dropCount_ = 0;
+
+	LOG(IPASoftAf, Debug) << "Scan started at frame " << frame;
+	moveTo(context, frame, scanPositions_[0]);
+}
+
+void Af::finishScan(IPAContext &context, uint32_t frame)
+{
+	phase_ = Phase::Focused;
+	focusedMeasure_ = 0.0;
+	dropCount_ = 0;
+
+	if (bestMeasure_ <= 0.0 ||
+	    (bestMeasure_ - worstMeasure_) < minContrast_ * bestMeasure_) {
+		state_ = controls::AfStateFailed;
+		LOG(IPASoftAf, Debug)
+			<< "Scan failed (best " << bestMeasure_ << ", worst "
+			<< worstMeasure_ << ")";
+		moveTo(context, frame, defaultPosition_);
+		return;
+	}
+
+	state_ = controls::AfStateFocused;
+	LOG(IPASoftAf, Debug)
+		<< "Focused at " << bestPosition_ << " (measure " << bestMeasure_ << ")";
+	moveTo(context, frame, bestPosition_);
+}
+
+void Af::queueRequest(IPAContext &context, const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = *mode;
+		if (mode_ == controls::AfModeContinuous) {
+			startScan(context, frame);
+		} else {
+			phase_ = Phase::Idle;
+			state_ = controls::AfStateIdle;
+		}
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart) {
+			startScan(context, frame);
+		} else if (*trigger == controls::AfTriggerCancel) {
+			phase_ = Phase::Idle;
+			state_ = controls::AfStateIdle;
+		}
+	}
+}
+
+void Af::process(IPAContext &context, const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	metadata.set(controls::AfState, state_);
+
+	if (!stats->valid || phase_ == Phase::Idle || frame < settleUntil_)
+		return;
+
+	const double measure = stats->afSum
+				       ? static_cast<double>(stats->afSharpness) / stats->afSum
+				       : 0.0;
+
+	switch (phase_) {
+	case Phase::Coarse:
+	case Phase::Fine:
+		LOG(IPASoftAf, Debug)
+			<< "Position " << position_ << ": measure " << measure;
+		if (measure > bestMeasure_) {
+			bestMeasure_ = measure;
+			bestPosition_ = position_;
+		}
+		worstMeasure_ = std::min(worstMeasure_, measure);
+
+		if (++scanIndex_ < scanPositions_.size()) {
+			moveTo(context, frame, scanPositions_[scanIndex_]);
+			break;
+		}
+
+		if (phase_ == Phase::Coarse) {
+			/* Fine positions around the best coarse one */
+			const double best = bestPosition_;
+			scanPositions_.clear();
+			for (double d : { -2.0, -1.0, 1.0, 2.0 }) {
+				double p = best + d * fineStep_;
+				if (p >= 0.0 && p <= 1.0)
+					scanPositions_.push_back(p);
+			}
+			scanIndex_ = 0;
+			phase_ = Phase::Fine;
+			if (!scanPositions_.empty()) {
+				moveTo(context, frame, scanPositions_[0]);
+				break;
+			}
+		}
+
+		finishScan(context, frame);
+		break;
+
+	case Phase::Focused:
+		if (mode_ != controls::AfModeContinuous)
+			break;
+
+		if (focusedMeasure_ <= 0.0) {
+			focusedMeasure_ = measure;
+			break;
+		}
+
+		if (measure < focusedMeasure_ * (1.0 - rescanDrop_)) {
+			if (++dropCount_ >= rescanFrames_)
+				startScan(context, frame);
+		} else {
+			dropCount_ = 0;
+			/* Follow slow changes (light, small movements) */
+			focusedMeasure_ = 0.9 * focusedMeasure_ + 0.1 * measure;
+		}
+		break;
+
+	case Phase::Idle:
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
