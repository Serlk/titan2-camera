+/* Normalised position (0.0 far .. 1.0 near) from the AF algorithm */
+void SimpleCameraData::afLensPosition(float position)
+{
+	if (!lens_ || afMode_ == controls::AfModeManual)
+		return;
+
+	setLensPosition(std::clamp(position, 0.0f, 1.0f) * lensMaxDioptres_);
+}
