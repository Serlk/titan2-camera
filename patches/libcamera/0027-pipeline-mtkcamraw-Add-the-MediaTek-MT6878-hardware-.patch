+/* the reason for not claiming a camera is logged once per process */
+bool told = false;
+
+/* media_device_info.driver holds 15 characters */
+constexpr const char *kRawDriver = "mtk-camraw";
+constexpr const char *kRawEntity = "mtk-camraw-a";
+constexpr const char *kCamsvDriver = "mtk-camsv";
+constexpr unsigned int kBufferCount = 4;
+/* luma histogram: bins, and the sampling step in pixels and lines */
+constexpr unsigned int kHistBins = 256;
+constexpr unsigned int kHistStep = 8;
+
+/* the name of the node's one input: the sensor interface entity */
+std::string inputName(const std::string &node)
+{
+	UniqueFD fd(::open(node.c_str(), O_RDWR | O_CLOEXEC));
+	struct v4l2_input input = {};
+
+	if (!fd.isValid())
+		return {};
+	input.index = 0;
+	if (::ioctl(fd.get(), VIDIOC_ENUMINPUT, &input) < 0)
+		return {};
+	return std::string(reinterpret_cast<const char *>(input.name),
+			   strnlen(reinterpret_cast<const char *>(input.name),
+				   sizeof(input.name)));
+}
+
