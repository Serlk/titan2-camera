+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+/*
+ * \todo Document the interface and remove the related EXCLUDE_PATTERNS entry.
+ */
+
+module ipa.mtkcamraw;
+
+import "include/libcamera/ipa/core.mojom";
+
+/*
+ * start() returns a struct: the proxy generator passes no other outputs
+ * of start() next to a return value.
+ */
+struct StartResult {
+	int32 ret;
+	libcamera.ControlList controls;
+};
+
+struct IPAConfigInfo {
+	libcamera.IPACameraSensorInfo sensorInfo;
+	libcamera.ControlInfoMap sensorControls;
+};
+
+interface IPAMtkCamrawInterface {
+	init(libcamera.IPASettings settings, IPAConfigInfo configInfo)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+	configure(IPAConfigInfo configInfo)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+
+	/*
+	 * sensorControls: the exposure and gain the sensor holds now;
+	 * startControls: what to write to the sensor before it streams.
+	 */
+	start(libcamera.ControlList sensorControls) => (StartResult result);
+	stop();
+
+	[async] queueRequest(uint32 frame, libcamera.ControlList controls);
+
+	/*
+	 * Statistics of one output frame, computed by the pipeline handler
+	 * from the processed picture: a histogram of the luma plane on the
+	 * output's own (encoded) scale. sensorControls are the sensor
+	 * controls in effect for that frame.
+	 */
+	[async] processStats(uint32 frame, array<uint32> yHistogram,
+			     libcamera.ControlList sensorControls);
+};
+
+interface IPAMtkCamrawEventInterface {
+	setSensorControls(libcamera.ControlList sensorControls);
+	metadataReady(uint32 frame, libcamera.ControlList metadata);
+};
