+/* -----------------------------------------------------------------------------
+ * Camera data
+ */
+
+int MtkCamrawCameraData::init(MediaDevice *rawMedia, MediaDevice *camsvMedia,
+			      const std::string &seninfName)
+{
+	video_ = V4L2VideoDevice::fromEntityName(rawMedia, kRawEntity);
+	if (video_->open())
+		return -ENODEV;
+
+	/* the driver reports a picture only with its captured requests loaded */
+	if (video_->getFormat(&format_) || !format_.size.width ||
+	    !format_.planes[0].size) {
+		LOG(MtkCamraw, Info)
+			<< "Not claiming a camera: no captured requests loaded (" << video_->deviceNode()
+			<< " reports no picture format); the hardware ISP camera is not offered";
+		return -ENODATA;
+	}
+
+	MediaEntity *seninf = camsvMedia->getEntityByName(seninfName);
+	if (!seninf)
+		return -ENODEV;
+	seninf_ = std::make_unique<V4L2Subdevice>(seninf);
+	if (seninf_->open())
+		return -ENODEV;
+
+	/* the sensor is what feeds the sensor interface's sink */
+	MediaEntity *sensor = nullptr;
+	for (const MediaPad *pad : seninf->pads()) {
+		if (!(pad->flags() & MEDIA_PAD_FL_SINK))
+			continue;
+		for (const MediaLink *link : pad->links()) {
+			MediaEntity *e = link->source()->entity();
+			if (e->function() == MEDIA_ENT_F_CAM_SENSOR)
+				sensor = e;
+		}
+	}
+	if (!sensor) {
+		LOG(MtkCamraw, Error) << "No sensor in front of " << seninfName;
+		return -ENODEV;
+	}
+	sensor_ = CameraSensorFactoryBase::create(sensor);
+	if (!sensor_)
+		return -ENODEV;
+
+	bool fullPitch = pipe()->cameraManager()->_d()->configuration()
+				 .option<bool>({ "pipelines", "mtkcamraw", "full_pitch" })
+				 .value_or(true);
+	outputSize_ = format_.size;
+	if (fullPitch)
+		outputSize_.width = format_.planes[0].bpl;
+
+	/* the sensor input the captured requests were made for */
+	Rectangle bounds;
+	if (!video_->getSelection(V4L2_SEL_TGT_CROP_BOUNDS, &bounds))
+		inputSize_ = bounds.size();
+	else
+		inputSize_ = sensor_->resolution();
+
+	const CameraSensorProperties::SensorDelays &delays = sensor_->sensorDelays();
+	std::unordered_map<uint32_t, DelayedControls::ControlParams> params = {
+		{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
+		{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
+		{ V4L2_CID_VBLANK, { delays.vblankDelay, true } },
+	};
+	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
+	frameStartEvents_ = video_->supportsFrameStartEvent();
+
+	video_->bufferReady.connect(this, &MtkCamrawCameraData::bufferReady);
+
+	properties_ = sensor_->properties();
+	return 0;
+}
+
+int MtkCamrawCameraData::loadIPA()
+{
+	ipa_ = pipe()->createIPA<ipa::mtkcamraw::IPAProxyMtkCamraw>(1, 1);
+	if (!ipa_) {
+		LOG(MtkCamraw, Error) << "No mtkcamraw IPA module";
+		return -ENOENT;
+	}
+
+	ipa_->setSensorControls.connect(this, &MtkCamrawCameraData::setSensorControls);
+	ipa_->metadataReady.connect(this, &MtkCamrawCameraData::metadataReady);
+
+	std::string conf = ipa_->configurationFile(sensor_->model() + ".yaml",
+						   "uncalibrated.yaml");
+
+	ipa::mtkcamraw::IPAConfigInfo info;
+	int ret = sensor_->sensorInfo(&info.sensorInfo);
+	if (ret)
+		return ret;
+	info.sensorControls = sensor_->controls();
+
+	ControlInfoMap ipaControls;
+	ret = ipa_->init(IPASettings{ conf, sensor_->model() }, info, &ipaControls);
+	if (ret) {
+		LOG(MtkCamraw, Error) << "IPA initialisation failed: " << ret;
+		return ret;
+	}
+	controlInfo_ = ipaControls;
+	return 0;
+}
+
+/* luma histogram of the picture, every kHistStep-th pixel of every kHistStep-th line */
+std::vector<uint32_t> MtkCamrawCameraData::histogram(FrameBuffer *buffer)
+{
+	std::vector<uint32_t> hist(kHistBins, 0);
+
+	auto it = mapped_.find(buffer);
+	if (it == mapped_.end()) {
+		auto map = std::make_unique<MappedFrameBuffer>(buffer,
+							       MappedFrameBuffer::MapFlag::Read);
+		if (!map->isValid())
+			return {};
+		it = mapped_.emplace(buffer, std::move(map)).first;
+	}
+
+	Span<uint8_t> y = it->second->planes()[0];
+	const unsigned int stride = format_.planes[0].bpl;
+	const unsigned int width = format_.size.width;
+	const unsigned int height = format_.size.height;
+
+	if (y.size() < static_cast<size_t>(stride) * height)
+		return {};
+	for (unsigned int line = kHistStep / 2; line < height; line += kHistStep) {
+		const uint8_t *p = y.data() + static_cast<size_t>(line) * stride;
+		for (unsigned int x = kHistStep / 2; x < width; x += kHistStep)
+			hist[p[x] * kHistBins / 256]++;
+	}
+	return hist;
+}
+
+void MtkCamrawCameraData::bufferReady(FrameBuffer *buffer)
+{
+	PipelineHandlerMtkCamraw *pipe = static_cast<PipelineHandlerMtkCamraw *>(this->pipe());
+	Request *request = buffer->request();
+
+	if (buffer->metadata().status == FrameMetadata::FrameCancelled) {
+		pipe->completeBuffer(request, buffer);
+		pipe->completeRequest(request);
+		return;
+	}
+
+	/* a frame the driver lost (returned with an error): no statistics */
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess) {
+		pipe->completeBuffer(request, buffer);
+		pipe->completeRequest(request);
+		return;
+	}
+
+	uint32_t sequence = buffer->metadata().sequence;
+	request->_d()->metadata().set(controls::SensorTimestamp,
+				      buffer->metadata().timestamp);
+
+	std::vector<uint32_t> hist = histogram(buffer);
+	ControlList sensorControls = delayedCtrls_->get(sequence);
+
+	pipe->completeBuffer(request, buffer);
+	pending_[request->sequence()] = request;
+	ipa_->processStats(request->sequence(), hist, sensorControls);
+}
+
+void MtkCamrawCameraData::metadataReady(uint32_t frame, const ControlList &metadata)
+{
+	auto it = pending_.find(frame);
+	if (it == pending_.end())
+		return;
+
+	Request *request = it->second;
+	pending_.erase(it);
+	request->_d()->metadata().merge(metadata);
+	pipe()->completeRequest(request);
+}
+
+void MtkCamrawCameraData::setSensorControls(const ControlList &sensorControls)
+{
+	delayedCtrls_->push(sensorControls);
+	if (!frameStartEvents_) {
+		ControlList ctrls(sensorControls);
+		sensor_->setControls(&ctrls);
+	}
+}
+
+/* -----------------------------------------------------------------------------
+ * Configuration
+ */
+
+CameraConfiguration::Status MtkCamrawCameraConfiguration::validate()
+{
+	Status status = Valid;
+
+	if (config_.empty())
+		return Invalid;
+
+	/*
+	 * Neither the sensor nor the replayed lists can flip or rotate (a
+	 * flip would change the Bayer order the lists were made for): the
+	 * pictures come in the sensor's mounting orientation, and the
+	 * application rotates them by what is reported here.
+	 */
+	Orientation native = data_->sensor_->mountingOrientation();
+	if (orientation != native) {
+		orientation = native;
+		status = Adjusted;
+	}
+
+	if (config_.size() > 1) {
+		config_.resize(1);
+		status = Adjusted;
+	}
+
+	/* one picture of the captured format and size, whatever is asked */
+	StreamConfiguration &cfg = config_[0];
+	const V4L2DeviceFormat &format = data_->format_;
+	PixelFormat pixelFormat = format.fourcc.toPixelFormat();
+
+	if (cfg.pixelFormat != pixelFormat || cfg.size != data_->outputSize_) {
+		LOG(MtkCamraw, Debug)
+			<< "Adjusting to " << pixelFormat << " " << data_->outputSize_;
+		cfg.pixelFormat = pixelFormat;
+		cfg.size = data_->outputSize_;
+		status = Adjusted;
+	}
+
+	cfg.stride = format.planes[0].bpl;
+	cfg.frameSize = format.planes[0].size;
+	if (cfg.bufferCount < 2)
+		cfg.bufferCount = kBufferCount;
+
+	return status;
+}
+
+std::unique_ptr<CameraConfiguration>
+PipelineHandlerMtkCamraw::generateConfiguration(Camera *camera,
+						Span<const StreamRole> roles)
+{
+	MtkCamrawCameraData *data = cameraData(camera);
+	auto config = std::make_unique<MtkCamrawCameraConfiguration>(data);
+
+	if (roles.empty())
+		return config;
+
+	for (StreamRole role : roles) {
+		if (role == StreamRole::Raw) {
+			LOG(MtkCamraw, Error) << "No raw stream";
+			return nullptr;
+		}
+	}
+
+	const V4L2DeviceFormat &format = data->format_;
+	std::map<PixelFormat, std::vector<SizeRange>> formats = {
+		{ format.fourcc.toPixelFormat(), { SizeRange(data->outputSize_) } },
+	};
+	StreamConfiguration cfg{ StreamFormats{ formats } };
+	cfg.pixelFormat = format.fourcc.toPixelFormat();
+	cfg.size = data->outputSize_;
+	cfg.bufferCount = kBufferCount;
+	config->addConfiguration(cfg);
+
+	config->validate();
+	return config;
+}
+
+int PipelineHandlerMtkCamraw::configure(Camera *camera, CameraConfiguration *c)
+{
+	MtkCamrawCameraData *data = cameraData(camera);
+	StreamConfiguration &cfg = c->at(0);
+	int ret;
+
+	/* the sensor mode of the captured requests, on the sensor interface too */
+	V4L2SubdeviceFormat sensorFormat = data->sensor_->getFormat(data->sensor_->mbusCodes(),
+								    data->inputSize_);
+	if (sensorFormat.size != data->inputSize_) {
+		LOG(MtkCamraw, Error)
+			<< "The sensor has no " << data->inputSize_
+			<< " mode, the captured requests need it";
+		return -EINVAL;
+	}
+	ret = data->sensor_->setFormat(&sensorFormat);
+	if (ret)
+		return ret;
+	ret = data->seninf_->setFormat(0, &sensorFormat);
+	if (ret)
+		return ret;
+
+	V4L2DeviceFormat format = data->format_;
+	ret = data->video_->setFormat(&format);
+	if (ret)
+		return ret;
+	data->format_ = format;
+
+	cfg.setStream(&data->stream_);
+
+	ipa::mtkcamraw::IPAConfigInfo info;
+	ret = data->sensor_->sensorInfo(&info.sensorInfo);
+	if (ret)
+		return ret;
+	info.sensorControls = data->sensor_->controls();
+
+	ControlInfoMap ipaControls;
+	ret = data->ipa_->configure(info, &ipaControls);
+	if (ret)
+		return ret;
+	data->controlInfo_ = ipaControls;
+	return 0;
+}
+
+int PipelineHandlerMtkCamraw::exportFrameBuffers(Camera *camera, Stream *stream,
+						 std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+{
+	MtkCamrawCameraData *data = cameraData(camera);
+
+	return data->video_->exportBuffers(stream->configuration().bufferCount, buffers);
+}
+
+int PipelineHandlerMtkCamraw::start(Camera *camera, [[maybe_unused]] const ControlList *controls)
+{
+	MtkCamrawCameraData *data = cameraData(camera);
+	int ret;
+
+	ret = data->video_->importBuffers(data->stream_.configuration().bufferCount);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * AE starts from what the sensor holds (e.g. the last session's
+	 * values), brought inside AE's limits; those go to the sensor before
+	 * it streams. Blanking first: it sets the exposure range.
+	 */
+	{
+		const uint32_t ids[] = { V4L2_CID_EXPOSURE, V4L2_CID_ANALOGUE_GAIN };
+		ipa::mtkcamraw::StartResult result;
+
+		data->ipa_->start(data->sensor_->getControls(ids), &result);
+		ret = result.ret;
+		if (ret)
+			goto err_release;
+		ControlList &startControls = result.controls;
+		if (startControls.contains(V4L2_CID_VBLANK)) {
+			ControlList vblank(data->sensor_->controls());
+			vblank.set(V4L2_CID_VBLANK, startControls.get(V4L2_CID_VBLANK));
+			data->sensor_->setControls(&vblank);
+		}
+		data->sensor_->setControls(&startControls);
+	}
+
+	data->delayedCtrls_->reset();
+	if (data->frameStartEvents_) {
+		ret = data->video_->setFrameStartEnabled(true);
+		if (ret)
+			data->frameStartEvents_ = false;
+		else
+			data->video_->frameStart.connect(data->delayedCtrls_.get(),
+							 &DelayedControls::applyControls);
+	}
+
+	/* the driver starts the sensor interface and the sensor itself */
+	ret = data->video_->streamOn();
+	if (ret)
+		goto err_ipa;
+	return 0;
+
+err_ipa:
+	data->ipa_->stop();
+err_release:
+	if (data->frameStartEvents_) {
+		data->video_->setFrameStartEnabled(false);
+		data->video_->frameStart.disconnect(data->delayedCtrls_.get());
+	}
+	data->video_->releaseBuffers();
+	return ret;
+}
+
+void PipelineHandlerMtkCamraw::stopDevice(Camera *camera)
+{
+	MtkCamrawCameraData *data = cameraData(camera);
+
+	data->video_->streamOff();
+	data->ipa_->stop();
+	if (data->frameStartEvents_) {
+		data->video_->setFrameStartEnabled(false);
+		data->video_->frameStart.disconnect(data->delayedCtrls_.get());
+	}
+
+	/* requests whose statistics were still with the IPA */
+	for (auto &[frame, request] : data->pending_)
+		completeRequest(request);
+	data->pending_.clear();
+	data->mapped_.clear();
+	data->video_->releaseBuffers();
+}
+
+int PipelineHandlerMtkCamraw::queueRequestDevice(Camera *camera, Request *request)
+{
+	MtkCamrawCameraData *data = cameraData(camera);
+	FrameBuffer *buffer = request->findBuffer(&data->stream_);
+
+	if (!buffer)
+		return -ENOENT;
+
+	data->ipa_->queueRequest(request->sequence(), request->controls());
+	return data->video_->queueBuffer(buffer);
+}
+
+/* -----------------------------------------------------------------------------
+ * Match
+ */
+
+bool PipelineHandlerMtkCamraw::match(DeviceEnumerator *enumerator)
+{
+	DeviceMatch rawMatch(kRawDriver);
+	rawMatch.add(kRawEntity);
+
+	std::shared_ptr<MediaDevice> rawMedia = acquireMediaDevice(enumerator, rawMatch);
+	if (!rawMedia) {
+		/* said once, and not after a camera was made (match() is called again) */
+		if (!told)
+			LOG(MtkCamraw, Info)
+				<< "No free media device of driver \"" << kRawDriver
+				<< "\" with \"" << kRawEntity
+				<< "\" (module not loaded, not the -raw board, or already in use)";
+		told = true;
+		return false;
+	}
+
+	MediaEntity *node = rawMedia->getEntityByName(kRawEntity);
+	std::string seninfName = inputName(node->deviceNode());
+	if (seninfName.empty()) {
+		LOG(MtkCamraw, Info)
+			<< "Not claiming a camera: " << node->deviceNode()
+			<< " names no input (sensor interface)";
+		return false;
+	}
+
+	DeviceMatch camsvMatch(kCamsvDriver);
+	camsvMatch.add(seninfName);
+	std::shared_ptr<MediaDevice> camsvMedia = acquireMediaDevice(enumerator, camsvMatch);
+	if (!camsvMedia) {
+		LOG(MtkCamraw, Info)
+			<< "Not claiming a camera: no free \"" << kCamsvDriver
+			<< "\" media device with \"" << seninfName << "\"";
+		return false;
+	}
+
+	auto data = std::make_unique<MtkCamrawCameraData>(this);
+	int ret = data->init(rawMedia.get(), camsvMedia.get(), seninfName);
+	if (ret) {
+		if (ret != -ENODATA)
+			LOG(MtkCamraw, Info)
+				<< "Not claiming a camera: the sensor or the sensor interface behind "
+				<< seninfName << " could not be set up (" << ret << ")";
+		return false;
+	}
+	ret = data->loadIPA();
+	if (ret) {
+		LOG(MtkCamraw, Info)
+			<< "Not claiming a camera: the mtkcamraw IPA did not load (" << ret << ")";
+		return false;
+	}
+
+	LOG(MtkCamraw, Info)
+		<< "Hardware ISP camera: " << data->sensor_->model() << " -> "
+		<< seninfName << " -> " << kRawEntity << ", "
+		<< data->format_.fourcc << " " << data->format_.size << " (pitch "
+		<< data->format_.planes[0].bpl << ", offered as " << data->outputSize_
+		<< "), mounting orientation " << data->sensor_->mountingOrientation();
+
+	std::set<Stream *> streams{ &data->stream_ };
+	const std::string &id = data->sensor_->id();
+	std::shared_ptr<Camera> camera = Camera::create(std::move(data), id, streams);
+	registerCamera(std::move(camera));
+	told = true;
+	return true;
+}
+
+REGISTER_PIPELINE_HANDLER(PipelineHandlerMtkCamraw, "mtkcamraw")
+
+} /* namespace libcamera */
