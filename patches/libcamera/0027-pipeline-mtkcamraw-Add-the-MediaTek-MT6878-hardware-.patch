+class MtkCamrawCameraData : public Camera::Private
+{
+public:
+	MtkCamrawCameraData(PipelineHandler *pipe)
+		: Camera::Private(pipe)
+	{
+	}
+
+	int init(MediaDevice *rawMedia, MediaDevice *camsvMedia,
+		 const std::string &seninfName);
+	int loadIPA();
+
+	void bufferReady(FrameBuffer *buffer);
+	void setSensorControls(const ControlList &sensorControls);
+	void metadataReady(uint32_t frame, const ControlList &metadata);
+	std::vector<uint32_t> histogram(FrameBuffer *buffer);
+
+	std::unique_ptr<V4L2VideoDevice> video_;
+	std::unique_ptr<V4L2Subdevice> seninf_;
+	std::unique_ptr<CameraSensor> sensor_;
+	std::unique_ptr<DelayedControls> delayedCtrls_;
+	std::unique_ptr<ipa::mtkcamraw::IPAProxyMtkCamraw> ipa_;
+	bool frameStartEvents_ = false;
+
+	Stream stream_;
+	V4L2DeviceFormat format_;
+	Size inputSize_;
+	/*
+	 * The size offered to applications. By default the width is the
+	 * line pitch (full_pitch): some consumers ignore the stride and
+	 * would shear the picture; the pitch columns right of the picture
+	 * are filled black by the driver.
+	 */
+	Size outputSize_;
+
+	std::map<uint32_t, Request *> pending_;
+	std::map<const FrameBuffer *, std::unique_ptr<MappedFrameBuffer>> mapped_;
+};
