From 2bea1d4b1bc6d9e88bbb3be290c3a4b9adea2ddf Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Sun, 8 Nov 2026 22:03:18 +0300
Subject: [PATCH 04/26] libcamera: sensor: Add Hi-847, IMX766 and S5KGD1SP
 properties

Add the three sensors of the Unihertz Titan 2 to the sensor database:
test pattern modes by the menu indices of the kernel drivers, and sensor
delays from the module configuration (exposure and gain take effect two
frames later; frame length after two frames, three for the IMX766).

The pixel unit cell sizes of these modules are not known. Leave them
empty, and do not report an empty unit cell size as a property instead
of reporting 0x0.

Signed-off-by: serlk <22211586+Serlk@users.noreply.github.com>
---
 src/libcamera/sensor/camera_sensor_legacy.cpp |  3 +-
 .../sensor/camera_sensor_properties.cpp       | 63 +++++++++++++++++++
 src/libcamera/sensor/camera_sensor_raw.cpp    |  3 +-
 3 files changed, 67 insertions(+), 2 deletions(-)

diff --git a/src/libcamera/sensor/camera_sensor_legacy.cpp b/src/libcamera/sensor/camera_sensor_legacy.cpp
index 6a68382..b96f263 100644
--- a/src/libcamera/sensor/camera_sensor_legacy.cpp
+++ b/src/libcamera/sensor/camera_sensor_legacy.cpp
@@ -480,7 +480,8 @@ void CameraSensorLegacy::initStaticProperties()
 		return;
 
 	/* Register the properties retrieved from the sensor database. */
-	properties_.set(properties::UnitCellSize, staticProps_->unitCellSize);
+	if (!staticProps_->unitCellSize.isNull())
+		properties_.set(properties::UnitCellSize, staticProps_->unitCellSize);
 
 	initTestPatternModes();
 }
