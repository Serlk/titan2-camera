From 10408cb3354cf5717d66f3d3bdbce5f7804bcbd0 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Mon, 9 Nov 2026 23:02:10 +0300
Subject: [PATCH 20/26] software_isp: Lens shading map and tone curve

Add two tables to DebayerParams:

- a lens shading gain map, 17 x 17 nodes over the input frame, per node
  R, G and B gains coded as log2(gain) / 3 in 8 bits (1.0 .. 8.0). The
  GPU debayer uploads it as a texture when it changes and multiplies the
  colour after the black level subtraction, bilinearly between the nodes
  (the detail stage high-pass is scaled alike). The CPU debayer has no
  spatial correction and ignores it;

- a tone curve, 256 output values for uniformly spaced linear inputs,
  replacing the gamma power law: a texture lookup on the GPU, the gamma
  table on the CPU. The contrast curve still applies before it.

Signed-off-by: serlk <22211586+Serlk@users.noreply.github.com>
---
 .../internal/software_isp/debayer_params.h    | 22 ++++++++
 src/libcamera/shaders/bayer_1x_packed.frag    | 37 ++++++++++++-
 src/libcamera/shaders/bayer_unpacked.frag     | 37 ++++++++++++-
 src/libcamera/software_isp/debayer_cpu.cpp    | 19 ++++++-
 src/libcamera/software_isp/debayer_egl.cpp    | 55 +++++++++++++++++++
 src/libcamera/software_isp/debayer_egl.h      | 12 ++++
 6 files changed, 175 insertions(+), 7 deletions(-)

diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index 8925f3c..7f36e00 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -10,6 +10,7 @@
 
 #pragma once
 
+#include <array>
 #include <stdint.h>
 
 #include "libcamera/internal/matrix.h"
@@ -28,6 +29,27 @@ struct DebayerParams {
 	float sharpen = 0.0;
 	float denoise = 0.0;
 	float noiseThreshold = 0.0;
+
+	/*
+	 * Lens shading correction (GPU debayer only): kLscGrid x kLscGrid
+	 * nodes over the input frame, RGBA8 per node with R, G, B =
+	 * log2(gain) / 3 * 255 (gain 1 .. 8), bilinearly interpolated.
+	 * lscSequence changes whenever the table does.
+	 */
+	static constexpr unsigned int kLscGrid = 17;
+	bool lscEnabled = false;
+	uint32_t lscSequence = 0;
+	std::array<uint8_t, kLscGrid * kLscGrid * 4> lscTable = {};
+
+	/*
+	 * Tone curve replacing the gamma power law: output 0 .. 255 for
+	 * kToneCurveSize uniformly spaced linear inputs 0 .. 1, interpolated
+	 * linearly. toneCurveSequence changes whenever the curve does.
+	 */
+	static constexpr unsigned int kToneCurveSize = 256;
+	bool toneCurveEnabled = false;
+	uint32_t toneCurveSequence = 0;
+	std::array<uint8_t, kToneCurveSize> toneCurve = {};
 	RGB<float> gains = RGB<float>({ 1.0, 1.0, 1.0 });
 };
 
diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 9f4bec3..dfe864a 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -79,6 +79,36 @@ uniform float contrastExp;
  */
 uniform vec3 detail;
 
+/*
+ * Lens shading (Titan 2): 17x17 RGBA8 gain map over the input frame,
+ * channel = log2(gain) / 3, bilinear. Tone curve: 256x1 R8 table of the
+ * output for uniformly spaced linear inputs, replacing the gamma power law.
+ */
+uniform sampler2D lsc_tex;
+uniform float lsc_on;
+uniform sampler2D tone_tex;
+uniform float tone_on;
+
+vec3 lsc_gain(vec2 uv)
+{
+	if (lsc_on < 0.5)
+		return vec3(1.0);
+	vec2 t = (clamp(uv, 0.0, 1.0) * 16.0 + 0.5) / 17.0;
+	return exp2(texture2D(lsc_tex, t).rgb * 3.0);
+}
+
+float tone(float v)
+{
+	return texture2D(tone_tex, vec2((clamp(v, 0.0, 1.0) * 255.0 + 0.5) / 256.0, 0.5)).r;
+}
+
+vec3 apply_tone(vec3 rgb, float g)
+{
+	if (tone_on > 0.5)
+		return vec3(tone(rgb.r), tone(rgb.g), tone(rgb.b));
+	return pow(rgb, vec3(g));
+}
+
 vec3 apply_detail(vec3 rgb, float hp)
 {
 	float w = mix(-detail.y, detail.x,
@@ -243,6 +273,9 @@ void main(void)
 
 	rgb = rgb - blacklevel;
 
+	vec3 lscg = lsc_gain((center_pixel + 0.5) / tex_size);
+	rgb *= lscg;
+
 	/* Same-colour neighbours at distance 2, for the detail stage */
 	{
 		float xl = floor(BPP * (center_pixel.x - 2.0) + 0.02) * tex_step.x;
@@ -250,7 +283,7 @@ void main(void)
 		float same = fetch(xl, center_bytes.y) + fetch(xr, center_bytes.y) +
 			     fetch(center_bytes.x, center_bytes.y - 2.0 * tex_step.y) +
 			     fetch(center_bytes.x, center_bytes.y + 2.0 * tex_step.y);
-		rgb = apply_detail(rgb, C - same * 0.25);
+		rgb = apply_detail(rgb, (C - same * 0.25) * lscg.g);
 	}
 
 	/*
@@ -307,7 +340,7 @@ void main(void)
 	rgb.b = apply_contrast(rgb.b);
 
 	/* Apply gamma after colour correction */
-	rgb = pow(rgb, vec3(gamma));
+	rgb = apply_tone(rgb, gamma);
 
 #if defined (SWAP_BLUE)
 	gl_FragColor = vec4(rgb.bgr, 1.0);
diff --git a/src/libcamera/shaders/bayer_unpacked.frag b/src/libcamera/shaders/bayer_unpacked.frag
index ed3ac40..849f0fa 100644
--- a/src/libcamera/shaders/bayer_unpacked.frag
+++ b/src/libcamera/shaders/bayer_unpacked.frag
@@ -38,6 +38,36 @@ uniform float           contrastExp;
  */
 uniform vec3 detail;
 
+/*
+ * Lens shading (Titan 2): 17x17 RGBA8 gain map over the input frame,
+ * channel = log2(gain) / 3, bilinear. Tone curve: 256x1 R8 table of the
+ * output for uniformly spaced linear inputs, replacing the gamma power law.
+ */
+uniform sampler2D lsc_tex;
+uniform float lsc_on;
+uniform sampler2D tone_tex;
+uniform float tone_on;
+
+vec3 lsc_gain(vec2 uv)
+{
+    if (lsc_on < 0.5)
+        return vec3(1.0);
+    vec2 t = (clamp(uv, 0.0, 1.0) * 16.0 + 0.5) / 17.0;
+    return exp2(texture2D(lsc_tex, t).rgb * 3.0);
+}
+
+float tone(float v)
+{
+    return texture2D(tone_tex, vec2((clamp(v, 0.0, 1.0) * 255.0 + 0.5) / 256.0, 0.5)).r;
+}
+
+vec3 apply_tone(vec3 rgb, float g)
+{
+    if (tone_on > 0.5)
+        return vec3(tone(rgb.r), tone(rgb.g), tone(rgb.b));
