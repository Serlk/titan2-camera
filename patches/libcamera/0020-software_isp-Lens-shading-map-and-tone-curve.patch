+}
+
 vec3 apply_detail(vec3 rgb, float hp)
 {
     float w = mix(-detail.y, detail.x,
@@ -146,8 +176,11 @@ void main(void) {
 
     rgb = rgb - blacklevel;
 
+    vec3 lscg = lsc_gain(center.xy);
+    rgb *= lscg;
+
     /* value[0] = (0,-2) + (0,2), value[2] = (-2,0) + (2,0): same colour as C */
-    rgb = apply_detail(rgb, C - (value[0] + value[2]) * 0.25);
+    rgb = apply_detail(rgb, (C - (value[0] + value[2]) * 0.25) * lscg.g);
 
     /*
      *   CCM is a 3x3 in the format
@@ -202,7 +235,7 @@ void main(void) {
     rgb.b = apply_contrast(rgb.b);
 
     /* Apply gamma after colour correction */
-    rgb = pow(rgb, vec3(gamma));
+    rgb = apply_tone(rgb, gamma);
 
 #if defined (SWAP_BLUE)
     gl_FragColor = vec4(rgb.bgr, 1.0);
diff --git a/src/libcamera/software_isp/debayer_cpu.cpp b/src/libcamera/software_isp/debayer_cpu.cpp
index c3f8488..3ccae17 100644
--- a/src/libcamera/software_isp/debayer_cpu.cpp
+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -898,8 +898,19 @@ void DebayerCpu::updateGammaTable(const DebayerParams &params)
 			normalized = 0.5 * std::pow(normalized / 0.5, contrastExp);
 		else
 			normalized = 1.0 - 0.5 * std::pow((1.0 - normalized) / 0.5, contrastExp);
-		gammaTable_[i] = UINT8_MAX *
-				 std::pow(normalized, gamma);
+		if (params.toneCurveEnabled) {
+			/* Tone curve table: uniformly spaced linear inputs */
+			const float pos = std::clamp(normalized, 0.0f, 1.0f) *
+					  (DebayerParams::kToneCurveSize - 1);
+			const unsigned int i0 = std::min(static_cast<unsigned int>(pos),
+							 DebayerParams::kToneCurveSize - 2);
+			const float f = pos - i0;
+			gammaTable_[i] = params.toneCurve[i0] * (1.0f - f) +
+					 params.toneCurve[i0 + 1] * f;
+		} else {
+			gammaTable_[i] = UINT8_MAX *
+					 std::pow(normalized, gamma);
+		}
 	}
 	/*
 	 * Due to CCM operations, the table lookup may reach indices below the black
@@ -916,7 +927,9 @@ void DebayerCpu::updateLookupTables(const DebayerParams &params)
 	const bool gammaUpdateNeeded =
 		params.gamma != params_.gamma ||
 		params.blackLevel != params_.blackLevel ||
-		params.contrastExp != params_.contrastExp;
+		params.contrastExp != params_.contrastExp ||
+		params.toneCurveEnabled != params_.toneCurveEnabled ||
+		params.toneCurveSequence != params_.toneCurveSequence;
 	if (gammaUpdateNeeded)
 		updateGammaTable(params);
 
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index 2e36d31..4c67187 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -104,6 +104,10 @@ int DebayerEGL::getShaderVariableLocations(void)
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
 	detailUniformDataIn_ = glGetUniformLocation(programId_, "detail");
+	lscTexUniform_ = glGetUniformLocation(programId_, "lsc_tex");
+	lscOnUniform_ = glGetUniformLocation(programId_, "lsc_on");
+	toneTexUniform_ = glGetUniformLocation(programId_, "tone_tex");
+	toneOnUniform_ = glGetUniformLocation(programId_, "tone_on");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -495,11 +499,52 @@ void DebayerEGL::setShaderVariableValues(const DebayerParams &params)
 	/* Detail stage: sharpening, denoise, noise threshold */
 	glUniform3f(detailUniformDataIn_, params.sharpen, params.denoise,
 		    params.noiseThreshold);
+
+	/* Lens shading and tone curve tables (texture units 2 and 3) */
+	updateTables(params);
+	glUniform1i(lscTexUniform_, eglImageLsc_->texture_unit_uniform_id_);
+	glUniform1f(lscOnUniform_, params.lscEnabled && lscUploaded_ ? 1.0f : 0.0f);
+	glUniform1i(toneTexUniform_, eglImageTone_->texture_unit_uniform_id_);
+	glUniform1f(toneOnUniform_, params.toneCurveEnabled && toneUploaded_ ? 1.0f : 0.0f);
 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
 	return;
 }
 
+void DebayerEGL::updateTables(const DebayerParams &params)
+{
+	if (params.lscEnabled &&
+	    (!lscUploaded_ || params.lscSequence != lscSequence_)) {
+		egl_.createTexture2D(*eglImageLsc_, GL_RGBA, DebayerParams::kLscGrid,
+				     DebayerParams::kLscGrid,
+				     const_cast<uint8_t *>(params.lscTable.data()));
+		/* The gain map is interpolated between the nodes */
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		lscSequence_ = params.lscSequence;
+		lscUploaded_ = true;
+	} else {
+		glActiveTexture(eglImageLsc_->texture_unit_);
+		glBindTexture(GL_TEXTURE_2D, eglImageLsc_->texture_);
+	}
+
+	if (params.toneCurveEnabled &&
+	    (!toneUploaded_ || params.toneCurveSequence != toneSequence_)) {
+		egl_.createTexture2D(*eglImageTone_, GL_LUMINANCE,
+				     DebayerParams::kToneCurveSize, 1,
+				     const_cast<uint8_t *>(params.toneCurve.data()));
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		toneSequence_ = params.toneCurveSequence;
+		toneUploaded_ = true;
+	} else {
+		glActiveTexture(eglImageTone_->texture_unit_);
+		glBindTexture(GL_TEXTURE_2D, eglImageTone_->texture_);
+	}
+
+	glActiveTexture(GL_TEXTURE0);
+}
+
 int DebayerEGL::debayerGPU(MappedFrameBuffer &in, int out_fd, const DebayerParams &params)
 {
 	/* eGL context switch */
@@ -588,6 +633,14 @@ int DebayerEGL::start()
 	/* Texture we will render to */
 	eglImageBayerOut_ = std::make_unique<eGLImage>(outputSize_.width, outputSize_.height, outputConfig_.stride, GL_TEXTURE1, 1);
 
+	/* Lens shading gain map and tone curve */
+	eglImageLsc_ = std::make_unique<eGLImage>(DebayerParams::kLscGrid, DebayerParams::kLscGrid,
+						  DebayerParams::kLscGrid * 4, GL_TEXTURE2, 2);
+	eglImageTone_ = std::make_unique<eGLImage>(DebayerParams::kToneCurveSize, 1,
+						   DebayerParams::kToneCurveSize, GL_TEXTURE3, 3);
+	lscUploaded_ = false;
+	toneUploaded_ = false;
+
 	if (initBayerShaders(inputPixelFormat_, outputPixelFormat_))
 		return -EINVAL;
 
@@ -598,6 +651,8 @@ void DebayerEGL::stop()
 {
 	eglImageBayerOut_.reset();
 	eglImageBayerIn_.reset();
+	eglImageLsc_.reset();
+	eglImageTone_.reset();
 
 	if (programId_)
 		glDeleteProgram(programId_);
