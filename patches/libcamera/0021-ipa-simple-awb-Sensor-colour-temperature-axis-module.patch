--- /dev/null
+++ b/src/ipa/simple/module_eeprom.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, serlk <22211586+Serlk@users.noreply.github.com>
+ *
+ * Calibration data of MediaTek-style camera module EEPROMs
+ */
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+#include "libcamera/internal/vector.h"
+
+namespace libcamera {
+
+namespace ipa::soft {
+
+/*
+ * The "MTK" layout of the module EEPROM (format tag 0x010B00FF at 0x0001):
+ * white balance averages of the module and of the golden sample, focus
+ * DAC codes, and the module lens shading table. Exposed by the sensor
+ * driver as /sys/bus/nvmem/devices/<sensor>-eeprom/nvmem.
+ */
+struct ModuleEeprom {
+	static std::optional<ModuleEeprom> read(const std::string &path);
+	static std::string defaultPath(const std::string &sensorModel);
+
+	uint8_t formatVersion = 0;
+
+	bool hasAwb = false;
+	/* Per-channel gains (minimum 1.0) of the module and of the golden sample */
+	RGB<double> unitGains{ { 1.0, 1.0, 1.0 } };
+	RGB<double> goldenGains{ { 1.0, 1.0, 1.0 } };
+
+	bool hasAf = false;
+	uint16_t afInfinity = 0;
+	uint16_t afMacro = 0;
+	/* Target distances of the focus calibration, 0 if unknown */
+	uint16_t afInfinityMm = 0;
+	uint16_t afMacroMm = 0;
+
+	/* Module lens shading table: raw u16 nodes as stored */
+	std::vector<uint16_t> lscTable;
+};
+
+} /* namespace ipa::soft */
+
+} /* namespace libcamera */
