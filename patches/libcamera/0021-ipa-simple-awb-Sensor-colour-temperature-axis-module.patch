diff --git a/src/ipa/simple/module_eeprom.cpp b/src/ipa/simple/module_eeprom.cpp
new file mode 100644
index 0000000..54e9625
--- /dev/null
+++ b/src/ipa/simple/module_eeprom.cpp
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, serlk <22211586+Serlk@users.noreply.github.com>
+ *
+ * Calibration data of MediaTek-style camera module EEPROMs
+ */
+
+#include "module_eeprom.h"
+
+#include <algorithm>
+#include <fstream>
+#include <iterator>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftEeprom)
+
+namespace ipa::soft {
+
+namespace {
+
+constexpr size_t kTagOffset = 0x0001;
+constexpr uint8_t kTag[] = { 0xff, 0x00, 0x0b, 0x01 };
+constexpr size_t kFlagsOffset = 0x0008;
+constexpr size_t kUnitOffset = 0x0009;
+constexpr size_t kGoldenOffset = 0x000d;
+constexpr size_t kAfInfOffset = 0x0011;
+constexpr size_t kAfMacroOffset = 0x0013;
+constexpr size_t kLscLengthOffset = 0x0015;
+constexpr size_t kLscTableOffset = 0x005b;
+constexpr size_t kLscHeaderSize = kLscTableOffset - 0x0017;
+constexpr size_t kAfExtOffset = 0x0f63;
+constexpr size_t kVersionOffset = 0x0fa3;
+
+uint16_t u16(const std::vector<uint8_t> &d, size_t off)
+{
+	return d[off] | (d[off + 1] << 8);
+}
+
+bool usable(uint16_t v)
+{
+	return v != 0 && v != 0xffff;
+}
+
+/*
+ * Averages R, Gr, Gb, B to gains as the module calibration defines them:
+ * G = (Gr + Gb + 1) / 2, gain = max(R, G, B) / channel, minimum 1.0.
+ */
+std::optional<RGB<double>> gains(const std::vector<uint8_t> &d, size_t off)
+{
+	const unsigned int r = d[off];
+	const unsigned int g = (d[off + 1] + d[off + 2] + 1) / 2;
+	const unsigned int b = d[off + 3];
+
+	if (!r || !g || !b || r == 0xff || b == 0xff)
+		return std::nullopt;
+
+	const double m = std::max({ r, g, b });
+	return RGB<double>{ { m / r, m / g, m / b } };
+}
+
+} /* namespace */
+
+std::string ModuleEeprom::defaultPath(const std::string &sensorModel)
+{
+	return "/sys/bus/nvmem/devices/" + sensorModel + "-eeprom/nvmem";
+}
+
+std::optional<ModuleEeprom> ModuleEeprom::read(const std::string &path)
+{
+	std::ifstream file(path, std::ios::binary);
+	if (!file)
+		return std::nullopt;
+
+	std::vector<uint8_t> d((std::istreambuf_iterator<char>(file)),
+			       std::istreambuf_iterator<char>());
+	if (d.size() < kVersionOffset + 1 ||
+	    !std::equal(std::begin(kTag), std::end(kTag), d.begin() + kTagOffset)) {
+		LOG(IPASoftEeprom, Info) << "No MTK calibration in " << path;
+		return std::nullopt;
+	}
+
+	ModuleEeprom e;
+	const uint8_t flags = d[kFlagsOffset];
+	e.formatVersion = d[kVersionOffset];
+
+	if (flags & 0x01) {
+		auto unit = gains(d, kUnitOffset);
+		auto golden = gains(d, kGoldenOffset);
+		if (unit && golden) {
+			e.hasAwb = true;
+			e.unitGains = *unit;
+			e.goldenGains = *golden;
+		}
+	}
+
+	if (flags & 0x02) {
+		e.afInfinity = u16(d, kAfInfOffset);
+		e.afMacro = u16(d, kAfMacroOffset);
+		e.hasAf = usable(e.afInfinity) && usable(e.afMacro) &&
+			  e.afMacro > e.afInfinity;
+		if (e.hasAf && e.formatVersion >= 0x17 && e.formatVersion != 0xff) {
+			uint16_t inf = u16(d, kAfExtOffset + 6);
+			uint16_t mac = u16(d, kAfExtOffset + 8);
+			if (usable(inf) && usable(mac) && inf > mac) {
+				e.afInfinityMm = inf;
+				e.afMacroMm = mac;
+			}
+		}
+	}
+
+	const uint16_t lscLength = u16(d, kLscLengthOffset);
+	if (usable(lscLength) && lscLength > kLscHeaderSize &&
+	    kLscTableOffset + (lscLength - kLscHeaderSize) <= d.size()) {
+		const size_t n = (lscLength - kLscHeaderSize) / 2;
+		for (size_t i = 0; i < n; i++)
+			e.lscTable.push_back(u16(d, kLscTableOffset + 2 * i));
+	}
+
+	LOG(IPASoftEeprom, Info)
+		<< "Module calibration " << path << ": version 0x" << std::hex
+		<< static_cast<unsigned int>(e.formatVersion) << std::dec
+		<< (e.hasAwb ? ", AWB" : "") << (e.hasAf ? ", AF " : "")
+		<< (e.hasAf ? std::to_string(e.afInfinity) + ".." + std::to_string(e.afMacro) : "")
+		<< ", LSC " << e.lscTable.size() << " values";
+
+	return e;
+}
+
+} /* namespace ipa::soft */
+
+} /* namespace libcamera */
diff --git a/src/ipa/simple/module_eeprom.h b/src/ipa/simple/module_eeprom.h
new file mode 100644
