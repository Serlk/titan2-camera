 namespace ipa::soft::algorithms {
 
+/*
+ * Tuning (optional):
+ *   cct: sensor colour temperature axis from the module tuning
+ *     ref: log2(gainR / gainB) of the white balance at the reference
+ *          (D65) point
+ *     table: [[x, CT], ...] with x = 256 * (log2(gainR / gainB) - ref),
+ *          increasing x; interpolated in mireds
+ *   eeprom: "auto" (default; /sys/bus/nvmem/devices/<sensor>-eeprom/nvmem),
+ *     a path, or "none": module white balance calibration. The gains are
+ *     brought to the golden sample (divided by module / golden) before the
+ *     colour temperature is looked up, so that the CCM and lens shading
+ *     follow the tuning of the golden module.
+ * Without a cct table the generic estimateCCT() is used.
+ */
+int Awb::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const ValueNode &cct = tuningData["cct"];
+	cctRef_ = cct["ref"].get<double>().value_or(0.0);
+	cctTable_.clear();
+	for (const ValueNode &p : cct["table"].asList()) {
+		auto x = p[0].get<double>();
+		auto t = p[1].get<double>();
+		if (!x || !t || *t <= 0.0 ||
+		    (!cctTable_.empty() && *x <= cctTable_.back().first)) {
+			LOG(IPASoftAwb, Error) << "Invalid cct table";
+			return -EINVAL;
+		}
+		cctTable_.emplace_back(*x, *t);
+	}
+
+	std::string eeprom = tuningData["eeprom"].get<std::string>().value_or("auto");
+	if (eeprom == "auto")
+		eeprom = ModuleEeprom::defaultPath(context.sensorModel);
+	if (eeprom != "none") {
+		auto e = ModuleEeprom::read(eeprom);
+		if (e && e->hasAwb) {
+			moduleRatio_ = e->unitGains / e->goldenGains;
+			LOG(IPASoftAwb, Info)
+				<< "Module white balance correction " << moduleRatio_;
+		}
+	}
+
+	return 0;
+}
+
+unsigned int Awb::estimateTemperature(const RGB<float> &gains) const
+{
+	if (cctTable_.empty()) {
+		RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
+		return estimateCCT(rgbGains);
+	}
+
+	/* Gains of the golden module for the same light */
+	const double r = gains.r() / moduleRatio_.r();
+	const double b = gains.b() / moduleRatio_.b();
+	const double x = 256.0 * (std::log2(r / b) - cctRef_);
+
+	if (x <= cctTable_.front().first)
+		return cctTable_.front().second;
+	if (x >= cctTable_.back().first)
+		return cctTable_.back().second;
+
+	for (size_t i = 1; i < cctTable_.size(); i++) {
+		if (x > cctTable_[i].first)
+			continue;
+		const auto &[x0, t0] = cctTable_[i - 1];
+		const auto &[x1, t1] = cctTable_[i];
+		const double f = (x - x0) / (x1 - x0);
+		/* Linear in mireds */
+		const double mired = 1e6 / t0 + f * (1e6 / t1 - 1e6 / t0);
+		return std::lround(1e6 / mired);
+	}
+
+	return cctTable_.back().second;
+}
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
@@ -94,8 +173,7 @@ void Awb::process(IPAContext &context,
 		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
 	} };
 
-	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
-	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+	context.activeState.awb.temperatureK = estimateTemperature(gains);
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
 
 	LOG(IPASoftAwb, Debug)
