diff --git a/test/ipa/mtkcamraw_agc_test.cpp b/test/ipa/mtkcamraw_agc_test.cpp
new file mode 100644
index 0000000..1c988a9
--- /dev/null
+++ b/test/ipa/mtkcamraw_agc_test.cpp
@@ -0,0 +1,241 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Copyright (C) 2026, serlk
+ *
+ * The mtkcamraw IPA's exposure control against a simulated camera: a
+ * scene of fixed linear radiances, a sensor whose signal is radiance x
+ * exposure time x analogue gain (clipped), and an output encoded with a
+ * power law, as the processed pictures of the hardware ISP are. The AGC
+ * must bring a dark and a bright scene to its target within a few dozen
+ * frames, keep the controls inside the sensor's ranges, and stay there.
+ */
+
+#include <cmath>
+#include <iostream>
+#include <memory>
+#include <random>
+#include <vector>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+#include <libcamera/ipa/mtkcamraw_ipa_interface.h>
+
+#include "libcamera/internal/ipa_module.h"
+
+#include "test.h"
+
+using namespace std;
+using namespace libcamera;
+
+namespace {
+
+/* the IMX766 4096x3072 mode as the sensor driver reports it */
+constexpr unsigned int kWidth = 4096;
+constexpr unsigned int kHeight = 3072;
+constexpr unsigned int kLineLength = 15616;
+constexpr uint64_t kPixelRate = 1488000000;
+constexpr int32_t kExposureMin = 24, kExposureDef = 976;
+constexpr int32_t kVblankMin = 104, kVblankMax = 62460;
+constexpr int32_t kExposureMargin = 48;
+/* AE's own margin from the tuning file */
+constexpr int32_t kFrameMargin = 256;
+constexpr int32_t kGainMin = 0, kGainMax = 16128, kGainDef = 0;
+constexpr double kEncodingGamma = 2.2;
+
+double imx766Gain(int32_t code)
+{
+	return 16384.0 / (16384 - code);
+}
+
+const ControlId::DirectionFlags kInOut = ControlId::Direction::In | ControlId::Direction::Out;
+const ControlId exposureId(V4L2_CID_EXPOSURE, "Exposure", "v4l2", ControlTypeInteger32, kInOut);
+const ControlId gainId(V4L2_CID_ANALOGUE_GAIN, "Analogue Gain", "v4l2", ControlTypeInteger32, kInOut);
+const ControlId vblankId(V4L2_CID_VBLANK, "Vertical Blanking", "v4l2", ControlTypeInteger32, kInOut);
+const ControlId hblankId(V4L2_CID_HBLANK, "Horizontal Blanking", "v4l2", ControlTypeInteger32, kInOut);
+const ControlIdMap sensorIdMap = {
+	{ V4L2_CID_EXPOSURE, &exposureId },
+	{ V4L2_CID_ANALOGUE_GAIN, &gainId },
+	{ V4L2_CID_VBLANK, &vblankId },
+	{ V4L2_CID_HBLANK, &hblankId },
+};
+
+} /* namespace */
+
+class MtkCamrawAgcTest : public Test
+{
+protected:
+	int init() override
+	{
+		module_ = make_unique<IPAModule>("src/ipa/mtkcamraw/ipa_mtkcamraw.so");
+		if (!module_->isValid() || !module_->load()) {
+			cerr << "mtkcamraw IPA module not loadable" << endl;
+			return TestFail;
+		}
+
+		ControlInfoMap::Map ctrls;
+		ctrls.emplace(&exposureId, ControlInfo(kExposureMin,
+						       static_cast<int32_t>(kHeight + kVblankMin - kExposureMargin),
+						       kExposureDef));
+		ctrls.emplace(&gainId, ControlInfo(kGainMin, kGainMax, kGainDef));
+		ctrls.emplace(&vblankId, ControlInfo(kVblankMin, kVblankMax, kVblankMin));
+		ctrls.emplace(&hblankId, ControlInfo(11520, 11520, 11520));
+		config_.sensorControls = ControlInfoMap(std::move(ctrls), sensorIdMap);
+
+		IPACameraSensorInfo &info = config_.sensorInfo;
+		info.model = "imx766";
+		info.bitsPerPixel = 10;
+		info.activeAreaSize = { kWidth, kHeight };
+		info.analogCrop = { 0, 0, kWidth, kHeight };
+		info.outputSize = { kWidth, kHeight };
+		info.pixelRate = kPixelRate;
+		info.minLineLength = kLineLength;
+		info.maxLineLength = kLineLength;
+		info.minFrameLength = kHeight + kVblankMin;
+		info.maxFrameLength = kHeight + kVblankMax;
+
+		return TestPass;
+	}
+
+	/* encoded luma histogram of the scene at this exposure and gain */
+	vector<uint32_t> picture(double scene, int32_t exposure, int32_t gainCode,
+				 double *meanLinear)
+	{
+		vector<uint32_t> hist(256, 0);
+		double expo = exposure * double(kLineLength) / kPixelRate;
+		double sum = 0.0;
+
+		for (double r : radiance_) {
+			double lin = min(1.0, r * scene * expo * imx766Gain(gainCode));
+			unsigned int y = min(255.0, 255.0 * pow(lin, 1.0 / kEncodingGamma) + 0.5);
+			hist[y]++;
+			sum += lin;
+		}
+		*meanLinear = sum / radiance_.size();
+		return hist;
+	}
+
+	/*
+	 * Run the loop on one scene. The simulated sensor takes new controls
+	 * kDelay frames after they are pushed, like the IMX766 (exposure and
+	 * gain delay 2), and reports per frame what it ran, as DelayedControls
+	 * does. True when the picture settles near the target within
+	 * kSettleFrames and the controls stay in range and under the AE gain
+	 * limit.
+	 */
+	bool runScene(const char *name, double scene, double target)
+	{
+		static constexpr unsigned int kDelay = 2;
+		static constexpr unsigned int kFrames = 60;
+		static constexpr unsigned int kSettleFrames = 20;
+		static constexpr double kMaxAeGain = 16.0;
+
+		unique_ptr<ipa::mtkcamraw::IPAMtkCamrawInterface> ipa(
+			static_cast<ipa::mtkcamraw::IPAMtkCamrawInterface *>(module_->createInterface()));
+		ControlList sensor(config_.sensorControls);
+		vector<ControlList> pushed;
+		ControlInfoMap ipaControls;
+
+		/* a sensor left at 64x by an earlier session (the cap applies from frame 0) */
+		sensor.set(V4L2_CID_EXPOSURE, kExposureDef);
+		sensor.set(V4L2_CID_ANALOGUE_GAIN, kGainMax);
+		sensor.set(V4L2_CID_VBLANK, kVblankMin);
+
+		ipa->setSensorControls.connect(this, [&](const ControlList &c) {
+			pushed.push_back(c);
+		});
+
+		IPASettings settings{ MTKCAMRAW_TUNING, "imx766" };
+		ControlList startControls(config_.sensorControls);
+		startControls.set(V4L2_CID_EXPOSURE, sensor.get(V4L2_CID_EXPOSURE));
+		startControls.set(V4L2_CID_ANALOGUE_GAIN, sensor.get(V4L2_CID_ANALOGUE_GAIN));
+		ipa::mtkcamraw::StartResult first;
+		if (ipa->init(settings, config_, &ipaControls) ||
+		    ipa->configure(config_, &ipaControls)) {
+			cerr << name << ": IPA init/configure failed" << endl;
+			return false;
+		}
+		ipa->start(startControls, &first);
+		if (first.ret) {
+			cerr << name << ": IPA start failed" << endl;
+			return false;
+		}
+		/* the start values reach the sensor before it streams */
+		for (const auto &[id, value] : first.controls)
+			sensor.set(id, value);
+
+		vector<double> means;
+		bool ok = true;
+		size_t used = 0;
+		for (unsigned int frame = 0; frame < kFrames; frame++) {
+			/* what was pushed kDelay frames ago reaches the sensor now */
+			while (used < pushed.size() && used + kDelay <= frame) {
+				for (const auto &[id, value] : pushed[used])
+					sensor.set(id, value);
+				used++;
+			}
+
+			int32_t exposure = sensor.get(V4L2_CID_EXPOSURE).get<int32_t>();
+			int32_t gain = sensor.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>();
+			int32_t vblank = sensor.get(V4L2_CID_VBLANK).get<int32_t>();
+
+			if (exposure < kExposureMin ||
+			    exposure > static_cast<int32_t>(kHeight) + vblank - kFrameMargin ||
+			    gain < kGainMin || gain > kGainMax ||
+			    vblank < kVblankMin || vblank > kVblankMax ||
+			    imx766Gain(gain) > kMaxAeGain * 1.01) {
+				cerr << name << ": frame " << frame << ": control out of range: exposure "
+				     << exposure << " gain " << imx766Gain(gain) << " vblank " << vblank << endl;
+				ok = false;
+			}
+
+			double mean;
+			vector<uint32_t> hist = picture(scene, exposure, gain, &mean);
+			means.push_back(mean);
+			ipa->queueRequest(frame, ControlList(controls::controls));
+			ipa->processStats(frame, hist, ControlList(sensor));
+		}
+		ipa->stop();
+
+		/* the first frame from which the picture stays within 15 % of the target */
+		unsigned int settled = kFrames;
+		for (unsigned int f = kFrames; f-- > 0;) {
+			if (abs(means[f] / target - 1.0) > 0.15)
+				break;
+			settled = f;
+		}
+
+		int32_t exposure = sensor.get(V4L2_CID_EXPOSURE).get<int32_t>();
+		int32_t gain = sensor.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>();
+		cout << name << ": mean linear luminance " << means.back() << " (target ~" << target
+		     << "), settled at frame " << settled << ", exposure " << exposure
+		     << " lines, gain " << imx766Gain(gain) << endl;
+
+		return ok && settled <= kSettleFrames;
+	}
+
+	int run() override
+	{
+		/* a scene with a spread of radiances, mostly mid-tones */
+		mt19937 rng(1);
+		lognormal_distribution<double> dist(0.0, 0.8);
+		radiance_.resize(20000);
+		for (double &r : radiance_)
+			r = dist(rng);
+
+		/* 0.12: the relative luminance target of the tuning file */
+		bool ok = runScene("dark scene (long frames)", 0.15, 0.12);
+		ok &= runScene("bright scene", 300.0, 0.12);
+		ok &= runScene("normal scene", 8.0, 0.12);
+
+		return ok ? TestPass : TestFail;
+	}
+
+private:
+	unique_ptr<IPAModule> module_;
+	ipa::mtkcamraw::IPAConfigInfo config_;
+	vector<double> radiance_;
+};
+
+TEST_REGISTER(MtkCamrawAgcTest)
