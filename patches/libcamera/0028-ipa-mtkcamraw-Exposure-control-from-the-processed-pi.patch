+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, serlk
+ *
+ * IPA for the MediaTek MT6878 RAW/YUV engines driven by a replayed command
+ * queue (mtkcamraw pipeline handler).
+ *
+ * The ISP settings of a frame are those of a captured request and cannot
+ * be changed: its own statistics, colour gains and tone curve are not
+ * available to us. What can be controlled is the sensor: exposure time,
+ * analogue gain and frame length. The AGC here runs on a luma histogram of
+ * the processed output picture, which the pipeline handler computes. The
+ * output is on an encoded (non-linear) scale; the histogram is brought back
+ * to an approximately linear scale with a power law (encodingGamma in the
+ * tuning file, 2.2 by default) before the mean luminance AGC of libipa
+ * sees it. The closed loop does not depend on that model being exact.
+ */
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <memory>
+#include <string.h>
+#include <vector>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/log.h>
+#include <libcamera/base/span.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/ipa/ipa_interface.h>
+#include <libcamera/ipa/ipa_module_info.h>
+#include <libcamera/ipa/mtkcamraw_ipa_interface.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "libipa/agc_mean_luminance.h"
+#include "libipa/camera_sensor_helper.h"
+#include "libipa/histogram.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAMtkCamraw)
+
+using namespace std::literals::chrono_literals;
+
+namespace ipa::mtkcamraw {
+
+/* bins of the linearised histogram */
+static constexpr unsigned int kLinearBins = 1024;
+static constexpr double kDefaultEncodingGamma = 2.2;
+
+class Agc : public AgcMeanLuminance
+{
+public:
+	void setEncodingGamma(double gamma) { gamma_ = gamma; }
+
+	/* the output's luma histogram (any bin count), linearised */
+	void setHistogram(Span<const uint32_t> encoded)
+	{
+		std::vector<uint32_t> linear(kLinearBins, 0);
+		const unsigned int n = encoded.size();
+
+		for (unsigned int i = 0; i < n; i++) {
+			double v = std::pow((i + 0.5) / n, gamma_);
+			unsigned int bin = std::min<unsigned int>(v * kLinearBins,
+								  kLinearBins - 1);
+			linear[bin] += encoded[i];
+		}
+		hist_ = Histogram(Span<const uint32_t>(linear));
+	}
+
+	const Histogram &histogram() const { return hist_; }
+
+private:
+	double estimateLuminance(const double gain) const override
+	{
+		Span<const uint64_t> cumulative = hist_.data();
+		const uint64_t total = hist_.total();
+		const size_t bins = hist_.bins();
+		double sum = 0.0;
+
+		if (!total)
+			return 0.0;
+		for (size_t i = 0; i < bins; i++) {
+			uint64_t count = cumulative[i + 1] - cumulative[i];
+			sum += std::min(1.0, (i + 0.5) / bins * gain) * count;
+		}
+		return sum / total;
+	}
+
+	double gamma_ = kDefaultEncodingGamma;
+	Histogram hist_;
+};
+
+class IPAMtkCamraw : public IPAMtkCamrawInterface
+{
+public:
+	int init(const IPASettings &settings, const IPAConfigInfo &configInfo,
+		 ControlInfoMap *ipaControls) override;
+	int configure(const IPAConfigInfo &configInfo,
+		      ControlInfoMap *ipaControls) override;
+
+	void start(const ControlList &sensorControls, StartResult *result) override;
+	void stop() override;
+
+	void queueRequest(const uint32_t frame, const ControlList &controls) override;
+	void processStats(const uint32_t frame, const std::vector<uint32_t> &yHistogram,
+			  const ControlList &sensorControls) override;
+
+private:
+	void updateLimits(const IPAConfigInfo &configInfo, ControlInfoMap *ipaControls);
+	void setControls();
+	ControlList sensorValues() const;
+	uint32_t maxExposureLines() const;
+
+	static constexpr double kSettledTolerance = 0.03;
+	static constexpr unsigned int kMaxWait = 4;
+	double requestedEv_ = 0.0;
+	unsigned int waited_ = 0;
+
+	std::unique_ptr<CameraSensorHelper> camHelper_;
+	Agc agc_;
+	ControlInfoMap sensorControls_;
+
+	utils::Duration lineDuration_;
+	Size outputSize_;
+	uint32_t lineLength_ = 0;
+	uint32_t exposureMargin_ = 0;
+	/* lines AE keeps between exposure and frame end (>= the sensor's margin) */
+	uint32_t frameMargin_ = 0;
+	int64_t tuningFrameMargin_ = -1;
+	int64_t tuningMaxFrameUs_ = 0;
+	int32_t minVblank_ = 0;
+	int32_t tuningMinVblank_ = 0;
+	int32_t tuningMargin_ = -1;
+	double tuningMaxGain_ = 0.0;
+	int32_t maxVblank_ = 0;
+	utils::Duration minFrameDuration_;
+	utils::Duration maxFrameDuration_;
+	double minGain_ = 1.0;
+	double maxGain_ = 1.0;
+	uint32_t minExposure_ = 1;
+
+	/* what is applied next */
+	bool autoEnabled_ = true;
+	uint32_t exposure_ = 0;		/* lines */
+	double gain_ = 1.0;
+	uint32_t manualExposure_ = 0;
+	double manualGain_ = 1.0;
+	int32_t constraintMode_ = 0;
+	int32_t exposureMode_ = 0;
+};
+
+int IPAMtkCamraw::init(const IPASettings &settings, const IPAConfigInfo &configInfo,
+		       ControlInfoMap *ipaControls)
+{
+	camHelper_ = CameraSensorHelperFactoryBase::create(settings.sensorModel);
+	if (!camHelper_) {
+		LOG(IPAMtkCamraw, Error)
+			<< "No camera sensor helper for " << settings.sensorModel;
+		return -ENODEV;
+	}
+
+	File file(settings.configurationFile);
+	if (!file.open(File::OpenModeFlag::ReadOnly)) {
+		int ret = file.error();
+		LOG(IPAMtkCamraw, Error)
+			<< "Failed to open configuration file "
+			<< settings.configurationFile << ": " << strerror(-ret);
+		return ret;
+	}
+
+	std::unique_ptr<ValueNode> data = YamlParser::parse(file);
+	if (!data)
+		return -EINVAL;
+
+	/* algorithms: [ { Agc: { ... } } ] as in the other IPAs */
+	static const ValueNode empty;
+	const ValueNode *agcData = &empty;
+	const ValueNode &algos = (*data)["algorithms"];
+	if (algos.isList()) {
+		for (const auto &algo : algos.asList()) {
+			if (algo.contains("Agc"))
+				agcData = &algo["Agc"];
+		}
+	}
+
+	agc_.setEncodingGamma((*agcData)["encodingGamma"].get<double>(kDefaultEncodingGamma));
+	/*
+	 * Frame length margin: the picture's frame done comes about 0.5 ms
+	 * after the last line; with the shortest blanking it lands on the
+	 * next start of frame and the engine starts dropping frames.
+	 */
+	tuningMinVblank_ = (*data)["minVblank"].get<int32_t>(0);
+	/* lines the sensor keeps between exposure and frame length */
+	tuningMargin_ = (*data)["exposureMargin"].get<int32_t>(-1);
+	/* AE's analogue gain limit (image quality), below the sensor's own */
+	tuningMaxGain_ = (*data)["maxAnalogueGain"].get<double>(0.0);
+	/*
+	 * The replayed ISP misbehaves (late frame done, CQ trigger delay,
+	 * lost frames) when the exposure comes close to the frame length:
+	 * AE keeps frameMargin lines free and lengthens the frame instead,
+	 * up to maxFrameDuration (us).
+	 */
+	tuningFrameMargin_ = (*data)["frameMargin"].get<int32_t>(-1);
+	tuningMaxFrameUs_ = (*data)["maxFrameDuration"].get<int32_t>(0);
+	int ret = agc_.parseTuningData(*agcData);
+	if (ret)
+		return ret;
+
+	constraintMode_ = agc_.constraintModes().begin()->first;
+	exposureMode_ = agc_.exposureModeHelpers().begin()->first;
+
+	updateLimits(configInfo, ipaControls);
+	return 0;
+}
+
+/* limits of the sensor mode and the controls the camera offers */
+void IPAMtkCamraw::updateLimits(const IPAConfigInfo &configInfo,
+				ControlInfoMap *ipaControls)
+{
+	const IPACameraSensorInfo &info = configInfo.sensorInfo;
+	const ControlInfoMap &sensorControls = configInfo.sensorControls;
+
+	sensorControls_ = sensorControls;
+	outputSize_ = info.outputSize;
+	lineLength_ = info.minLineLength;
+	lineDuration_ = info.minLineLength * 1.0s / info.pixelRate;
+
+	const ControlInfo &v4l2Exposure = sensorControls.find(V4L2_CID_EXPOSURE)->second;
+	const ControlInfo &v4l2Gain = sensorControls.find(V4L2_CID_ANALOGUE_GAIN)->second;
+	const ControlInfo &v4l2VBlank = sensorControls.find(V4L2_CID_VBLANK)->second;
+
+	minExposure_ = v4l2Exposure.min().get<int32_t>();
+	minVblank_ = std::clamp(tuningMinVblank_, v4l2VBlank.min().get<int32_t>(),
+				v4l2VBlank.max().get<int32_t>());
+	maxVblank_ = v4l2VBlank.max().get<int32_t>();
+	minGain_ = camHelper_->gain(v4l2Gain.min().get<int32_t>());
+	maxGain_ = camHelper_->gain(v4l2Gain.max().get<int32_t>());
+	if (tuningMaxGain_ >= minGain_)
+		maxGain_ = std::min(maxGain_, tuningMaxGain_);
+
+	/*
+	 * The exposure range the sensor reports is that of its current frame
+	 * length (default vertical blanking): the difference is the margin
+	 * the sensor keeps between exposure and frame length.
+	 */
+	/*
+	 * Without a tuned margin: the exposure range the sensor reports is
+	 * that of its current frame length, which is the default only on a
+	 * fresh sensor - a margin from it is a guess.
+	 */
+	if (tuningMargin_ >= 0) {
+		exposureMargin_ = tuningMargin_;
+	} else {
+		int32_t defFrameLength = outputSize_.height + v4l2VBlank.def().get<int32_t>();
+		int32_t maxExposureNow = v4l2Exposure.max().get<int32_t>();
+		exposureMargin_ = std::max(0, defFrameLength - maxExposureNow);
+	}
+
+	frameMargin_ = std::max<int64_t>(exposureMargin_, tuningFrameMargin_);
+
+	minFrameDuration_ = (outputSize_.height + minVblank_) * lineDuration_;
+	/*
+	 * Longest frame AE may use: the tuning file's (lower frame rate in the
+	 * dark), else the fastest frame rate of the mode; FrameDurationLimits
+	 * overrides it.
+	 */
+	utils::Duration longest = (outputSize_.height + maxVblank_) * lineDuration_;
+	maxFrameDuration_ = std::clamp<utils::Duration>(std::chrono::microseconds(tuningMaxFrameUs_),
+							minFrameDuration_, longest);
+
+	if (!exposure_) {
+		exposure_ = v4l2Exposure.def().get<int32_t>();
+		gain_ = std::max(minGain_, camHelper_->gain(v4l2Gain.def().get<int32_t>()));
+		manualExposure_ = exposure_;
+		manualGain_ = gain_;
+	}
+
+	ControlInfoMap::Map ctrls = agc_.controls();
+	double lineUs = lineDuration_.get<std::micro>();
+	int64_t minFrameUs = minFrameDuration_.get<std::micro>();
+	int64_t maxFrameUs = utils::Duration((outputSize_.height + maxVblank_) * lineDuration_).get<std::micro>();
+
+	ctrls[&controls::AeEnable] = ControlInfo(false, true, true);
+	ctrls[&controls::ExposureTime] =
+		ControlInfo(static_cast<int32_t>(minExposure_ * lineUs),
+			    static_cast<int32_t>((outputSize_.height + maxVblank_ -
+						  exposureMargin_) * lineUs),
+			    static_cast<int32_t>(exposure_ * lineUs));
+	ctrls[&controls::AnalogueGain] =
+		ControlInfo(static_cast<float>(minGain_), static_cast<float>(maxGain_),
+			    static_cast<float>(gain_));
+	ctrls[&controls::ExposureValue] = ControlInfo(-8.0f, 8.0f, 0.0f);
+	int64_t defMaxFrameUs = maxFrameDuration_.get<std::micro>();
+	ctrls[&controls::FrameDurationLimits] =
+		ControlInfo(minFrameUs, maxFrameUs,
+			    ControlValue(Span<const int64_t, 2>{ { minFrameUs, defMaxFrameUs } }));
+
+	*ipaControls = ControlInfoMap(std::move(ctrls), controls::controls);
+
+	LOG(IPAMtkCamraw, Debug)
+		<< "line " << lineDuration_ << ", exposure margin " << exposureMargin_
+		<< " lines, gain " << minGain_ << "-" << maxGain_
+		<< ", frame " << minFrameDuration_ << "-"
+		<< (outputSize_.height + maxVblank_) * lineDuration_;
+}
+
+int IPAMtkCamraw::configure(const IPAConfigInfo &configInfo,
+			    ControlInfoMap *ipaControls)
+{
+	updateLimits(configInfo, ipaControls);
+
+	agc_.configure(lineDuration_, camHelper_.get());
+	agc_.setLimits(minExposure_ * lineDuration_, maxExposureLines() * lineDuration_,
+		       minGain_, maxGain_, {});
+	agc_.resetFrameCount();
+	return 0;
+}
+
+void IPAMtkCamraw::start(const ControlList &sensorControls, StartResult *result)
+{
+	if (sensorControls.contains(V4L2_CID_EXPOSURE))
+		exposure_ = std::max<int32_t>(minExposure_,
+					      sensorControls.get(V4L2_CID_EXPOSURE).get<int32_t>());
+	if (sensorControls.contains(V4L2_CID_ANALOGUE_GAIN))
+		gain_ = std::clamp(camHelper_->gain(sensorControls.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>()),
+				   minGain_, maxGain_);
+	exposure_ = std::min(exposure_, maxExposureLines());
+	requestedEv_ = 0.0;
+	waited_ = 0;
+	/* inside the limits before the first frame (a previous session may have used 64x) */
+	result->controls = sensorValues();
+	result->ret = 0;
+}
+
+void IPAMtkCamraw::stop()
+{
+}
+
+void IPAMtkCamraw::queueRequest([[maybe_unused]] const uint32_t frame,
+				const ControlList &controls)
+{
+	const auto &aeEnable = controls.get(controls::AeEnable);
+	if (aeEnable && *aeEnable != autoEnabled_) {
+		autoEnabled_ = *aeEnable;
+		if (!autoEnabled_) {
+			manualExposure_ = exposure_;
+			manualGain_ = gain_;
+		}
+		LOG(IPAMtkCamraw, Debug) << "AGC " << (autoEnabled_ ? "on" : "off");
+	}
+
+	const auto &exposureTime = controls.get(controls::ExposureTime);
+	if (exposureTime)
+		manualExposure_ = std::max<uint32_t>(minExposure_,
+						     *exposureTime * 1.0us / lineDuration_);
+	const auto &analogueGain = controls.get(controls::AnalogueGain);
+	if (analogueGain)
+		manualGain_ = std::clamp<double>(*analogueGain, minGain_, maxGain_);
+
+	const auto &ev = controls.get(controls::ExposureValue);
+	if (ev)
+		agc_.setExposureCompensation(std::pow(2.0, *ev));
+
+	const auto &constraintMode = controls.get(controls::AeConstraintMode);
+	if (constraintMode)
+		constraintMode_ = *constraintMode;
+	const auto &exposureMode = controls.get(controls::AeExposureMode);
+	if (exposureMode)
+		exposureMode_ = *exposureMode;
+
+	const auto &frameDurations = controls.get(controls::FrameDurationLimits);
+	if (frameDurations) {
+		utils::Duration maxFrame = std::chrono::microseconds((*frameDurations)[1]);
+		utils::Duration longest = (outputSize_.height + maxVblank_) * lineDuration_;
+
+		maxFrameDuration_ = std::clamp(maxFrame, minFrameDuration_, longest);
+		agc_.setLimits(minExposure_ * lineDuration_,
+			       maxExposureLines() * lineDuration_,
+			       minGain_, maxGain_, {});
+	}
+
+	if (!autoEnabled_) {
+		exposure_ = manualExposure_;
+		gain_ = manualGain_;
+	}
+}
+
+void IPAMtkCamraw::processStats(const uint32_t frame,
+				const std::vector<uint32_t> &yHistogram,
+				const ControlList &sensorControls)
+{
+	ControlList metadata(controls::controls);
+
+	/* what the sensor ran for this frame */
+	uint32_t exposure = exposure_;
+	double gain = gain_;
+	int32_t vblank = minVblank_;
+	if (sensorControls.contains(V4L2_CID_EXPOSURE))
+		exposure = sensorControls.get(V4L2_CID_EXPOSURE).get<int32_t>();
+	if (sensorControls.contains(V4L2_CID_ANALOGUE_GAIN))
+		gain = camHelper_->gain(sensorControls.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>());
+	if (sensorControls.contains(V4L2_CID_VBLANK))
+		vblank = sensorControls.get(V4L2_CID_VBLANK).get<int32_t>();
+
+	utils::Duration exposureTime = exposure * lineDuration_;
+
+	/*
+	 * The sensor takes new values a few frames late: compute only on a
+	 * frame that shows the exposure last asked for (or after a few frames
+	 * of waiting), otherwise the AGC corrects the same error twice and
+	 * the exposure swings.
+	 */
+	double appliedEv = exposure * gain;
+	bool settled = requestedEv_ <= 0.0 ||
+		       std::abs(appliedEv / requestedEv_ - 1.0) < kSettledTolerance ||
+		       ++waited_ > kMaxWait;
+
+	if (autoEnabled_ && !yHistogram.empty() && settled) {
+		agc_.setHistogram(yHistogram);
+
+		utils::Duration newExposure;
+		double aGain, qGain, dGain;
+		/* aGain is quantised to the sensor steps, qGain the rest */
+		std::tie(newExposure, aGain, qGain, dGain) =
+			agc_.calculateNewEv(constraintMode_, exposureMode_,
+					    agc_.histogram(), exposureTime * gain);
+
+		/* no digital gain can be applied: the ISP settings are frozen */
+		exposure_ = std::min(std::max<uint32_t>(minExposure_, newExposure / lineDuration_),
+				     maxExposureLines());
+		gain_ = std::clamp(camHelper_->gain(camHelper_->gainCode(aGain)), minGain_, maxGain_);
+		requestedEv_ = exposure_ * gain_;
+		waited_ = 0;
+
+		LOG(IPAMtkCamraw, Debug)
+			<< "frame " << frame << ": " << exposureTime << " x " << gain
+			<< " -> " << exposure_ * lineDuration_ << " x " << gain_
+			<< (dGain > 1.01 ? " (would need digital gain)" : "");
+	}
+
+	setControls();
+
+	uint32_t frameLength = outputSize_.height + vblank;
+	metadata.set(controls::ExposureTime,
+		     static_cast<int32_t>(exposureTime.get<std::micro>()));
+	metadata.set(controls::AnalogueGain, static_cast<float>(gain));
+	metadata.set(controls::FrameDuration,
+		     static_cast<int64_t>(utils::Duration(frameLength * lineDuration_).get<std::micro>()));
+	metadata.set(controls::AeEnable, autoEnabled_);
+	metadataReady.emit(frame, metadata);
+}
+
+/* the longest exposure the allowed frame length leaves */
+uint32_t IPAMtkCamraw::maxExposureLines() const
+{
+	uint32_t frameLines = maxFrameDuration_ / lineDuration_;
+
+	return std::max<uint32_t>(minExposure_, frameLines - frameMargin_);
+}
+
+/* exposure, gain and the frame length that keeps frameMargin lines after the exposure */
+ControlList IPAMtkCamraw::sensorValues() const
+{
+	uint32_t exposure = std::min(exposure_, maxExposureLines());
+	int32_t vblank = std::max<int32_t>(minVblank_,
+					   exposure + frameMargin_ - outputSize_.height);
+	ControlList ctrls(sensorControls_);
+
+	ctrls.set(V4L2_CID_VBLANK, vblank);
+	ctrls.set(V4L2_CID_EXPOSURE, static_cast<int32_t>(exposure));
+	ctrls.set(V4L2_CID_ANALOGUE_GAIN,
+		  static_cast<int32_t>(camHelper_->gainCode(gain_)));
+	return ctrls;
+}
+
+void IPAMtkCamraw::setControls()
+{
+	setSensorControls.emit(sensorValues());
+}
+
+} /* namespace ipa::mtkcamraw */
