new file mode 100644
index 0000000..cb3c864
--- /dev/null
+++ b/src/ipa/mtkcamraw/data/imx766.yaml
@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: CC0-1.0
+%YAML 1.1
+---
+version: 1
+# Vertical blanking at least this (lines): the frame done of the replayed
+# ISP comes ~0.5 ms after the last line, 300 lines (3.1 ms) keep it ahead of
+# the next start of frame (28.3 fps instead of 30).
+minVblank: 300
+# Lines the sensor itself keeps between exposure and frame length.
+exposureMargin: 48
+# Lines AE keeps between exposure and frame length: with only the sensor's
+# 48 the replayed ISP lost frames (exposure 3324 of 3372 lines); 3144 of
+# 3372 ran clean. A longer exposure lengthens the frame instead.
+frameMargin: 256
+# Longest frame AE may use (us): 15 fps in the dark.
+maxFrameDuration: 66667
+# AE's analogue gain limit: the sensor goes to 64x, which is very noisy.
+maxAnalogueGain: 16.0
+algorithms:
+  - Agc:
+      encodingGamma: 2.2
+      # mean linear luminance target; 0.12 is about 97 of 255 on the output
+      relativeLuminanceTarget: [ 0, 0.12 ]
+      # Highlights: an upper bound only. libipa's default lower bound (top
+      # 2 % at least 0.5) halves the exposure at most per step while the
+      # output is clipped, which takes ~20 frames from an overexposed start.
+      AeConstraintMode:
+        ConstraintNormal:
+          upper:
+            qLo: 0.98
+            qHi: 1.0
+            yTarget: [ 0, 0.95 ]
+      AeExposureMode:
+        ExposureNormal:
+          # exposure time up to 30 ms at 1x, gain to 4x, then longer frames
+          # (down to 15 fps) at 4x, then gain to the limit
+          exposureTime: [ 100, 10000, 30000, 30000, 60000, 60000 ]
+          gain: [ 1.0, 1.0, 1.0, 4.0, 4.0, 16.0 ]
+...
