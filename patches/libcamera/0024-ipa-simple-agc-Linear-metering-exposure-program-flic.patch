+++ b/src/ipa/simple/algorithms/agc.h
@@ -7,6 +7,10 @@
 
 #pragma once
 
+#include <array>
+#include <utility>
+#include <vector>
+
 #include "algorithm.h"
 
 namespace libcamera {
@@ -28,12 +32,26 @@ public:
 
 private:
 	void updateExposure(IPAContext &context, IPAFrameContext &frameContext,
-			    double exposureMSV, double highlights);
+			    double exposureMSV, double linearMean, double highlights);
+	void distribute(IPAContext &context, double total,
+			int32_t &exposure, double &gain) const;
 
 	/* Target mean sample value (1 .. kExposureBinsCount) */
 	double target_;
 	/* Fraction of the samples allowed in the top histogram bins */
 	double highlightLimit_;
+
+	/*
+	 * Linear metering: weighted mean of the 5x5 zones above the black
+	 * level, as a fraction of the range; 0 = use the MSV target
+	 */
+	double targetLinear_ = 0.0;
+	std::array<double, 25> weights_ = {};
+
+	/* Exposure program: (exposure time in s, total gain) points */
+	std::vector<std::pair<double, double>> program_;
+	/* Flicker period in s (0 = no flicker avoidance) */
+	double flickerPeriod_ = 0.0;
 };
 
 } /* namespace ipa::soft::algorithms */
