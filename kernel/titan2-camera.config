# Camera options for the Titan 2 on top of arm64 defconfig + configs/mainline-titan2.config of
# titan2-tools (https://github.com/Serlk/titan2-tools), for titan2-linux branch titan2 with kernel/patches.
# MT6319 (SPMI SID 6, MT6315 driver): vbuck1 = camera/ISP vcore ("VMM") for the CAM/ISP power
# domains; built in, the power controller needs it at probe. The node is enabled only by the
# camera board file.
CONFIG_REGULATOR_MT6315=y
# test-only switches of the camera board (sensor rails from user space)
CONFIG_REGULATOR_USERSPACE_CONSUMER=y
# seninf + camsv + the sensors, as modules
CONFIG_VIDEO_MEDIATEK_SENINF=m
CONFIG_VIDEO_MEDIATEK_CAMSV=m
CONFIG_VIDEO_IMX766=m
CONFIG_VIDEO_S5KGD1SP=m
CONFIG_VIDEO_HI847=m
# autofocus VCMs: DW9714 (Hi-847), DW9800K through dw9719 (IMX766)
CONFIG_VIDEO_DW9714=m
CONFIG_VIDEO_DW9719=m
# libcamera DmaBufAllocator (softISP output buffers): /dev/dma_heap without module autoload
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
