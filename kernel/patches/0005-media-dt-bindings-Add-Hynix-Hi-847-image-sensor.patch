From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:22:52 +0300
Subject: [PATCH 05/19] media: dt-bindings: Add Hynix Hi-847 image sensor

The hi847 driver only had an ACPI match. Describe the sensor for DT:
MCLK (19.2 or 24 MHz), reset and power down GPIOs, the three supplies
and the 4-lane CSI-2 endpoint.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/media/i2c/hynix,hi847.yaml       | 112 ++++++++++++++++++
 MAINTAINERS                                   |   1 +
 2 files changed, 113 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/hynix,hi847.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/hynix,hi847.yaml b/Documentation/devicetree/bindings/media/i2c/hynix,hi847.yaml
new file mode 100644
index 000000000000..bd350dc9f8e1
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/hynix,hi847.yaml
@@ -0,0 +1,112 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/hynix,hi847.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SK Hynix Hi-847 8M Pixel MIPI CSI-2 sensor
+
+maintainers:
+  - serlk <22211586+Serlk@users.noreply.github.com>
+
+description:
+  The Hi-847 is an 8 megapixel raw image sensor with a 4-lane MIPI CSI-2
+  D-PHY data interface and a CCI (I2C compatible) control bus. The driver
+  supports a 19.2 MHz or a 24 MHz external clock; the link frequencies
+  depend on it (19.2 MHz - 400 and 200 MHz, 24 MHz - 500 and 400 MHz).
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: hynix,hi847
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK, 19.2 or 24 MHz.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the RESETB pin.
+    maxItems: 1
+
+  powerdown-gpios:
+    description: Active low GPIO connected to the power down pin.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  dvdd-supply:
+    description: Digital core voltage supply.
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@20 {
+            compatible = "hynix,hi847";
+            reg = <0x20>;
+            clocks = <&camera_mclk 0>;
+            assigned-clocks = <&camera_mclk 0>;
+            assigned-clock-rates = <24000000>;
+            reset-gpios = <&gpio 25 GPIO_ACTIVE_LOW>;
+            powerdown-gpios = <&gpio 189 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&vcam_avdd>;
+            dvdd-supply = <&vcam_dvdd>;
+            dovdd-supply = <&vcam_dovdd>;
+            lens-focus = <&vcm>;
+            orientation = <1>;
+            rotation = <270>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <500000000 400000000>;
+                    remote-endpoint = <&csi_in>;
+                };
+            };
+        };
+    };
+...
