+	.driver = {
+		.name = "s5kgd1sp",
+		.pm = pm_ptr(&s5kgd1sp_pm_ops),
+		.of_match_table = s5kgd1sp_of_match,
+	},
+	.probe = s5kgd1sp_probe,
+	.remove = s5kgd1sp_remove,
+};
+module_i2c_driver(s5kgd1sp_i2c_driver);
