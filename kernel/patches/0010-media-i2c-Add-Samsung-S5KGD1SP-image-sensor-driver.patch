+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Samsung S5KGD1SP image sensor driver
+ *
+ * Copyright (c) 2026 serlk
+ *
+ * Written from the Titan 2 camera sensor specification. The sensor needs a
+ * sensor firmware patch (TnP) on every power-up; it is not part of this
+ * driver and is loaded with request_firmware() from S5KGD1SP_TNP_FW.
+ *
+ * TnP firmware file format: a flat array of little-endian u16 pairs
+ * { register, value }, 4 bytes per entry, no header. The entries are written
+ * in file order as 16-bit register writes, without sorting or removing
+ * duplicates (the 0x6f12 data window auto-increments, and 0x602a moves it).
+ * The file is not distributed with the kernel; the user has to supply it.
+ *
+ * One mode, 3280x2464 at 30 fps over 4-lane D-PHY, RAW10.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5KGD1SP_TNP_FW			"s5kgd1sp_tnp.bin"
+/* Sanity limit for the TnP file: the known table has 1215 entries */
+#define S5KGD1SP_TNP_MAX_ENTRIES	4096
+
+#define S5KGD1SP_MCLK_FREQ		(24 * HZ_PER_MHZ)
+#define S5KGD1SP_DATA_LANES		4
+
+#define S5KGD1SP_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5KGD1SP_CHIP_ID		0x0841
+
+#define S5KGD1SP_REG_FRAME_COUNT	CCI_REG8(0x0005)
+
+#define S5KGD1SP_REG_MODE_SELECT	CCI_REG8(0x0100)
+#define S5KGD1SP_MODE_STANDBY		0x00
+#define S5KGD1SP_MODE_STREAMING		0x01
+
+#define S5KGD1SP_REG_ORIENTATION	CCI_REG8(0x0101)
+#define S5KGD1SP_HFLIP			BIT(0)
+#define S5KGD1SP_VFLIP			BIT(1)
+
+#define S5KGD1SP_REG_GROUP_HOLD		CCI_REG8(0x0104)
+
+#define S5KGD1SP_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5KGD1SP_EXPOSURE_MIN		3
+#define S5KGD1SP_EXPOSURE_STEP		1
+#define S5KGD1SP_EXPOSURE_MARGIN	3
+#define S5KGD1SP_EXPOSURE_DEFAULT	976
+
+/* code = gain * 32, i.e. 1/32 steps: 1x = 0x20 .. 16x = 0x200 */
+#define S5KGD1SP_REG_ANALOG_GAIN	CCI_REG16(0x0204)
+#define S5KGD1SP_AGAIN_MIN		0x0020
+#define S5KGD1SP_AGAIN_MAX		0x0200
+#define S5KGD1SP_AGAIN_STEP		1
+#define S5KGD1SP_AGAIN_DEFAULT		0x0080	/* 4x */
+
+#define S5KGD1SP_REG_FRAME_LENGTH	CCI_REG16(0x0340)
+#define S5KGD1SP_FLL_MAX		0xffff
+
+#define S5KGD1SP_REG_TEST_PATTERN	CCI_REG16(0x0600)
+#define S5KGD1SP_REG_TP_RED		CCI_REG16(0x0602)
+#define S5KGD1SP_REG_TP_GREENR		CCI_REG16(0x0604)
+#define S5KGD1SP_REG_TP_BLUE		CCI_REG16(0x0606)
+#define S5KGD1SP_REG_TP_GREENB		CCI_REG16(0x0608)
+#define S5KGD1SP_TP_COLOUR_MAX		0x3ff
+
+#define S5KGD1SP_REG_PAGE		CCI_REG16(0x6028)
+#define S5KGD1SP_REG_SW_RESET		CCI_REG16(0x6010)
+
+/*
+ * 345.6 Mpixel/s RAW10 on 4 lanes: 864 Mbit/s per lane. The mode table PLL
+ * (24 MHz / 4 (0x030e) * 288 (0x0310) / 2 (0x0312)) gives the same 864.
+ * csi_pixel_rate is taken as pixel/s.
+ */
+#define S5KGD1SP_LINK_FREQ_432MHZ	(432 * HZ_PER_MHZ)
+
+#define S5KGD1SP_NATIVE_WIDTH		6560
+#define S5KGD1SP_NATIVE_HEIGHT		4928
+
+static const s64 s5kgd1sp_link_freq_menu[] = {
+	S5KGD1SP_LINK_FREQ_432MHZ,
+};
+
+static const char * const s5kgd1sp_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+};
+
+/*
+ * Indexed by the register mirror bits (vflip << 1) | hflip. The factory
+ * configuration (both bits set) delivers a Gb first pixel; the other entries
+ * are derived from it. TODO: only the factory (1, 1) setting is
+ * confirmed.
+ *
+ * The module is mounted with both mirror bits set (factory setting), and the DT
+ * rotation is given for that orientation. The HFLIP/VFLIP controls are
+ * relative to it: 0/0 is the factory orientation, so that userspace resetting
+ * the flips (libcamera does for an identity transform) keeps the confirmed
+ * Bayer order and the mounting rotation.
+ */
+#define S5KGD1SP_MOUNT_FLIPS		(S5KGD1SP_HFLIP | S5KGD1SP_VFLIP)
+
+static const u32 s5kgd1sp_mbus_codes[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+static const char * const s5kgd1sp_supply_names[] = {
+	"dovdd",	/* Digital I/O 1.8 V */
+	"avdd",		/* Analog 2.8 V */
+	"dvdd",		/* Digital core 1.1 V */
+};
+
+enum s5kgd1sp_supply {
+	S5KGD1SP_SUPPLY_DOVDD,
+	S5KGD1SP_SUPPLY_AVDD,
+	S5KGD1SP_SUPPLY_DVDD,
+	S5KGD1SP_NUM_SUPPLIES,
+};
+
