From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:22:55 +0300
Subject: [PATCH 08/19] media: i2c: Add Sony IMX766 image sensor driver

Port the sensor part of the MediaTek GPL imgsensor driver
(kernel_modules/mtkcam/imgsensor/src-v4l2/common/imx766_mipi_raw/) to a
mainline V4L2 subdev driver: init and mode register tables, gain code
16384 - 16384 / gain, group hold 0x0104, test pattern 0x0601 and the
frame counter stream-off check before a mode table.

Two modes: 4096x3072@30 (link 574 MHz) and 2048x1152@120 (377 MHz) on a
3-trio C-PHY bus, RAW10, R first pixel without flips. Controls: exposure
(24.., step 4, margin 48), analogue and digital gain, vblank, hblank,
pixel rate, link frequency, h/v flip (0x0101 bits 0/1, Bayer order
follows), test pattern, orientation/rotation. The power sequence is the
Titan 2 one. The module EEPROM is offered as read-only nvmem. No PDAF,
HDR or seamless mode switch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx766.c | 1544 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1556 insertions(+)
 create mode 100644 drivers/media/i2c/imx766.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5d173e0ecf42..eb26e3477c10 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -287,6 +287,17 @@ config VIDEO_IMX415
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx415.
 
+config VIDEO_IMX766
+	tristate "Sony IMX766 sensor support"
+	depends on OF
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX766 camera sensor with a MIPI CSI-2 C-PHY interface.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx766.
+
 config VIDEO_MAX9271_LIB
 	tristate
 
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index e45359efe0e4..e820a3d9a969 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -61,6 +61,7 @@ obj-$(CONFIG_VIDEO_IMX335) += imx335.o
 obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
+obj-$(CONFIG_VIDEO_IMX766) += imx766.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
