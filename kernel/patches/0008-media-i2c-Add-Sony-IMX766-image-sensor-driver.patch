+#define IMX766_NATIVE_WIDTH		8192
+#define IMX766_NATIVE_HEIGHT		6144
+
+struct imx766 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[IMX766_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+
+	const struct imx766_mode *mode;
+};
+
+static inline struct imx766 *to_imx766(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx766, sd);
+}
+
+static u32 imx766_get_format_code(struct imx766 *imx766)
+{
+	unsigned int i;
+
+	i = (imx766->vflip->val ? 2 : 0) | (imx766->hflip->val ? 1 : 0);
+
+	return imx766_mbus_codes[i];
+}
+
+static int imx766_group_hold(struct imx766 *imx766, bool hold, int *err)
+{
+	return cci_write(imx766->regmap, IMX766_REG_GROUP_HOLD, hold ? 1 : 0,
+			 err);
+}
+
+static int imx766_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx766 *imx766 = container_of(ctrl->handler, struct imx766,
+					     ctrl_handler);
+	const struct imx766_mode *mode = imx766->mode;
+	s64 exposure_max;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - IMX766_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(imx766->exposure,
+					 imx766->exposure->minimum,
+					 exposure_max,
+					 imx766->exposure->step,
+					 min_t(s64, IMX766_EXPOSURE_DEFAULT,
+					       exposure_max));
+	}
+
+	/* V4L2 controls are applied when the sensor is powered up */
+	if (!pm_runtime_get_if_active(imx766->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		imx766_group_hold(imx766, true, &ret);
+		cci_write(imx766->regmap, IMX766_REG_EXPOSURE, ctrl->val, &ret);
+		imx766_group_hold(imx766, false, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		imx766_group_hold(imx766, true, &ret);
+		cci_write(imx766->regmap, IMX766_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		imx766_group_hold(imx766, false, &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		imx766_group_hold(imx766, true, &ret);
+		cci_write(imx766->regmap, IMX766_REG_DIGITAL_GAIN, ctrl->val,
+			  &ret);
+		imx766_group_hold(imx766, false, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		imx766_group_hold(imx766, true, &ret);
+		cci_write(imx766->regmap, IMX766_REG_FRAME_LENGTH,
+			  mode->height + ctrl->val, &ret);
+		imx766_group_hold(imx766, false, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(imx766->regmap, IMX766_REG_ORIENTATION,
+				      IMX766_HFLIP | IMX766_VFLIP,
+				      (imx766->hflip->val ? IMX766_HFLIP : 0) |
+				      (imx766->vflip->val ? IMX766_VFLIP : 0),
+				      NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(imx766->regmap, IMX766_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_LINK_FREQ:
+	case V4L2_CID_PIXEL_RATE:
+	case V4L2_CID_HBLANK:
+		/* Read-only, follow the mode */
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(imx766->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx766_ctrl_ops = {
+	.s_ctrl = imx766_set_ctrl,
+};
+
+static int imx766_init_controls(struct imx766 *imx766)
+{
+	struct v4l2_ctrl_handler *hdl = &imx766->ctrl_handler;
+	const struct imx766_mode *mode = imx766->mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 hblank, vblank, exposure_max;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	imx766->link_freq =
+		v4l2_ctrl_new_int_menu(hdl, &imx766_ctrl_ops,
+				       V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(imx766_link_freq_menu) - 1,
+				       mode->link_freq_index,
+				       imx766_link_freq_menu);
+	if (imx766->link_freq)
+		imx766->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx766->pixel_rate = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       mode->pixel_rate,
+					       mode->pixel_rate, 1,
+					       mode->pixel_rate);
+
+	hblank = mode->line_length - mode->width;
+	imx766->hblank = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (imx766->hblank)
+		imx766->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->frame_length - mode->height;
+	imx766->vblank = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   IMX766_FLL_MAX - mode->height,
+					   mode->fll_step,
+					   mode->frame_length_def - mode->height);
+
+	exposure_max = mode->frame_length_def - IMX766_EXPOSURE_MARGIN;
+	imx766->exposure = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX766_EXPOSURE_MIN, exposure_max,
+					     IMX766_EXPOSURE_STEP,
+					     IMX766_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX766_AGAIN_MIN, IMX766_AGAIN_MAX,
+			  IMX766_AGAIN_STEP, IMX766_AGAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX766_DGAIN_MIN, IMX766_DGAIN_MAX,
+			  IMX766_DGAIN_STEP, IMX766_DGAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx766_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx766_test_pattern_menu) - 1,
+				     0, 0, imx766_test_pattern_menu);
+
+	imx766->hflip = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (imx766->hflip)
+		imx766->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	imx766->vflip = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (imx766->vflip)
+		imx766->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(imx766->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &imx766_ctrl_ops, &props);
+	if (ret)
+		goto error;
+
+	imx766->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+/*
+ * Wait until the frame counter reads 0xff (sensor in software standby), as
+ * the MediaTek driver does before writing a mode table. The timeout is one
+ * frame time of the current mode plus 1 ms.
+ */
+static void imx766_wait_stream_off(struct imx766 *imx766)
+{
+	const struct imx766_mode *mode = imx766->mode;
+	unsigned int i, timeout_ms;
+	u32 fps10;
+	u64 val;
+	int ret;
+
+	/* the current frame length: VBLANK may be above the mode minimum */
+	fps10 = div_u64(div_u64(mode->pixel_rate, mode->line_length) * 10,
+			mode->height + imx766->vblank->val);
+	timeout_ms = fps10 ? 10000 / fps10 + 1 : 101;
+
+	for (i = 0; i < timeout_ms; i++) {
+		ret = cci_read(imx766->regmap, IMX766_REG_FRAME_COUNT, &val,
+			       NULL);
+		if (!ret && val == 0xff)
+			return;
+		usleep_range(1000, 1100);
+	}
+
+	dev_warn(imx766->dev, "sensor did not report stream off\n");
+}
+
+static int imx766_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+	const struct imx766_reg_list *reg_list = &imx766->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx766->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(imx766->regmap, imx766_init_regs,
+				  ARRAY_SIZE(imx766_init_regs), NULL);
+	if (ret)
+		goto error;
+
+	/* Temperature sensor on, as the MediaTek open path does */
+	cci_write(imx766->regmap, IMX766_REG_TEMP_EN, 0x01, &ret);
+	if (ret)
+		goto error;
+
+	imx766_wait_stream_off(imx766);
+
+	cci_multi_reg_write(imx766->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	/*
+	 * No long exposure: coarse integration shift 0. Auto frame length
+	 * extension (0x0350) is left at its table/reset value, the exposure
+	 * control range keeps the exposure below frame length - margin.
+	 * TODO: the factory configuration writes 0x0350 = 1 with every exposure update.
+	 */
+	cci_write(imx766->regmap, IMX766_REG_EXPOSURE_LSHIFT, 0x00, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(imx766->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	ret = cci_write(imx766->regmap, IMX766_REG_MODE_SELECT,
+			IMX766_MODE_STREAMING, NULL);
+	if (ret)
+		goto error;
+
+	/* Flips must not change while streaming */
+	__v4l2_ctrl_grab(imx766->vflip, true);
+	__v4l2_ctrl_grab(imx766->hflip, true);
+
+	return 0;
+
+error:
+	dev_err(imx766->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(imx766->dev);
+
+	return ret;
+}
+
+static int imx766_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+	int ret;
+
+	ret = cci_write(imx766->regmap, IMX766_REG_MODE_SELECT,
+			IMX766_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(imx766->dev, "failed to stop streaming: %d\n", ret);
+
+	__v4l2_ctrl_grab(imx766->vflip, false);
+	__v4l2_ctrl_grab(imx766->hflip, false);
+
+	pm_runtime_put_autosuspend(imx766->dev);
+
+	return ret;
+}
+
+static void imx766_update_pad_format(struct imx766 *imx766,
+				     const struct imx766_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = imx766_get_format_code(imx766);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx766_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+	const struct imx766_mode *mode;
+	s64 hblank, vblank, exposure_max;
+	int ret;
+
+	mode = v4l2_find_nearest_size(imx766_modes, ARRAY_SIZE(imx766_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	imx766_update_pad_format(imx766, mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || imx766->mode == mode)
+		return 0;
+
+	imx766->mode = mode;
+
+	ret = __v4l2_ctrl_s_ctrl(imx766->link_freq, mode->link_freq_index);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(imx766->pixel_rate, mode->pixel_rate,
+				       mode->pixel_rate, 1, mode->pixel_rate);
+	if (ret)
+		return ret;
+
+	hblank = mode->line_length - mode->width;
+	ret = __v4l2_ctrl_modify_range(imx766->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	vblank = mode->frame_length - mode->height;
+	ret = __v4l2_ctrl_modify_range(imx766->vblank, vblank,
+				       IMX766_FLL_MAX - mode->height,
+				       mode->fll_step,
+				       mode->frame_length_def - mode->height);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx766->vblank,
+				 mode->frame_length_def - mode->height);
+	if (ret)
+		return ret;
+
+	exposure_max = mode->frame_length_def - IMX766_EXPOSURE_MARGIN;
+	return __v4l2_ctrl_modify_range(imx766->exposure, IMX766_EXPOSURE_MIN,
+					exposure_max, IMX766_EXPOSURE_STEP,
+					IMX766_EXPOSURE_DEFAULT);
+}
+
+static int imx766_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = imx766_get_format_code(imx766);
+
+	return 0;
+}
+
+static int imx766_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+
+	if (fse->index >= ARRAY_SIZE(imx766_modes))
+		return -EINVAL;
+
+	if (fse->code != imx766_get_format_code(imx766))
+		return -EINVAL;
+
+	fse->min_width = imx766_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = imx766_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx766_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX766_NATIVE_WIDTH;
+		sel->r.height = IMX766_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx766_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = imx766_modes[0].width,
+			.height = imx766_modes[0].height,
+		},
+	};
+
+	return imx766_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops imx766_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx766_pad_ops = {
+	.set_fmt = imx766_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = imx766_get_selection,
+	.enum_mbus_code = imx766_enum_mbus_code,
+	.enum_frame_size = imx766_enum_frame_size,
+	.enable_streams = imx766_enable_streams,
+	.disable_streams = imx766_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx766_subdev_ops = {
+	.video = &imx766_video_ops,
+	.pad = &imx766_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx766_internal_ops = {
+	.init_state = imx766_init_state,
+};
+
+static const struct media_entity_operations imx766_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+/*
+ * Power sequence of the Titan 2 module. Every step is followed by its delay;
+ * MCLK first, PDN and RST held low (asserted), AVDD, DVDD, DOVDD, then PDN and
+ * RST released. The MCLK pad drive strength is a pinctrl setting in DT; its
+ * 6 ms delay is kept at the same place in the sequence.
+ */
+static int imx766_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx766 *imx766 = to_imx766(sd);
+	int ret;
+
+	ret = clk_prepare_enable(imx766->mclk);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(imx766->powerdown_gpio, 1);
+	gpiod_set_value_cansleep(imx766->reset_gpio, 1);
+	usleep_range(1000, 1100);
+
+	ret = regulator_enable(imx766->supplies[IMX766_SUPPLY_AVDD].consumer);
+	if (ret)
+		goto err_clk;
+	usleep_range(3000, 3100);
+
+	ret = regulator_enable(imx766->supplies[IMX766_SUPPLY_DVDD].consumer);
+	if (ret)
+		goto err_avdd;
+	usleep_range(4000, 4100);
+
+	ret = regulator_enable(imx766->supplies[IMX766_SUPPLY_DOVDD].consumer);
+	if (ret)
+		goto err_dvdd;
+	usleep_range(1000, 1100);
+
+	/* MCLK drive strength step (pinctrl) */
+	usleep_range(6000, 6100);
+
+	gpiod_set_value_cansleep(imx766->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(imx766->reset_gpio, 0);
+	usleep_range(5000, 5100);
+
+	return 0;
+
+err_dvdd:
+	regulator_disable(imx766->supplies[IMX766_SUPPLY_DVDD].consumer);
+err_avdd:
+	regulator_disable(imx766->supplies[IMX766_SUPPLY_AVDD].consumer);
+err_clk:
+	gpiod_set_value_cansleep(imx766->reset_gpio, 1);
+	gpiod_set_value_cansleep(imx766->powerdown_gpio, 1);
+	clk_disable_unprepare(imx766->mclk);
+
+	return ret;
+}
+
+/* Reverse order of imx766_power_on(), without delays */
+static int imx766_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx766 *imx766 = to_imx766(sd);
+
+	gpiod_set_value_cansleep(imx766->reset_gpio, 1);
+	gpiod_set_value_cansleep(imx766->powerdown_gpio, 1);
+	regulator_disable(imx766->supplies[IMX766_SUPPLY_DOVDD].consumer);
+	regulator_disable(imx766->supplies[IMX766_SUPPLY_DVDD].consumer);
+	regulator_disable(imx766->supplies[IMX766_SUPPLY_AVDD].consumer);
+	clk_disable_unprepare(imx766->mclk);
+
+	return 0;
+}
+
+static int imx766_identify(struct imx766 *imx766)
+{
+	unsigned int retry;
+	u64 hi = 0, lo = 0;
+	int ret;
+
+	/* The MediaTek probe reads the ID up to two times */
+	for (retry = 0; retry < 2; retry++) {
+		ret = cci_read(imx766->regmap, IMX766_REG_CHIP_ID_H, &hi, NULL);
+		cci_read(imx766->regmap, IMX766_REG_CHIP_ID_L, &lo, &ret);
+		if (!ret && ((hi << 8) | lo) == IMX766_CHIP_ID)
+			return 0;
+	}
+
+	if (ret)
+		return dev_err_probe(imx766->dev, ret,
+				     "failed to read chip id\n");
+
+	return dev_err_probe(imx766->dev, -ENODEV,
+			     "chip id mismatch: %x != %llx\n",
+			     IMX766_CHIP_ID, (hi << 8) | lo);
+}
+
+static int imx766_check_hwcfg(struct imx766 *imx766)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx766->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX766_CPHY_TRIOS) {
+		dev_err(imx766->dev, "unsupported number of C-PHY trios: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(imx766->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       imx766_link_freq_menu,
+				       ARRAY_SIZE(imx766_link_freq_menu),
+				       &freq_bitmap);
+	if (ret)
+		goto out;
+
+	/* Every mode has its own link frequency, all of them are needed */
+	if (freq_bitmap != GENMASK(ARRAY_SIZE(imx766_link_freq_menu) - 1, 0)) {
+		dev_err(imx766->dev, "link-frequencies must list 574 and 377 MHz\n");
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int imx766_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx766 *imx766;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	imx766 = devm_kzalloc(dev, sizeof(*imx766), GFP_KERNEL);
+	if (!imx766)
+		return -ENOMEM;
+
+	imx766->dev = dev;
+	v4l2_i2c_subdev_init(&imx766->sd, client, &imx766_subdev_ops);
+
+	ret = imx766_check_hwcfg(imx766);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to check HW configuration\n");
+
+	imx766->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx766->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx766->regmap),
+				     "failed to init CCI\n");
+
+	imx766->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(imx766->mclk))
+		return dev_err_probe(dev, PTR_ERR(imx766->mclk),
+				     "failed to get MCLK\n");
+
+	freq = clk_get_rate(imx766->mclk);
+	if (freq != IMX766_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "MCLK frequency %lu is not supported\n",
+				     freq);
+
+	for (i = 0; i < IMX766_NUM_SUPPLIES; i++)
+		imx766->supplies[i].supply = imx766_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, IMX766_NUM_SUPPLIES,
+				      imx766->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	imx766->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx766->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx766->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	imx766->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(imx766->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx766->powerdown_gpio),
+				     "failed to get powerdown GPIO\n");
+
+	ret = imx766_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = imx766_identify(imx766);
+	if (ret)
+		goto err_power_off;
+
+	/* Module calibration, readable only while powered */
+	mtk_module_eeprom_register(dev, client, "imx766-eeprom");
+
+	imx766->mode = &imx766_modes[0];
+
+	ret = imx766_init_controls(imx766);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init controls\n");
+		goto err_power_off;
+	}
+
+	imx766->sd.state_lock = imx766->ctrl_handler.lock;
+	imx766->sd.internal_ops = &imx766_internal_ops;
+	imx766->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx766->sd.entity.ops = &imx766_entity_ops;
+	imx766->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx766->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx766->sd.entity, 1, &imx766->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_ctrl_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&imx766->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity_cleanup;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx766->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&imx766->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_entity_cleanup:
+	media_entity_cleanup(&imx766->sd.entity);
+err_ctrl_free:
+	v4l2_ctrl_handler_free(&imx766->ctrl_handler);
+err_power_off:
+	imx766_power_off(dev);
+
+	return ret;
+}
+
+static void imx766_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx766 *imx766 = to_imx766(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx766->ctrl_handler);
+
+	pm_runtime_disable(imx766->dev);
+	if (!pm_runtime_status_suspended(imx766->dev)) {
+		imx766_power_off(imx766->dev);
+		pm_runtime_set_suspended(imx766->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx766_pm_ops, imx766_power_off,
+				 imx766_power_on, NULL);
+
+static const struct of_device_id imx766_of_match[] = {
+	{ .compatible = "sony,imx766" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx766_of_match);
+
+static struct i2c_driver imx766_i2c_driver = {
+	.driver = {
+		.name = "imx766",
+		.pm = pm_ptr(&imx766_pm_ops),
+		.of_match_table = imx766_of_match,
+	},
+	.probe = imx766_probe,
+	.remove = imx766_remove,
+};
+module_i2c_driver(imx766_i2c_driver);
+
+MODULE_DESCRIPTION("Sony IMX766 image sensor driver");
+MODULE_LICENSE("GPL");
