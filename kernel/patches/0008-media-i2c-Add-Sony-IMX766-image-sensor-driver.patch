new file mode 100644
index 000000000000..1635a67e4a13
--- /dev/null
+++ b/drivers/media/i2c/imx766.c
@@ -0,0 +1,1544 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony IMX766 image sensor driver
+ *
+ * Copyright (c) 2022 MediaTek Inc.
+ * Copyright (c) 2026 serlk
+ *
+ * Ported from the MediaTek GPL imgsensor driver
+ * kernel_modules/mtkcam/imgsensor/src-v4l2/common/imx766_mipi_raw/
+ * (imx766mipiraw_Sensor.c, imx766_Sensor_setting.h): the register tables,
+ * the gain-to-register mapping, group hold, test pattern and the stream-off
+ * check come from there. Board parameters (orientation, power sequence) follow
+ * the Unihertz Titan 2 configuration.
+ *
+ * Only the two non-PDAF, non-HDR modes 4096x3072@30 and 2048x1152@120 are
+ * supported. No module calibration (QSC) is written.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#include "mtk-module-eeprom.h"
+
+#define IMX766_MCLK_FREQ		(24 * HZ_PER_MHZ)
+/* C-PHY: number of trios */
+#define IMX766_CPHY_TRIOS		3
+
+#define IMX766_REG_FRAME_COUNT		CCI_REG8(0x0005)
+#define IMX766_REG_CHIP_ID_H		CCI_REG8(0x0016)
+#define IMX766_REG_CHIP_ID_L		CCI_REG8(0x0017)
+#define IMX766_CHIP_ID			0x0766
+
+#define IMX766_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX766_MODE_STANDBY		0x00
+#define IMX766_MODE_STREAMING		0x01
+
+#define IMX766_REG_ORIENTATION		CCI_REG8(0x0101)
+#define IMX766_HFLIP			BIT(0)
+#define IMX766_VFLIP			BIT(1)
+
+#define IMX766_REG_GROUP_HOLD		CCI_REG8(0x0104)
+
+#define IMX766_REG_TEMP_EN		CCI_REG8(0x0138)
+
+#define IMX766_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX766_EXPOSURE_MIN		24
+#define IMX766_EXPOSURE_STEP		4
+#define IMX766_EXPOSURE_MARGIN		48
+#define IMX766_EXPOSURE_DEFAULT		976
+
+#define IMX766_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+/* code = 16384 - 16384 / gain; 1x .. 64x */
+#define IMX766_AGAIN_MIN		0
+#define IMX766_AGAIN_MAX		16128
+#define IMX766_AGAIN_STEP		1
+#define IMX766_AGAIN_DEFAULT		12288	/* 4x */
+
+/*
+ * 8.8 fixed point. MediaTek masks the integer part to 4 bits, so 16x (spec
+ * maximum) would wrap to 0; the control stops just below it.
+ */
+#define IMX766_REG_DIGITAL_GAIN		CCI_REG16(0x020e)
+#define IMX766_DGAIN_MIN		0x0100
+#define IMX766_DGAIN_MAX		0x0fff
+#define IMX766_DGAIN_STEP		1
+#define IMX766_DGAIN_DEFAULT		0x0100
+
+#define IMX766_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define IMX766_FLL_MAX			0xfffc
+
+#define IMX766_REG_TEST_PATTERN		CCI_REG8(0x0601)
+
+#define IMX766_REG_EXPOSURE_LSHIFT	CCI_REG8(0x3128)
+
+/*
+ * Derived from the mode tables: OP PLL 24 MHz / 3 (0x030d) * 287 or 377
+ * (0x030e/0x030f) / 2 or 4 (0x030b) = 1148 or 754 Msymbol/s per trio, half of
+ * it as link frequency (V4L2 convention: pixel rate = link_freq * 2 * trios *
+ * 16 / 7 / bpp). That reproduces the factory csi_pixel_rate of 787.2 and
+ * 517.0 Mpixel/s. TODO: confirm against the seninf C-PHY setup.
+ */
+#define IMX766_LINK_FREQ_574MHZ		(574 * HZ_PER_MHZ)
+#define IMX766_LINK_FREQ_377MHZ		(377 * HZ_PER_MHZ)
+
+static const s64 imx766_link_freq_menu[] = {
+	IMX766_LINK_FREQ_574MHZ,
+	IMX766_LINK_FREQ_377MHZ,
+};
+
+static const char * const imx766_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+};
+
+/* Indexed by (vflip << 1) | hflip; no flip gives an R first pixel */
+static const u32 imx766_mbus_codes[] = {
+	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+static const char * const imx766_supply_names[] = {
+	"avdd",		/* Analog 2.8 V */
+	"dvdd",		/* Digital core 1.1 V */
+	"dovdd",	/* Digital I/O 1.8 V */
+};
+
+enum imx766_supply {
+	IMX766_SUPPLY_AVDD,
+	IMX766_SUPPLY_DVDD,
+	IMX766_SUPPLY_DOVDD,
+	IMX766_NUM_SUPPLIES,
+};
+
+struct imx766_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct imx766_mode {
+	u32 width;
+	u32 height;
+	/* Pixel clock of the timing generator, in Hz */
+	u64 pixel_rate;
+	/* Line length and minimum frame length, in lines */
+	u32 line_length;
+	u32 frame_length;
+	/*
+	 * Default frame length: 30 fps, so that the default exposure range
+	 * does not end at a few milliseconds for the high speed mode
+	 */
+	u32 frame_length_def;
+	/* Frame length granularity */
+	u32 fll_step;
+	unsigned int link_freq_index;
+	struct v4l2_rect crop;
+	struct imx766_reg_list reg_list;
+};
