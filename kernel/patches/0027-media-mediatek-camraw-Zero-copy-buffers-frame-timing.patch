+/* probe points of the first frame: middle line of each plane, left and right */
+static u32 camraw_probe_off(struct mtk_camraw *raw, unsigned int i)
+{
+	unsigned int plane = i / 2;
+	u32 line = (plane ? raw->height / 2 : raw->height) / 2;
+	u32 col = i & 1 ? raw->width - 2 * CAMRAW_PROBE_BYTES : CAMRAW_PROBE_BYTES;
+
+	return (plane ? raw->pic_size[0] : 0) + line * raw->stride + col;
