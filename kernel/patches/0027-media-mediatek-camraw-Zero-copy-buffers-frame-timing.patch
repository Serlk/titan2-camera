+
+#define CAMRAW_NUM_PROBES		(2 * CAMRAW_PICTURE_PLANES)
+
+static void camraw_probe_fill(struct mtk_camraw *raw, u8 *vaddr)
+{
+	unsigned int i;
+
+	for (i = 0; vaddr && i < CAMRAW_NUM_PROBES; i++)
+		memset(vaddr + camraw_probe_off(raw, i), CAMRAW_FILL,
+		       CAMRAW_PROBE_BYTES);
+}
+
+/* hard IRQ: how much of the fill pattern the first picture left */
+static void camraw_probe_check(struct mtk_camraw *raw, const u8 *vaddr)
+{
+	unsigned int i, j;
+
+	if (!vaddr)
+		return;
+	for (i = 0; i < CAMRAW_NUM_PROBES; i++) {
+		const u8 *q = vaddr + camraw_probe_off(raw, i);
