+/*
+ * Point the picture planes of an emitted slot (@dst) at @picture[]: only
+ * the address words of the picture output, both sides. Cheap enough for
+ * every application of the per-frame request.
+ */
+void camraw_replay_patch_picture(const struct camraw_replay *rp, u8 *dst,
+				 const dma_addr_t picture[CAMRAW_PICTURE_PLANES])
+{
+	unsigned int i, p;
+
+	for (i = 0; i < rp->num_relocs; i++) {
+		const struct camraw_reloc *r = &rp->relocs[i];
+
+		for (p = 0; p < CAMRAW_PICTURE_PLANES; p++) {
+			u64 addr;
+
+			if (r->buf != rp->out_plane[p])
+				continue;
+			addr = (u64)picture[p] + r->addend;
+			put_unaligned_le32(lower_32_bits(addr), dst + r->off);
+			put_unaligned_le32(upper_32_bits(addr), dst + r->msb_off);
+		}
+	}
+}
