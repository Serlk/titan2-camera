+		raw->probe_same[i] = 0;
+		for (j = 0; j < CAMRAW_PROBE_BYTES; j++)
+			raw->probe_same[i] += q[j] == CAMRAW_FILL;
+		memcpy(raw->probe_bytes[i], q, sizeof(raw->probe_bytes[i]));
+	}
+	raw->probe_done = true;
+	raw->probe_report = true;
+}
