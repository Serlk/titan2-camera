+++ b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-iommu-camera.dtsi.example
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Titan 2: CAMSV through the MM IOMMU. EXAMPLE of the camsv1 path alone;
+ * the built description is mt6878-unihertz-titan2-cameras.dtsi (all three
+ * engines: larb13/14/29, both cam sub-commons), part of -all since
+ * 2026-11-11. Before that it was appended to the seninf test pattern board
+ * -camera-tpg (the CAM_VCORE/VMM chain of -camera and camsv1).
+ * Nothing here is LK-relevant: it only switches on SoC nodes and adds
+ * iommus, so the LK requirements of the base DTB are unchanged; run
+ * scripts/lk-fdt-check.py on the result anyway.
+ *
+ * Path of camsv1: larb14 (CAM_MAIN) -> cam sub-common 1 (CAM_MAIN) ->
+ * cam-vcore sub-common (CAM_VCORE) -> smi-common (MM_INFRA) -> M4U. The
+ * M4U needs one available larb to probe; larb14 is it here. The factory
+ * description gives camsv1 no iommus (its ports are in a "camisp-l14-1"
+ * helper node); mt6878.dtsi puts them on the engine, as the factory device tree does for
+ * camsv5. The CAMSV driver requires this path (it refuses to probe
+ * without an IOMMU).
+ *
+ * For camsv5 instead (larb29 ports 2 and 6), enable larb29 and
+ * smi_sub_common_cam0 as in the commented block; the seninf graph of
+ * -camera-tpg then has to end at camsv5.
+ */
+
+/* the cam-vcore sub-common is clocked by camsys_vcore */
+&camsys_vcore {
+	status = "okay";
+};
+
+&smi_common {
+	status = "okay";
+};
+
+&smi_sub_common_cam_vcore {
+	status = "okay";
+};
+
+&smi_sub_common_cam1 {
+	status = "okay";
+};
+
+&larb14 {
+	status = "okay";
+};
+
+&m4u {
+	status = "okay";
+};
+
+/*
+ * camsv1's iommus (larb14 ports 0 and 1) are in mt6878.dtsi.
+ *
+ * camsv5 instead (iommus: larb29 ports 2 and 6, also in the dtsi):
+ *
+ * &smi_sub_common_cam0 {
+ *	status = "okay";
+ * };
+ *
+ * &larb29 {
+ *	status = "okay";
+ * };
+ */
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-jpeg.dts b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-jpeg.dts
index 2b03f6e469f7..c6caa8422b44 100644
