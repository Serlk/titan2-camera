+++ b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-cameras.dtsi.example
@@ -0,0 +1,258 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * Unihertz Titan 2: camera sensors and autofocus VCMs (EXAMPLE, not built).
+ *
+ * Copyright (c) 2026 serlk
+ *
+ * Not included by any board dts. The seninf (CSI-2 receiver) driver does not
+ * exist yet, so the remote endpoints below are commented out; without them
+ * the sensor drivers fail to probe (they need an endpoint for the bus
+ * configuration).
+ *
+ *   sensor0  IMX766    rear main   i2c8 0x1a  C-PHY 3 trios  csi-port-2
+ *   sensor1  S5KGD1SP  front       i2c4 0x2d  D-PHY 4 lanes  csi-port-0
+ *   sensor4  Hi-847    rear second i2c7 0x20  D-PHY 4 lanes  csi-port-1
+ *
+ * I2C addresses are the factory 8-bit write addresses shifted right by one
+ * (0x34, 0x5a, 0x40); the factory device tree reg values (0x1a, 0x5a, 0x10) are not
+ * what the downstream driver uses on the bus. TODO: verify 0x2d and 0x20.
+ *
+ * Supplies are GPIO-switched load switches; DOVDD (GPIO194) is shared by all
+ * three sensors and VCAMAF (GPIO193) by both VCMs, so they are one
+ * regulator-fixed each and the regulator core counts the users.
+ *
+ * rotation: the user-space HAL reports the Android SENSOR_ORIENTATION (clockwise
+ * correction): IMX766 90, S5KGD1SP 270, Hi-847 90. The DT rotation property
+ * is the counter-clockwise angle (video-interface-devices.yaml), and
+ * libcamera's Android layer uses orientation = (360 - rotation) % 360 for
+ * both facings, so rotation = 270, 90, 270. For the S5KGD1SP this assumes
+ * the driver default flips (H mirror + V flip, the factory setting).
+ * TODO: check on the first frame of every sensor.
+ */
+
+#include <dt-bindings/clock/mediatek,mt6878-clock.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/media/video-interfaces.h>
+
+/ {
+	vcam_dovdd: regulator-vcam-dovdd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcam_dovdd";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&pio 194 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vcamaf: regulator-vcamaf {
+		compatible = "regulator-fixed";
+		regulator-name = "vcamaf";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pio 193 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/* IMX766 */
+	vcam0_avdd: regulator-vcam0-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcam0_avdd";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pio 195 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vcam0_dvdd: regulator-vcam0-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcam0_dvdd";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		gpio = <&pio 37 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/* S5KGD1SP */
+	vcam1_avdd: regulator-vcam1-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcam1_avdd";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pio 192 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vcam1_dvdd: regulator-vcam1-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcam1_dvdd";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		gpio = <&pio 191 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/* Hi-847 */
+	vcam4_avdd: regulator-vcam4-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcam4_avdd";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pio 188 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vcam4_dvdd: regulator-vcam4-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcam4_dvdd";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		gpio = <&pio 39 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&pio {
+	/*
+	 * MCLK pads. drive-strength follows the MCLK_DRIVING_CURRENT step of
+	 * each factory power sequence (4, 6 and 2 mA). TODO: the
+	 * static isp_driving_current parameters say 4, 8 and 8 mA.
+	 */
+	cam0_mclk_pins: cam0-mclk-pins {
+		pins-mclk {
+			pinmux = <PINMUX_GPIO94__FUNC_CMMCLK2>;
+			drive-strength = <4>;
+		};
+	};
+
+	cam1_mclk_pins: cam1-mclk-pins {
+		pins-mclk {
+			pinmux = <PINMUX_GPIO96__FUNC_CMMCLK4>;
+			drive-strength = <6>;
+		};
+	};
+
+	cam4_mclk_pins: cam4-mclk-pins {
+		pins-mclk {
+			pinmux = <PINMUX_GPIO93__FUNC_CMMCLK1>;
+			drive-strength = <2>;
+		};
+	};
+};
+
+/* IMX766, rear main, and its DW9800 VCM */
+&i2c8 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	vcm0: lens@c {
+		compatible = "dongwoon,dw9800k";
+		reg = <0x0c>;
+		vdd-supply = <&vcamaf>;
+		dongwoon,vcm-prescale = <0x60>;
+	};
+
+	camera@1a {
+		compatible = "sony,imx766";
+		reg = <0x1a>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_mclk_pins>;
+		clocks = <&topckgen CLK_TOP_CAMTG3_SEL>;
+		assigned-clocks = <&topckgen CLK_TOP_CAMTG3_SEL>;
+		/* univpll 192 MHz / 8 */
+		assigned-clock-parents = <&topckgen CLK_TOP_UVPLL192M_D8>;
+		assigned-clock-rates = <24000000>;
+		reset-gpios = <&pio 26 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&pio 28 GPIO_ACTIVE_LOW>;
+		avdd-supply = <&vcam0_avdd>;
+		dvdd-supply = <&vcam0_dvdd>;
+		dovdd-supply = <&vcam_dovdd>;
+		lens-focus = <&vcm0>;
+		orientation = <1>;	/* back */
+		rotation = <270>;
+
+		port {
+			imx766_out: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				link-frequencies = /bits/ 64 <574000000 377000000>;
+				/* remote-endpoint = <&seninf_csi2_in>; */
+			};
+		};
+	};
+};
+
+/* S5KGD1SP, front, fixed focus */
+&i2c4 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	camera@2d {
+		compatible = "samsung,s5kgd1sp";
+		reg = <0x2d>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_mclk_pins>;
+		clocks = <&topckgen CLK_TOP_CAMTG5_SEL>;
+		assigned-clocks = <&topckgen CLK_TOP_CAMTG5_SEL>;
+		/* univpll 192 MHz / 8 */
+		assigned-clock-parents = <&topckgen CLK_TOP_UVPLL192M_D8>;
+		assigned-clock-rates = <24000000>;
+		reset-gpios = <&pio 24 GPIO_ACTIVE_LOW>;
+		avdd-supply = <&vcam1_avdd>;
+		dvdd-supply = <&vcam1_dvdd>;
+		dovdd-supply = <&vcam_dovdd>;
+		orientation = <0>;	/* front */
+		rotation = <90>;
+
+		port {
+			s5kgd1sp_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <432000000>;
+				/* remote-endpoint = <&seninf_csi0_in>; */
+			};
+		};
+	};
+};
+
+/* Hi-847, rear second, and its DW9714 VCM */
+&i2c7 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	vcm4: lens@c {
+		compatible = "dongwoon,dw9714";
+		reg = <0x0c>;
+		vcc-supply = <&vcamaf>;
+	};
+
+	camera@20 {
+		compatible = "hynix,hi847";
+		reg = <0x20>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam4_mclk_pins>;
+		clocks = <&topckgen CLK_TOP_CAMTG2_SEL>;
+		assigned-clocks = <&topckgen CLK_TOP_CAMTG2_SEL>;
+		/* univpll 192 MHz / 8 */
+		assigned-clock-parents = <&topckgen CLK_TOP_UVPLL192M_D8>;
+		assigned-clock-rates = <24000000>;
+		reset-gpios = <&pio 25 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&pio 189 GPIO_ACTIVE_LOW>;
+		avdd-supply = <&vcam4_avdd>;
+		dvdd-supply = <&vcam4_dvdd>;
+		dovdd-supply = <&vcam_dovdd>;
+		lens-focus = <&vcm4>;
+		orientation = <1>;	/* back */
+		rotation = <270>;
+
+		port {
+			hi847_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				/* 24 MHz MCLK: 500 MHz for 3264x2448, 400 MHz for 1080p */
+				link-frequencies = /bits/ 64 <500000000 400000000>;
+				/* remote-endpoint = <&seninf_csi1_in>; */
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-iommu-camera.dtsi.example b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-iommu-camera.dtsi.example
