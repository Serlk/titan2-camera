+/* INT3 / INT8 bits with a known name; the others by number */
+static int camraw_dmain_text(char *buf, size_t size, u32 v, bool underflow)
+{
+	static const char * const cqi[] = { "CQI_R1", "CQI_R2", "CQI_R3", "CQI_R4" };
+	unsigned int bit;
+	int len = 0;
+
+	for (bit = 0; bit < 32; bit++) {
+		if (!(v & BIT(bit)))
+			continue;
+		if (bit >= 8 && bit <= 11)
+			len += scnprintf(buf + len, size - len, " %s", cqi[bit - 8]);
+		else if (bit == 18)
+			len += scnprintf(buf + len, size - len, " LSCI_R1");
+		else if (underflow && bit >= 24)
+			len += scnprintf(buf + len, size - len, " ring-overflow-b%u", bit);
+		else
+			len += scnprintf(buf + len, size - len, " b%u", bit);
+	}
+	if (!len)
+		len = scnprintf(buf, size, " none");
+	return len;
+}
