+/*
+ * Ready/request words of one block: select 0..6 request groups 1..7, 8..14
+ * ready groups 1..7, 15 the latched events (RMS: 0..2, 8..10, 15). A module
+ * that requests and is not ready is the stalled one.
+ */
+static void camraw_rdyreq_read(void __iomem *base, bool rms, u32 *out)
+{
+	unsigned int sel;
+	u32 set;
+
+	for (sel = 0; sel < 16; sel++) {
+		out[sel] = 0;
+		if (sel == 7 || (rms && ((sel > 2 && sel < 8) || (sel > 10 && sel < 15))))
+			continue;
+		set = readl(base + CAMCTL_DBG_SET);
+		writel((set & 0xfff000) | 1 | sel << 8, base + CAMCTL_DBG_SET);
+		out[sel] = readl(base + CAMCTL_DBG_PORT);
+	}
+}
+
+static void camraw_rdyreq_take(struct mtk_camraw *raw)
+{
+	struct mtk_camraw *eng[2] = { raw, raw->twin_on ? raw->twin : NULL };
+	unsigned int e;
+
+	if (raw->rdyreq_taken)
+		return;
+	for (e = 0; e < 2; e++) {
+		if (!eng[e])
+			continue;
+		camraw_rdyreq_read(eng[e]->base, false, raw->rdyreq[e][0]);
+		camraw_rdyreq_read(eng[e]->yuv->base, false, raw->rdyreq[e][1]);
+		if (eng[e]->rms)
+			camraw_rdyreq_read(eng[e]->rms, true, raw->rdyreq[e][2]);
+	}
+	raw->rdyreq_taken = true;
+}
+
+static void camraw_rdyreq_show(struct mtk_camraw *raw, struct seq_file *m)
+{
+	static const char * const blk[] = { "RAW", "YUV", "RMS" };
+	char line[200];
+	unsigned int e, b, sel;
+	int len;
+
+	if (!raw->rdyreq_taken)
+		return;
+	for (e = 0; e < (raw->twin ? 2 : 1); e++) {
+		for (b = 0; b < 3; b++) {
+			if (b == 2 && !(e ? raw->twin->rms : raw->rms))
+				continue;
+			len = 0;
+			for (sel = 0; sel < 16; sel++)
+				if (sel != 7)
+					len += scnprintf(line + len, sizeof(line) - len,
+							 "%s%08x", sel == 8 ? " | rdy" :
+							 sel == 15 ? " | latched " : " ",
+							 raw->rdyreq[e][b][sel]);
+			if (m)
+				seq_printf(m, "rdy/req at the first error %s-%c: req%s\n",
+					   blk[b], 'A' + e, line);
+			else
+				dev_info(raw->dev, "rdy/req at the first error %s-%c: req%s\n",
+					 blk[b], 'A' + e, line);
+		}
+	}
+}
