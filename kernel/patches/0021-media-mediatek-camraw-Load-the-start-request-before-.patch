+/* the larb ports of a device in the IOMMU domain: larb id:port */
+static void camraw_show_ports(struct device *dev)
+{
+	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+	char line[200];
+	unsigned int i;
+	int len = 0;
+
+	if (!fwspec)
+		return;
+	for (i = 0; i < fwspec->num_ids; i++)
+		len += scnprintf(line + len, sizeof(line) - len, " %u:%u",
+				 (fwspec->ids[i] >> 5) & 0x1f, fwspec->ids[i] & 0x1f);
+	dev_info(dev, "IOMMU ports (larb id:port):%s\n", line);
+}
