+/* double buffer toggle on every engine of the stream, then the WFBC set-up */
+static void camraw_toggle_engines(struct mtk_camraw *raw, bool wfbc)
+{
+	camraw_toggle_db(raw);
+	if (raw->twin_on)
+		camraw_toggle_db(raw->twin);
+	if (!wfbc)
+		return;
+	camraw_wfbc_setup(raw);
+	if (raw->twin_on)
+		camraw_wfbc_setup(raw->twin);
+}
