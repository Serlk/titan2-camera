From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:22:56 +0300
Subject: [PATCH 09/19] media: dt-bindings: Add Samsung S5KGD1SP image sensor

S5KGD1SP is a 32 MP sensor with a 4-lane MIPI CSI-2 D-PHY output, used as
the front camera of the Unihertz Titan 2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/media/i2c/samsung,s5kgd1sp.yaml  | 108 ++++++++++++++++++
 MAINTAINERS                                   |   7 ++
 2 files changed, 115 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/samsung,s5kgd1sp.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/samsung,s5kgd1sp.yaml b/Documentation/devicetree/bindings/media/i2c/samsung,s5kgd1sp.yaml
new file mode 100644
index 000000000000..335df22892a7
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,s5kgd1sp.yaml
@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5kgd1sp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5KGD1SP Image Sensor
+
+maintainers:
+  - serlk <22211586+Serlk@users.noreply.github.com>
+
+description:
+  Samsung S5KGD1SP (ISOCELL GD1) is a 32 megapixel (6560x4928) raw image
+  sensor with an on-chip remosaic. It is controlled over an I2C compatible
+  CCI bus and sends RAW10 data over a 4-lane MIPI CSI-2 D-PHY interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5kgd1sp
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK, 24 MHz.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the reset pin.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  dvdd-supply:
+    description: Digital core voltage supply, 1.1 volts.
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@2d {
+            compatible = "samsung,s5kgd1sp";
+            reg = <0x2d>;
+            clocks = <&camera_mclk 0>;
+            assigned-clocks = <&camera_mclk 0>;
+            assigned-clock-rates = <24000000>;
+            reset-gpios = <&gpio 24 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&vcam_avdd>;
+            dvdd-supply = <&vcam_dvdd>;
+            dovdd-supply = <&vcam_dovdd>;
+            orientation = <0>;
+            rotation = <90>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <432000000>;
+                    remote-endpoint = <&csi_in>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 034ee6c462db..88f44c84110d 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -24106,6 +24106,13 @@ L:	linux-media@vger.kernel.org
 S:	Supported
 F:	drivers/media/i2c/s5k5baf.c
 
