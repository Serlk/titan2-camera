+/*
+ * Power sequence of the Unihertz Titan 2 module: MCLK, PDN low 1 ms, RST low
+ * 1 ms, DOVDD 3 ms, AVDD 1 ms, DVDD 1 ms, RST high 2 ms, PDN high 2 ms. The
+ * MCLK pad drive strength is a DT pinctrl setting. On ACPI systems the
+ * GPIOs and supplies are usually absent and this only gates the clock.
+ */
+static int hi847_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi847 *hi847 = to_hi847(sd);
+	unsigned int i;
+	int ret;
+
+	ret = clk_prepare_enable(hi847->clk);
+	if (ret)
+		return ret;
+
+	if (hi847->powerdown_gpio) {
+		gpiod_set_value_cansleep(hi847->powerdown_gpio, 1);
+		usleep_range(1000, 1100);
+	}
+
+	if (hi847->reset_gpio) {
+		gpiod_set_value_cansleep(hi847->reset_gpio, 1);
+		usleep_range(1000, 1100);
+	}
+
+	for (i = 0; i < HI847_NUM_SUPPLIES; i++) {
+		static const unsigned int delay_us[HI847_NUM_SUPPLIES] = {
+			3000, 1000, 1000,
+		};
+
+		ret = regulator_enable(hi847->supplies[i].consumer);
+		if (ret)
+			goto err_supplies;
+		usleep_range(delay_us[i], delay_us[i] + 100);
+	}
+
+	if (hi847->reset_gpio) {
+		gpiod_set_value_cansleep(hi847->reset_gpio, 0);
+		usleep_range(2000, 2100);
+	}
+
+	if (hi847->powerdown_gpio) {
+		gpiod_set_value_cansleep(hi847->powerdown_gpio, 0);
+		usleep_range(2000, 2100);
+	}
+
+	return 0;
+
+err_supplies:
+	while (i--)
+		regulator_disable(hi847->supplies[i].consumer);
+	gpiod_set_value_cansleep(hi847->reset_gpio, 1);
+	gpiod_set_value_cansleep(hi847->powerdown_gpio, 1);
+	clk_disable_unprepare(hi847->clk);
+
+	return ret;
+}
+
+/* Reverse order of hi847_power_on(), without delays */
+static int hi847_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi847 *hi847 = to_hi847(sd);
+	unsigned int i = HI847_NUM_SUPPLIES;
+
+	gpiod_set_value_cansleep(hi847->powerdown_gpio, 1);
+	gpiod_set_value_cansleep(hi847->reset_gpio, 1);
+	while (i--)
+		regulator_disable(hi847->supplies[i].consumer);
+	clk_disable_unprepare(hi847->clk);
+
+	return 0;
+}
