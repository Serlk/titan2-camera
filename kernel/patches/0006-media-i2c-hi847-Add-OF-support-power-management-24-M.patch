diff --git a/drivers/media/i2c/mtk-module-eeprom.h b/drivers/media/i2c/mtk-module-eeprom.h
new file mode 100644
index 000000000000..24490a85a42a
--- /dev/null
+++ b/drivers/media/i2c/mtk-module-eeprom.h
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copy of the calibration EEPROM of a camera module, exposed as nvmem.
+ *
+ * The EEPROM of the MediaTek-style camera modules (Unihertz Titan 2: Hi-847
+ * and IMX766) sits next to the sensor on the same I2C bus, by default at
+ * 0x50, with 16-bit addressing, and answers only while the module is powered.
+ * The sensor driver owns the module power, so it reads the EEPROM once while
+ * it is powered for the chip ID check at probe, and offers the copy as a
+ * read-only nvmem device "<name>" (/sys/bus/nvmem/devices/<name>/nvmem) for
+ * userspace calibration (white balance, lens shading, focus range). The
+ * address can be given in DT as a second reg entry named "eeprom".
+ *
+ * Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#ifndef __MTK_MODULE_EEPROM_H__
+#define __MTK_MODULE_EEPROM_H__
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/i2c.h>
+#include <linux/nvmem-provider.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#define MTK_MODULE_EEPROM_ADDR		0x50
+#define MTK_MODULE_EEPROM_SIZE		0x2000
+#define MTK_MODULE_EEPROM_CHUNK		128
+
+static int mtk_module_eeprom_reg_read(void *priv, unsigned int offset,
+				      void *val, size_t bytes)
+{
+	const u8 *data = priv;
+
+	if (offset >= MTK_MODULE_EEPROM_SIZE ||
+	    bytes > MTK_MODULE_EEPROM_SIZE - offset)
+		return -EINVAL;
+
+	memcpy(val, data + offset, bytes);
+	return 0;
+}
+
+/* Call with the module powered. Failures are not fatal for the sensor. */
+static inline void mtk_module_eeprom_register(struct device *dev,
+					      struct i2c_client *client,
+					      const char *name)
+{
+	struct nvmem_config config = { };
+	struct i2c_client *eeprom;
+	struct nvmem_device *nvmem;
+	unsigned int offset;
+	u8 *data;
+	int ret = 0;
+
+	data = devm_kzalloc(dev, MTK_MODULE_EEPROM_SIZE, GFP_KERNEL);
+	if (!data)
+		return;
+
+	eeprom = i2c_new_ancillary_device(client, "eeprom",
+					  MTK_MODULE_EEPROM_ADDR);
+	if (IS_ERR(eeprom)) {
+		dev_info(dev, "no EEPROM client: %pe\n", eeprom);
+		return;
+	}
+
+	for (offset = 0; offset < MTK_MODULE_EEPROM_SIZE;
+	     offset += MTK_MODULE_EEPROM_CHUNK) {
+		u8 addr[2] = { offset >> 8, offset & 0xff };
+		struct i2c_msg msgs[2] = {
+			{
+				.addr = eeprom->addr,
+				.len = sizeof(addr),
+				.buf = addr,
+			}, {
+				.addr = eeprom->addr,
+				.flags = I2C_M_RD,
+				.len = MTK_MODULE_EEPROM_CHUNK,
+				.buf = data + offset,
+			},
+		};
+
+		ret = i2c_transfer(eeprom->adapter, msgs, ARRAY_SIZE(msgs));
+		if (ret != ARRAY_SIZE(msgs)) {
+			ret = ret < 0 ? ret : -EIO;
+			break;
+		}
+		ret = 0;
+	}
+	i2c_unregister_device(eeprom);
+
+	if (ret) {
+		dev_info(dev, "no module EEPROM at 0x%02x: %d\n",
+			 MTK_MODULE_EEPROM_ADDR, ret);
+		return;
+	}
+
+	config.dev = dev;
+	config.name = name;
+	config.id = NVMEM_DEVID_NONE;
+	config.owner = THIS_MODULE;
+	config.read_only = true;
+	config.word_size = 1;
+	config.stride = 1;
+	config.size = MTK_MODULE_EEPROM_SIZE;
+	config.reg_read = mtk_module_eeprom_reg_read;
+	config.priv = data;
+
+	nvmem = devm_nvmem_register(dev, &config);
+	if (IS_ERR(nvmem))
+		dev_warn(dev, "failed to register %s: %pe\n", name, nvmem);
+	else
+		dev_info(dev, "module EEPROM: %s, %u bytes\n", name,
+			 MTK_MODULE_EEPROM_SIZE);
+}
+
+#endif /* __MTK_MODULE_EEPROM_H__ */
