+static u64 to_pixel_rate(struct hi847 *hi847, u32 f_index)
 {
-	u64 pixel_rate = link_freq_menu_items[f_index] * 2 * HI847_DATA_LANES;
+	u64 pixel_rate = hi847->cfg->link_freqs[f_index] * 2 * HI847_DATA_LANES;
 
 	do_div(pixel_rate, HI847_RGB_DEPTH);
 
 	return pixel_rate;
 }
 
+/* HBLANK in pixel rate cycles: line time (llp at line_clk) minus width */
+static s64 hi847_hblank(struct hi847 *hi847, const struct hi847_mode *mode)
+{
+	u64 line;
+
+	if (!hi847->cfg->line_clk)
+		return (s64)mode->llp - mode->width;
+
+	line = DIV_ROUND_CLOSEST_ULL((u64)mode->llp *
+				     to_pixel_rate(hi847, mode->link_freq_index),
+				     hi847->cfg->line_clk);
+	return (s64)line - mode->width;
+}
