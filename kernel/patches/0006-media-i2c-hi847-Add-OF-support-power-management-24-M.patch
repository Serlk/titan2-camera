+static int hi847_get_selection(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *sd_state,
+			       struct v4l2_subdev_selection *sel)
+{
+	struct hi847 *hi847 = to_hi847(sd);
+	const struct v4l2_mbus_framefmt *try_fmt;
+	const struct hi847_mode *mode;
+
+	if (sel->pad)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		mutex_lock(&hi847->mutex);
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY) {
+			try_fmt = v4l2_subdev_state_get_format(sd_state, 0);
+			mode = v4l2_find_nearest_size(hi847->cfg->modes,
+						      hi847->cfg->num_modes,
+						      width, height,
+						      try_fmt->width,
+						      try_fmt->height);
+		} else {
+			mode = hi847->cur_mode;
+		}
+		sel->r = mode->crop;
+		mutex_unlock(&hi847->mutex);
+		return 0;
+
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = HI847_NATIVE_WIDTH;
+		sel->r.height = HI847_NATIVE_HEIGHT;
+		return 0;
+
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = HI847_ACTIVE_LEFT;
+		sel->r.top = HI847_ACTIVE_TOP;
+		sel->r.width = HI847_ACTIVE_WIDTH;
+		sel->r.height = HI847_ACTIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
