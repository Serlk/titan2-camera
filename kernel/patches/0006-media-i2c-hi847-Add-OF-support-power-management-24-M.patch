 static int hi847_read_reg(struct hi847 *hi847, u16 reg, u16 len, u32 *val)
 {
 	struct i2c_client *client = v4l2_get_subdevdata(&hi847->sd);
@@ -2267,6 +2650,74 @@ static int hi847_write_reg_list(struct hi847 *hi847,
 	return 0;
 }
 
+static int hi847_write_init(struct hi847 *hi847,
+			    const struct hi847_reg_list *r_list)
+{
+	struct hi847_reg_list part;
+	int ret;
+
+	if (!hi847->cfg->init_extra_write ||
+	    r_list->num_of_regs < HI847_INIT_24MHZ_EXTRA_POS)
+		return hi847_write_reg_list(hi847, r_list);
+
+	part.regs = r_list->regs;
+	part.num_of_regs = HI847_INIT_24MHZ_EXTRA_POS;
+	ret = hi847_write_reg_list(hi847, &part);
+	if (ret)
+		return ret;
+
+	ret = hi847_write_reg(hi847, HI847_REG_MIRROR_FLIP,
+			      HI847_REG_VALUE_16BIT, 0x0000);
+	if (ret)
+		return ret;
+
+	part.regs = r_list->regs + HI847_INIT_24MHZ_EXTRA_POS;
+	part.num_of_regs = r_list->num_of_regs - HI847_INIT_24MHZ_EXTRA_POS;
+
+	return hi847_write_reg_list(hi847, &part);
+}
+
+static int hi847_group_hold(struct hi847 *hi847, bool hold)
+{
+	if (!hi847->cfg->wide_timing)
+		return 0;
+
+	return hi847_write_reg(hi847, HI847_REG_GROUP_HOLD,
+			       HI847_REG_VALUE_08BIT,
+			       hold ? HI847_GROUP_HOLD_ON :
+				      HI847_GROUP_HOLD_OFF);
+}
+
+static int hi847_write_exposure(struct hi847 *hi847, u32 val)
+{
+	int ret;
+
+	if (hi847->cfg->wide_timing) {
+		ret = hi847_write_reg(hi847, HI847_REG_EXPOSURE_HI,
+				      HI847_REG_VALUE_08BIT, val >> 16);
+		if (ret)
+			return ret;
+	}
+
+	return hi847_write_reg(hi847, HI847_REG_EXPOSURE,
+			       HI847_REG_VALUE_16BIT, val & 0xffff);
+}
+
+static int hi847_write_fll(struct hi847 *hi847, u32 val)
+{
+	int ret;
+
+	if (hi847->cfg->wide_timing) {
+		ret = hi847_write_reg(hi847, HI847_REG_FLL_HI,
+				      HI847_REG_VALUE_08BIT, val >> 16);
+		if (ret)
+			return ret;
+	}
+
+	return hi847_write_reg(hi847, HI847_REG_FLL,
+			       HI847_REG_VALUE_16BIT, val & 0xffff);
+}
