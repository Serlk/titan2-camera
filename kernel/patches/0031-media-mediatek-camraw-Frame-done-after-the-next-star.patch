+/* hard IRQ: hand back the buffer of application @k (0: the start request, none) */
+static void camraw_finish_app(struct mtk_camraw *raw, unsigned int k,
+			      enum vb2_buffer_state state, u32 frame, u64 ns)
+{
+	struct mtk_camraw_buffer *buf;
+
+	if (!k)
+		return;
+	spin_lock(&raw->buf_lock);
+	buf = raw->app_buf[k % CAMRAW_APP_RING];
+	raw->app_buf[k % CAMRAW_APP_RING] = NULL;
+	spin_unlock(&raw->buf_lock);
+	if (buf)
+		camraw_buf_finish(raw, buf, state, frame, ns);
+}
+
+static void camraw_log_done(struct mtk_camraw *raw, u32 frame)
+{
+	if (frame < CAMRAW_SOF_LOG)
+		raw->sof_log[frame].done_us = camraw_us_since_vf(raw) ? : 1;
+}
