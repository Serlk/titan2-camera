@@ -935,48 +962,78 @@ static void camraw_apply_frame(struct mtk_camraw *raw)
 	raw->n_frame_applied = j;
 }
 
-/* hard IRQ, frame done: the picture of the frame in flight is complete */
+/*
+ * Hard IRQ, frame done (SW_PASS1_DONE). Normally it ends the frame in
+ * flight. When it comes after the next start of frame, it ends the frame
+ * before, and the application that start of frame held back is made now.
+ */
 static void camraw_frame_end(struct mtk_camraw *raw)
 {
-	unsigned int k = raw->inflight;
-	struct mtk_camraw_buffer *buf;
-
-	if (frame_done != 0 || !k)
+	if (raw->late_pending) {
+		raw->late_pending = false;
+		camraw_log_done(raw, raw->late_frame);
+		if (frame_done == 0)
+			camraw_finish_app(raw, raw->late_app, VB2_BUF_STATE_DONE,
+					  raw->late_frame, raw->late_ns);
+		if (raw->apply_deferred) {
+			raw->apply_deferred = false;
+			camraw_apply_frame(raw);
+		}
 		return;
-	spin_lock(&raw->buf_lock);
-	buf = raw->app_buf[k % CAMRAW_APP_RING];
-	raw->app_buf[k % CAMRAW_APP_RING] = NULL;
-	spin_unlock(&raw->buf_lock);
-	if (buf)
-		camraw_buf_finish(raw, buf, VB2_BUF_STATE_DONE);
+	}
+	raw->inflight_done = true;
+	camraw_log_done(raw, raw->inflight_frame);
+	if (frame_done == 0)
+		camraw_finish_app(raw, raw->inflight, VB2_BUF_STATE_DONE,
+				  raw->inflight_frame, raw->inflight_ns);
 }
 
 /*
  * Hard IRQ, start of frame. The application made at the previous start of
  * frame is now in effect (double buffered registers); the next one is
- * made at once, well inside the command queue start period.
+ * made at once, well inside the command queue start period - unless the
+ * frame before has not reported its done yet: lists started while the
+ * engine still finishes a frame were seen to end in a CQ trigger delay
+ * (the long first frames of a stream). Then the application waits for
+ * that done (apply_wait), at most until the next start of frame.
  */
 static void camraw_frame_start(struct mtk_camraw *raw)
 {
 	struct v4l2_event ev = { .type = V4L2_EVENT_FRAME_SYNC };
-	struct mtk_camraw_buffer *buf = NULL;
 	struct mtk_camraw_sof *log;
 	unsigned int k = raw->inflight;
+	bool applied = false;
 
-	if (frame_done == 1 && k) {
+	if (raw->late_pending) {
+		/* a whole frame without the done of the one before: lost */
+		camraw_finish_app(raw, raw->late_app, VB2_BUF_STATE_ERROR, 0, 0);
+		raw->late_pending = false;
+		raw->n_buf_errors++;
+	}
+	if (raw->apply_deferred) {
+		/* held back for a done that never came: for this frame now */
+		raw->apply_deferred = false;
+		camraw_apply_frame(raw);
+		applied = true;
+	}
+
+	if (frame_done == 1) {
 		/* the earlier rule: the frame before this one is complete */
-		spin_lock(&raw->buf_lock);
-		buf = raw->app_buf[k % CAMRAW_APP_RING];
-		raw->app_buf[k % CAMRAW_APP_RING] = NULL;
-		spin_unlock(&raw->buf_lock);
-		if (buf)
-			camraw_buf_finish(raw, buf, VB2_BUF_STATE_DONE);
+		camraw_finish_app(raw, k, VB2_BUF_STATE_DONE, raw->inflight_frame,
+				  raw->inflight_ns);
+	} else if (!raw->inflight_done) {
+		raw->late_pending = true;
+		raw->late_app = k;
+		raw->late_frame = raw->inflight_frame;
+		raw->late_ns = raw->inflight_ns;
+		raw->n_late_done++;
 	}
 
 	raw->frame_idx = raw->n_sof - 1;
 	raw->inflight = raw->n_frame_applied;
 	raw->inflight_frame = raw->frame_idx;
 	raw->inflight_ns = raw->sof_ns;
+	raw->inflight_done = false;
 
 	if (raw->frame_idx < CAMRAW_SOF_LOG) {
 		log = &raw->sof_log[raw->frame_idx];
@@ -985,14 +1042,21 @@ static void camraw_frame_start(struct mtk_camraw *raw)
