+/*
+ * Take the route to @dest for a stream. Called with hw_lock held; the
+ * port counts as streaming from here until seninf_disable_streams() or
+ * the error path of seninf_enable_streams().
+ */
+static int seninf_claim_route(struct mtk_seninf_port *port, unsigned int dest)
+{
+	struct mtk_seninf *priv = port->priv;
+	const struct mtk_seninf_route *r = &port->dest_route[dest];
+	unsigned int i;
+
+	lockdep_assert_held(&priv->hw_lock);
+
+	if (port->streaming) {
+		dev_err(priv->dev, "csi%u: already streaming to cam mux 0x%x\n",
+			port->id, port->route.cam_mux);
+		return -EBUSY;
+	}
+
+	for (i = 0; i < SENINF_NUM_PORTS; i++) {
+		const struct mtk_seninf_port *other = &priv->ports[i];
+
+		if (!other->priv || !other->streaming)
+			continue;
+		if (other->route.cam_mux == r->cam_mux) {
+			dev_err(priv->dev,
+				"csi%u: cam mux 0x%x is in use by csi%u\n",
+				port->id, r->cam_mux, i);
+			return -EBUSY;
+		}
+		if (other->route.mux == r->mux ||
+		    other->route.mux_vr == r->mux_vr) {
+			dev_err(priv->dev, "csi%u: mux %u is in use by csi%u\n",
+				port->id, r->mux, i);
+			return -EBUSY;
+		}
+	}
+
+	port->route = *r;
+	port->streaming = true;
+	return 0;
+}
