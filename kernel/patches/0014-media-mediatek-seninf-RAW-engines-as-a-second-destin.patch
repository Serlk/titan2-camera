+/**
+ * mtk_seninf_raw_source() - the sub-device that feeds a RAW engine
+ * @endpoint: the sensor interface's endpoint toward the RAW engine
+ * @pad: set to the source pad to enable streams on
+ *
+ * A RAW engine driver that has no media graph of its own asks for the CSI
+ * port by the endpoint its own endpoint is connected to. Returns NULL when
+ * the sensor interface is not probed or has no such destination.
+ */
+struct v4l2_subdev *mtk_seninf_raw_source(struct fwnode_handle *endpoint,
+					  unsigned int *pad)
+{
+	struct fwnode_handle *parent;
+	struct v4l2_subdev *sd = NULL;
+	struct mtk_seninf *priv;
+	struct device *dev;
+	unsigned int i;
+
+	parent = fwnode_graph_get_port_parent(endpoint);
+	if (!parent)
+		return NULL;
+	dev = bus_find_device_by_fwnode(&platform_bus_type, parent);
+	fwnode_handle_put(parent);
+	if (!dev)
+		return NULL;
+
+	priv = dev->driver == &mtk_seninf_driver.driver ?
+	       dev_get_drvdata(dev) : NULL;
+	for (i = 0; priv && i < SENINF_NUM_PORTS; i++) {
+		struct mtk_seninf_port *port = &priv->ports[i];
+
+		if (port->priv && port->source_ep[SENINF_DEST_RAW] == endpoint) {
+			sd = &port->sd;
+			*pad = SENINF_PAD_SOURCE_RAW;
+			break;
+		}
+	}
+	put_device(dev);
+	return sd;
+}
+EXPORT_SYMBOL_GPL(mtk_seninf_raw_source);
