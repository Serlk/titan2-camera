From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:16:18 +0300
Subject: [PATCH 33/35] media: mediatek: camraw: Hand buffers back from the IRQ
 thread, user-space frame numbers, error timing log

Under libcamera a few frames per run still ended in a CQ trigger delay
and a buffer returned with an error, while V4L2-only runs at the same
blanking were clean. The start-of-frame times libcamera recorded show
single interrupts handled ~11 ms late (one interval of 46.7 ms followed
by one of 24.2 ms, together two frames).

- Finished buffers are handed back by the IRQ thread. vb2_buffer_done()
  does the CPU cache maintenance of the whole 2.4 MB picture (the buffers
  are cached); in the frame done interrupt, which comes ~3 ms before the
  next start of frame, it could delay that start-of-frame interrupt and
  with it the start of the next frame's lists. Only the list start and
  the bookkeeping stay in the hard IRQ.
- Frame numbers for user space (buffer sequence and FRAME_SYNC) start at
  the first frame of the per-frame request: the start request's frame has
  no picture, and libcamera renumbers buffers from the first one but not
  the frame start events, so its delayed controls were looked up for the
  wrong frame.
- Diagnostics: the spread of the start-of-frame interrupt intervals (a
  late interrupt shows as a long interval followed by a short one), the
  longest time from a start-of-frame interrupt to the list start, and for
  each of the first 16 error interrupts the frame, the time since its
  start of frame and since the last frame done, the interval of that
  start of frame, and whether the last lists went to a buffer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../platform/mediatek/camraw/mtk-camraw-drv.c | 126 +++++++++++++++++-
 .../platform/mediatek/camraw/mtk-camraw.h     |  34 +++++
 2 files changed, 153 insertions(+), 7 deletions(-)

diff --git a/drivers/media/platform/mediatek/camraw/mtk-camraw-drv.c b/drivers/media/platform/mediatek/camraw/mtk-camraw-drv.c
index ded33962dcd9..a7f55b29d003 100644
--- a/drivers/media/platform/mediatek/camraw/mtk-camraw-drv.c
+++ b/drivers/media/platform/mediatek/camraw/mtk-camraw-drv.c
@@ -467,6 +467,20 @@ static void camraw_show_counters(struct mtk_camraw *raw, struct seq_file *m,
 			   raw->sof_log[i].frmsize, raw->sof_log[i].done_us);
 	if (raw->err_us)
 		CAMRAW_OUT("first error interrupt %u us after viewfinder on", raw->err_us);
+	CAMRAW_OUT("per-frame lists started at most %u us after their start-of-frame interrupt; start-of-frame interrupt intervals %u..%u us",
+		   raw->max_apply_us,
+		   raw->min_sof_interval_us == ~0U ? 0 : raw->min_sof_interval_us,
+		   raw->max_sof_interval_us);
+	for (i = 0; i < min(raw->n_err_log, CAMRAW_ERR_LOG); i++) {
+		const struct mtk_camraw_errlog *e = &raw->err_log[i];
+
+		CAMRAW_OUT("error %u: bits 0x%08x in frame %u, %u us after its start-of-frame interrupt (which came %u us after the one before), %d us after the last frame done; last lists %u us after their SOF interrupt %s; applications %u, in flight %u done %d, late done pending %d",
+			   i + 1, e->bits, e->frame, e->us_since_sof, e->sof_interval_us,
+			   e->us_since_done == ~0U ? -1 : (int)e->us_since_done,
+			   e->apply_us,
+			   e->apply_had_buf ? "with a buffer" : "to the scratch planes",
+			   e->applied, e->inflight, e->inflight_done, e->late);
+	}
 }
 
 #undef CAMRAW_OUT
@@ -703,6 +717,29 @@ static int camraw_dmain_text(char *buf, size_t size, u32 v, bool underflow)
 
 static void camraw_frame_start(struct mtk_camraw *raw);
 static void camraw_frame_end(struct mtk_camraw *raw);
+
+/* hard IRQ: the frame timing state at an error interrupt */
+static void camraw_err_record(struct mtk_camraw *raw, u32 bits)
+{
+	struct mtk_camraw_errlog *e;
+	u64 now = ktime_get_ns();
+
+	if (raw->n_err_log >= CAMRAW_ERR_LOG)
+		return;
+	e = &raw->err_log[raw->n_err_log++];
+	e->bits = bits;
+	e->frame = raw->frame_idx;
+	e->us_since_sof = raw->sof_ns ? div_u64(now - raw->sof_ns, 1000) : 0;
+	e->us_since_done = raw->last_done_ns ?
+			   div_u64(now - raw->last_done_ns, 1000) : ~0U;
+	e->sof_interval_us = raw->sof_interval_us;
+	e->apply_us = raw->last_apply_us;
+	e->applied = raw->n_frame_applied;
+	e->inflight = raw->inflight;
+	e->inflight_done = raw->inflight_done;
+	e->late = raw->late_pending;
+	e->apply_had_buf = raw->last_apply_buf;
+}
 static void camraw_frame_dropped(struct mtk_camraw *raw);
 
 static irqreturn_t camraw_irq_common(struct mtk_camraw *raw, unsigned int line,
@@ -785,6 +822,10 @@ static irqreturn_t camraw_irq_common(struct mtk_camraw *raw, unsigned int line,
 	}
 	spin_unlock(&raw->irq_lock);
 
+	if (line == CAMRAW_IRQ_RAW && (st[1] & CAMCTL_INT_ERRORS) &&
+	    READ_ONCE(raw->streaming))
+		camraw_err_record(raw, st[1] & CAMCTL_INT_ERRORS);
+
 	/* buffers and the next frame's lists: here, not in the thread */
 	if (line == CAMRAW_IRQ_RAW && READ_ONCE(raw->streaming)) {
 		if (st[1] & CAMCTL_INT_SW_PASS1_DONE)
@@ -899,6 +940,12 @@ static void camraw_probe_report(struct mtk_camraw *raw)
 			 8, raw->probe_bytes[i]);
 }
 
+/*
+ * Hard IRQ: a buffer is finished. It is handed back by the IRQ thread:
+ * vb2_buffer_done() does the CPU cache maintenance of the whole picture,
+ * which in the frame done interrupt delayed the next start-of-frame
+ * interrupt and with it the next frame's lists.
+ */
 static void camraw_buf_finish(struct mtk_camraw *raw,
 			      struct mtk_camraw_buffer *buf,
 			      enum vb2_buffer_state state, u32 frame, u64 ns)
@@ -906,14 +953,33 @@ static void camraw_buf_finish(struct mtk_camraw *raw,
 	if (state == VB2_BUF_STATE_DONE) {
 		vb2_set_plane_payload(&buf->vb.vb2_buf, 0, raw->sizeimage);
 		buf->vb.field = V4L2_FIELD_NONE;
-		buf->vb.sequence = frame;
+		buf->vb.sequence = frame - raw->seq_base;
 		buf->vb.vb2_buf.timestamp = ns;
-		if (!raw->probe_done)
+		raw->n_frames++;
+	}
+	buf->state = state;
+	spin_lock(&raw->buf_lock);
+	list_add_tail(&buf->list, &raw->done_bufs);
+	spin_unlock(&raw->buf_lock);
+}
+
+/* IRQ thread: hand the finished buffers back */
+static void camraw_buf_handback(struct mtk_camraw *raw)
+{
+	struct mtk_camraw_buffer *buf, *tmp;
+	unsigned long flags;
+	LIST_HEAD(list);
+
+	spin_lock_irqsave(&raw->buf_lock, flags);
+	list_splice_init(&raw->done_bufs, &list);
+	spin_unlock_irqrestore(&raw->buf_lock, flags);
+	list_for_each_entry_safe(buf, tmp, &list, list) {
+		list_del(&buf->list);
+		if (buf->state == VB2_BUF_STATE_DONE && !raw->probe_done)
 			camraw_probe_check(raw, vb2_plane_vaddr(&buf->vb.vb2_buf, 0),
 					   buf->dma);
-		raw->n_frames++;
+		vb2_buffer_done(&buf->vb.vb2_buf, buf->state);
 	}
-	vb2_buffer_done(&buf->vb.vb2_buf, state);
 }
 
 /* hard IRQ: hand back the buffer of application @k (0: the start request, none) */
@@ -963,7 +1029,10 @@ static void camraw_apply_frame(struct mtk_camraw *raw)
 	if (old) {
 		/* never completed: its frame was lost */
 		raw->n_buf_errors++;
-		vb2_buffer_done(&old->vb.vb2_buf, VB2_BUF_STATE_ERROR);
+		old->state = VB2_BUF_STATE_ERROR;
+		spin_lock_irqsave(&raw->buf_lock, flags);
+		list_add_tail(&old->list, &raw->done_bufs);
+		spin_unlock_irqrestore(&raw->buf_lock, flags);
 	}
 	if (buf) {
 		pic[0] = buf->dma;
@@ -979,6 +1048,13 @@ static void camraw_apply_frame(struct mtk_camraw *raw)
 	camraw_apply_cq(raw, raw->slot_frame[set].dma, &raw->frame,
 			raw->frame_size);
 	raw->n_frame_applied = j;
+
+	/* time from the start-of-frame interrupt to the list start */
+	raw->last_apply_us = raw->sof_ns ?
+			     div_u64(ktime_get_ns() - raw->sof_ns, 1000) : 0;
+	raw->last_apply_buf = buf;
+	if (READ_ONCE(raw->streaming))
+		raw->max_apply_us = max(raw->max_apply_us, raw->last_apply_us);
 }
 
 /*
@@ -988,6 +1064,7 @@ static void camraw_apply_frame(struct mtk_camraw *raw)
  */
 static void camraw_frame_end(struct mtk_camraw *raw)
 {
+	raw->last_done_ns = ktime_get_ns();
 	if (raw->late_pending) {
 		raw->late_pending = false;
 		camraw_log_done(raw, raw->late_frame);
@@ -1051,6 +1128,20 @@ static void camraw_frame_start(struct mtk_camraw *raw)
 		raw->n_late_done++;
 	}
 
+	/*
+	 * The sensor's frames are evenly spaced: an interval much longer than
+	 * the frame time followed by a short one is an interrupt handled late
+	 * (and the lists of the next frame started late with it).
+	 */
+	if (raw->prev_sof_ns) {
+		raw->sof_interval_us = div_u64(raw->sof_ns - raw->prev_sof_ns, 1000);
+		raw->min_sof_interval_us = min(raw->min_sof_interval_us,
+					       raw->sof_interval_us);
+		raw->max_sof_interval_us = max(raw->max_sof_interval_us,
+					       raw->sof_interval_us);
+	}
+	raw->prev_sof_ns = raw->sof_ns;
+
 	raw->frame_idx = raw->n_sof - 1;
 	raw->inflight = raw->n_frame_applied;
 	raw->inflight_frame = raw->frame_idx;
@@ -1068,8 +1159,17 @@ static void camraw_frame_start(struct mtk_camraw *raw)
 		raw->n_sof_log = raw->frame_idx + 1;
 	}
 
-	ev.u.frame_sync.frame_sequence = raw->frame_idx;
-	v4l2_event_queue(&raw->vdev, &ev);
+	/*
+	 * Frame numbers for user space start at the first frame of the
+	 * per-frame request (the start request's frame has no picture), so
+	 * that the first buffer is 0 and the frame start events count the
+	 * same way (libcamera renumbers buffers from the first one, not the
+	 * events).
+	 */
+	if (raw->frame_idx >= raw->seq_base) {
+		ev.u.frame_sync.frame_sequence = raw->frame_idx - raw->seq_base;
+		v4l2_event_queue(&raw->vdev, &ev);
+	}
 
 	if (!reapply || applied)
 		return;
@@ -1128,6 +1228,7 @@ static irqreturn_t camraw_raw_thread(int irq, void *data)
 				     raw_rd(raw, CAMRAW_AAO_R1 + CAMRAW_DMA_ERR_STAT),
 				     raw_rd(raw, CAMRAW_CQI_R1 + CAMRAW_DMA_ERR_STAT));
 
+	camraw_buf_handback(raw);
 	if ((pend[1] & CAMCTL_INT_TG_SOF) && READ_ONCE(raw->streaming))
 		camraw_snap_event(raw, 0);
 	if (raw->probe_report) {
@@ -1637,6 +1738,14 @@ static int camraw_stream_start(struct mtk_camraw *raw)
 	raw->n_late_done = 0;
 	raw->n_deferred = 0;
 	raw->n_sof_drop = 0;
+	raw->seq_base = prestart ? 0 : 1;
+	raw->max_apply_us = 0;
+	raw->prev_sof_ns = 0;
+	raw->sof_interval_us = 0;
+	raw->min_sof_interval_us = ~0U;
+	raw->max_sof_interval_us = 0;
+	raw->last_done_ns = 0;
+	raw->n_err_log = 0;
 	raw->n_applied = 0;
 	raw->n_frame_applied = 0;
 	raw->n_sof_log = 0;
@@ -1761,6 +1870,8 @@ static void camraw_return_bufs(struct mtk_camraw *raw,
 
 	unsigned int i;
 
+	/* finished ones first, as they were finished */
+	camraw_buf_handback(raw);
 	spin_lock_irqsave(&raw->buf_lock, flags);
 	list_splice_init(&raw->bufs, &list);
 	/* buffers the lists of a frame pointed at */
@@ -2354,6 +2465,7 @@ static int camraw_probe_master(struct mtk_camraw *raw)
 	spin_lock_init(&raw->irq_lock);
 	spin_lock_init(&raw->buf_lock);
 	INIT_LIST_HEAD(&raw->bufs);
+	INIT_LIST_HEAD(&raw->done_bufs);
 	init_completion(&raw->cq_done);
 	INIT_DELAYED_WORK(&raw->watchdog, camraw_watchdog);
 	ret = devm_mutex_init(dev, &raw->lock);
diff --git a/drivers/media/platform/mediatek/camraw/mtk-camraw.h b/drivers/media/platform/mediatek/camraw/mtk-camraw.h
index c84c284664f7..fce18748c110 100644
--- a/drivers/media/platform/mediatek/camraw/mtk-camraw.h
+++ b/drivers/media/platform/mediatek/camraw/mtk-camraw.h
@@ -66,6 +66,7 @@ struct mtk_camraw_buffer {
 	struct vb2_v4l2_buffer vb;
 	struct list_head list;
 	dma_addr_t dma;
+	enum vb2_buffer_state state;	/* how it is handed back */
 };
 
 /**
@@ -112,6 +113,23 @@ struct mtk_camraw_snap {
 	unsigned int num_ports;
 };
 
+/* one error interrupt and the state of the frame timing around it */
+struct mtk_camraw_errlog {
+	u32 bits;
+	u32 frame;		/* internal frame number (0: the start request's) */
+	u32 us_since_sof;
+	u32 us_since_done;	/* since the last frame done, ~0 if none yet */
+	u32 sof_interval_us;	/* this frame's start of frame after the one before */
+	u32 apply_us;		/* last lists started this long after their SOF IRQ */
+	u32 applied;
+	u32 inflight;
+	bool inflight_done;
+	bool late;
+	bool apply_had_buf;
+};
+
+#define CAMRAW_ERR_LOG			16
+
 struct mtk_camraw_sof {
 	u32 t_us;		/* time since viewfinder on */
 	u32 applied;		/* number of per-frame requests applied before */
@@ -153,6 +171,8 @@ struct mtk_camraw {
 	struct mutex lock;
 	spinlock_t buf_lock;
 	struct list_head bufs;
+	/* finished buffers, handed back by the IRQ thread */
+	struct list_head done_bufs;
 
 	/* the two loaded requests: the start request and the per-frame one */
 	struct camraw_replay start;
@@ -199,6 +219,20 @@ struct mtk_camraw {
 	unsigned int n_late_done;
 	unsigned int n_deferred;
 	unsigned int n_sof_drop;
+	/* first frame user space sees as 0: the first per-frame request's */
+	u32 seq_base;
+	/* when and where the last lists were started, the last frame done */
+	u32 last_apply_us;
+	bool last_apply_buf;
+	u32 max_apply_us;
+	/* start-of-frame interrupt intervals: their spread is IRQ latency */
+	u64 prev_sof_ns;
+	u32 sof_interval_us;
+	u32 min_sof_interval_us;
+	u32 max_sof_interval_us;
+	u64 last_done_ns;
+	struct mtk_camraw_errlog err_log[CAMRAW_ERR_LOG];
+	unsigned int n_err_log;
 	unsigned int n_no_buffer_frames;
 	unsigned int n_buf_errors;
 	bool probe_done;
-- 
