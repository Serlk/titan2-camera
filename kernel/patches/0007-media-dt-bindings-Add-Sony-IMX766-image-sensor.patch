From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:22:54 +0300
Subject: [PATCH 07/34] media: dt-bindings: Add Sony IMX766 image sensor

IMX766 is a 50 MP sensor with a 3-trio MIPI CSI-2 C-PHY output, used as
the main rear camera of the Unihertz Titan 2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/media/i2c/sony,imx766.yaml       | 117 ++++++++++++++++++
 MAINTAINERS                                   |   7 ++
 2 files changed, 124 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml
new file mode 100644
index 000000000000..2b9fa9159f3d
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx766.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX766 Image Sensor
+
+maintainers:
+  - serlk <22211586+Serlk@users.noreply.github.com>
+
+description:
+  Sony IMX766 is a 50 megapixel (8192x6144) raw image sensor with an on-chip
+  quad Bayer remosaic. It is controlled over an I2C compatible CCI bus and
+  sends RAW10 data over a 3-trio MIPI CSI-2 C-PHY interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx766
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK, 24 MHz.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the reset pin.
+    maxItems: 1
+
+  powerdown-gpios:
+    description: Active low GPIO connected to the power down pin of the module.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  dvdd-supply:
+    description: Digital core voltage supply, 1.1 volts.
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 1 # MEDIA_BUS_TYPE_CSI2_CPHY
+
+          data-lanes:
+            description: The three C-PHY trios.
+            minItems: 3
+            maxItems: 3
+
+          link-frequencies: true
+
+        required:
+          - bus-type
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/media/video-interfaces.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "sony,imx766";
+            reg = <0x1a>;
+            clocks = <&camera_mclk 0>;
+            assigned-clocks = <&camera_mclk 0>;
+            assigned-clock-rates = <24000000>;
+            reset-gpios = <&gpio 26 GPIO_ACTIVE_LOW>;
+            powerdown-gpios = <&gpio 28 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&vcam_avdd>;
+            dvdd-supply = <&vcam_dvdd>;
+            dovdd-supply = <&vcam_dovdd>;
+            orientation = <1>;
+            rotation = <270>;
+
+            port {
+                endpoint {
+                    bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+                    data-lanes = <0 1 2>;
+                    link-frequencies = /bits/ 64 <574000000 377000000>;
+                    remote-endpoint = <&csi_in>;
+                };
+            };
+        };
+    };
+...
