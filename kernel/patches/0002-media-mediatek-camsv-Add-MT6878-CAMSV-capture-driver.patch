+/*
+ * MediaTek MT6878 CAMSV capture driver.
+ *
+ * The engine state machine and the IRQ snapshot layout are based on
+ * mtk_cam-engine_fsm.h, mtk_cam-engine.h and mtk_cam-sv.h of the MediaTek
+ * ISP7SP camsys driver (kernel_modules/mtkcam/camsys/isp7sp/cam, GPL-2.0).
+ *
+ * Copyright (c) 2022-2023 MediaTek Inc.
+ * Copyright (c) 2026 serlk
+ */
