@@ -0,0 +1,985 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * MediaTek MT6878 CAMSV capture driver: video node, vb2 queue, media
+ * controller and job control (one buffer per CQ job).
+ *
+ * Copyright (c) 2026 serlk
+ */
+
+#include <linux/bitmap.h>
+#include <linux/iommu.h>
+#include <linux/jiffies.h>
+#include <linux/lockdep.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/timekeeping.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mc.h>
+#include <media/v4l2-subdev.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "mtk-camsv.h"
+
+/*
+ * TODO: the hardware size limits of a CAMSV tag are not in the
+ * specification. These bounds are conservative: the width is a multiple
+ * of the 8-pixel bus, and the stride fits the 16-bit stride field.
+ */
+#define CAMSV_MIN_WIDTH		64
+#define CAMSV_MAX_WIDTH		8192
+#define CAMSV_MIN_HEIGHT	16
+#define CAMSV_MAX_HEIGHT	8192
+#define CAMSV_WIDTH_ALIGN	8
+#define CAMSV_HEIGHT_ALIGN	2
+#define CAMSV_STRIDE_ALIGN	16	/* WDMA bus alignment, raw formats */
+#define CAMSV_BUF_ALIGN		16
+
+#define CAMSV_SETTING_TIMEOUT_MS	1000
+
+#define CAMSV_FMT(pix, bus, out, in, bits)				\
+	{								\
+		.fourcc = V4L2_PIX_FMT_##pix,				\
+		.mbus_code = MEDIA_BUS_FMT_##bus,			\
+		.out_fmt = CAMSV_CQ_FMT_##out,				\
+		.in_fmt = CAMSV_CQ_FMT_##in,				\
+		.bpp = bits,						\
+	}
+
+/*
+ * The first entry is the default.
+ *
+ * TODO: the specification leaves the V4L2 mapping of the protocol
+ * format codes open. The codes are taken as the public mtkcam IPI image
+ * formats (camsys/common/mtk_cam-fmt.h: 0 BAYER8, 1 BAYER10, 2 BAYER12,
+ * 5/6 BAYER10/12_UNPACKED, 0x50 BAYER10_MIPI); only formats with a
+ * mainline fourcc are offered (no MediaTek-packed 10/12-bit fourccs).
+ */
+static const struct mtk_camsv_format camsv_formats[] = {
+	CAMSV_FMT(SBGGR10P, SBGGR10_1X10, BAYER10_MIPI, BAYER10, 10),
+	CAMSV_FMT(SGBRG10P, SGBRG10_1X10, BAYER10_MIPI, BAYER10, 10),
+	CAMSV_FMT(SGRBG10P, SGRBG10_1X10, BAYER10_MIPI, BAYER10, 10),
+	CAMSV_FMT(SRGGB10P, SRGGB10_1X10, BAYER10_MIPI, BAYER10, 10),
+	CAMSV_FMT(SBGGR8, SBGGR8_1X8, BAYER8, BAYER8, 8),
+	CAMSV_FMT(SGBRG8, SGBRG8_1X8, BAYER8, BAYER8, 8),
+	CAMSV_FMT(SGRBG8, SGRBG8_1X8, BAYER8, BAYER8, 8),
+	CAMSV_FMT(SRGGB8, SRGGB8_1X8, BAYER8, BAYER8, 8),
+	CAMSV_FMT(SBGGR10, SBGGR10_1X10, BAYER10_UNPACKED, BAYER10, 16),
+	CAMSV_FMT(SGBRG10, SGBRG10_1X10, BAYER10_UNPACKED, BAYER10, 16),
+	CAMSV_FMT(SGRBG10, SGRBG10_1X10, BAYER10_UNPACKED, BAYER10, 16),
+	CAMSV_FMT(SRGGB10, SRGGB10_1X10, BAYER10_UNPACKED, BAYER10, 16),
+	CAMSV_FMT(SBGGR12, SBGGR12_1X12, BAYER12_UNPACKED, BAYER12, 16),
+	CAMSV_FMT(SGBRG12, SGBRG12_1X12, BAYER12_UNPACKED, BAYER12, 16),
+	CAMSV_FMT(SGRBG12, SGRBG12_1X12, BAYER12_UNPACKED, BAYER12, 16),
+	CAMSV_FMT(SRGGB12, SRGGB12_1X12, BAYER12_UNPACKED, BAYER12, 16),
+};
+
+static const struct mtk_camsv_format *camsv_find_format(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(camsv_formats); i++)
+		if (camsv_formats[i].fourcc == fourcc)
+			return &camsv_formats[i];
+	return NULL;
+}
+
+static const struct mtk_camsv_format *
+camsv_try_format(struct v4l2_pix_format *pix)
+{
+	const struct mtk_camsv_format *fmt;
+	u32 stride;
+
+	fmt = camsv_find_format(pix->pixelformat);
+	if (!fmt)
+		fmt = &camsv_formats[0];
+
+	pix->pixelformat = fmt->fourcc;
+	pix->width = clamp_t(u32, ALIGN(pix->width, CAMSV_WIDTH_ALIGN),
+			     CAMSV_MIN_WIDTH, CAMSV_MAX_WIDTH);
+	pix->height = clamp_t(u32, ALIGN(pix->height, CAMSV_HEIGHT_ALIGN),
+			      CAMSV_MIN_HEIGHT, CAMSV_MAX_HEIGHT);
+	/* stride as the ISP7SP format helpers compute it for raw formats */
+	stride = ALIGN(DIV_ROUND_UP(pix->width * fmt->bpp, 8),
+		       CAMSV_STRIDE_ALIGN);
+	pix->bytesperline = stride;
+	pix->sizeimage = stride * pix->height;
+	pix->field = V4L2_FIELD_NONE;
+	pix->colorspace = V4L2_COLORSPACE_RAW;
+	pix->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	pix->xfer_func = V4L2_XFER_FUNC_NONE;
+	pix->flags = 0;
+	return fmt;
+}
+
+/* ------------------------------------------------------------------ */
+/* Job control                                                         */
+
+static u32 camsv_next_cookie(struct mtk_camsv_dev *cam)
+{
+	/* positive 31-bit cookies, 0 skipped: the automaton starts at -1 */
+	cam->next_cookie = (cam->next_cookie + 1) & 0x7fffffff;
+	if (!cam->next_cookie)
+		cam->next_cookie = 1;
+	return cam->next_cookie;
+}
+
+static void camsv_buf_done(struct mtk_camsv_buffer *buf,
+			   enum vb2_buffer_state state)
+{
+	buf->vb.vb2_buf.timestamp = buf->started ? buf->ts_ns : ktime_get_ns();
+	buf->vb.sequence = buf->sequence;
+	buf->vb.field = V4L2_FIELD_NONE;
+	vb2_buffer_done(&buf->vb.vb2_buf, state);
+}
+
+/*
+ * Check a composed list before it is launched: it lies inside its slot,
+ * ends with exactly one END descriptor, and every value array it points
+ * at lies inside the same slot. With @print, each descriptor is logged
+ * with its register, count, value address and first value.
+ */
+static int camsv_check_list(struct mtk_camsv_dev *cam, void *slot_cpu,
+			    dma_addr_t slot_dma, u32 off, u32 len, bool print)
+{
+	struct camsv_cq_builder b;
+	struct camsv_cq_cmd cmd;
+	u32 pos, end, i;
+	int ret;
+
+	ret = camsv_cq_builder_init(&b, slot_cpu, slot_dma, CAMSV_CQ_SLOT_SIZE);
+	if (ret)
+		return ret;
+	if (!len || len % CAMSV_CQ_DESC_SIZE || off > CAMSV_CQ_SLOT_SIZE ||
+	    len > CAMSV_CQ_SLOT_SIZE - off)
+		return -EINVAL;
+	end = off + len;
+
+	for (pos = off, i = 0; pos < end; pos += CAMSV_CQ_DESC_SIZE, i++) {
+		const u8 *vals;
+
+		ret = camsv_cq_decode(&b, pos, &cmd);
+		if (ret)
+			return ret;
+		if (cmd.op == CAMSV_CQ_OP_END) {
+			if (pos + CAMSV_CQ_DESC_SIZE != end) {
+				dev_err(cam->dev, "CQ list: END at %u of %u bytes\n",
+					pos - off, len);
+				return -EINVAL;
+			}
+			if (print)
+				dev_info(cam->dev, "  cq[%2u] end\n", i);
+			return 0;
+		}
+
+		vals = camsv_cq_dma_to_cpu(&b, cmd.data);
+		if (cmd.op != CAMSV_CQ_OP_WRITE || !vals ||
+		    cmd.data + 4ULL * cmd.count > (u64)slot_dma + CAMSV_CQ_SLOT_SIZE) {
+			dev_err(cam->dev,
+				"CQ list: descriptor %u (op %u reg 0x%08x x%u) points at %#llx, outside its slot %pad\n",
+				i, cmd.op, cmd.reg, cmd.count, cmd.data, &slot_dma);
+			return -EFAULT;
+		}
+		if (print)
+			dev_info(cam->dev, "  cq[%2u] reg 0x%08x x%u at %#llx = 0x%08x\n",
+				 i, cmd.reg, cmd.count, cmd.data,
+				 get_unaligned_le32(vals));
+	}
+
+	dev_err(cam->dev, "CQ list of %u bytes has no END\n", len);
+	return -EINVAL;
+}
+
+/*
+ * Compose and launch the CQ of the next queued buffer, if the previous
+ * job's settings are already active and a CQ slot is free.
+ */
+void mtk_camsv_try_apply(struct mtk_camsv_dev *cam)
+{
+	struct mtk_camsv_buffer *buf;
+	unsigned long flags;
+	dma_addr_t slot_dma, out;
+	void *slot_cpu;
+	u32 cookie, off, len;
+	int slot, ret;
+
+	lockdep_assert_held(&cam->hw_mutex);
+
+	if (!cam->active || cam->wedged || mtk_camsv_job_bound(cam))
+		return;
+
+	slot = find_first_zero_bit(&cam->cq_slots, CAMSV_CQ_SLOTS);
+	if (slot >= CAMSV_CQ_SLOTS)
+		return;
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	buf = list_first_entry_or_null(&cam->pending_bufs,
+				       struct mtk_camsv_buffer, list);
+	if (buf)
+		list_del(&buf->list);
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+	if (!buf)
+		return;
+
+	slot_cpu = cam->cq_cpu + slot * CAMSV_CQ_SLOT_SIZE;
+	slot_dma = cam->cq_dma + slot * CAMSV_CQ_SLOT_SIZE;
+	out = vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0);
+	cookie = camsv_next_cookie(cam);
+
+	camsv_cq_frame_begin(&cam->cq_state, cookie);
+	ret = camsv_cq_frame_set_output(&cam->cq_state, cam->cq_hw_id,
+					CAMSV_IMG_TAG, cam->fmt->out_fmt,
+					cam->pix.bytesperline, out,
+					cam->pix.sizeimage);
+	if (!ret)
+		ret = camsv_cq_compose_single(&cam->cq_state, &cam->cq_scratch,
+					      slot_cpu, slot_dma,
+					      CAMSV_CQ_SLOT_SIZE, &off, &len);
+	if (!ret && !len)
+		ret = -ENODATA;
+	if (!ret)
+		ret = camsv_check_list(cam, slot_cpu, slot_dma, off, len,
+				       mtk_camsv_debug & CAMSV_DBG_CQ);
+	if (ret) {
+		/*
+		 * Nothing was published. A composition error leaves the
+		 * session state unchanged; a rejected list (a builder bug)
+		 * has already consumed the pending configuration.
+		 */
+		dev_err(cam->dev, "CQ composition failed: %d\n", ret);
+		buf->started = false;
+		buf->sequence = 0;
+		camsv_buf_done(buf, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	buf->cookie = cookie;
+	buf->slot = slot;
+	buf->error = false;
+	buf->started = false;
+	buf->sequence = 0;
+
+	/* bind before any MMIO of the launch */
+	if (mtk_camsv_bind_job(cam, cookie)) {
+		spin_lock_irqsave(&cam->buf_lock, flags);
+		list_add(&buf->list, &cam->pending_bufs);
+		spin_unlock_irqrestore(&cam->buf_lock, flags);
+		return;
+	}
+
+	set_bit(slot, &cam->cq_slots);
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	list_add_tail(&buf->list, &cam->inflight_bufs);
+	cam->num_inflight++;
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+
+	cam->last_out_dma = out;
+	if (mtk_camsv_debug & CAMSV_DBG_CQ) {
+		dma_addr_t list = slot_dma + off;
+
+		struct iommu_domain *dom = iommu_get_domain_for_dev(cam->dev);
+		phys_addr_t list_pa = dom ? iommu_iova_to_phys(dom, list) : 0;
+		phys_addr_t out_pa = dom ? iommu_iova_to_phys(dom, out) : 0;
+
+		dev_info(cam->dev,
+			 "job cookie %u: slot %d, list %pad (+%u) -> %pa, %u bytes, output %pad -> %pa (%u bytes, stride %u)\n",
+			 cookie, slot, &list, off, &list_pa, len, &out, &out_pa,
+			 cam->pix.sizeimage, cam->pix.bytesperline);
+	}
+
+	/* publish the CQ memory before the launch */
+	if (cam->cq_page)
+		dma_sync_single_for_device(cam->dev, slot_dma,
+					   CAMSV_CQ_SLOT_SIZE, DMA_TO_DEVICE);
+	dma_wmb();
+	mtk_camsv_hw_apply_cq(cam, slot_dma + off, len);
+
+	if (mtk_camsv_debug & CAMSV_DBG_CQ)
+		mtk_camsv_hw_dump_cq_regs(cam);
+}
+
+static struct mtk_camsv_buffer *
+camsv_find_inflight(struct mtk_camsv_dev *cam, u32 cookie)
+{
+	struct mtk_camsv_buffer *buf;
+
+	list_for_each_entry(buf, &cam->inflight_bufs, list)
+		if (buf->cookie == cookie)
+			return buf;
+	return NULL;
+}
+
+void mtk_camsv_frame_started(struct mtk_camsv_dev *cam, u32 cookie,
+			     const struct mtk_camsv_event *ev)
+{
+	struct mtk_camsv_buffer *buf;
+	unsigned long flags;
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	buf = camsv_find_inflight(cam, cookie);
+	if (buf) {
+		buf->started = true;
+		buf->ts_ns = ev->ts_mono_ns;
+		buf->sequence = ev->frame_count;
+	}
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+}
+
+/*
+ * Start of a frame on the image tag: V4L2_EVENT_FRAME_SYNC on the video
+ * node. The sequence is the one the buffer of this frame gets.
+ */
+void mtk_camsv_frame_sync(struct mtk_camsv_dev *cam, u32 sequence)
+{
+	struct v4l2_event event = {
+		.type = V4L2_EVENT_FRAME_SYNC,
+		.u.frame_sync.frame_sequence = sequence,
+	};
+
+	v4l2_event_queue(&cam->vdev, &event);
+}
+
+void mtk_camsv_frame_error(struct mtk_camsv_dev *cam, u32 cookie)
+{
+	struct mtk_camsv_buffer *buf;
+	unsigned long flags;
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	buf = camsv_find_inflight(cam, cookie);
+	if (buf)
+		buf->error = true;
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+}
+
+/*
+ * Return the buffer of @cookie. Jobs launched before it can no longer
+ * complete (the hardware moved past them) and are returned as errors. A
+ * cookie without a buffer (repeated or spurious done) returns nothing.
+ * Buffers are taken off the list under the lock and returned outside it.
+ */
+void mtk_camsv_frame_done(struct mtk_camsv_dev *cam, u32 cookie)
+{
+	struct mtk_camsv_buffer *buf, *tmp, *match;
+	unsigned long flags;
+	LIST_HEAD(done);
+
+	lockdep_assert_held(&cam->hw_mutex);
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	match = camsv_find_inflight(cam, cookie);
+	if (!match) {
+		spin_unlock_irqrestore(&cam->buf_lock, flags);
+		dev_dbg(cam->dev, "done for unknown cookie 0x%x\n", cookie);
+		return;
+	}
+	list_for_each_entry_safe(buf, tmp, &cam->inflight_bufs, list) {
+		list_move_tail(&buf->list, &done);
+		cam->num_inflight--;
+		if (buf == match)
+			break;
+	}
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+
+	list_for_each_entry_safe(buf, tmp, &done, list) {
+		list_del(&buf->list);
+		clear_bit(buf->slot, &cam->cq_slots);
+		camsv_buf_done(buf, buf == match && !buf->error ?
+				    VB2_BUF_STATE_DONE : VB2_BUF_STATE_ERROR);
+	}
+}
+
+static void camsv_return_all(struct mtk_camsv_dev *cam,
+			     enum vb2_buffer_state state)
+{
+	struct mtk_camsv_buffer *buf, *tmp;
+	unsigned long flags;
+	LIST_HEAD(all);
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	list_splice_tail_init(&cam->inflight_bufs, &all);
+	list_splice_tail_init(&cam->pending_bufs, &all);
+	cam->num_inflight = 0;
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+
+	bitmap_zero(&cam->cq_slots, CAMSV_CQ_SLOTS);
+	list_for_each_entry_safe(buf, tmp, &all, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* vb2                                                                 */
+
+static int camsv_queue_setup(struct vb2_queue *q, unsigned int *num_buffers,
+			     unsigned int *num_planes, unsigned int sizes[],
+			     struct device *alloc_devs[])
+{
+	struct mtk_camsv_dev *cam = vb2_get_drv_priv(q);
+
+	if (*num_planes)
+		return sizes[0] < cam->pix.sizeimage ? -EINVAL : 0;
+
+	*num_planes = 1;
+	sizes[0] = cam->pix.sizeimage;
+	return 0;
+}
+
+static int camsv_buf_prepare(struct vb2_buffer *vb)
+{
+	struct mtk_camsv_dev *cam = vb2_get_drv_priv(vb->vb2_queue);
+	unsigned long size = cam->pix.sizeimage;
+
+	if (vb2_plane_size(vb, 0) < size)
+		return -EINVAL;
+	/*
+	 * TODO: the WDMA address alignment is not specified; the
+	 * stride alignment is required for the start address as well.
+	 */
+	if (vb2_dma_contig_plane_dma_addr(vb, 0) & (CAMSV_BUF_ALIGN - 1))
+		return -EINVAL;
+
+	vb2_set_plane_payload(vb, 0, size);
+
+	if (mtk_camsv_debug & CAMSV_DBG_CQ) {
+		dma_addr_t addr = vb2_dma_contig_plane_dma_addr(vb, 0);
+
+		dev_info(cam->dev, "buffer %u: %pad, %lu bytes\n", vb->index,
+			 &addr, vb2_plane_size(vb, 0));
+	}
+	return 0;
+}
+
+static void camsv_buf_queue(struct vb2_buffer *vb)
+{
+	struct mtk_camsv_dev *cam = vb2_get_drv_priv(vb->vb2_queue);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct mtk_camsv_buffer *buf =
+		container_of(vbuf, struct mtk_camsv_buffer, vb);
+	unsigned long flags;
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	list_add_tail(&buf->list, &cam->pending_bufs);
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+
+	mutex_lock(&cam->hw_mutex);
+	mtk_camsv_try_apply(cam);
+	mutex_unlock(&cam->hw_mutex);
+}
+
+static void camsv_source_log_status(struct mtk_camsv_dev *cam)
+{
+	if (cam->source)
+		v4l2_subdev_call(cam->source, core, log_status);
+}
+
+static void camsv_dump_work(struct work_struct *work)
+{
+	struct mtk_camsv_dev *cam =
+		container_of(to_delayed_work(work), struct mtk_camsv_dev,
+			     dump_work);
+
+	mtk_camsv_hw_dump(cam, "1 s after start");
+	camsv_source_log_status(cam);
+}
+
+/*
+ * Stop the engine and give every buffer back. If the stop reset times
+ * out the hardware may still write to memory: the device is marked
+ * wedged, keeps its power reference (no clock gating of a busy master)
+ * and refuses to stream again. vb2 still needs the buffers back.
+ */
+static void camsv_stop(struct mtk_camsv_dev *cam, enum vb2_buffer_state state)
+{
+	int ret;
+
+	cancel_delayed_work_sync(&cam->dump_work);
+	if (mtk_camsv_debug & CAMSV_DBG_DUMP) {
+		mtk_camsv_hw_dump(cam, "stop");
+		if (cam->source_streaming)
+			camsv_source_log_status(cam);
+	}
+
+	mutex_lock(&cam->hw_mutex);
+	cam->active = false;
+	ret = mtk_camsv_hw_stop(cam);
+	mtk_camsv_unbind_job(cam);
+	if (ret) {
+		cam->wedged = true;
+		dev_err(cam->dev,
+			"engine did not stop (%d): device disabled until rebind\n",
+			ret);
+	}
+	camsv_return_all(cam, state);
+	mutex_unlock(&cam->hw_mutex);
+
+	if (cam->source_streaming) {
+		v4l2_subdev_disable_streams(cam->source, cam->source_pad,
+					    BIT_ULL(0));
+		cam->source_streaming = false;
+	}
+
+	if (cam->wedged)
+		mtk_camsv_hw_irqs(cam, false);
+	else
+		pm_runtime_put(cam->dev);
+}
+
+static int camsv_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct mtk_camsv_dev *cam = vb2_get_drv_priv(q);
+	struct camsv_cq_tag cfg = {
+		.tag_id = CAMSV_IMG_TAG,
+		.tag_order = CAMSV_IMG_TAG_ORDER,
+		.pixel_mode = CAMSV_PIXEL_MODE,
+	};
+	struct media_pad *remote;
+	bool bound;
+	int ret;
+
+	if (cam->wedged) {
+		ret = -EIO;
+		goto err_return;
+	}
+
+	ret = video_device_pipeline_start(&cam->vdev, &cam->pipe);
+	if (ret)
+		goto err_return;
+
+	remote = media_pad_remote_pad_unique(&cam->pad);
+	if (IS_ERR(remote)) {
+		ret = PTR_ERR(remote);
+		goto err_pipe;
+	}
+	if (!is_media_entity_v4l2_subdev(remote->entity)) {
+		ret = -EINVAL;
+		goto err_pipe;
+	}
+	cam->source = media_entity_to_v4l2_subdev(remote->entity);
+	cam->source_pad = remote->index;
+
+	ret = pm_runtime_resume_and_get(cam->dev);
+	if (ret)
+		goto err_pipe;
+
+	cfg.input_format = cam->fmt->in_fmt;
+	cfg.crop_width = cam->pix.width;
+	cfg.crop_height = cam->pix.height;
+
+	mutex_lock(&cam->hw_mutex);
+	mtk_camsv_state_reset(cam);
+	mtk_camsv_hw_dev_config(cam);
+	camsv_cq_state_init(&cam->cq_state);
+	camsv_cq_config_begin(&cam->cq_state);
+	ret = camsv_cq_config_add(&cam->cq_state, 0, 0, cam->cq_hw_id, &cfg,
+				  true, false, false);
+	reinit_completion(&cam->setting_done);
+	if (!ret) {
+		cam->active = true;
+		/* the first job carries the configuration */
+		mtk_camsv_try_apply(cam);
+		bound = mtk_camsv_job_bound(cam);
+		if (!bound)
+			ret = -EIO;
+	}
+	mutex_unlock(&cam->hw_mutex);
+	if (ret)
+		goto err_stop;
+
+	/*
+	 * TODO: the first CQ is expected to execute before the TG
+	 * is enabled (the CQ-done IRQ confirms it); not verified on hardware.
+	 */
+	if (!wait_for_completion_timeout(&cam->setting_done,
+					 msecs_to_jiffies(CAMSV_SETTING_TIMEOUT_MS))) {
+		dev_err(cam->dev, "first CQ was not applied\n");
+		if (mtk_camsv_debug & CAMSV_DBG_DUMP)
+			mtk_camsv_hw_dump(cam, "first CQ timeout");
+		ret = -ETIMEDOUT;
+		goto err_stop;
+	}
+
+	mutex_lock(&cam->hw_mutex);
+	/* diagnostic only: the read-back semantics of the outer set are unproven */
+	mtk_camsv_hw_check_applied(cam, CAMSV_IMG_TAG, cam->pix.width,
+				   cam->last_out_dma);
+	ret = mtk_camsv_hw_stream(cam, true, BIT(CAMSV_IMG_TAG), 1);
+	mutex_unlock(&cam->hw_mutex);
+	if (ret)
+		goto err_stop;
+
+	ret = v4l2_subdev_enable_streams(cam->source, cam->source_pad,
+					 BIT_ULL(0));
+	if (ret)
+		goto err_stop;
+	cam->source_streaming = true;
+
+	if (mtk_camsv_debug & CAMSV_DBG_DUMP) {
+		mtk_camsv_hw_dump(cam, "start");
+		camsv_source_log_status(cam);
+		schedule_delayed_work(&cam->dump_work,
+				      msecs_to_jiffies(CAMSV_DUMP_DELAY_MS));
+	}
+	return 0;
+
+err_stop:
+	camsv_stop(cam, VB2_BUF_STATE_QUEUED);
+	video_device_pipeline_stop(&cam->vdev);
+	return ret;
+err_pipe:
+	video_device_pipeline_stop(&cam->vdev);
+err_return:
+	mutex_lock(&cam->hw_mutex);
+	camsv_return_all(cam, VB2_BUF_STATE_QUEUED);
+	mutex_unlock(&cam->hw_mutex);
+	return ret;
+}
+
+static void camsv_stop_streaming(struct vb2_queue *q)
+{
+	struct mtk_camsv_dev *cam = vb2_get_drv_priv(q);
+
+	camsv_stop(cam, VB2_BUF_STATE_ERROR);
+	video_device_pipeline_stop(&cam->vdev);
+}
+
+static const struct vb2_ops camsv_vb2_ops = {
+	.queue_setup = camsv_queue_setup,
+	.buf_prepare = camsv_buf_prepare,
+	.buf_queue = camsv_buf_queue,
+	.start_streaming = camsv_start_streaming,
+	.stop_streaming = camsv_stop_streaming,
+};
+
+/* ------------------------------------------------------------------ */
+/* ioctls                                                              */
+
+static int camsv_querycap(struct file *file, void *priv,
+			  struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, CAMSV_MDEV_DRIVER_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "MediaTek MT6878 CAMSV", sizeof(cap->card));
+	return 0;
+}
+
+static int camsv_enum_fmt(struct file *file, void *priv,
+			  struct v4l2_fmtdesc *f)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(camsv_formats); i++) {
+		if (f->mbus_code && camsv_formats[i].mbus_code != f->mbus_code)
+			continue;
+		if (n++ == f->index) {
+			f->pixelformat = camsv_formats[i].fourcc;
+			return 0;
+		}
+	}
+	return -EINVAL;
+}
+
+static int camsv_g_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct mtk_camsv_dev *cam = video_drvdata(file);
+
+	f->fmt.pix = cam->pix;
+	return 0;
+}
+
+static int camsv_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	camsv_try_format(&f->fmt.pix);
+	return 0;
+}
+
+static int camsv_s_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct mtk_camsv_dev *cam = video_drvdata(file);
+
+	if (vb2_is_busy(&cam->queue))
+		return -EBUSY;
+
+	cam->fmt = camsv_try_format(&f->fmt.pix);
+	cam->pix = f->fmt.pix;
+	return 0;
+}
+
+/* VIDIOC_LOG_STATUS: engine and source registers, only while powered */
+static int camsv_log_status(struct file *file, void *priv)
+{
+	struct mtk_camsv_dev *cam = video_drvdata(file);
+
+	mtk_camsv_hw_dump(cam, "log_status");
+	camsv_source_log_status(cam);
+	return 0;
+}
+
+static int camsv_enum_framesizes(struct file *file, void *priv,
+				 struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index || !camsv_find_format(fsize->pixel_format))
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = CAMSV_MIN_WIDTH;
+	fsize->stepwise.max_width = CAMSV_MAX_WIDTH;
+	fsize->stepwise.step_width = CAMSV_WIDTH_ALIGN;
+	fsize->stepwise.min_height = CAMSV_MIN_HEIGHT;
+	fsize->stepwise.max_height = CAMSV_MAX_HEIGHT;
+	fsize->stepwise.step_height = CAMSV_HEIGHT_ALIGN;
+	return 0;
+}
+
+static int camsv_subscribe_event(struct v4l2_fh *fh,
+				 const struct v4l2_event_subscription *sub)
+{
+	switch (sub->type) {
+	case V4L2_EVENT_FRAME_SYNC:
+		return v4l2_event_subscribe(fh, sub, 2, NULL);
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct v4l2_ioctl_ops camsv_ioctl_ops = {
+	.vidioc_querycap = camsv_querycap,
+	.vidioc_enum_fmt_vid_cap = camsv_enum_fmt,
+	.vidioc_g_fmt_vid_cap = camsv_g_fmt,
+	.vidioc_s_fmt_vid_cap = camsv_s_fmt,
+	.vidioc_try_fmt_vid_cap = camsv_try_fmt,
+	.vidioc_enum_framesizes = camsv_enum_framesizes,
+	.vidioc_reqbufs = vb2_ioctl_reqbufs,
+	.vidioc_create_bufs = vb2_ioctl_create_bufs,
+	.vidioc_prepare_buf = vb2_ioctl_prepare_buf,
+	.vidioc_querybuf = vb2_ioctl_querybuf,
+	.vidioc_qbuf = vb2_ioctl_qbuf,
+	.vidioc_dqbuf = vb2_ioctl_dqbuf,
+	.vidioc_expbuf = vb2_ioctl_expbuf,
+	.vidioc_streamon = vb2_ioctl_streamon,
+	.vidioc_streamoff = vb2_ioctl_streamoff,
+	.vidioc_log_status = camsv_log_status,
+	.vidioc_subscribe_event = camsv_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+static const struct v4l2_file_operations camsv_fops = {
+	.owner = THIS_MODULE,
+	.open = v4l2_fh_open,
+	.release = vb2_fop_release,
+	.poll = vb2_fop_poll,
+	.mmap = vb2_fop_mmap,
+	.unlocked_ioctl = video_ioctl2,
+};
+
+/* ------------------------------------------------------------------ */
+/* Media controller                                                    */
+
+static int camsv_link_validate(struct media_link *link)
+{
+	struct video_device *vdev =
+		media_entity_to_video_device(link->sink->entity);
+	struct mtk_camsv_dev *cam = video_get_drvdata(vdev);
+	struct v4l2_subdev_format sfmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = link->source->index,
+	};
+	struct v4l2_subdev *sd;
+	int ret;
+
+	if (!is_media_entity_v4l2_subdev(link->source->entity))
+		return -EINVAL;
+	sd = media_entity_to_v4l2_subdev(link->source->entity);
+
+	ret = v4l2_subdev_call_state_active(sd, pad, get_fmt, &sfmt);
+	if (ret)
+		return ret;
+
+	if (sfmt.format.width != cam->pix.width ||
+	    sfmt.format.height != cam->pix.height ||
+	    sfmt.format.code != cam->fmt->mbus_code) {
+		dev_dbg(cam->dev, "format mismatch %ux%u 0x%04x vs %ux%u 0x%04x\n",
+			sfmt.format.width, sfmt.format.height, sfmt.format.code,
+			cam->pix.width, cam->pix.height, cam->fmt->mbus_code);
+		return -EPIPE;
+	}
+	return 0;
+}
+
+/* Only endpoints of this device's port 0 map to the sink pad. */
+static int camsv_get_fwnode_pad(struct media_entity *entity,
+				struct fwnode_endpoint *endpoint)
+{
+	struct video_device *vdev = media_entity_to_video_device(entity);
+	struct mtk_camsv_dev *cam = video_get_drvdata(vdev);
+	struct fwnode_handle *parent;
+	bool mine;
+
+	parent = fwnode_graph_get_port_parent(endpoint->local_fwnode);
+	mine = parent == dev_fwnode(cam->dev);
+	fwnode_handle_put(parent);
+
+	return mine && endpoint->port == 0 ? 0 : -ENXIO;
+}
+
+static const struct media_entity_operations camsv_entity_ops = {
+	.link_validate = camsv_link_validate,
+	.get_fwnode_pad = camsv_get_fwnode_pad,
+};
+
+static int camsv_notifier_bound(struct v4l2_async_notifier *notifier,
+				struct v4l2_subdev *sd,
+				struct v4l2_async_connection *asc)
+{
+	struct mtk_camsv_dev *cam =
+		container_of(notifier, struct mtk_camsv_dev, notifier);
+
+	return v4l2_create_fwnode_links_to_pad(sd, &cam->pad,
+					       MEDIA_LNK_FL_ENABLED |
+					       MEDIA_LNK_FL_IMMUTABLE);
+}
+
+static int camsv_notifier_complete(struct v4l2_async_notifier *notifier)
+{
+	struct mtk_camsv_dev *cam =
+		container_of(notifier, struct mtk_camsv_dev, notifier);
+
+	return v4l2_device_register_subdev_nodes(&cam->v4l2_dev);
+}
+
+static const struct v4l2_async_notifier_operations camsv_notifier_ops = {
+	.bound = camsv_notifier_bound,
+	.complete = camsv_notifier_complete,
+};
+
+static int camsv_register_notifier(struct mtk_camsv_dev *cam)
+{
+	struct v4l2_async_connection *asc;
+	struct fwnode_handle *ep;
+	int ret;
+
+	v4l2_async_nf_init(&cam->notifier, &cam->v4l2_dev);
+	cam->notifier.ops = &camsv_notifier_ops;
+
+	/* the source (seninf) is optional until it has a driver */
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(cam->dev), 0, 0,
+					     FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!ep)
+		return 0;
+
+	asc = v4l2_async_nf_add_fwnode_remote(&cam->notifier, ep,
+					      struct v4l2_async_connection);
+	fwnode_handle_put(ep);
+	if (IS_ERR(asc)) {
+		ret = PTR_ERR(asc);
+		goto err_cleanup;
+	}
+
+	ret = v4l2_async_nf_register(&cam->notifier);
+	if (ret)
+		goto err_cleanup;
+	return 0;
+
+err_cleanup:
+	v4l2_async_nf_cleanup(&cam->notifier);
+	return ret;
+}
+
+int mtk_camsv_video_register(struct mtk_camsv_dev *cam)
+{
+	struct video_device *vdev = &cam->vdev;
+	struct vb2_queue *q = &cam->queue;
+	int ret;
+
+	INIT_DELAYED_WORK(&cam->dump_work, camsv_dump_work);
+
+	cam->pix.pixelformat = camsv_formats[0].fourcc;
+	cam->pix.width = 1920;
+	cam->pix.height = 1080;
+	cam->fmt = camsv_try_format(&cam->pix);
+
+	cam->mdev.dev = cam->dev;
+	strscpy(cam->mdev.model, "MediaTek MT6878 CAMSV", sizeof(cam->mdev.model));
+	strscpy(cam->mdev.driver_name, CAMSV_MDEV_DRIVER_NAME,
+		sizeof(cam->mdev.driver_name));
+	media_device_init(&cam->mdev);
+	cam->v4l2_dev.mdev = &cam->mdev;
+
+	ret = v4l2_device_register(cam->dev, &cam->v4l2_dev);
+	if (ret)
+		goto err_mdev;
+
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_MMAP | VB2_DMABUF;
+	q->drv_priv = cam;
+	q->buf_struct_size = sizeof(struct mtk_camsv_buffer);
+	q->ops = &camsv_vb2_ops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC |
+			     V4L2_BUF_FLAG_TSTAMP_SRC_SOE;
+	q->lock = &cam->vlock;
+	q->dev = cam->dev;
+	q->min_queued_buffers = 1;
+	ret = vb2_queue_init(q);
+	if (ret)
+		goto err_v4l2;
+
+	cam->pad.flags = MEDIA_PAD_FL_SINK | MEDIA_PAD_FL_MUST_CONNECT;
+	vdev->entity.ops = &camsv_entity_ops;
+	ret = media_entity_pads_init(&vdev->entity, 1, &cam->pad);
+	if (ret)
+		goto err_v4l2;
+
+	strscpy(vdev->name, dev_name(cam->dev), sizeof(vdev->name));
+	vdev->fops = &camsv_fops;
+	vdev->ioctl_ops = &camsv_ioctl_ops;
+	vdev->v4l2_dev = &cam->v4l2_dev;
+	vdev->queue = q;
+	vdev->lock = &cam->vlock;
+	vdev->release = video_device_release_empty;
+	vdev->vfl_dir = VFL_DIR_RX;
+	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING |
+			    V4L2_CAP_IO_MC;
+	video_set_drvdata(vdev, cam);
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_entity;
+
+	ret = camsv_register_notifier(cam);
+	if (ret)
+		goto err_video;
+
+	ret = media_device_register(&cam->mdev);
+	if (ret)
+		goto err_notifier;
+	return 0;
+
+err_notifier:
+	v4l2_async_nf_unregister(&cam->notifier);
+	v4l2_async_nf_cleanup(&cam->notifier);
+err_video:
+	vb2_video_unregister_device(vdev);
+err_entity:
+	media_entity_cleanup(&vdev->entity);
+err_v4l2:
+	v4l2_device_unregister(&cam->v4l2_dev);
+err_mdev:
+	media_device_cleanup(&cam->mdev);
+	return ret;
+}
+
+void mtk_camsv_video_unregister(struct mtk_camsv_dev *cam)
+{
+	cancel_delayed_work_sync(&cam->dump_work);
+	media_device_unregister(&cam->mdev);
+	v4l2_async_nf_unregister(&cam->notifier);
+	v4l2_async_nf_cleanup(&cam->notifier);
+	vb2_video_unregister_device(&cam->vdev);
+	media_entity_cleanup(&cam->vdev.entity);
+	v4l2_device_unregister(&cam->v4l2_dev);
+	media_device_cleanup(&cam->mdev);
+}
