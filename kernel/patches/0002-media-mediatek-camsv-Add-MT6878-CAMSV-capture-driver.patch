+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_MEDIATEK_CAMSV
+	tristate "MediaTek MT6878 CAMSV capture driver"
+	depends on V4L_PLATFORM_DRIVERS
+	depends on VIDEO_DEV
+	select MEDIA_CONTROLLER
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on PM
+	select MFD_SYSCON
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_FWNODE
+	select VIDEO_V4L2_SUBDEV_API
+	select VIDEO_MEDIATEK_CAMSV_CQ
+	help
+	  Support for the CAMSV ("camera simple") capture engine of the
+	  MediaTek MT6878 SoC. It writes the image of a sensor interface
+	  (seninf) tag straight to memory and exposes it as a V4L2 video
+	  capture node.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mtk-camsv-mt6878.
+
+config VIDEO_MEDIATEK_CAMSV_CQ
+	tristate
+
+config VIDEO_MEDIATEK_CAMSV_CQ_KUNIT_TEST
+	tristate "KUnit tests for the MediaTek CAMSV CQ builder" if !KUNIT_ALL_TESTS
+	depends on KUNIT && VIDEO_MEDIATEK_CAMSV_CQ
+	default KUNIT_ALL_TESTS
+	help
+	  Unit tests of the CAMSV command queue builder (descriptor format,
+	  splitting, alignment, composition and the safe profile checks).
+
+	  If unsure, say N.
