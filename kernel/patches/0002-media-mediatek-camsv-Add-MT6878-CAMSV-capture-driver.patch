+	KUNIT_CASE(cq_test_compressed),
+	KUNIT_CASE(cq_test_ring),
+	KUNIT_CASE(cq_test_repeat_commit),
+	KUNIT_CASE(cq_test_scenario_320a),
+	KUNIT_CASE(cq_test_shared_cache),
+	KUNIT_CASE(cq_test_enomem_injection),
+	KUNIT_CASE(cq_test_single_rejects),
+	{}
+};
+
+static struct kunit_suite camsv_cq_test_suite = {
+	.name = "mtk-camsv-cq",
+	.test_cases = camsv_cq_test_cases,
+};
+
+kunit_test_suite(camsv_cq_test_suite);
