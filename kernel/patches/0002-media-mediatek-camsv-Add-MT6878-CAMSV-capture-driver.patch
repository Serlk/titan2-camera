+#ifndef _MTK_CAMSV_H
+#define _MTK_CAMSV_H
+
+#include <linux/atomic.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/interrupt.h>
+#include <linux/kfifo.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+#include <media/media-device.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-dev.h>
+#include <media/v4l2-device.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "mtk-camsv-cq.h"
+#include "mtk-camsv-regs.h"
+
+#define CAMSV_DRV_NAME			"mtk-camsv-mt6878"
+/* media_device_info.driver and v4l2_capability.driver hold 15 characters */
+#define CAMSV_MDEV_DRIVER_NAME		"mtk-camsv"
+
+#define CAMSV_NUM_IRQS			4
+#define CAMSV_NUM_CLKS			8
+#define CAMSV_MAX_HW_ID			5	/* camsv-id 0..5 -> h 3..8 */
+
+/*
+ * The single tag used for a plain RAW image (ISP7SP "normal" tag table).
+ * TODO: tag, group order and pixel mode of the factory single
+ * exposure capture on Titan 2 are not in the specification.
+ */
+#define CAMSV_IMG_TAG			2
+#define CAMSV_IMG_TAG_ORDER		0
+#define CAMSV_PIXEL_MODE		3	/* 8 pixels per clock */
+
+/* CQ memory: one slot per job in flight. */
+#define CAMSV_CQ_SLOTS			4
+#define CAMSV_CQ_SLOT_SIZE		SZ_4K
+
+#define CAMSV_EVENT_FIFO_SIZE		16
+
+/*
+ * Module parameter "debug" (mtk_camsv_debug):
+ * CAMSV_DBG_CQ: the CQ area, every job's list address, length and output
+ *	buffer, a decode of each list and the CQ address registers read
+ *	back after the launch;
+ * CAMSV_DBG_DUMP: a register dump of the engine and of the source
+ *	(log_status) at stream start, one second later, on a first-CQ
+ *	timeout and at stream stop. Status registers are read (whether a
+ *	read clears them is not known) and the frame size monitor selector
+ *	is written; nothing else is changed.
+ */
+#define CAMSV_DBG_CQ			BIT(0)
+#define CAMSV_DBG_DUMP			BIT(1)
+#define CAMSV_DUMP_DELAY_MS		1000
+
+extern unsigned int mtk_camsv_debug;
+
+#define CAMSV_CQ_AREA_SIZE		(CAMSV_CQ_SLOTS * CAMSV_CQ_SLOT_SIZE)
+
+enum mtk_camsv_irq {
+	CAMSV_IRQ_DONE,
+	CAMSV_IRQ_ERR,
+	CAMSV_IRQ_SOF,
+	CAMSV_IRQ_CQ_DONE,
+};
+
+/* Event classes carried by a snapshot (bit mask). */
+#define CAMSV_EV_DONE			BIT(0)	/* group done */
+#define CAMSV_EV_DROP			BIT(1)	/* enqueue loss reported at SOF */
+#define CAMSV_EV_SOF			BIT(2)
+#define CAMSV_EV_ERROR			BIT(3)
+#define CAMSV_EV_SETTING_DONE		BIT(4)	/* last expected CQ done */
+#define CAMSV_EV_INNER			BIT(5)	/* job settings reached inner */
+
+/**
+ * struct mtk_camsv_event - IRQ snapshot passed to the threaded consumer
+ * @ts_boot_ns: ktime_get_boottime_ns() at the IRQ
+ * @ts_mono_ns: ktime_get_ns() at the IRQ (V4L2 timestamps)
+ * @type: CAMSV_EV_* mask
+ * @cookie_outer: outer cookie of the first tag
+ * @cookie_inner: active cookie of the first tag
+ * @sof_tags: tags with a start of frame
+ * @done_tags: tags covered by the done groups
+ * @drop_tags: tags with an enqueue loss
+ * @err_tags: tags with an error
+ * @err_status: raw error status
+ * @groups: active group masks (SOF only)
+ * @first_tag: first tag mask (SOF only)
+ * @last_tag: last tag mask (SOF only)
+ * @fbc_empty: all active tags have an empty FBC (SOF of the last tag)
+ * @frame_count: extended frame counter before this SOF's update
+ */
+struct mtk_camsv_event {
+	u64 ts_boot_ns;
+	u64 ts_mono_ns;
+	u32 type;
+	u32 cookie_outer;
+	u32 cookie_inner;
+	u32 sof_tags;
+	u32 done_tags;
+	u32 drop_tags;
+	u32 err_tags;
+	u32 err_status;
+	u32 groups[CAMSV_NUM_GROUPS];
+	u32 first_tag;
+	u32 last_tag;
+	u32 frame_count;
+	bool fbc_empty;
+};
+
+/* Cookie automaton; both start at -1. */
+struct mtk_camsv_fsm {
+	s32 active_cookie;
+	s32 completed_cookie;
+};
+
+struct mtk_camsv_format {
+	u32 fourcc;
+	u32 mbus_code;
+	u32 out_fmt;		/* protocol code of the memory format */
+	u32 in_fmt;		/* protocol code of the bus format */
+	u8 bpp;			/* bits per pixel in memory */
+};
+
+struct mtk_camsv_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+	u32 cookie;
+	int slot;
+	bool error;
+	bool started;
+	u64 ts_ns;
+	u32 sequence;
+};
+
+struct mtk_camsv_dev {
+	struct device *dev;
+	unsigned int hw_id;		/* mediatek,camsv-id */
+	u32 cq_hw_id;			/* h = hw_id + 3 */
+	unsigned long engine_mask;	/* bit used in the pending masks */
+
+	void __iomem *base;		/* C: central, outer */
+	void __iomem *base_dma;		/* D: DMA, outer */
+	void __iomem *base_scq;		/* Q: command queue */
+	void __iomem *inner;		/* I: central, active */
+	void __iomem *inner_dma;
+	void __iomem *inner_scq;
+	struct regmap *camsys;		/* T: camsys main reset */
+
+	int irq[CAMSV_NUM_IRQS];
+	atomic_t irq_count[CAMSV_NUM_IRQS];	/* hard IRQ entries */
+	bool irqs_enabled;
+	struct clk_bulk_data clks[CAMSV_NUM_CLKS];
+
+	/*
+	 * Producer side, shared by the four hard IRQ handlers and the code
+	 * that binds a job: @hw_lock. The kfifo has one writer at a time
+	 * (under @hw_lock) and one reader (the consumer under @hw_mutex).
+	 */
+	raw_spinlock_t hw_lock;
+	DECLARE_KFIFO(events, struct mtk_camsv_event, CAMSV_EVENT_FIFO_SIZE);
+	atomic_t fifo_overflow;
+	u32 first_tag;
+	u32 last_tag;
+	u32 active_groups[CAMSV_NUM_GROUPS];
+	u32 tg_cnt;
+	bool ref_bound;
+	u32 expected_cookie;
+	atomic_long_t pending_cq;
+	atomic_long_t pending_inner;
+
+	/* Consumer side and job control: @hw_mutex. */
+	struct mutex hw_mutex;
+	bool active;			/* events are consumed */
+	bool wedged;			/* a stop reset timed out */
+	struct mtk_camsv_fsm fsm;
+	u32 used_tags;
+	u32 dropped_tags;
+	u32 handled_tags;
+	u32 enabled_tags;
+	/*
+	 * Frame number of the stream: counts the starts of frame of the first
+	 * tag from 0 at stream on. Buffer sequence and FRAME_SYNC event.
+	 */
+	u32 sof_seq;
+	unsigned int streaming_count;
+	unsigned int expected_count;
+	struct completion setting_done;
+	struct camsv_cq_state cq_state;
+	struct camsv_cq_state cq_scratch;
+	void *cq_cpu;
+	dma_addr_t cq_dma;
+	struct page *cq_page;		/* set: streaming mapping (cq_low) */
+	unsigned long cq_slots;
+	u32 next_cookie;
+	dma_addr_t last_out_dma;	/* output buffer of the last launch */
+	struct delayed_work dump_work;
+
+	/* Buffer lists: @buf_lock. */
+	spinlock_t buf_lock;
+	struct list_head pending_bufs;
+	struct list_head inflight_bufs;
+	unsigned int num_inflight;
+
+	/* V4L2 / media controller */
+	struct media_device mdev;
+	struct v4l2_device v4l2_dev;
+	struct video_device vdev;
+	struct media_pad pad;
+	struct media_pipeline pipe;
+	struct vb2_queue queue;
+	struct mutex vlock;		/* serializes the video node */
+	struct v4l2_async_notifier notifier;
+	struct v4l2_subdev *source;
+	u32 source_pad;
+	bool source_streaming;
+	struct v4l2_pix_format pix;
+	const struct mtk_camsv_format *fmt;
+};
