diff --git a/drivers/media/platform/mediatek/camsv/mtk-camsv-cq-test.c b/drivers/media/platform/mediatek/camsv/mtk-camsv-cq-test.c
new file mode 100644
index 000000000000..f05e713a0daa
--- /dev/null
+++ b/drivers/media/platform/mediatek/camsv/mtk-camsv-cq-test.c
@@ -0,0 +1,728 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * KUnit tests for the MT6878 CAMSV CQ builder.
+ *
+ * The vectors follow the test cases of the specification the builder
+ * was written from.
+ *
+ * Copyright (c) 2026 serlk
+ */
+
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "mtk-camsv-cq.h"
+
+#define AREA_DMA	0x40000000ULL
+#define AREA_SIZE	4096
+
+#define C3		0x1a100000
+#define D3		0x1a110000
+#define C4		0x1a101000
+
+struct cq_pair {
+	u32 reg;
+	u32 val;
+	u32 desc;	/* index of the descriptor that carried it */
+};
+
+static u8 *cq_area(struct kunit *test, size_t size)
+{
+	u8 *p = kunit_kzalloc(test, size, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, p);
+	return p;
+}
+
+static u32 desc_ctrl(const u8 *cpu, size_t off)
+{
+	return get_unaligned_le32(cpu + off);
+}
+
+static u64 desc_data(const u8 *cpu, size_t off)
+{
+	return get_unaligned_le64(cpu + off + 4);
+}
+
+/*
+ * Expand the list at @off (at most @len bytes, stops at END) into
+ * register/value pairs. Returns the number of pairs, or -1 if no END was
+ * found within @len.
+ */
+static int cq_collect(struct kunit *test, u8 *cpu, dma_addr_t dma,
+		      size_t size, size_t off, size_t len,
+		      struct cq_pair *out, int max)
+{
+	struct camsv_cq_builder view;
+	size_t pos;
+	int n = 0;
+	u32 d = 0;
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&view, cpu, dma, size), 0);
+
+	for (pos = off; pos + CAMSV_CQ_DESC_SIZE <= off + len;
+	     pos += CAMSV_CQ_DESC_SIZE, d++) {
+		struct camsv_cq_cmd cmd;
+		u32 k;
+
+		KUNIT_ASSERT_EQ(test, camsv_cq_decode(&view, pos, &cmd), 0);
+		if (cmd.op == CAMSV_CQ_OP_END) {
+			KUNIT_EXPECT_EQ(test, cmd.data, 0ULL);
+			return n;
+		}
+		KUNIT_ASSERT_EQ(test, cmd.op, (u32)CAMSV_CQ_OP_WRITE);
+		for (k = 0; k < cmd.count; k++) {
+			u8 *v = camsv_cq_dma_to_cpu(&view, cmd.data + 4 * k);
+
+			KUNIT_ASSERT_NOT_NULL(test, v);
+			KUNIT_ASSERT_LT(test, n, max);
+			out[n].reg = cmd.reg + 4 * k;
+			out[n].val = get_unaligned_le32(v);
+			out[n].desc = d;
+			n++;
+		}
+	}
+	return -1;
+}
+
+static int cq_find(const struct cq_pair *p, int n, u32 reg, int from)
+{
+	int i;
+
+	for (i = from; i < n; i++)
+		if (p[i].reg == reg)
+			return i;
+	return -1;
+}
+
+/* one value at 0x1a100548 */
+static void cq_test_single_write(struct kunit *test)
+{
+	struct camsv_cq_builder b;
+	u8 *cpu = cq_area(test, 64);
+	u32 val = 0xdeadbeef;
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, 64), 0);
+	KUNIT_ASSERT_EQ(test, camsv_cq_write(&b, 0x1a100548, &val, 1), 0);
+
+	KUNIT_EXPECT_EQ(test, desc_ctrl(cpu, 0), 0x80000548U);
+	KUNIT_EXPECT_EQ(test, desc_data(cpu, 0), AREA_DMA + 60);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(cpu + 60), 0xdeadbeefU);
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)12);
+	KUNIT_EXPECT_EQ(test, camsv_cq_value_bytes(&b), (size_t)4);
+	KUNIT_EXPECT_FALSE(test, b.failed);
+}
+
+/* 511 values in one descriptor, 512 in two */
+static void cq_test_split(struct kunit *test)
+{
+	struct camsv_cq_builder b;
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	u32 *vals;
+
+	vals = kunit_kcalloc(test, 512, sizeof(*vals), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, vals);
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, AREA_SIZE), 0);
+	KUNIT_ASSERT_EQ(test, camsv_cq_write(&b, 0x1a100548, vals, 511), 0);
+	KUNIT_EXPECT_EQ(test, desc_ctrl(cpu, 0), 0x81fe0548U);
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)12);
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, AREA_SIZE), 0);
+	KUNIT_ASSERT_EQ(test, camsv_cq_write(&b, 0x1a100548, vals, 512), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)24);
+	KUNIT_EXPECT_EQ(test, desc_ctrl(cpu, 0), 0x81fe0548U);
+	/* second chunk: register + 2044, one value */
+	KUNIT_EXPECT_EQ(test, desc_ctrl(cpu, 12), 0x80000548U + 2044);
+	KUNIT_EXPECT_EQ(test, desc_data(cpu, 12), desc_data(cpu, 0) + 2044);
+}
+
+/* a 16-byte area is full after one copied value */
+static void cq_test_area_16(struct kunit *test)
+{
+	struct camsv_cq_builder b;
+	u8 *cpu = cq_area(test, 16);
+	u32 val = 1;
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, 16), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write(&b, C3 + 0x548, &val, 1), 0);
+	KUNIT_EXPECT_EQ(test, b.desc_end, b.payload_begin);
+	KUNIT_EXPECT_EQ(test, camsv_cq_add_end(&b), -ENOMEM);
+	/* the previous write is kept */
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)12);
+	KUNIT_EXPECT_EQ(test, desc_ctrl(cpu, 0), 0x80000548U);
+}
+
+/* a 12-byte area fails at the descriptor, the value bytes stay used */
+static void cq_test_area_12(struct kunit *test)
+{
+	struct camsv_cq_builder b;
+	u8 *cpu = cq_area(test, 12);
+	u32 val = 1;
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, 12), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write(&b, C3 + 0x548, &val, 1), -ENOMEM);
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_value_bytes(&b), (size_t)4);
+	KUNIT_EXPECT_TRUE(test, b.failed);
+}
+
+/* zero lengths */
+static void cq_test_zero_length(struct kunit *test)
+{
+	struct camsv_cq_builder b;
+	u8 *cpu = cq_area(test, 64);
+	u32 val = 0;
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, 64), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write_ref(&b, C3, AREA_DMA, 0), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write_pairs(&b, &val, 0), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write(&b, C3, &val, 0), -ENOMEM);
+	KUNIT_EXPECT_NULL(test, camsv_cq_reserve(&b, 0));
+
+	KUNIT_EXPECT_EQ(test, camsv_cq_builder_init(&b, NULL, AREA_DMA, 64), -EINVAL);
+	KUNIT_EXPECT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, 0), -EINVAL);
+}
+
+/* next list on a 16-byte boundary, gap untouched */
+static void cq_test_alignment(struct kunit *test)
+{
+	static const size_t gap[] = { 0, 12, 24, 36 };
+	u8 *cpu = cq_area(test, 128);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(gap); i++) {
+		struct camsv_cq_builder b;
+		u8 copy[128];
+
+		memset(cpu, 0xa5, 128);
+		memcpy(copy, cpu, sizeof(copy));
+		KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu,
+							    AREA_DMA + 4 * i, 128), 0);
+		KUNIT_EXPECT_EQ(test, camsv_cq_align_next(&b), 0);
+		KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), gap[i]);
+		KUNIT_EXPECT_MEMEQ(test, cpu, copy, sizeof(copy));
+	}
+}
+
+/* pairs A, A+4, A+12 make two runs; order and duplicates kept */
+static void cq_test_pairs(struct kunit *test)
+{
+	const u32 a = C3 + 0x548;
+	const u32 pairs[] = { a, 10, a + 4, 11, a + 12, 12 };
+	const u32 dup[] = { a, 1, a, 2 };
+	struct camsv_cq_builder b;
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	u64 data;
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, AREA_SIZE), 0);
+	KUNIT_ASSERT_EQ(test, camsv_cq_write_pairs(&b, pairs, ARRAY_SIZE(pairs)), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)24);
+
+	KUNIT_EXPECT_EQ(test, desc_ctrl(cpu, 0), 0x80010548U);
+	data = desc_data(cpu, 0) - AREA_DMA;
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(cpu + data), 10U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(cpu + data + 4), 11U);
+
+	KUNIT_EXPECT_EQ(test, desc_ctrl(cpu, 12), 0x80000554U);
+	data = desc_data(cpu, 12) - AREA_DMA;
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(cpu + data), 12U);
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, AREA_SIZE), 0);
+	KUNIT_ASSERT_EQ(test, camsv_cq_write_pairs(&b, dup, ARRAY_SIZE(dup)), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)24);
+
+	/* odd word count has no contract */
+	KUNIT_EXPECT_EQ(test, camsv_cq_write_pairs(&b, pairs, 3), -EINVAL);
+}
+
+/* Safe profile: no aliasing of registers outside the descriptor window */
+static void cq_test_reject_window(struct kunit *test)
+{
+	struct camsv_cq_builder b;
+	u8 *cpu = cq_area(test, 64);
+	u32 val = 0;
+
+	KUNIT_ASSERT_EQ(test, camsv_cq_builder_init(&b, cpu, AREA_DMA, 64), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write(&b, 0x1a200000, &val, 1), -EINVAL);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write(&b, 0x19fffffc, &val, 1), -EINVAL);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write(&b, C3 + 2, &val, 1), -EINVAL);
+	KUNIT_EXPECT_EQ(test, camsv_cq_write_ref(&b, 0x1a1ffffc, AREA_DMA, 2),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, camsv_cq_desc_bytes(&b), (size_t)0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_value_bytes(&b), (size_t)0);
+}
+
+static void cq_test_formats(struct kunit *test)
+{
+	static const struct {
+		u32 in, hw;
+		bool unpack;
+	} tbl[] = {
+		{ 0x00, 0, false }, { 0x4c, 0, false },
+		{ 0x01, 1, false }, { 0x4d, 1, false }, { 0x05, 1, true },
+		{ 0x02, 2, false }, { 0x4e, 2, false }, { 0x06, 2, true },
+		{ 0x03, 4, false }, { 0x4f, 4, false }, { 0x07, 4, true },
+		{ 0x0f, 3, false }, { 0x12, 3, false },
+		{ 0x50, 8, false }, { 0x04, 0, false }, { 0x99, 0, false },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(tbl); i++) {
+		bool unpack;
+
+		KUNIT_EXPECT_EQ(test, camsv_cq_format_hw(tbl[i].in, &unpack),
+				tbl[i].hw);
+		KUNIT_EXPECT_EQ(test, unpack, tbl[i].unpack);
+	}
+	KUNIT_EXPECT_EQ(test, camsv_cq_format_word(0x4c), 0x06000000U);
+	KUNIT_EXPECT_EQ(test, camsv_cq_format_word(0x4d), 0x06810001U);
+	KUNIT_EXPECT_EQ(test, camsv_cq_format_word(0x4e), 0x06820002U);
+	KUNIT_EXPECT_EQ(test, camsv_cq_format_word(0x4f), 0x06830004U);
+	KUNIT_EXPECT_EQ(test, camsv_cq_format_word(0x05), 0x41U);
+}
+
+/* One channel (h = 3), tag 2, first-frame configuration plus one frame. */
+static void cq_setup_single(struct camsv_cq_state *s, u32 in_fmt,
+			    u32 out_fmt, u16 w, u16 h, u16 stride, u64 dma)
+{
+	struct camsv_cq_tag cfg = {
+		.tag_id = 2,
+		.tag_order = 0,
+		.pixel_mode = 3,
+		.input_format = in_fmt,
+		.crop_width = w,
+		.crop_height = h,
+	};
+
+	camsv_cq_state_init(s);
+	camsv_cq_config_begin(s);
+	WARN_ON(camsv_cq_config_add(s, 0, 0, 3, &cfg, true, false, false));
+	camsv_cq_frame_begin(s, 0x12345);
+	WARN_ON(camsv_cq_frame_set_output(s, 3, 2, out_fmt, stride, dma,
+					  (u64)stride * h));
+}
+
+static void cq_test_full_sequence(struct kunit *test)
+{
+	static const struct {
+		u32 reg, val;
+	} exp[] = {
+		/* configuration */
+		{ C3 + 0x5c8, 0x0fa00000 }, { C3 + 0x5cc, 0x0bb80000 },
+		{ C3 + 0x5d4, 1 }, { C3 + 0x5dc, 1 }, { C3 + 0x5c0, 0x8000 },
+		{ D3 + 0x290, 0x13900010 }, { D3 + 0xa90, 0x10 },
+		/* frame */
+		{ C3 + 0x5d4, 8 }, { D3 + 0x290, 0x13900010 },
+		{ D3 + 0x280, 0x23456000 }, { D3 + 0x284, 1 },
+		{ D3 + 0x298, 0 }, { D3 + 0x29c, 0 }, { D3 + 0x2a0, 0 },
+		{ D3 + 0x2a4, 0 }, { C3 + 0x5c0, 0x8080 },
+		/* common configuration */
+		{ C3 + 0x140, 1 }, { C3 + 0x18c, 3 }, { C3 + 0x170, 0x20 },
+		{ C3 + 0x144, 0 }, { C3 + 0x040, 4 }, { C3 + 0x044, 4 },
+		{ D3 + 0xf30, 0x404 }, { C3 + 0x344, 0xf0000 },
+		{ C3 + 0x34c, 0x1c001 }, { C3 + 0x35c, 0x400 },
+		{ C3 + 0x36c, 0x11111111 },
+		/* routing */
+		{ C3 + 0x1d4, 0 }, { C3 + 0x1d8, 0 },
+		/* grouping, first frame: no mode write */
+		{ C3 + 0x1b8, 4 }, { C3 + 0x1bc, 0 }, { C3 + 0x1c0, 0 },
+		{ C3 + 0x1c4, 0 }, { C3 + 0x1cc, 4 }, { C3 + 0x1c8, 4 },
+		/* cookies */
+		{ C3 + 0x57c, 0x12345 }, { C3 + 0x5bc, 0x12345 },
+		{ C3 + 0x5fc, 0x12345 }, { C3 + 0x63c, 0x12345 },
+		{ C3 + 0x67c, 0x12345 }, { C3 + 0x6bc, 0x12345 },
+		{ C3 + 0x6fc, 0x12345 }, { C3 + 0x73c, 0x12345 },
+	};
+	struct camsv_cq_state *s, *scratch;
+	struct cq_pair got[64];
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	u32 off, len;
+	unsigned int i;
+	int n;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	scratch = kunit_kzalloc(test, sizeof(*scratch), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, scratch);
+
+	cq_setup_single(s, CAMSV_CQ_FMT_BAYER10, CAMSV_CQ_FMT_BAYER10_MIPI,
+			4000, 3000, 5008, 0x123456000ULL);
+	KUNIT_ASSERT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len), 0);
+	KUNIT_EXPECT_EQ(test, off, 0U);
+	KUNIT_EXPECT_EQ(test, len, (u32)(ARRAY_SIZE(exp) + 1) * 12);
+
+	n = cq_collect(test, cpu, AREA_DMA, AREA_SIZE, off, len, got,
+		       ARRAY_SIZE(got));
+	KUNIT_ASSERT_EQ(test, n, (int)ARRAY_SIZE(exp));
+	for (i = 0; i < ARRAY_SIZE(exp); i++) {
+		KUNIT_EXPECT_EQ_MSG(test, got[i].reg, exp[i].reg, "pair %u", i);
+		KUNIT_EXPECT_EQ_MSG(test, got[i].val, exp[i].val, "pair %u", i);
+		/* every write is its own descriptor */
+		KUNIT_EXPECT_EQ(test, got[i].desc, i);
+	}
+
+	/* flags were consumed, first_frame cleared, caches updated */
+	KUNIT_EXPECT_FALSE(test, s->ch[0].tags[0].config_pending);
+	KUNIT_EXPECT_FALSE(test, s->ch[0].tags[0].frame_pending);
+	KUNIT_EXPECT_FALSE(test, s->ch[0].first_frame);
+	KUNIT_EXPECT_EQ(test, s->ch[0].cached_groups[0], 4U);
+	KUNIT_EXPECT_EQ(test, s->cached_first, 4U);
+	KUNIT_EXPECT_EQ(test, s->cached_last, 4U);
+}
+
+/* compressed output 0x4d, stride 100, height 10 */
+static void cq_test_compressed(struct kunit *test)
+{
+	const u64 dma = 0x80000000ULL;
+	struct camsv_cq_state *s, *scratch;
+	struct cq_pair got[96];
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	u32 off, len;
+	int n, i;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	scratch = kunit_kzalloc(test, sizeof(*scratch), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, scratch);
+
+	cq_setup_single(s, 0x4d, 0x4d, 64, 10, 100, dma);
+	KUNIT_ASSERT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len), 0);
+	n = cq_collect(test, cpu, AREA_DMA, AREA_SIZE, off, len, got,
+		       ARRAY_SIZE(got));
+	KUNIT_ASSERT_GT(test, n, 0);
+
+	i = cq_find(got, n, D3 + 0x280, 0);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, got[i].val, (u32)(dma + 4096));
+
+	i = cq_find(got, n, D3 + 0xa80, 0);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, got[i].val, (u32)(dma + 5136));
+
+	/* geometry from the width, in configuration and frame */
+	i = cq_find(got, n, D3 + 0xa90, 0);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, got[i].val, 0x00100010U);
+	i = cq_find(got, n, D3 + 0xa90, i + 1);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, got[i].val, 0x00100010U);
+
+	i = cq_find(got, n, C3 + 0x5d4, 0);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, got[i].val, 0x06810001U);
+}
+
+/* ring off -> four zero registers; ring on for tag < 4 */
+static void cq_test_ring(struct kunit *test)
+{
+	struct camsv_cq_state *s, *scratch;
+	struct cq_pair got[64];
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	u32 off, len;
+	int n, i;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	scratch = kunit_kzalloc(test, sizeof(*scratch), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, scratch);
+
+	cq_setup_single(s, 1, 1, 640, 480, 800, 0x900000000ULL);
+	KUNIT_ASSERT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len), 0);
+	n = cq_collect(test, cpu, AREA_DMA, AREA_SIZE, off, len, got,
+		       ARRAY_SIZE(got));
+	for (i = 0; i < 4; i++) {
+		int k = cq_find(got, n, D3 + 0x298 + 4 * i, 0);
+
+		KUNIT_ASSERT_GE(test, k, 0);
+		KUNIT_EXPECT_EQ(test, got[k].val, 0U);
+	}
+
+	cq_setup_single(s, 1, 1, 640, 480, 800, 0x900000000ULL);
+	s->ring_enabled = true;
+	s->ring_start_offset = 0x100;
+	KUNIT_ASSERT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len), 0);
+	n = cq_collect(test, cpu, AREA_DMA, AREA_SIZE, off, len, got,
+		       ARRAY_SIZE(got));
+	i = cq_find(got, n, D3 + 0x298, 0);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, got[i].val, 1U);
+	KUNIT_EXPECT_EQ(test, got[i + 1].val, 800U * 480);
+	KUNIT_EXPECT_EQ(test, got[i + 2].val, 0x00000100U);
+	KUNIT_EXPECT_EQ(test, got[i + 3].val, 0x80000009U);
+	/* the 4096 offset only applies to compressed data, not the ring */
+	i = cq_find(got, n, D3 + 0x280, 0);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, got[i].val, 0U);
+}
+
+/* the repeated commit is a second descriptor, not a 2-word write */
+static void cq_test_repeat_commit(struct kunit *test)
+{
+	struct camsv_cq_state *s, *scratch;
+	struct cq_pair got[64];
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	u32 off, len;
+	int n, i;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	scratch = kunit_kzalloc(test, sizeof(*scratch), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, scratch);
+
+	cq_setup_single(s, 1, 1, 640, 480, 800, 0x1000000ULL);
+	s->repeat_commit = true;
+	KUNIT_ASSERT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len), 0);
+	n = cq_collect(test, cpu, AREA_DMA, AREA_SIZE, off, len, got,
+		       ARRAY_SIZE(got));
+
+	i = cq_find(got, n, C3 + 0x5c0, 0);		/* config 0x8000 */
+	i = cq_find(got, n, C3 + 0x5c0, i + 1);		/* frame commit */
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_ASSERT_LT(test, i + 1, n);
+	KUNIT_EXPECT_EQ(test, got[i].val, 0x8080U);
+	KUNIT_EXPECT_EQ(test, got[i + 1].reg, (u32)(C3 + 0x5c0));
+	KUNIT_EXPECT_EQ(test, got[i + 1].val, 0x8080U);
+	KUNIT_EXPECT_NE(test, got[i].desc, got[i + 1].desc);
+}
+
+/* 0x320a is in T and may be in E, never in M */
+static void cq_test_scenario_320a(struct kunit *test)
+{
+	struct camsv_cq_state s;
+
+	camsv_cq_state_init(&s);
+	s.scenario = 0x320a;
+	s.exposure_count = 1;
+	s.previous_exposure_count = 1;
+	KUNIT_EXPECT_TRUE(test, camsv_cq_is_special_order(&s));
+	KUNIT_EXPECT_TRUE(test, camsv_cq_is_special_group(&s));
+	KUNIT_EXPECT_FALSE(test, camsv_cq_is_merged(&s));
+	KUNIT_EXPECT_FALSE(test, camsv_cq_is_exp_change(&s));
+	s.exposure_count = 2;
+	KUNIT_EXPECT_TRUE(test, camsv_cq_is_exp_change(&s));
+
+	s.scenario = 0;
+	s.software_feature = 1;
+	KUNIT_EXPECT_TRUE(test, camsv_cq_is_merged(&s));
+	KUNIT_EXPECT_TRUE(test, camsv_cq_is_special_group(&s));
+	KUNIT_EXPECT_FALSE(test, camsv_cq_is_special_order(&s));
+}
+
+static void cq_setup_two(struct camsv_cq_state *s, bool first)
+{
+	struct camsv_cq_tag a = { .tag_id = 2, .pixel_mode = 3,
+				  .input_format = 1,
+				  .crop_width = 64, .crop_height = 8 };
+	struct camsv_cq_tag b = { .tag_id = 0, .pixel_mode = 3,
+				  .input_format = 1,
+				  .crop_width = 64, .crop_height = 8 };
+
+	camsv_cq_config_begin(s);
+	WARN_ON(camsv_cq_config_add(s, 0, 0, 3, &a, first, false, false));
+	WARN_ON(camsv_cq_config_add(s, 1, 0, 4, &b, first, false, false));
+	camsv_cq_frame_begin(s, 7);
+}
+
+/* the first/last cache is shared by both channels */
+static void cq_test_shared_cache(struct kunit *test)
+{
+	struct camsv_cq_state *s;
+	struct camsv_cq_result res;
+	struct cq_pair got[96];
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	int n;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+
+	camsv_cq_state_init(s);
+	cq_setup_two(s, true);
+	KUNIT_ASSERT_FALSE(test, camsv_cq_compose(s, cpu, AREA_DMA, AREA_SIZE, &res));
+	KUNIT_EXPECT_EQ(test, s->cached_first, 1U);
+	KUNIT_EXPECT_GT(test, res.sv_offset[1], 0U);
+
+	/* second configuration: same groups per channel, suppress allowed */
+	cq_setup_two(s, false);
+	KUNIT_ASSERT_FALSE(test, camsv_cq_compose(s, cpu, AREA_DMA, AREA_SIZE, &res));
+
+	n = cq_collect(test, cpu, AREA_DMA, AREA_SIZE, res.sv_offset[0],
+		       res.sv_size[0], got, ARRAY_SIZE(got));
+	KUNIT_ASSERT_GT(test, n, 0);
+	KUNIT_EXPECT_GE(test, cq_find(got, n, C3 + 0x1b8, 0), 0);
+	n = cq_collect(test, cpu, AREA_DMA, AREA_SIZE, res.sv_offset[1],
+		       res.sv_size[1], got, ARRAY_SIZE(got));
+	KUNIT_ASSERT_GT(test, n, 0);
+	KUNIT_EXPECT_GE(test, cq_find(got, n, C4 + 0x1b8, 0), 0);
+
+	/* control: one channel alone is suppressed the second time */
+	camsv_cq_state_init(s);
+	cq_setup_single(s, 1, 1, 64, 8, 80, 0x1000000ULL);
+	KUNIT_ASSERT_FALSE(test, camsv_cq_compose(s, cpu, AREA_DMA, AREA_SIZE, &res));
+	{
+		struct camsv_cq_tag cfg = { .tag_id = 2, .pixel_mode = 3,
+					    .input_format = 1,
+					    .crop_width = 64, .crop_height = 8 };
+
+		camsv_cq_config_begin(s);
+		KUNIT_ASSERT_EQ(test, camsv_cq_config_add(s, 0, 0, 3, &cfg, false,
+							  false, false), 0);
+	}
+	KUNIT_ASSERT_FALSE(test, camsv_cq_compose(s, cpu, AREA_DMA, AREA_SIZE, &res));
+	n = cq_collect(test, cpu, AREA_DMA, AREA_SIZE, res.sv_offset[0],
+		       res.sv_size[0], got, ARRAY_SIZE(got));
+	KUNIT_ASSERT_GT(test, n, 0);
+	KUNIT_EXPECT_LT(test, cq_find(got, n, C3 + 0x1b8, 0), 0);
+}
+
+/*
+ * out of space at every step. The composition fails, the flags it
+ * reached are consumed and first_frame is cleared; the kernel wrapper
+ * returns an error and leaves the session untouched.
+ */
+static void cq_test_enomem_injection(struct kunit *test)
+{
+	struct camsv_cq_state *s, *ref, *scratch;
+	struct camsv_cq_result res;
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	const size_t need = 44 * 12 + 43 * 4;
+	u32 off, len;
+	size_t size;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	ref = kunit_kzalloc(test, sizeof(*ref), GFP_KERNEL);
+	scratch = kunit_kzalloc(test, sizeof(*scratch), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, ref);
+	KUNIT_ASSERT_NOT_NULL(test, scratch);
+
+	for (size = 4; size < need; size += 4) {
+		cq_setup_single(s, 1, 0x50, 4000, 3000, 5008, 0x1000000ULL);
+		*ref = *s;
+
+		KUNIT_EXPECT_EQ_MSG(test, camsv_cq_compose_single(s, scratch, cpu,
+								  AREA_DMA, size,
+								  &off, &len),
+				    -ENOMEM, "size %zu", size);
+		KUNIT_EXPECT_MEMEQ(test, s, ref, sizeof(*s));
+
+		KUNIT_EXPECT_TRUE_MSG(test, camsv_cq_compose(s, cpu, AREA_DMA,
+							     size, &res),
+				      "size %zu", size);
+		KUNIT_EXPECT_FALSE(test, s->ch[0].tags[0].config_pending);
+		KUNIT_EXPECT_FALSE(test, s->ch[0].tags[0].frame_pending);
+		KUNIT_EXPECT_FALSE(test, s->ch[0].first_frame);
+	}
+
+	cq_setup_single(s, 1, 0x50, 4000, 3000, 5008, 0x1000000ULL);
+	KUNIT_EXPECT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      need, &off, &len), 0);
+	KUNIT_EXPECT_EQ(test, len, 44U * 12);
+}
+
+/* Kernel profile: one device, channel 0, standalone list */
+static void cq_test_single_rejects(struct kunit *test)
+{
+	struct camsv_cq_tag cfg = { .tag_id = 2, .pixel_mode = 3,
+				    .input_format = 1,
+				    .crop_width = 64, .crop_height = 8 };
+	struct camsv_cq_state *s, *scratch;
+	u8 *cpu = cq_area(test, AREA_SIZE);
+	u32 off, len;
+
+	s = kunit_kzalloc(test, sizeof(*s), GFP_KERNEL);
+	scratch = kunit_kzalloc(test, sizeof(*scratch), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, scratch);
+
+	/* channel 1 only */
+	camsv_cq_state_init(s);
+	camsv_cq_config_begin(s);
+	KUNIT_ASSERT_EQ(test, camsv_cq_config_add(s, 1, 0, 4, &cfg, true,
+						  false, false), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len),
+			-EINVAL);
+
+	/* two non-empty channels */
+	camsv_cq_state_init(s);
+	cq_setup_two(s, true);
+	KUNIT_EXPECT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len),
+			-EINVAL);
+
+	/* merged two-channel layout is rejected by the state check */
+	s->scenario = 0x101;
+	KUNIT_EXPECT_EQ(test, camsv_cq_check_state(s), -EINVAL);
+
+	/* merged list on one channel: nothing would terminate it */
+	cq_setup_single(s, 1, 1, 64, 8, 80, 0x1000000ULL);
+	s->scenario = 0x101;
+	KUNIT_EXPECT_EQ(test, camsv_cq_check_state(s), 0);
+	KUNIT_EXPECT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len),
+			-EINVAL);
+
+	/* unsupported hardware id and tag */
+	KUNIT_EXPECT_EQ(test, camsv_cq_config_add(s, 0, 0, 9, &cfg, true,
+						  false, false), -EINVAL);
+	cq_setup_single(s, 1, 1, 64, 8, 80, 0x1000000ULL);
+	s->ch[0].channel_id = 2;
+	KUNIT_EXPECT_EQ(test, camsv_cq_check_state(s), -EINVAL);
+	cq_setup_single(s, 1, 1, 64, 8, 80, 0x1000000ULL);
+	s->ch[0].tags[0].tag_id = 8;
+	KUNIT_EXPECT_EQ(test, camsv_cq_check_state(s), -EINVAL);
+
+	/* geometry overflow */
+	cq_setup_single(s, 1, 1, 64, 8, 80, 0x1000000ULL);
+	s->ch[0].tags[0].crop_x = 0xfff0;
+	KUNIT_EXPECT_EQ(test, camsv_cq_check_state(s), -EINVAL);
+
+	/* nothing pending: empty answer, no error */
+	cq_setup_single(s, 1, 1, 64, 8, 80, 0x1000000ULL);
+	KUNIT_ASSERT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len), 0);
+	KUNIT_ASSERT_EQ(test, camsv_cq_compose_single(s, scratch, cpu, AREA_DMA,
+						      AREA_SIZE, &off, &len), 0);
+	KUNIT_EXPECT_EQ(test, len, 0U);
+}
+
+static struct kunit_case camsv_cq_test_cases[] = {
