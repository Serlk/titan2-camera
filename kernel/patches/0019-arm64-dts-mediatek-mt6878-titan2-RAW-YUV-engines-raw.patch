+++ b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-jpeg.dts
@@ -1,27 +1,26 @@
 // SPDX-License-Identifier: (GPL-2.0-only OR MIT)
 /*
- * Titan 2: JPEG encoder bring-up without the IOMMU. Same as -all, plus the
- * vencsys clocks, the smi-common, larb7 and the JPEG encoder.
+ * Titan 2: JPEG encoder through the MM IOMMU ("variant B"). Same as -all,
+ * plus the
+ * vencsys clocks, larb7 and the JPEG encoder with its four larb7 ports
+ * (5 Y RDMA, 6 C RDMA, 7 Q table, 9 BSDMA), as in the factory device tree.
  *
- * The encoder reads and writes physical addresses: its buffers come from
- * CMA below 4 GiB (32-bit DMA mask of the driver) and its four larb7 ports
- * (5, 6, 7, 9) must be in bypass. No IOMMU binds larb7, so the SMI driver
- * leaves MMU_EN as it is after VEN0 power-on (assumed clear, not checked)
- * and only switches the larb clocks.
+ * -all already runs the M4U (smi_common, m4u) for the three camera larbs
+ * (13, 14, 29), so the same path is used here: the M4U binds larb7 and
+ * links the encoder to it, a runtime resume of the encoder resumes larb7
+ * (clocks, MMU_EN on the four ports) and the smi-common, with no sysfs
+ * step. The buffers are IOVAs of the 0 ~ 4G region (32-bit DMA mask of the
+ * driver, BANK_SEL 0), not CMA, so dma-buf frames from the cameras or the
+ * GPU can be imported for MJPEG recording.
  *
- * Nothing links the encoder to larb7 without the IOMMU: keep larb7
- * resumed by hand during the test, else the encoder's requests stall in
- * the unclocked larb and the frame times out after one second:
- *   echo on > /sys/bus/platform/devices/17010000.smi/power/control
- * The SMI common is runtime resumed through larb7 and then writes its
- * init values and bus selection while the display is running, as with
- * the -iommu DTB.
+ * Variant A (physical addresses, larb7 ports in bypass, larb7 kept resumed
+ * by hand) was the first version of this file (see its history); it is
+ * not kept as a board since the M4U
+ * path of the camera larbs is proven in -all.
  *
- * With the cameras (titan2-camera) -all has the M4U, and larb7 enabled
- * here is bound to it too; without iommus on the encoder its ports keep
- * MMU_EN clear and the physical addressing above still applies.
- *
- * If the encoder times out or the bus hangs, boot the -all DTB again.
+ * If the frame times out, the log shows M4U translation faults on ports
+ * 5/6/7/9 (the larb of a fault is reported as invalid on MT6878) or the
+ * bus hangs, boot the -all DTB again.
  *
  * Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
  */
@@ -31,14 +30,14 @@ &vencsys {
 	status = "okay";
 };
 
-&smi_common {
-	status = "okay";
-};
-
 &larb7 {
 	status = "okay";
 };
 
 &jpgenc {
+	iommus = <&m4u M4U_L7_P5_JPGENC_Y_RDMA>,
+		 <&m4u M4U_L7_P6_JPGENC_C_RDMA>,
+		 <&m4u M4U_L7_P7_JPGENC_Q_RDMA>,
+		 <&m4u M4U_L7_P9_JPGENC_BSDMA>;
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-raw.dts b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-raw.dts
