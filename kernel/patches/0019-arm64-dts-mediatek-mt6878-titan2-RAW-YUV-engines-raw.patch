+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Titan 2: TEST board, -vcp with the VCP and its DMA helper nodes behind
+ * the MM IOMMU (mt6878-unihertz-titan2-iommu-vcp.dtsi.example, inlined):
+ * the larb-less master M4U_L41_VIDEO_UP gets the VDO_UP window of the
+ * factory layout (0x1_1000_0000 + 1.5 GiB), the VCP driver sets a 34-bit
+ * DMA mask when the device is IOMMU mapped, and the shared memory handed
+ * to the VCP is an IOVA (bits 35..32 packed into bits 3..0).
+ *
+ * The M4U (smi_common, m4u) is enabled by -all for the cameras. Open: what
+ * enables translation for the larb-less VCP port (the downstream driver
+ * maps vcp_cfgreg_mmu but never writes it). Boot it only after -vcp: if -vcp gets "VCP ready" the port is
+ * in bypass and this board is expected to fail with a dead VCP (no READY,
+ * PC stuck) or an IOMMU fault on larb 41; if -vcp fails and this one gets
+ * READY, the port translates. Either way, boot -all afterwards.
+ *
+ * Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+#include "mt6878-unihertz-titan2-vcp.dts"
+
+&{/vcp@1ea00000} {
+	iommus = <&m4u M4U_L41_VIDEO_UP>;
+};
+
+&{/vcp-iommu-vdec} {
+	iommus = <&m4u M4U_L41_VIDEO_UP>;
+};
+
+&{/vcp-iommu-venc} {
+	iommus = <&m4u M4U_L41_VIDEO_UP>;
+};
+
+&{/vcp-iommu-work} {
+	iommus = <&m4u M4U_L41_VIDEO_UP>;
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-vcp.dts b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-vcp.dts
