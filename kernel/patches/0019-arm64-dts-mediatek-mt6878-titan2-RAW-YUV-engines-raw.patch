index 000000000000..7f593756098b
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-vcp.dts
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Titan 2: TEST board, -all plus the VCP (video companion processor, the
+ * RV55 that runs the video codec firmware) as described in the factory
+ * device tree, with vcp-support = <1>: the boot loader then loads the VCP
+ * firmware from the vcp_<slot> partition into me_vcp_reserved and the
+ * ported host driver (drivers/soc/mediatek/vcp) can power the
+ * VCP, hand it the shared memory and release it from reset.
+ *
+ * Stage 1 ("VCP starts and sends READY"): the
+ * shared memory is plain DMA memory below 4 GiB and the VCP node has no
+ * iommus, so the VCP must read it through its DRAM port in bypass (an
+ * assumption this board tests). The -vcp-iommu board is the same path
+ * through the MM IOMMU.
+ *
+ * Nothing starts the VCP at boot: the driver powers it only when a user
+ * registers a feature (modprobe mtk-vcp boot_test=1, or
+ * echo 1 > /sys/bus/platform/devices/vcp@1ea00000/vcp_rtos).
+ *
+ * Risk: the boot loader reads vcp-sram-size, vcp-dram-size, core-nums,
+ * memorydump and the secure dump properties of the node and stops with an
+ * assertion when they do not fit; keep "all" as the default menu entry and
+ * boot "vcp" as a one-shot entry. If the phone does not boot, hangs or the
+ * screen stays dark, boot -all.
+ *
+ * Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+#include "mt6878-unihertz-titan2-all.dts"
+/* after mt6878-titan2-lk-compat.dtsi (part of the board file): deletes its /vcp */
+#include "mt6878-unihertz-titan2-vcp.dtsi"
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-vcp.dtsi b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-vcp.dtsi
