index 000000000000..9c575e3cdef5
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-raw.dts
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Titan 2: TEST board, -all plus the RAW and YUV engines of the image
+ * signal processor for the replay of captured command queues
+ * (the mtk-camraw-mt6878 driver): larbs 16/17 (side A) and 33/34 (side B) behind
+ * the M4U, the engine nodes of both sides with RAW-B as the second engine
+ * of RAW-A, and a second destination of CSI port 2 (the main IMX766
+ * camera) toward RAW-A next to its CAMSV engine.
+ *
+ * The CSI port of the main camera has three pads on this board; its media
+ * device is otherwise the one of -all, and the sensor mode is set there.
+ * The RAW video node is outside the media graph. Nothing is powered or
+ * written until that node streams, and it needs the request dumps
+ * /lib/firmware/titan2/camraw-start.bin and camraw-frame.bin. Side B is
+ * powered only with the module parameter twin=1.
+ *
+ * Boot it as a one-shot entry, -all afterwards.
+ *
+ * Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+#include "mt6878-unihertz-titan2-all.dts"
+
+&larb16 {
+	status = "okay";
+};
+
+&larb17 {
+	status = "okay";
+};
+
+&larb33 {
+	status = "okay";
+};
+
+&larb34 {
+	status = "okay";
+};
+
+&cam_yuv_a {
+	status = "okay";
+};
+
+&cam_yuv_b {
+	status = "okay";
+};
+
+&cam_raw_b {
+	status = "okay";
+};
+
+&cam_raw_a {
+	status = "okay";
+	mediatek,twin = <&cam_raw_b>;
+
+	port {
+		cam_raw_a_in: endpoint {
+			remote-endpoint = <&seninf_csi2_raw>;
+		};
+	};
+};
+
+&seninf_port5 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	seninf_csi2_raw: endpoint@1 {
+		reg = <1>;
+		remote-endpoint = <&cam_raw_a_in>;
+	};
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-vcp-iommu.dts b/arch/arm64/boot/dts/mediatek/mt6878-unihertz-titan2-vcp-iommu.dts
