+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * MediaTek MT6878 sensor interface (seninf) driver: V4L2 sub-devices,
+ * static routing, probe and power management.
+ *
+ * Every CSI port is its own sub-device with one sink pad (the sensor) and
+ * one source pad (a CAMSV engine). The route of a port (seninf interface,
+ * seninf mux, cam mux) is fixed at probe time from the device tree graph.
+ *
+ * Copyright (c) 2026 serlk
+ */
+
+#include <linux/clk.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+
+#include <media/mipi-csi2.h>
+#include <media/v4l2-common.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mc.h>
+
+#include "mtk-seninf.h"
+
+#define SENINF_SOURCE_PORT(n)		((n) + SENINF_NUM_PORTS)
+
+#define SENINF_DEF_WIDTH		1920
+#define SENINF_DEF_HEIGHT		1080
+#define SENINF_MIN_SIZE			16
+#define SENINF_MAX_SIZE			0xffff	/* cam mux size checker */
+
+/*
+ * The tag the CAMSV driver captures the image with (CAMSV_IMG_TAG of
+ * drivers/media/platform/mediatek/camsv/mtk-camsv.h). Both sides must
+ * agree: for a tagged engine the cam mux is the engine's cam mux base plus
+ * the tag (mtk_cam_get_sv_cammux_id()).
+ */
+#define SENINF_CAMSV_TAG		2
+
+/*
+ * CAMSV engines by mediatek,camsv-id: cam mux base (factory device
+ * tree mediatek,cammux-id) and type. Engines 0..3 are tagged ("SAT"), 4..5
+ * single ("normal") engines (mtk_cam_get_sv_cammux_id()).
+ *
+ * TODO: the cam mux bases of camsv-id 2, 3 and 5 are not in the
+ * specification, those engines are rejected.
+ */
+static const struct {
+	bool valid;
+	bool sat;
+	u8 cam_mux;
+} seninf_camsv[] = {
+	[0] = { true, true, 0x00 },
+	[1] = { true, true, 0x08 },
+	[4] = { true, false, 0x20 },
+};
+
+static const char * const seninf_clk_names[SENINF_NUM_CLKS] = {
+	/* order of mtk_cam-seninf-def.h: seninf, cam, camtg gates */
+	"seninf", "cam", "camtg",
+};
+
+static const char * const seninf_test_pattern_menu[] = {
+	"Disabled",
+	"Test Model",
+};
+
+struct mtk_seninf_format {
+	u32 code;
+	u8 dt;
+	/* the same depth in the test model's colour order */
+	u32 tm_code;
+};
+
+/*
+ * The Bayer formats the CAMSV driver accepts.
+ *
+ * The test model sends its colour bars in GRBG order (measured on the
+ * Titan 2, 2026-11-08: the eight bars of a full 5632x4224 frame decode to
+ * white, yellow, cyan, green, magenta, red, blue, black only as GRBG), so
+ * while it is selected the pads carry the GRBG code of the chosen depth.
+ */
+#define SENINF_FMT(order, depth, dt)					\
+	{ MEDIA_BUS_FMT_S##order##depth##_1X##depth, MIPI_CSI2_DT_##dt,	\
+	  MEDIA_BUS_FMT_SGRBG##depth##_1X##depth }
+
+static const struct mtk_seninf_format seninf_formats[] = {
+	SENINF_FMT(BGGR, 10, RAW10),
+	SENINF_FMT(GBRG, 10, RAW10),
+	SENINF_FMT(GRBG, 10, RAW10),
+	SENINF_FMT(RGGB, 10, RAW10),
+	SENINF_FMT(BGGR, 8, RAW8),
+	SENINF_FMT(GBRG, 8, RAW8),
+	SENINF_FMT(GRBG, 8, RAW8),
+	SENINF_FMT(RGGB, 8, RAW8),
+	SENINF_FMT(BGGR, 12, RAW12),
+	SENINF_FMT(GBRG, 12, RAW12),
+	SENINF_FMT(GRBG, 12, RAW12),
+	SENINF_FMT(RGGB, 12, RAW12),
+};
+
+static const struct mtk_seninf_format *seninf_find_format(u32 code)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(seninf_formats); i++)
+		if (seninf_formats[i].code == code)
+			return &seninf_formats[i];
+	return NULL;
+}
+
+static unsigned int seninf_dt_bpp(u8 dt)
+{
+	switch (dt) {
+	case MIPI_CSI2_DT_RAW8:
+		return 8;
+	case MIPI_CSI2_DT_RAW12:
+		return 12;
+	default:
+		return 10;
+	}
+}
+
+static inline struct mtk_seninf_port *sd_to_port(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct mtk_seninf_port, sd);
+}
+
+/* ------------------------------------------------------------------ */
+/* Pad operations                                                      */
+
+/* GRBG: the order of the test model and of the Hi-847 */
+static const struct v4l2_mbus_framefmt seninf_default_fmt = {
+	.code = MEDIA_BUS_FMT_SGRBG10_1X10,
+	.width = SENINF_DEF_WIDTH,
+	.height = SENINF_DEF_HEIGHT,
+	.field = V4L2_FIELD_NONE,
+	.colorspace = V4L2_COLORSPACE_RAW,
+	.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+	.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+	.xfer_func = V4L2_XFER_FUNC_NONE,
+};
+
+static int seninf_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SINK) = seninf_default_fmt;
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SOURCE) = seninf_default_fmt;
+	return 0;
+}
+
+static int seninf_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->pad == SENINF_PAD_SOURCE) {
+		/* the source pad follows the sink pad */
+		if (code->index)
+			return -EINVAL;
+		code->code = v4l2_subdev_state_get_format(state,
+							  SENINF_PAD_SINK)->code;
+		return 0;
+	}
+
+	if (code->index >= ARRAY_SIZE(seninf_formats))
+		return -EINVAL;
+	code->code = seninf_formats[code->index].code;
+	return 0;
+}
+
+static int seninf_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct mtk_seninf_port *port = sd_to_port(sd);
+	const struct mtk_seninf_format *f;
+	struct v4l2_mbus_framefmt *sink;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE && port->streaming)
+		return -EBUSY;
+
+	/* the source pad format is the sink pad format */
+	if (fmt->pad == SENINF_PAD_SOURCE)
+		return v4l2_subdev_get_fmt(sd, state, fmt);
+
+	f = seninf_find_format(fmt->format.code);
+	if (!f)
+		f = seninf_find_format(seninf_default_fmt.code);
+	/* the test model has a fixed colour order */
+	fmt->format.code = v4l2_ctrl_g_ctrl(port->test_pattern) ? f->tm_code :
+								   f->code;
+	fmt->format.width = clamp_t(u32, fmt->format.width, SENINF_MIN_SIZE,
+				    SENINF_MAX_SIZE);
+	fmt->format.height = clamp_t(u32, fmt->format.height, SENINF_MIN_SIZE,
+				     SENINF_MAX_SIZE);
+	fmt->format.field = V4L2_FIELD_NONE;
+	if (fmt->format.colorspace == V4L2_COLORSPACE_DEFAULT)
+		fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+
+	sink = v4l2_subdev_state_get_format(state, SENINF_PAD_SINK);
+	*sink = fmt->format;
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SOURCE) = fmt->format;
+	return 0;
+}
+
+/* VC of the image: from the sensor's frame descriptor, else 0 */
+static u8 seninf_sensor_vc(struct mtk_seninf_port *port,
+			   struct media_pad *remote, u8 dt)
+{
+	struct v4l2_mbus_frame_desc fd = { };
+	unsigned int i;
+
+	if (v4l2_subdev_call(port->sensor, pad, get_frame_desc, remote->index,
+			     &fd) || fd.type != V4L2_MBUS_FRAME_DESC_TYPE_CSI2)
+		return 0;
+
+	for (i = 0; i < fd.num_entries; i++)
+		if (fd.entry[i].bus.csi2.dt == dt)
+			return fd.entry[i].bus.csi2.vc;
+	return 0;
+}
+
+/* C-PHY fixed settle time for @link_freq from the sink endpoint table */
+static u32 seninf_settle_ns(struct mtk_seninf_port *port, s64 link_freq)
+{
+	unsigned int i;
+
+	if (!port->settle_ns)
+		return 0;
+
+	for (i = 0; i < port->num_link_freqs; i++)
+		if (port->link_freqs[i] == link_freq)
+			return port->settle_ns[i];
+	return 0;
+}
+
+static int seninf_prepare_stream(struct mtk_seninf_port *port,
+				 struct v4l2_subdev_state *state,
+				 struct media_pad **remote)
+{
+	struct mtk_seninf_stream *cfg = &port->cfg;
+	const struct mtk_seninf_format *f;
+	struct v4l2_mbus_framefmt *fmt;
+	unsigned int bpp;
+	s64 link_freq;
+
+	fmt = v4l2_subdev_state_get_format(state, SENINF_PAD_SINK);
+	f = seninf_find_format(fmt->code);
+	if (!f)
+		return -EINVAL;
+
+	memset(cfg, 0, sizeof(*cfg));
+	cfg->dt = f->dt;
+	cfg->hsize = fmt->width;
+	cfg->vsize = fmt->height;
+	cfg->test_model = v4l2_ctrl_g_ctrl(port->test_pattern) != 0;
+	*remote = NULL;
+
+	if (cfg->test_model) {
+		/*
+		 * Formats set before the test pattern was selected may carry
+		 * another order; the image would be mislabelled.
+		 */
+		if (fmt->code != f->tm_code) {
+			dev_err(port->priv->dev,
+				"csi%u: the test model sends GRBG, set the pad format to code 0x%04x\n",
+				port->id, f->tm_code);
+			return -EPIPE;
+		}
+		return 0;
+	}
+
+	if (!port->sensor)
+		return -ENOLINK;
+
+	*remote = media_pad_remote_pad_unique(&port->pads[SENINF_PAD_SINK]);
+	if (IS_ERR(*remote))
+		return PTR_ERR(*remote);
+
+	cfg->vc = seninf_sensor_vc(port, *remote, cfg->dt);
+
+	/*
+	 * D-PHY: lane bit rate = 2 * link frequency; C-PHY: trio symbol
+	 * rate = 2 * link frequency (pixel rate * bpp * 7 / (16 * trios)).
+	 */
+	bpp = seninf_dt_bpp(cfg->dt);
+	if (port->cphy)
+		link_freq = v4l2_get_link_freq(*remote, bpp * 7,
+					       32 * port->num_lanes);
+	else
+		link_freq = v4l2_get_link_freq(*remote, bpp,
+					       2 * port->num_lanes);
+	if (link_freq < 0) {
+		dev_err(port->priv->dev, "csi%u: no link frequency: %lld\n",
+			port->id, link_freq);
+		return link_freq;
+	}
+
+	cfg->data_rate = 2 * (u64)link_freq;
+	if (port->cphy)
+		cfg->settle_ns = seninf_settle_ns(port, link_freq);
+	return 0;
+}
+
+static int seninf_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct mtk_seninf_port *port = sd_to_port(sd);
+	struct mtk_seninf *priv = port->priv;
+	struct media_pad *remote;
+	int ret;
+
+	if (streams_mask != BIT_ULL(0))
+		return -EINVAL;
+
+	ret = seninf_prepare_stream(port, state, &remote);
+	if (ret)
+		return ret;
+
+	ret = pm_runtime_resume_and_get(priv->dev);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(port->csi_clk);
+	if (ret)
+		goto err_pm;
+
+	port->cfg.csi_clk = clk_get_rate(port->csi_clk);
+	if (!port->cfg.csi_clk) {
+		dev_warn(priv->dev, "csi%u: no CSI clock rate, assuming %lu\n",
+			 port->id, SENINF_CSI_CLK_DEFAULT);
+		port->cfg.csi_clk = SENINF_CSI_CLK_DEFAULT;
+	}
+
+	mutex_lock(&priv->hw_lock);
+	ret = mtk_seninf_hw_start(port);
+	mutex_unlock(&priv->hw_lock);
+	if (ret)
+		goto err_clk;
+
+	/* the sensor starts after the receiver and the muxes are set */
+	if (remote) {
+		ret = v4l2_subdev_enable_streams(port->sensor, remote->index,
+						 BIT_ULL(0));
+		if (ret)
+			goto err_hw;
+	}
+
+	port->streaming = true;
+	v4l2_ctrl_grab(port->test_pattern, true);
+	return 0;
+
+err_hw:
+	mutex_lock(&priv->hw_lock);
+	mtk_seninf_hw_stop(port);
+	mutex_unlock(&priv->hw_lock);
+err_clk:
+	clk_disable_unprepare(port->csi_clk);
+err_pm:
+	pm_runtime_put(priv->dev);
+	return ret;
+}
+
+static int seninf_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct mtk_seninf_port *port = sd_to_port(sd);
+	struct mtk_seninf *priv = port->priv;
+	struct media_pad *remote;
+
+	if (!port->streaming)
+		return 0;
+
+	if (!port->cfg.test_model && port->sensor) {
+		remote = media_pad_remote_pad_unique(&port->pads[SENINF_PAD_SINK]);
+		if (!IS_ERR(remote))
+			v4l2_subdev_disable_streams(port->sensor, remote->index,
+						    BIT_ULL(0));
+	}
+
+	mutex_lock(&priv->hw_lock);
+	mtk_seninf_hw_stop(port);
+	mutex_unlock(&priv->hw_lock);
+
+	clk_disable_unprepare(port->csi_clk);
+	pm_runtime_put(priv->dev);
+
+	v4l2_ctrl_grab(port->test_pattern, false);
+	port->streaming = false;
+	return 0;
+}
+
+/*
+ * VIDIOC_LOG_STATUS (also called by the CAMSV driver's debug dumps): the
+ * port's registers, only while the device is powered.
+ */
+static int seninf_log_status(struct v4l2_subdev *sd)
+{
+	struct mtk_seninf_port *port = sd_to_port(sd);
+	struct mtk_seninf *priv = port->priv;
+
+	if (pm_runtime_get_if_active(priv->dev) <= 0) {
+		dev_info(priv->dev, "csi%u: powered off, nothing read\n",
+			 port->id);
+		return 0;
+	}
+
+	mutex_lock(&priv->hw_lock);
+	mtk_seninf_hw_dump(port);
+	mutex_unlock(&priv->hw_lock);
+
+	pm_runtime_put(priv->dev);
+	return 0;
+}
+
+static const struct v4l2_subdev_core_ops seninf_core_ops = {
+	.log_status = seninf_log_status,
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+};
+
+static const struct v4l2_subdev_video_ops seninf_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops seninf_pad_ops = {
+	.enum_mbus_code = seninf_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = seninf_set_fmt,
+	.link_validate = v4l2_subdev_link_validate_default,
+	.enable_streams = seninf_enable_streams,
+	.disable_streams = seninf_disable_streams,
+};
+
+static const struct v4l2_subdev_ops seninf_subdev_ops = {
+	.core = &seninf_core_ops,
+	.video = &seninf_video_ops,
+	.pad = &seninf_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops seninf_internal_ops = {
+	.init_state = seninf_init_state,
+};
+
+/* Endpoints of this port map to its pads; other ports' to nothing. */
+static int seninf_get_fwnode_pad(struct media_entity *entity,
+				 struct fwnode_endpoint *endpoint)
+{
+	struct mtk_seninf_port *port =
+		sd_to_port(media_entity_to_v4l2_subdev(entity));
+
+	if (port->sink_ep && endpoint->local_fwnode == port->sink_ep)
+		return SENINF_PAD_SINK;
+	if (endpoint->local_fwnode == port->source_ep)
+		return SENINF_PAD_SOURCE;
+	return -ENXIO;
+}
+
+static const struct media_entity_operations seninf_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+	.get_fwnode_pad = seninf_get_fwnode_pad,
+};
+
+/* ------------------------------------------------------------------ */
+/* Controls                                                            */
+
+static int seninf_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	/* read when the stream starts; grabbed while streaming */
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops seninf_ctrl_ops = {
+	.s_ctrl = seninf_s_ctrl,
+};
+
+/* ------------------------------------------------------------------ */
+/* Sensor notifier                                                     */
+
+static int seninf_notifier_bound(struct v4l2_async_notifier *notifier,
+				 struct v4l2_subdev *sd,
+				 struct v4l2_async_connection *asc)
+{
+	struct mtk_seninf_port *port =
+		container_of(notifier, struct mtk_seninf_port, notifier);
+	int ret;
+
+	ret = v4l2_create_fwnode_links_to_pad(sd, &port->pads[SENINF_PAD_SINK],
+					      MEDIA_LNK_FL_ENABLED |
+					      MEDIA_LNK_FL_IMMUTABLE);
+	if (ret)
+		return ret;
+
+	port->sensor = sd;
+	return 0;
+}
+
+static void seninf_notifier_unbind(struct v4l2_async_notifier *notifier,
+				   struct v4l2_subdev *sd,
+				   struct v4l2_async_connection *asc)
+{
+	struct mtk_seninf_port *port =
+		container_of(notifier, struct mtk_seninf_port, notifier);
+
+	port->sensor = NULL;
+}
+
+static const struct v4l2_async_notifier_operations seninf_notifier_ops = {
+	.bound = seninf_notifier_bound,
+	.unbind = seninf_notifier_unbind,
+};
+
+/* ------------------------------------------------------------------ */
+/* Probe                                                               */
+
+/* bus type, lanes and the per link frequency C-PHY settle times */
+static int seninf_parse_sink(struct mtk_seninf_port *port)
+{
+	struct device *dev = port->priv->dev;
+	struct v4l2_fwnode_endpoint vep = { .bus_type = V4L2_MBUS_UNKNOWN };
+	unsigned int n;
+	int ret;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(port->sink_ep, &vep);
+	if (ret)
+		return dev_err_probe(dev, ret, "csi%u: bad endpoint\n", port->id);
+
+	switch (vep.bus_type) {
+	case V4L2_MBUS_CSI2_DPHY:
+		port->cphy = false;
+		/* full port: 2 or 4 lanes; 1 lane needs a split port */
+		if (vep.bus.mipi_csi2.num_data_lanes != 2 &&
+		    vep.bus.mipi_csi2.num_data_lanes != 4)
+			ret = -EINVAL;
+		break;
+	case V4L2_MBUS_CSI2_CPHY:
+		port->cphy = true;
+		if (vep.bus.mipi_csi2.num_data_lanes < 1 ||
+		    vep.bus.mipi_csi2.num_data_lanes > 3)
+			ret = -EINVAL;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	if (ret) {
+		dev_err(dev, "csi%u: unsupported bus type %u / %u lanes\n",
+			port->id, vep.bus_type, vep.bus.mipi_csi2.num_data_lanes);
+		goto out;
+	}
+	port->num_lanes = vep.bus.mipi_csi2.num_data_lanes;
+
+	/*
+	 * TODO: lane reordering is not supported; the data lanes
+	 * are taken in the fixed GPL lane select order.
+	 */
+
+	n = vep.nr_of_link_frequencies;
+	if (!port->cphy || !n ||
+	    !fwnode_property_present(port->sink_ep, "mediatek,cphy-settle-ns"))
+		goto out;
+
+	port->link_freqs = devm_kmemdup_array(dev, vep.link_frequencies, n,
+					      sizeof(*port->link_freqs),
+					      GFP_KERNEL);
+	port->settle_ns = devm_kcalloc(dev, n, sizeof(*port->settle_ns),
+				       GFP_KERNEL);
+	if (!port->link_freqs || !port->settle_ns) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ret = fwnode_property_read_u32_array(port->sink_ep,
+					     "mediatek,cphy-settle-ns",
+					     port->settle_ns, n);
+	if (ret) {
+		dev_err(dev, "csi%u: mediatek,cphy-settle-ns needs %u entries\n",
+			port->id, n);
+		goto out;
+	}
+	port->num_link_freqs = n;
+
+out:
+	v4l2_fwnode_endpoint_free(&vep);
+	return ret;
+}
+
+/* destination engine of the source endpoint -> static route */
+static int seninf_parse_source(struct mtk_seninf_port *port)
+{
+	struct device *dev = port->priv->dev;
+	struct fwnode_handle *camsv;
+	u32 id;
+	int ret;
+
+	camsv = fwnode_graph_get_remote_port_parent(port->source_ep);
+	if (!camsv)
+		return dev_err_probe(dev, -ENOTCONN, "csi%u: no CAMSV link\n",
+				     port->id);
+	ret = fwnode_property_read_u32(camsv, "mediatek,camsv-id", &id);
+	fwnode_handle_put(camsv);
+	if (ret || id >= ARRAY_SIZE(seninf_camsv) || !seninf_camsv[id].valid)
+		return dev_err_probe(dev, -EINVAL,
+				     "csi%u: unsupported CAMSV engine\n",
+				     port->id);
+
+	ret = mtk_seninf_hw_route(port->id, seninf_camsv[id].sat,
+				  seninf_camsv[id].cam_mux, SENINF_CAMSV_TAG,
+				  &port->route);
+	if (ret)
+		return dev_err_probe(dev, ret, "csi%u: no route to camsv-id %u\n",
+				     port->id, id);
+
+	dev_dbg(dev, "csi%u: seninf %u mux %u vr 0x%x cam mux 0x%x\n",
+		port->id, port->route.seninf, port->route.mux,
+		port->route.mux_vr, port->route.cam_mux);
+	return 0;
+}
+
+/* Two ports cannot share a mux or a cam mux. */
+static int seninf_check_routes(struct mtk_seninf *priv)
+{
+	unsigned int i, j;
+
+	for (i = 0; i < SENINF_NUM_PORTS; i++) {
+		if (!priv->ports[i].priv)
+			continue;
+		for (j = i + 1; j < SENINF_NUM_PORTS; j++) {
+			if (!priv->ports[j].priv)
+				continue;
+			if (priv->ports[i].route.mux == priv->ports[j].route.mux ||
+			    priv->ports[i].route.cam_mux ==
+			    priv->ports[j].route.cam_mux)
+				return dev_err_probe(priv->dev, -EINVAL,
+						     "csi%u and csi%u share a mux\n",
+						     i, j);
+		}
+	}
+	return 0;
+}
+
+static int seninf_read_efuse(struct mtk_seninf_port *port)
+{
+	struct device *dev = port->priv->dev;
+	char name[8];
+	u32 val;
+	int ret;
+
+	snprintf(name, sizeof(name), "csi%u", port->id);
+	ret = nvmem_cell_read_u32(dev, name, &val);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret) {
+		dev_dbg(dev, "csi%u: no PHY calibration (%d)\n", port->id, ret);
+		return 0;
+	}
+
+	/* as the GPL driver: a bad checksum is reported, the data used */
+	if (!mtk_seninf_hw_efuse_valid(val, port->id))
+		dev_warn(dev, "csi%u: PHY calibration 0x%08x fails its check\n",
+			 port->id, val);
+	port->efuse = val;
+	return 0;
+}
+
+static void seninf_port_cleanup(struct mtk_seninf_port *port)
+{
+	v4l2_async_unregister_subdev(&port->sd);
+	v4l2_async_nf_unregister(&port->notifier);
+	v4l2_async_nf_cleanup(&port->notifier);
+	v4l2_subdev_cleanup(&port->sd);
+	media_entity_cleanup(&port->sd.entity);
+	v4l2_ctrl_handler_free(&port->ctrls);
+}
+
+static int seninf_port_register(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	struct device *dev = priv->dev;
+	struct v4l2_subdev *sd = &port->sd;
+	struct v4l2_async_connection *asc;
+	int ret;
+
+	v4l2_subdev_init(sd, &seninf_subdev_ops);
+	sd->internal_ops = &seninf_internal_ops;
+	sd->dev = dev;
+	sd->flags |= V4L2_SUBDEV_FL_HAS_DEVNODE | V4L2_SUBDEV_FL_HAS_EVENTS;
+	snprintf(sd->name, sizeof(sd->name), "%s csi%u", dev_name(dev),
+		 port->id);
+	v4l2_set_subdevdata(sd, port);
+
+	v4l2_ctrl_handler_init(&port->ctrls, 1);
+	port->test_pattern =
+		v4l2_ctrl_new_std_menu_items(&port->ctrls, &seninf_ctrl_ops,
+					     V4L2_CID_TEST_PATTERN,
+					     ARRAY_SIZE(seninf_test_pattern_menu) - 1,
+					     0, 0, seninf_test_pattern_menu);
+	if (port->ctrls.error) {
+		ret = port->ctrls.error;
+		goto err_ctrls;
+	}
+	sd->ctrl_handler = &port->ctrls;
+
+	sd->entity.function = MEDIA_ENT_F_VID_IF_BRIDGE;
+	sd->entity.ops = &seninf_entity_ops;
+	port->pads[SENINF_PAD_SINK].flags = MEDIA_PAD_FL_SINK;
+	port->pads[SENINF_PAD_SOURCE].flags = MEDIA_PAD_FL_SOURCE |
+					      MEDIA_PAD_FL_MUST_CONNECT;
+	ret = media_entity_pads_init(&sd->entity, SENINF_NUM_PADS, port->pads);
+	if (ret)
+		goto err_ctrls;
+
+	/* the CAMSV notifier matches this sub-device by its source endpoint */
+	ret = v4l2_async_subdev_endpoint_add(sd, port->source_ep);
+	if (ret)
+		goto err_entity;
+
+	ret = v4l2_subdev_init_finalize(sd);
+	if (ret)
+		goto err_subdev;
+
+	v4l2_async_subdev_nf_init(&port->notifier, sd);
+	port->notifier.ops = &seninf_notifier_ops;
+	if (port->sink_ep) {
+		asc = v4l2_async_nf_add_fwnode_remote(&port->notifier,
+						      port->sink_ep,
+						      struct v4l2_async_connection);
+		if (IS_ERR(asc) && PTR_ERR(asc) != -ENOTCONN) {
+			ret = PTR_ERR(asc);
+			goto err_nf;
+		}
+	}
+	ret = v4l2_async_nf_register(&port->notifier);
+	if (ret)
+		goto err_nf;
+
+	ret = v4l2_async_register_subdev(sd);
+	if (ret)
+		goto err_nf_unreg;
+	return 0;
+
+err_nf_unreg:
+	v4l2_async_nf_unregister(&port->notifier);
+err_nf:
+	v4l2_async_nf_cleanup(&port->notifier);
+err_subdev:
+	v4l2_subdev_cleanup(sd);
+err_entity:
+	media_entity_cleanup(&sd->entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&port->ctrls);
+	return ret;
+}
+
+static void seninf_put_endpoints(struct mtk_seninf *priv)
+{
+	unsigned int i;
+
+	for (i = 0; i < SENINF_NUM_PORTS; i++) {
+		fwnode_handle_put(priv->ports[i].sink_ep);
+		fwnode_handle_put(priv->ports[i].source_ep);
+		priv->ports[i].sink_ep = NULL;
+		priv->ports[i].source_ep = NULL;
+	}
+}
+
+static int seninf_probe_port(struct mtk_seninf *priv, unsigned int id)
+{
+	struct mtk_seninf_port *port = &priv->ports[id];
+	struct fwnode_handle *fwnode = dev_fwnode(priv->dev);
+	char name[8];
+	int ret;
+
+	port->source_ep = fwnode_graph_get_endpoint_by_id(fwnode,
+							  SENINF_SOURCE_PORT(id),
+							  0, 0);
+	if (!port->source_ep)
+		return 0;	/* port not used */
+
+	port->priv = priv;
+	port->id = id;
+	port->sink_ep = fwnode_graph_get_endpoint_by_id(fwnode, id, 0, 0);
+
+	snprintf(name, sizeof(name), "csi%u", id);
+	port->csi_clk = devm_clk_get(priv->dev, name);
+	if (IS_ERR(port->csi_clk))
+		return dev_err_probe(priv->dev, PTR_ERR(port->csi_clk),
+				     "no %s clock\n", name);
+
+	/* without a sensor the port can still run the test model */
+	if (port->sink_ep) {
+		ret = seninf_parse_sink(port);
+		if (ret)
+			return ret;
+	}
+
+	ret = seninf_parse_source(port);
+	if (ret)
+		return ret;
+
+	return seninf_read_efuse(port);
+}
+
+static int mtk_seninf_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mtk_seninf *priv;
+	unsigned int i, n = 0;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->dev = dev;
+	platform_set_drvdata(pdev, priv);
+
+	priv->base = devm_platform_ioremap_resource_byname(pdev, "seninf");
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+	priv->ana = devm_platform_ioremap_resource_byname(pdev, "csi-rx");
+	if (IS_ERR(priv->ana))
+		return PTR_ERR(priv->ana);
+
+	for (i = 0; i < SENINF_NUM_CLKS; i++)
+		priv->clks[i].id = seninf_clk_names[i];
+	ret = devm_clk_bulk_get(dev, SENINF_NUM_CLKS, priv->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	/* CAM_MAIN and CSI_RX; with a single domain the core attaches it */
+	ret = devm_pm_domain_attach_list(dev, NULL, &priv->pd_list);
+	if (ret < 0 && ret != -EEXIST)
+		return dev_err_probe(dev, ret, "failed to attach power domains\n");
+
+	ret = devm_mutex_init(dev, &priv->hw_lock);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < SENINF_NUM_PORTS; i++) {
+		ret = seninf_probe_port(priv, i);
+		if (ret)
+			goto err_put;
+		if (priv->ports[i].priv)
+			n++;
+	}
+	if (!n) {
+		ret = dev_err_probe(dev, -ENODEV, "no CSI port is connected\n");
+		goto err_put;
+	}
+
+	ret = seninf_check_routes(priv);
+	if (ret)
+		goto err_put;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		goto err_put;
+
+	for (i = 0; i < SENINF_NUM_PORTS; i++) {
+		if (!priv->ports[i].priv)
+			continue;
+		ret = seninf_port_register(&priv->ports[i]);
+		if (ret) {
+			dev_err_probe(dev, ret, "csi%u: registration failed\n", i);
+			goto err_unregister;
+		}
+	}
+	return 0;
+
+err_unregister:
+	while (i--)
+		if (priv->ports[i].priv)
+			seninf_port_cleanup(&priv->ports[i]);
+err_put:
+	seninf_put_endpoints(priv);
+	return ret;
+}
+
+static void mtk_seninf_remove(struct platform_device *pdev)
+{
+	struct mtk_seninf *priv = platform_get_drvdata(pdev);
+	unsigned int i;
+
+	for (i = 0; i < SENINF_NUM_PORTS; i++)
+		if (priv->ports[i].priv)
+			seninf_port_cleanup(&priv->ports[i]);
+	seninf_put_endpoints(priv);
+}
+
+/* ------------------------------------------------------------------ */
+/* Power management                                                    */
+
+static int mtk_seninf_runtime_suspend(struct device *dev)
+{
+	struct mtk_seninf *priv = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(SENINF_NUM_CLKS, priv->clks);
+	return 0;
+}
+
+/*
+ * runtime_resume() of the GPL driver for the first user: power domains
+ * (device links), the camsys gates, then no mux or cam mux routed.
+ *
+ * TODO: the GPL driver also raises the vcore through
+ * dvfsrc-vcore (575 mV for the 312 MHz CSI clock step) and enables the
+ * CAMTM clock for the timestamp recorder; neither is done here.
+ */
+static int mtk_seninf_runtime_resume(struct device *dev)
+{
+	struct mtk_seninf *priv = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(SENINF_NUM_CLKS, priv->clks);
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->hw_lock);
+	mtk_seninf_hw_init(priv);
+	mutex_unlock(&priv->hw_lock);
+	return 0;
+}
+
+static const struct dev_pm_ops mtk_seninf_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+	RUNTIME_PM_OPS(mtk_seninf_runtime_suspend, mtk_seninf_runtime_resume,
+		       NULL)
+};
+
+static const struct of_device_id mtk_seninf_of_match[] = {
+	{ .compatible = "mediatek,mt6878-seninf" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mtk_seninf_of_match);
+
+static struct platform_driver mtk_seninf_driver = {
+	.probe = mtk_seninf_probe,
+	.remove = mtk_seninf_remove,
+	.driver = {
+		.name = SENINF_DRV_NAME,
+		.of_match_table = mtk_seninf_of_match,
+		.pm = pm_ptr(&mtk_seninf_pm_ops),
+	},
+};
+module_platform_driver(mtk_seninf_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6878 sensor interface (CSI-2 receiver) driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/mediatek/seninf/mtk-seninf-hw.c b/drivers/media/platform/mediatek/seninf/mtk-seninf-hw.c
new file mode 100644
index 000000000000..a9dd677afd7d
--- /dev/null
+++ b/drivers/media/platform/mediatek/seninf/mtk-seninf-hw.c
@@ -0,0 +1,1471 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6878 sensor interface (seninf): CSI PHY 3.1, CSI-2 MAC,
+ * seninf interfaces, seninf muxes, cam muxes and the test model.
+ *
+ * Ported from mtk_csi_phy_3_1/mtk_cam-seninf-hw_phy_3_1.c,
+ * mtk_cam-seninf-route.c and mtk_cam-seninf-drv.c of the MediaTek ISP7SP
+ * camsys driver (kernel_modules/mtkcam/camsys/isp7sp/cam, GPL-2.0). Only
+ * the full ports (4 D-PHY lanes + clock or 3 C-PHY trios, "4D1C") are
+ * kept; the split A/B ports, ULPS, init deskew, LRTE, DT remapping,
+ * stagger, AOV, secure camera and the debug code are left out.
+ *
+ * Copyright (c) 2019 MediaTek Inc.
+ * Copyright (c) 2026 serlk
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/lockdep.h>
+#include <linux/math.h>
+#include <linux/math64.h>
+#include <linux/time64.h>
+
+#include "mtk-seninf.h"
+#include "mtk-seninf-regs.h"
+
+static inline void seninf_rmw(void __iomem *addr, u32 mask, u32 bits)
+{
+	writel((readl(addr) & ~mask) | (bits & mask), addr);
+}
+
+#define SENINF_SET(base, reg, mask, val) \
+	seninf_rmw((base) + (reg), (mask), field_prep((mask), (val)))
+#define SENINF_GET(base, reg, mask) \
+	field_get((mask), readl((base) + (reg)))
+/* set or clear all bits of a (not necessarily contiguous) group */
+#define SENINF_SET_ALL(base, reg, mask, on) \
+	seninf_rmw((base) + (reg), (mask), (on) ? (mask) : 0)
+
+/* ------------------------------------------------------------------ */
+/* Register windows (mtk_cam_seninf_init_iomem())                      */
+
+/* @half: 0 = A (also the full port), 1 = B */
+static void __iomem *ana_rx(struct mtk_seninf *priv, unsigned int port,
+			    unsigned int half)
+{
+	return priv->ana + port * SENINF_ANA_PORT_STRIDE +
+	       half * SENINF_ANA_HALF_STRIDE;
+}
+
+static void __iomem *ana_dphy(struct mtk_seninf *priv, unsigned int port)
+{
+	return priv->ana + port * SENINF_ANA_PORT_STRIDE + SENINF_ANA_DPHY_TOP;
+}
+
+static void __iomem *ana_cphy(struct mtk_seninf *priv, unsigned int port)
+{
+	return priv->ana + port * SENINF_ANA_PORT_STRIDE + SENINF_ANA_CPHY_TOP;
+}
+
+static void __iomem *mac_top(struct mtk_seninf *priv, unsigned int port)
+{
+	return priv->ana + port * SENINF_ANA_PORT_STRIDE + SENINF_ANA_MAC_TOP;
+}
+
+static void __iomem *mac_csi(struct mtk_seninf *priv, unsigned int port,
+			     unsigned int half)
+{
+	return priv->ana + port * SENINF_ANA_PORT_STRIDE + SENINF_ANA_MAC_CSI +
+	       half * SENINF_ANA_HALF_STRIDE;
+}
+
+static void __iomem *seninf_ctrl(struct mtk_seninf *priv, unsigned int idx)
+{
+	return priv->base + SENINF_IF_CTRL(idx);
+}
+
+static void __iomem *seninf_csi2(struct mtk_seninf *priv, unsigned int idx)
+{
+	return priv->base + SENINF_IF_CSI2(idx);
+}
+
+static void __iomem *seninf_mux(struct mtk_seninf *priv, unsigned int idx)
+{
+	return priv->base + SENINF_IF_MUX(idx);
+}
+
+static void __iomem *cam_mux(struct mtk_seninf *priv, unsigned int idx)
+{
+	return priv->base + SENINF_IF_CAM_MUX(idx);
+}
+
+static void __iomem *cam_mux_gcsr(struct mtk_seninf *priv)
+{
+	return priv->base + SENINF_IF_CAM_MUX_GCSR;
+}
+
+/* ------------------------------------------------------------------ */
+/* Static routing (replaces the dynamic allocator of seninf-route.c)   */
+
+/*
+ * Mux and virtual mux ranges of the factory device tree (mux-*-range,
+ * muxvr-*-range, cammux-*-range); the formulas are those of
+ * mux2mux_vr_() and mux_vr2mux_().
+ */
+#define SENINF_SAT_MUX_FIRST		0
+#define SENINF_SAT_MUX_LAST		2
+#define SENINF_NORMAL_MUX		4
+#define SENINF_RAW_MUX_FIRST		6
+#define SENINF_RAW_MUX_LAST		8
+#define SENINF_PDP_MUX			10
+
+#define SENINF_SAT_MUXVR_FIRST		0x00
+#define SENINF_SAT_MUXVR_LAST		0x17
+#define SENINF_NORMAL_MUXVR		0x20
+#define SENINF_RAW_MUXVR_FIRST		0x22
+#define SENINF_RAW_MUXVR_LAST		0x2d
+#define SENINF_PDP_MUXVR		0x32
+
+#define SENINF_SAT_CAM_MUX_FIRST	0x00
+#define SENINF_SAT_CAM_MUX_LAST		0x0f
+#define SENINF_NORMAL_CAM_MUX		0x20
+
+#define SENINF_SAT_MUX_FACTOR		8
+#define SENINF_RAW_MUX_FACTOR		4
+
+/*
+ * Tagged ("SAT") CAMSV mux per CSI port. The choice makes the test model
+ * interface of the mux (seninf_tm_source()) either the port's own
+ * interface or one that no full port uses (SENINF_2).
+ *
+ * TODO: the muxes the downstream driver allocates are not known.
+ */
+static const u8 seninf_sat_mux[SENINF_NUM_PORTS] = { 0, 2, 1 };
+
+/* get_seninf_test_model_src() */
+static int seninf_tm_source(unsigned int mux)
+{
+	switch (mux) {
+	case 0: case 6: case 10:
+		return 0;
+	case 1: case 7: case 11:
+		return 1;
+	case 2: case 8: case 12:
+		return 2;
+	case 3: case 9: case 13:
+		return 3;
+	case 4:
+		return 4;
+	case 5:
+		return 5;
+	case 14:
+		return 6;
+	default:
+		return -EINVAL;
+	}
+}
+
+int mtk_seninf_hw_route(unsigned int port, bool sat, u8 cam_mux_base,
+			u8 tag, struct mtk_seninf_route *route)
+{
+	int tm;
+
+	if (port >= SENINF_NUM_PORTS)
+		return -EINVAL;
+
+	/* mtk_cam_seninf_init_port(): CSI_PORT_n -> SENINF_(2n + 1) */
+	route->seninf = port * 2;
+	route->tag = tag;
+	route->sat = sat;
+
+	if (sat) {
+		route->mux = seninf_sat_mux[port];
+		/* VC offset 0: one virtual channel per port */
+		route->mux_vr = (route->mux - SENINF_SAT_MUX_FIRST) *
+				SENINF_SAT_MUX_FACTOR + SENINF_SAT_MUXVR_FIRST;
+		/* mtk_cam_get_sv_cammux_id(): one cam mux per tag */
+		route->cam_mux = cam_mux_base + tag;
+		if (route->cam_mux > SENINF_SAT_CAM_MUX_LAST)
+			return -EINVAL;
+	} else {
+		route->mux = SENINF_NORMAL_MUX;
+		route->mux_vr = SENINF_NORMAL_MUXVR;
+		route->cam_mux = cam_mux_base;
+		if (route->cam_mux != SENINF_NORMAL_CAM_MUX)
+			return -EINVAL;
+	}
+
+	tm = seninf_tm_source(route->mux);
+	if (tm < 0)
+		return tm;
+	route->tm_seninf = tm;
+
+	return 0;
+}
+
+/* mux_vr2mux_(); the idle selector maps to no mux */
+static int seninf_mux_vr_to_mux(unsigned int mux_vr)
+{
+	if (mux_vr <= SENINF_SAT_MUXVR_LAST)
+		return SENINF_SAT_MUX_FIRST +
+		       (mux_vr - SENINF_SAT_MUXVR_FIRST) / SENINF_SAT_MUX_FACTOR;
+	if (mux_vr == SENINF_NORMAL_MUXVR)
+		return SENINF_NORMAL_MUX;
+	if (mux_vr >= SENINF_RAW_MUXVR_FIRST && mux_vr <= SENINF_RAW_MUXVR_LAST)
+		return SENINF_RAW_MUX_FIRST +
+		       (mux_vr - SENINF_RAW_MUXVR_FIRST) / SENINF_RAW_MUX_FACTOR;
+	if (mux_vr == SENINF_PDP_MUXVR)
+		return SENINF_PDP_MUX;
+	return -ENOENT;
+}
+
+/* ------------------------------------------------------------------ */
+/* CSI PHY efuse (dev_read_csi_efuse(), csi_efuse_value_verify())      */
+
+bool mtk_seninf_hw_efuse_valid(u32 efuse, unsigned int port)
+{
+	unsigned int sum, check;
+
+	sum = ((efuse >> 27) & 0x1f) + ((efuse >> 22) & 0x1f) +
+	      ((efuse >> 17) & 0x1f) + ((efuse >> 12) & 0x1f) +
+	      ((efuse >> 7) & 0x1f) + port;
+
+	/* all codes zero: nothing to verify */
+	if (sum == port)
+		return true;
+
+	check = (((sum >> 4) & 0xf) + (sum & 0xf)) & 0x1f;
+	return check == (efuse & 0x1f);
+}
