--- /dev/null
+++ b/drivers/media/platform/mediatek/seninf/mtk-seninf.h
@@ -0,0 +1,179 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MediaTek MT6878 sensor interface (seninf) driver.
+ *
+ * The port/interface numbering and the per-stream parameters follow
+ * mtk_cam-seninf.h and mtk_cam-seninf-def.h of the MediaTek ISP7SP camsys
+ * driver (kernel_modules/mtkcam/camsys/isp7sp/cam, GPL-2.0).
+ *
+ * Copyright (c) 2019 MediaTek Inc.
+ * Copyright (c) 2026 serlk
+ */
+
+#ifndef _MTK_SENINF_H
+#define _MTK_SENINF_H
+
+#include <linux/clk.h>
+#include <linux/mutex.h>
+#include <linux/types.h>
+
+#include <media/media-entity.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-subdev.h>
+
+#define SENINF_DRV_NAME			"mtk-seninf-mt6878"
+
+/*
+ * CSI ports handled by this driver, all in full (4D1C / 3 trio) mode.
+ * The block has six ports; only 0..2 are described for this SoC.
+ */
+#define SENINF_NUM_PORTS		3
+
+/* Hardware instance counts (factory device tree "seninf-num", "mux-num", "cam-mux-num") */
+#define SENINF_NUM_SENINF		12
+#define SENINF_NUM_MUX			13
+#define SENINF_NUM_CAM_MUX		43
+
+#define SENINF_NUM_CLKS			3
+
+/*
+ * CSI receiver clock of the first DVFS step of the factory device tree
+ * (cdphy-dvfs-step0); it is also the GPL default SENINF_CK.
+ */
+#define SENINF_CSI_CLK_DEFAULT		312000000UL
+
+/* 8 pixels per clock, the GPL default and what the CAMSV driver uses */
+#define SENINF_PIXEL_MODE		3
+
+enum mtk_seninf_pad {
+	SENINF_PAD_SINK,
+	SENINF_PAD_SOURCE,
+	SENINF_NUM_PADS,
+};
+
+/**
+ * struct mtk_seninf_route - static path of one CSI port
+ * @seninf: seninf interface index of the port (0 = SENINF_1)
+ * @tm_seninf: seninf interface that feeds @mux in test model mode
+ * @mux: seninf mux index (0 = SENINF_MUX1)
+ * @mux_vr: cam mux source selector ("virtual" mux) of @mux
+ * @cam_mux: cam mux index that feeds the CAMSV tag
+ * @tag: CAMSV tag of the image
+ * @sat: the destination is a tagged ("SAT") CAMSV engine
+ */
+struct mtk_seninf_route {
+	u8 seninf;
+	u8 tm_seninf;
+	u8 mux;
+	u8 mux_vr;
+	u8 cam_mux;
+	u8 tag;
+	bool sat;
+};
+
+/**
+ * struct mtk_seninf_stream - parameters of one CSI-2 stream
+ * @vc: virtual channel
+ * @dt: data type
+ * @hsize: expected line length in pixels (cam mux checker)
+ * @vsize: expected number of lines (cam mux checker)
+ * @data_rate: bit rate per lane (D-PHY) or symbol rate per trio (C-PHY)
+ * @csi_clk: CSI receiver clock rate in Hz
+ * @settle_ns: fixed C-PHY HS settle time, 0 for the automatic value
+ * @test_model: feed the mux from the test model instead of the CSI port
+ */
+struct mtk_seninf_stream {
+	u8 vc;
+	u8 dt;
+	u16 hsize;
+	u16 vsize;
+	u64 data_rate;
+	unsigned long csi_clk;
+	u32 settle_ns;
+	bool test_model;
+};
+
+struct dev_pm_domain_list;
+struct mtk_seninf;
+
+/**
+ * struct mtk_seninf_port - one CSI port and its V4L2 sub-device
+ * @priv: the seninf block
+ * @id: CSI port number (0..2)
+ * @sd: V4L2 sub-device
+ * @pads: media pads
+ * @notifier: async notifier of the sensor
+ * @ctrls: control handler
+ * @test_pattern: V4L2_CID_TEST_PATTERN
+ * @sink_ep: endpoint toward the sensor, NULL when there is none
+ * @source_ep: endpoint toward the CAMSV engine
+ * @csi_clk: CSI receiver clock of the port's seninf pair
+ * @cphy: the bus is C-PHY
+ * @num_lanes: data lanes (D-PHY) or trios (C-PHY)
+ * @link_freqs: link frequencies of the sink endpoint
+ * @settle_ns: fixed C-PHY settle times, one per @link_freqs entry
+ * @num_link_freqs: number of entries of @link_freqs and @settle_ns
+ * @efuse: CSI PHY calibration word, 0 if there is none
+ * @route: static route toward the CAMSV engine
+ * @sensor: bound sensor sub-device
+ * @streaming: the port is streaming
+ * @cfg: parameters of the running stream
+ */
+struct mtk_seninf_port {
+	struct mtk_seninf *priv;
+	unsigned int id;
+
+	struct v4l2_subdev sd;
+	struct media_pad pads[SENINF_NUM_PADS];
+	struct v4l2_async_notifier notifier;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *test_pattern;
+
+	struct fwnode_handle *sink_ep;
+	struct fwnode_handle *source_ep;
+	struct clk *csi_clk;
+
+	bool cphy;
+	unsigned int num_lanes;
+	u64 *link_freqs;
+	u32 *settle_ns;
+	unsigned int num_link_freqs;
+	u32 efuse;
+
+	struct mtk_seninf_route route;
+	struct v4l2_subdev *sensor;
+	bool streaming;
+	struct mtk_seninf_stream cfg;
+};
+
+/**
+ * struct mtk_seninf - the sensor interface block
+ * @dev: device
+ * @base: seninf top, interfaces, muxes and cam muxes
+ * @ana: CSI PHYs and CSI-2 MACs
+ * @clks: camsys gates of the block
+ * @pd_list: attached power domains
+ * @hw_lock: serializes the shared registers (top mux, cam mux page, ...)
+ * @ports: CSI ports, @ports[i].priv is NULL for unused ports
+ */
+struct mtk_seninf {
+	struct device *dev;
+	void __iomem *base;
+	void __iomem *ana;
+	struct clk_bulk_data clks[SENINF_NUM_CLKS];
+	struct dev_pm_domain_list *pd_list;
+	struct mutex hw_lock;	/* shared registers */
+	struct mtk_seninf_port ports[SENINF_NUM_PORTS];
+};
+
+/* mtk-seninf-hw.c, all called with @hw_lock held */
+bool mtk_seninf_hw_efuse_valid(u32 efuse, unsigned int port);
+int mtk_seninf_hw_route(unsigned int port, bool sat, u8 cam_mux_base,
+			u8 tag, struct mtk_seninf_route *route);
+void mtk_seninf_hw_init(struct mtk_seninf *priv);
+int mtk_seninf_hw_start(struct mtk_seninf_port *port);
+void mtk_seninf_hw_stop(struct mtk_seninf_port *port);
+void mtk_seninf_hw_dump(struct mtk_seninf_port *port);
+
+#endif /* _MTK_SENINF_H */
