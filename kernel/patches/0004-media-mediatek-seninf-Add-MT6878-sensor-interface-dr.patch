+
+#define CSIRX_MAC_CSI2_HDR_MODE_0			0x0008
+#define RG_CSI2_HEADER_MODE				GENMASK(7, 0)
+#define RG_CSI2_HEADER_LEN				GENMASK(10, 8)
+
+#define CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL		0x0010
+#define RG_CSI2_RESYNC_CYCLE_CNT			GENMASK(4, 0)
+#define RG_CSI2_RESYNC_CYCLE_CNT_OPT			BIT(8)
+#define RG_CSI2_RESYNC_LRTE_EN				BIT(11)
+#define RG_CSI2_RESYNC_DMY_EN				GENMASK(15, 12)
+#define RG_CSI2_RESYNC_DMY_CYCLE			GENMASK(27, 16)
+#define RG_CSI2_RESYNC_DMY_CNT				GENMASK(31, 28)
+
+#define CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL2		0x0014
+#define RG_CSI2_DESKEW_BYPASS				BIT(24)
+#define RG_CSI2_SYNC_INIT_DESKEW_EN			BIT(25)
+
+#define CSIRX_MAC_CSI2_IRQ_G1_EN			0x00b8
