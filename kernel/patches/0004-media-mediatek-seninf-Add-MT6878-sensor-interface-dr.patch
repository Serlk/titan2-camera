+#define CPHY_FSM_FLUSH_CTRL				0x0204
+
+/* CSI_DPHY_LN0..3_FLUSH_EN, see seninf_dphy_setting() */
+#define SENINF_DPHY_LN_FLUSH_EN_ALL			GENMASK(3, 0)
+
+/* CSI-2 MAC top (ana + port + SENINF_ANA_MAC_TOP) */
+#define CSIRX_MAC_TOP_CTRL				0x0000
+#define RG_8PIX_SHARE_16PIX_DATA			BIT(16)
+
+#define CSIRX_MAC_TOP_PHY_CTRL_CSI0			0x0040
+#define PHY_SENINF_MUX0_DPHY_EN				BIT(0)
+#define PHY_SENINF_MUX0_CPHY_EN				BIT(1)
+#define RG_PHY_SENINF_MUX0_CPHY_MODE			GENMASK(9, 8)
+
+#define CSIRX_MAC_TOP_SW_RST				BIT(0)
+
+/* CSI-2 MAC (ana + port + SENINF_ANA_MAC_CSI + half) */
+#define CSIRX_MAC_CSI2_EN				0x0000
+#define CSI2_LANE0_EN					BIT(0)
+#define CSI2_LANE1_EN					BIT(1)
+#define CSI2_LANE2_EN					BIT(2)
