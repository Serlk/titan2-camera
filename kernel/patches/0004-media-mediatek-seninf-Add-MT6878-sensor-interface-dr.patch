+#define RG_DPHY_RX_LC1_SEL				GENMASK(6, 4)
+#define RG_DPHY_RX_LD0_SEL				GENMASK(10, 8)
+#define RG_DPHY_RX_LD1_SEL				GENMASK(14, 12)
+#define RG_DPHY_RX_LD2_SEL				GENMASK(18, 16)
+#define RG_DPHY_RX_LD3_SEL				GENMASK(22, 20)
