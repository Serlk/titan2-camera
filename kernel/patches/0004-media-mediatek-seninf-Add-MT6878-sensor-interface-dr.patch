+/* D-PHY digital (ana + port + SENINF_ANA_DPHY_TOP) */
+#define DPHY_RX_LANE_EN					0x0000
+#define DPHY_RX_LC0_EN					BIT(0)
+#define DPHY_RX_LC1_EN					BIT(1)
