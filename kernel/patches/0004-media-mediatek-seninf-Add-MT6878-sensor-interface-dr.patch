+/* ------------------------------------------------------------------ */
+/* Entry points                                                        */
+
+/*
+ * Read-only state of the CSI receiver of a port (the registers
+ * mtk_cam_seninf_debug() prints, without its write-to-clear steps): the
+ * analog halves, the D-PHY/C-PHY digital blocks, the CSI-2 MAC (IRQ
+ * status, last packet header, line/frame and packet counters, size
+ * checkers) and the seninf interface's CSI-2 part.
+ */
+static void seninf_dump_csi(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	struct device *dev = priv->dev;
+	void __iomem *dphy = ana_dphy(priv, port->id);
+	void __iomem *cphy = ana_cphy(priv, port->id);
+	void __iomem *mac = mac_csi(priv, port->id, 0);
+	void __iomem *top = mac_top(priv, port->id);
+	void __iomem *csi2 = seninf_csi2(priv, port->route.seninf);
+	unsigned int h;
+	u32 pkt;
+
+	dev_info(dev, "csi%u: %s, %u lanes, %llu bps/lane, csi clk %lu Hz\n",
+		 port->id, port->cphy ? "C-PHY" : "D-PHY", port->num_lanes,
+		 port->cfg.data_rate, port->cfg.csi_clk);
+
+	for (h = 0; h < 2; h++) {
+		void __iomem *a = ana_rx(priv, port->id, h);
+
+		dev_info(dev,
+			 "ana %c: ana0..8 0x%08x 0x%08x 0x%08x 0x%08x 0x%08x 0x%08x 0x%08x 0x%08x 0x%08x ana14 0x%08x set0/1 0x%08x/0x%08x afifo 0x%08x ad0/1 0x%08x/0x%08x ad_hs0 0x%08x\n",
+			 'A' + h, readl(a + CDPHY_RX_ANA_0), readl(a + CDPHY_RX_ANA_1),
+			 readl(a + CDPHY_RX_ANA_2), readl(a + CDPHY_RX_ANA_3),
+			 readl(a + CDPHY_RX_ANA_4), readl(a + CDPHY_RX_ANA_5),
+			 readl(a + CDPHY_RX_ANA_6), readl(a + CDPHY_RX_ANA_7),
+			 readl(a + CDPHY_RX_ANA_8), readl(a + CDPHY_RX_ANA_14),
+			 readl(a + CDPHY_RX_ANA_SETTING_0),
+			 readl(a + CDPHY_RX_ANA_SETTING_1),
+			 readl(a + CDPHY_RX_ASYM_AFIFO_CTRL_0),
+			 readl(a + CDPHY_RX_ANA_AD_0), readl(a + CDPHY_RX_ANA_AD_1),
+			 readl(a + CDPHY_RX_ANA_AD_HS_0));
+	}
+
+	dev_info(dev,
+		 "dphy: lane_en 0x%08x sel 0x%08x hs_rx_sw 0x%08x clk_hs 0x%08x/0x%08x data_hs 0x%08x 0x%08x 0x%08x 0x%08x deskew 0x%08x irq_en 0x%08x irq_sts 0x%08x sts0 0x%08x spare0 0x%08x v21 0x%08x\n",
+		 readl(dphy + DPHY_RX_LANE_EN), readl(dphy + DPHY_RX_LANE_SELECT),
+		 readl(dphy + DPHY_RX_HS_RX_EN_SW),
+		 readl(dphy + DPHY_RX_CLOCK_LANE_HS_PARAMETER(0)),
+		 readl(dphy + DPHY_RX_CLOCK_LANE_HS_PARAMETER(1)),
+		 readl(dphy + DPHY_RX_DATA_LANE_HS_PARAMETER(0)),
+		 readl(dphy + DPHY_RX_DATA_LANE_HS_PARAMETER(1)),
+		 readl(dphy + DPHY_RX_DATA_LANE_HS_PARAMETER(2)),
+		 readl(dphy + DPHY_RX_DATA_LANE_HS_PARAMETER(3)),
+		 readl(dphy + DPHY_RX_DESKEW_CTRL), readl(dphy + DPHY_RX_IRQ_EN),
+		 readl(dphy + DPHY_RX_IRQ_STATUS), readl(dphy + DPHY_RX_STATUS_0),
+		 readl(dphy + DPHY_RX_SPARE0), readl(dphy + DPHY_DPHYV21_CTRL));
+	dev_info(dev, "cphy: ctrl 0x%08x detect_post 0x%08x irq_en 0x%08x irq 0x%08x\n",
+		 readl(cphy + CPHY_RX_CTRL), readl(cphy + CPHY_RX_DETECT_CTRL_POST),
+		 readl(cphy + CPHY_RX_IRQ_EN), readl(cphy + CPHY_RX_IRQ_CLR));
+
+	pkt = readl(mac + CSIRX_MAC_CSI2_PACKET_STATUS);
+	dev_info(dev,
+		 "mac: top 0x%08x phy 0x%08x en 0x%08x opt 0x%08x hdr 0x%08x resync 0x%08x/0x%08x irq_en 0x%08x irq 0x%08x multi_err 0x%08x g1 0x%08x line/frame 0x%08x packet 0x%08x (dt 0x%02lx vc %lu wc %lu) pkt_cnt 0x%08x\n",
+		 readl(top + CSIRX_MAC_TOP_CTRL),
+		 readl(top + CSIRX_MAC_TOP_PHY_CTRL_CSI0),
+		 readl(mac + CSIRX_MAC_CSI2_EN), readl(mac + CSIRX_MAC_CSI2_OPT),
+		 readl(mac + CSIRX_MAC_CSI2_HDR_MODE_0),
+		 readl(mac + CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL),
+		 readl(mac + CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL2),
+		 readl(mac + CSIRX_MAC_CSI2_IRQ_EN),
+		 readl(mac + CSIRX_MAC_CSI2_IRQ_STATUS),
+		 readl(mac + CSIRX_MAC_CSI2_IRQ_MULTI_ERR_FRAME_SYNC_STATUS),
+		 readl(mac + CSIRX_MAC_CSI2_IRQ_G1_STATUS),
+		 readl(mac + CSIRX_MAC_CSI2_LINE_FRAME_NUM), pkt,
+		 (unsigned long)(pkt & 0x3f), (unsigned long)((pkt >> 8) & 0x1f),
+		 (unsigned long)(pkt >> 16),
+		 readl(mac + CSIRX_MAC_CSI2_PACKET_CNT_STATUS));
+	dev_info(dev,
+		 "mac size chk: ctrl 0x%08x 0x%08x 0x%08x 0x%08x 0x%08x rcv 0x%08x 0x%08x 0x%08x 0x%08x 0x%08x\n",
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL0),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL1),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL2),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL3),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL4),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_RCV0),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_RCV1),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_RCV2),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_RCV3),
+		 readl(mac + CSIRX_MAC_CSI2_SIZE_CHK_RCV4));
+	dev_info(dev,
+		 "seninf %u csi2: en 0x%08x opt 0x%08x di0 0x%08x ch0 0x%08x irq 0x%08x\n",
+		 port->route.seninf, readl(csi2 + SENINF_CSI2_EN),
+		 readl(csi2 + SENINF_CSI2_OPT), readl(csi2 + SENINF_CSI2_DI_CTRL(0)),
+		 readl(csi2 + SENINF_CSI2_CH_CTRL(0)),
+		 readl(csi2 + SENINF_CSI2_IRQ_STATUS));
+}
+
+/*
+ * Read-only state of one port's path: seninf top, the interface (or the
+ * test model interface), its mux, its cam mux and the cam mux globals,
+ * with a sensor also the CSI receiver (seninf_dump_csi()).
+ * The caller holds a runtime PM reference of an active device.
+ */
+void mtk_seninf_hw_dump(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	struct mtk_seninf_route *r = &port->route;
+	unsigned int intf = port->cfg.test_model ? r->tm_seninf : r->seninf;
+	void __iomem *ctrl = seninf_ctrl(priv, intf);
+	void __iomem *mux = seninf_mux(priv, r->mux);
+	void __iomem *cm = cam_mux(priv, r->cam_mux);
+	void __iomem *g = cam_mux_gcsr(priv);
+	struct device *dev = priv->dev;
+
+	dev_info(dev,
+		 "csi%u: route seninf %u tm %u mux %u mux_vr 0x%02x cam_mux 0x%02x tag %u%s; streaming %d, test model %d, vc %u dt 0x%02x %ux%u\n",
+		 port->id, r->seninf, r->tm_seninf, r->mux, r->mux_vr,
+		 r->cam_mux, r->tag, r->sat ? " sat" : "", port->streaming,
+		 port->cfg.test_model, port->cfg.vc, port->cfg.dt,
+		 port->cfg.hsize, port->cfg.vsize);
+	dev_info(dev,
+		 "top: ctrl 0x%08x ctrl2 0x%08x mux_ctrl 0x%08x 0x%08x 0x%08x irq_sts 0x%08x\n",
+		 readl(priv->base + SENINF_TOP_CTRL),
+		 readl(priv->base + SENINF_TOP_CTRL2),
+		 readl(priv->base + SENINF_TOP_MUX_CTRL(0)),
+		 readl(priv->base + SENINF_TOP_MUX_CTRL(4)),
+		 readl(priv->base + SENINF_TOP_MUX_CTRL(8)),
+		 readl(priv->base + SENINF_TOP_IRQ_STS));
+	dev_info(dev,
+		 "seninf %u: ctrl 0x%08x csi2_ctrl 0x%08x testmdl 0x%08x tg 0x%08x tm ctl 0x%08x size 0x%08x clk 0x%08x dum 0x%08x stagger 0x%08x/0x%08x\n",
+		 intf, readl(ctrl + SENINF_CTRL), readl(ctrl + SENINF_CSI2_CTRL),
+		 readl(ctrl + SENINF_TESTMDL_CTRL), readl(ctrl + SENINF_TG_CTRL),
+		 readl(ctrl + TM_CTL), readl(ctrl + TM_SIZE), readl(ctrl + TM_CLK),
+		 readl(ctrl + TM_DUM), readl(ctrl + TM_STAGGER_CTL),
+		 readl(ctrl + TM_STAGGER_CON0));
+	dev_info(dev,
+		 "mux %u: ctrl0 0x%08x ctrl1 0x%08x opt 0x%08x irq 0x%08x/0x%08x img 0x%08x size 0x%08x err 0x%08x fifo 0x%08x mon 0x%08x pix 0x%08x vc0 0x%08x\n",
+		 r->mux, readl(mux + SENINF_MUX_CTRL_0), readl(mux + SENINF_MUX_CTRL_1),
+		 readl(mux + SENINF_MUX_OPT), readl(mux + SENINF_MUX_IRQ_EN),
+		 readl(mux + SENINF_MUX_IRQ_STATUS), readl(mux + SENINF_MUX_IMG_SIZE),
+		 readl(mux + SENINF_MUX_SIZE), readl(mux + SENINF_MUX_ERR_SIZE),
+		 readl(mux + SENINF_MUX_FIFO_STATUS), readl(mux + SENINF_MUX_CAM_MON),
+		 readl(mux + SENINF_MUX_PIX_CNT), readl(mux + SENINF_MUX_VC_SEL0));
+	dev_info(dev,
+		 "cam mux 0x%02x: ctrl 0x%08x opt 0x%08x irq 0x%08x/0x%08x chk 0x%08x res 0x%08x err_res 0x%08x tag vc 0x%08x dt 0x%08x\n",
+		 r->cam_mux, readl(cm + SENINF_CAM_MUX_PCSR_CTRL),
+		 readl(cm + SENINF_CAM_MUX_PCSR_OPT),
+		 readl(cm + SENINF_CAM_MUX_PCSR_IRQ_EN),
+		 readl(cm + SENINF_CAM_MUX_PCSR_IRQ_STATUS),
+		 readl(cm + SENINF_CAM_MUX_PCSR_CHK_CTL),
+		 readl(cm + SENINF_CAM_MUX_PCSR_CHK_RES),
+		 readl(cm + SENINF_CAM_MUX_PCSR_CHK_ERR_RES),
+		 readl(cm + SENINF_CAM_MUX_PCSR_TAG_VC_SEL),
+		 readl(cm + SENINF_CAM_MUX_PCSR_TAG_DT_SEL));
+	dev_info(dev,
+		 "cam mux gcsr: ctrl 0x%08x dyn 0x%08x irq 0x%08x/0x%08x mux_en 0x%08x chk_en 0x%08x vsync_en 0x%08x sts: hsize 0x%08x vsize 0x%08x vsync 0x%08x\n",
+		 readl(g + SENINF_CAM_MUX_GCSR_CTRL),
+		 readl(g + SENINF_CAM_MUX_GCSR_DYN_CTRL),
+		 readl(g + SENINF_CAM_MUX_GCSR_IRQ_EN),
+		 readl(g + SENINF_CAM_MUX_GCSR_IRQ_STS),
+		 readl(g + SENINF_CAM_MUX_GCSR_MUX_EN),
+		 readl(g + SENINF_CAM_MUX_GCSR_CHK_EN),
+		 readl(g + SENINF_CAM_MUX_GCSR_VSYNC_IRQ_EN),
+		 readl(g + SENINF_CAM_MUX_GCSR_HSIZE_ERR_IRQ_STS),
+		 readl(g + SENINF_CAM_MUX_GCSR_VSIZE_ERR_IRQ_STS),
+		 readl(g + SENINF_CAM_MUX_GCSR_VSYNC_IRQ_STS));
+
+	if (!port->cfg.test_model)
+		seninf_dump_csi(port);
+}
+
+/* runtime_resume() of the first user: nothing routed yet */
+void mtk_seninf_hw_init(struct mtk_seninf *priv)
+{
+	unsigned int i;
+
+	lockdep_assert_held(&priv->hw_lock);
+
+	for (i = 0; i < SENINF_NUM_MUX; i++)
+		SENINF_SET(seninf_mux(priv, i), SENINF_MUX_CTRL_0,
+			   SENINF_MUX_EN, 0);
+	for (i = 0; i < SENINF_NUM_CAM_MUX; i++)
+		seninf_cam_mux_disable(priv, i);
+}
+
+/* config_hw_csi() + mtk_cam_seninf_s_stream_mux(), or the test model */
+int mtk_seninf_hw_start(struct mtk_seninf_port *port)
+{
+	int ret;
+
+	lockdep_assert_held(&port->priv->hw_lock);
+
+	if (port->cfg.test_model) {
+		seninf_test_model_start(port);
+		return 0;
+	}
+
+	seninf_reset(port, port->route.seninf);
+	seninf_set_vc(port);
+
+	/* mtk_cam_seninf_set_csi_mipi() */
+	seninf_phy_init(port);
+	seninf_mac_top(port);
+	seninf_mac_csi_fixed(mac_csi(port->priv, port->id, 0));
+	seninf_mac_csi_fixed(mac_csi(port->priv, port->id, 1));
+	seninf_mac_csi(port);
+	seninf_if_enable(port);
+	ret = seninf_phy_setting(port);
+	if (ret) {
+		seninf_csi_poweroff(port);
+		return ret;
+	}
+
+	/*
+	 * mtk_cam_seninf_set_csi_afifo_pop() only acts in 16 pixel mode;
+	 * this driver uses 8 pixel mode.
+	 */
+
+	/* a CAMSV destination takes all channel groups (VC_CH_GROUP_ALL) */
+	seninf_setup_mux(port, SENINF_SRC_MIPI_SENSOR, port->route.seninf);
+	seninf_cam_mux_start(port);
+	return 0;
+}
+
+/* mtk_cam_seninf_set_idle() + mtk_cam_seninf_poweroff() */
+void mtk_seninf_hw_stop(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+
+	lockdep_assert_held(&priv->hw_lock);
+
+	seninf_mux_disable(priv, port->route.mux);
+	seninf_cam_mux_disable(priv, port->route.cam_mux);
+
+	if (port->cfg.test_model)
+		seninf_test_model_stop(port);
+	else
+		seninf_csi_poweroff(port);
+}
diff --git a/drivers/media/platform/mediatek/seninf/mtk-seninf-regs.h b/drivers/media/platform/mediatek/seninf/mtk-seninf-regs.h
new file mode 100644
index 000000000000..3c18d9566bdb
--- /dev/null
+++ b/drivers/media/platform/mediatek/seninf/mtk-seninf-regs.h
@@ -0,0 +1,433 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MediaTek MT6878 sensor interface (seninf) registers.
+ *
+ * Register offsets and fields used by this driver, taken from the
+ * mtk_csi_phy_3_1/mtk_cam-seninf-*.h register headers of the MediaTek
+ * ISP7SP camsys driver (kernel_modules/mtkcam/camsys/isp7sp/cam,
+ * GPL-2.0); the indexed forms collapse the per-instance copies. The
+ * window layout follows mtk_cam_seninf_init_iomem() of
+ * mtk_csi_phy_3_1/mtk_cam-seninf-hw_phy_3_1.c.
+ *
+ * Copyright (c) 2020 MediaTek Inc.
+ * Copyright (c) 2026 serlk
+ */
+
+#ifndef _MTK_SENINF_REGS_H
+#define _MTK_SENINF_REGS_H
+
+#include <linux/bits.h>
+
+/* "seninf" window */
+#define SENINF_IF_CTRL(n)				(0x0200 + (n) * 0x1000)
+#define SENINF_IF_CSI2(n)				(0x0a00 + (n) * 0x1000)
+#define SENINF_IF_MUX(n)				(0x0d00 + (n) * 0x1000)
+#define SENINF_IF_CAM_MUX(n)				(0x17000 + (n) * 0x40)
+#define SENINF_IF_CAM_MUX_GCSR				0x17f00
+
+/* "csi-rx" window: one 32 KiB block per CSI port */
+#define SENINF_ANA_PORT_STRIDE				0x8000
+#define SENINF_ANA_HALF_STRIDE				0x1000	/* A -> B */
+#define SENINF_ANA_DPHY_TOP				0x2000
+#define SENINF_ANA_CPHY_TOP				0x3000
+#define SENINF_ANA_MAC_TOP				0x4000
+#define SENINF_ANA_MAC_CSI				0x5000
+
+/* seninf top (base + 0x0000) */
+#define SENINF_TOP_CTRL					0x0000
+#define SENINF_TOP_CTRL2				0x0004
+#define SENINF_TOP_IRQ_STS				0x0084
+
+/* four 5-bit source selectors per register, 8 bits apart */
+#define SENINF_TOP_MUX_CTRL(m)				(0x0010 + ((m) / 4) * 4)
+#define SENINF_TOP_MUX_SRC_SEL(m)			(GENMASK(4, 0) << (((m) % 4) * 8))
+
+/* seninf interface n (base + SENINF_IF_CTRL(n)), test model included */
+#define SENINF_CTRL					0x0000
+#define SENINF_EN					BIT(0)
+
+#define SENINF_CSI2_CTRL				0x0010
+#define RG_SENINF_CSI2_EN				BIT(0)
+#define SENINF_CSI2_SW_RST				BIT(4)
+
+#define SENINF_TESTMDL_CTRL				0x0020
+#define RG_SENINF_TESTMDL_EN				BIT(0)
+#define SENINF_TG_CTRL					0x0030
+
+#define TM_CTL						0x0d08
+#define TM_EN						BIT(0)
+#define TM_PAT						GENMASK(8, 4)
+
+#define TM_SIZE						0x0d0c
+#define TM_PXL						GENMASK(15, 0)
+#define TM_LINE						GENMASK(31, 16)
+
+#define TM_CLK						0x0d10
+#define TM_CLK_CNT					GENMASK(7, 0)
+
+#define TM_DUM						0x0d18
+#define TM_DUMMYPXL					GENMASK(15, 0)
+#define TM_VSYNC					GENMASK(31, 16)
+
+#define TM_STAGGER_CTL					0x0d24
+#define TM_STAGGER_MODE_EN				BIT(0)
+#define TM_EXP_NUM					GENMASK(6, 4)
+#define TM_VSYNC_DELAY					GENMASK(19, 12)
+
+#define TM_STAGGER_CON0					0x0d28
+#define TM_EXP_DT0					GENMASK(5, 0)
+#define TM_EXP_VSYNC_VC0				GENMASK(12, 8)
+#define TM_EXP_HSYNC_VC0				GENMASK(20, 16)
+
+/* seninf interface n, CSI-2 part (base + SENINF_IF_CSI2(n)) */
+#define SENINF_CSI2_EN					0x0000
+#define SENINF_CSI2_OPT					0x0004
+
+/* VC/DT slots 0..7 */
+#define SENINF_CSI2_DI_CTRL(s)				(0x0020 + (s) * 4)
+#define SENINF_CSI2_VC_INTERLEAVE_EN			BIT(0)
+#define SENINF_CSI2_DT_INTERLEAVE_MODE			GENMASK(5, 4)
+#define SENINF_CSI2_VC_SEL				GENMASK(12, 8)
+#define SENINF_CSI2_DT_SEL				GENMASK(21, 16)
+
+/* channel groups 0..3 */
+#define SENINF_CSI2_CH_CTRL(c)				(0x0060 + (c) * 4)
+#define SENINF_CSI2_CH_S_GRP_EN(s)			BIT(8 + (s))
+
+/* read-only status (debug dump) */
+#define SENINF_CSI2_IRQ_STATUS				0x00c8
+
+/* seninf mux (base + SENINF_IF_MUX(n)) */
+#define SENINF_MUX_CTRL_0				0x0000
+#define SENINF_MUX_EN					BIT(0)
+#define SENINF_MUX_IRQ_SW_RST				BIT(1)
+#define SENINF_MUX_SW_RST				BIT(2)
+
+#define SENINF_MUX_CTRL_1				0x0004
+#define RG_SENINF_MUX_SRC_SEL				GENMASK(3, 0)
+#define RG_SENINF_MUX_PIX_MODE_SEL			GENMASK(10, 8)
+
+#define SENINF_MUX_OPT					0x0008
+#define RG_SENINF_MUX_VS_SPLIT_EN			BIT(3)
+#define RG_SENINF_MUX_HSYNC_POL				BIT(16)
+#define RG_SENINF_MUX_VSYNC_POL				BIT(17)
+
+#define SENINF_MUX_IRQ_EN				0x0010
+#define SENINF_MUX_IRQ_STATUS				0x0018
+#define SENINF_MUX_IMG_SIZE				0x0020
+#define SENINF_MUX_SIZE					0x0030
+#define SENINF_MUX_ERR_SIZE				0x0034
+#define SENINF_MUX_FIFO_STATUS				0x0040
+#define SENINF_MUX_CAM_MON				0x00a0
+#define SENINF_MUX_PIX_CNT				0x00a4
+#define SENINF_MUX_VC_SEL0				0x0100
+#define RG_SENINF_MUX_B0_VC_SEL				GENMASK(4, 0)
+#define RG_SENINF_MUX_B0_VC_REF_EN			BIT(7)
+
+/* cam mux global part (base + SENINF_IF_CAM_MUX_GCSR) */
+#define SENINF_CAM_MUX_GCSR_CTRL			0x0000
+#define SENINF_CAM_MUX_GCSR_DYN_CTRL			0x0004
+#define RG_SENINF_CAM_MUX_GCSR_DYN_PAGE_SEL		BIT(7)
+
+#define SENINF_CAM_MUX_GCSR_IRQ_EN			0x0008
+#define RG_SENINF_CAM_MUX_GCSR_SKIP_NEXT_FRAME_IRQ_EN	GENMASK(9, 8)
+
+#define SENINF_CAM_MUX_GCSR_IRQ_STS			0x000c
+#define SENINF_CAM_MUX_GCSR_MUX_EN			0x0080
+#define SENINF_CAM_MUX_GCSR_CHK_EN			0x0088
+#define SENINF_CAM_MUX_GCSR_VSYNC_IRQ_EN		0x00c0
+
+#define SENINF_CAM_MUX_GCSR_VSYNC_IRQ_EN_H		0x00c4
+#define SENINF_CAM_MUX_GCSR_HSIZE_ERR_IRQ_STS		0x00c8
+#define SENINF_CAM_MUX_GCSR_VSIZE_ERR_IRQ_STS		0x00d0
+#define SENINF_CAM_MUX_GCSR_VSYNC_IRQ_STS		0x00d8
+
+/* cam mux n (base + SENINF_IF_CAM_MUX(n)) */
+#define SENINF_CAM_MUX_PCSR_CTRL			0x0000
+#define RG_SENINF_CAM_MUX_PCSR_SRC_SEL			GENMASK(6, 0)
+#define RG_SENINF_CAM_MUX_PCSR_EN			BIT(7)
+#define RG_SENINF_CAM_MUX_PCSR_CHK_PIX_MODE		GENMASK(10, 8)
+#define CAM_MUX_PCSR_NEXT_SRC_SEL			GENMASK(22, 16)
+
+#define SENINF_CAM_MUX_PCSR_OPT				0x0004
+#define RG_SENINF_CAM_MUX_PCSR_VC_SEL			GENMASK(4, 0)
+#define RG_SENINF_CAM_MUX_PCSR_VC_SEL_EN		BIT(7)
+#define RG_SENINF_CAM_MUX_PCSR_DT_SEL			GENMASK(13, 8)
+#define RG_SENINF_CAM_MUX_PCSR_DT_SEL_EN		BIT(15)
+#define RG_SENINF_CAM_MUX_PCSR_TAG_VC_DT_PAGE_SEL	GENMASK(26, 24)
+
+#define SENINF_CAM_MUX_PCSR_IRQ_EN			0x0008
+#define SENINF_CAM_MUX_PCSR_IRQ_STATUS			0x000c
+#define RO_SENINF_CAM_MUX_PCSR_HSIZE_ERR_IRQ		BIT(0)
+#define RO_SENINF_CAM_MUX_PCSR_VSIZE_ERR_IRQ		BIT(1)
+#define RO_SENINF_CAM_MUX_PCSR_VSYNC_IRQ		BIT(8)
+
+#define SENINF_CAM_MUX_PCSR_CHK_CTL			0x0014
+#define RG_SENINF_CAM_MUX_PCSR_EXP_HSIZE		GENMASK(15, 0)
+#define RG_SENINF_CAM_MUX_PCSR_EXP_VSIZE		GENMASK(31, 16)
+#define SENINF_CAM_MUX_PCSR_CHK_RES			0x0018
+#define SENINF_CAM_MUX_PCSR_CHK_ERR_RES			0x001c
+
+#define SENINF_CAM_MUX_PCSR_TAG_VC_SEL			0x0020
+
+#define SENINF_CAM_MUX_PCSR_TAG_DT_SEL			0x0024
+
+/* tag 4 * page + n of the page selected in PCSR_OPT */
+#define SENINF_CAM_MUX_TAG_VC_SEL(n)			(GENMASK(4, 0) << ((n) * 8))
+#define SENINF_CAM_MUX_TAG_DT_SEL(n)			(GENMASK(5, 0) << ((n) * 8))
+#define SENINF_CAM_MUX_TAG_SEL_EN(n)			BIT((n) * 8 + 7)
+
+/* analog PHY, A and B half (ana + port + half) */
+#define CDPHY_RX_ANA_0					0x0000
+#define RG_CSI0_BG_CORE_EN				BIT(0)
+#define RG_CSI0_BG_LPF_EN				BIT(1)
+#define RG_CSI0_CPHY_T0_HSMODE_EN			BIT(6)
+#define RG_CSI0_CPHY_T1_HSMODE_EN			BIT(7)
+#define RG_CSI0_DPHY_L2_CKMODE_EN			BIT(14)
+#define RG_CSI0_CPHY_EN					BIT(20)
+#define RG_CSI0_CPHY_T0_CDR_FIRST_EDGE_EN		BIT(21)
+#define RG_CSI0_CPHY_T1_CDR_FIRST_EDGE_EN		BIT(22)
+
+#define CDPHY_RX_ANA_1					0x0004
+#define RG_CSI0_BG_LPRX_VTL_SEL				GENMASK(2, 0)
+#define RG_CSI0_BG_LPRX_VTH_SEL				GENMASK(6, 4)
+#define RG_CSI0_BG_VREF_SEL				GENMASK(11, 8)
+#define RG_CSI0_CDPHY_EQ_DES_VREF_SEL			GENMASK(18, 16)
+
+#define CDPHY_RX_ANA_2					0x0008
+#define RG_CSI0_L0P_T0A_HSRT_CODE			GENMASK(4, 0)
+#define RG_CSI0_L0N_T0B_HSRT_CODE			GENMASK(12, 8)
+#define RG_CSI0_CPHY_T0_CDR_SELF_CAL_EN			BIT(16)
+#define RG_CSI0_CPHY_T1_CDR_SELF_CAL_EN			BIT(17)
+#define RG_CSI0_BG_ALP_RX_VTL_SEL			GENMASK(26, 24)
+#define RG_CSI0_BG_ALP_RX_VTH_SEL			GENMASK(30, 28)
+
+#define CDPHY_RX_ANA_3					0x000c
+#define RG_CSI0_L1P_T0C_HSRT_CODE			GENMASK(4, 0)
+#define RG_CSI0_L1N_T1A_HSRT_CODE			GENMASK(12, 8)
+#define RG_CSI0_EQ_DES_VREF_SEL				GENMASK(25, 20)
+
+#define CDPHY_RX_ANA_4					0x0010
+#define RG_CSI0_L2P_T1B_HSRT_CODE			GENMASK(4, 0)
+#define RG_CSI0_L2N_T1C_HSRT_CODE			GENMASK(12, 8)
+
+#define CDPHY_RX_ANA_5					0x0014
+#define RG_CSI0_CDPHY_EQ_BW				GENMASK(1, 0)
+#define RG_CSI0_CDPHY_EQ_IS				GENMASK(3, 2)
+#define RG_CSI0_CDPHY_EQ_DG0_EN				BIT(4)
+#define RG_CSI0_CDPHY_EQ_SR0				GENMASK(11, 8)
+#define RG_CSI0_ULPS_IGNORE_EN				BIT(30)
+
+#define CDPHY_RX_ANA_6					0x0018
+#define RG_CSI0_CPHY_T0_CDR_AB_WIDTH			GENMASK(4, 0)
+#define RG_CSI0_CPHY_T0_CDR_BC_WIDTH			GENMASK(12, 8)
+#define RG_CSI0_CPHY_T0_CDR_CA_WIDTH			GENMASK(20, 16)
+#define RG_CSI0_CPHY_T0_CDR_CK_DELAY			GENMASK(28, 24)
+
+#define CDPHY_RX_ANA_7					0x001c
+#define RG_CSI0_CPHY_T1_CDR_AB_WIDTH			GENMASK(4, 0)
+#define RG_CSI0_CPHY_T1_CDR_BC_WIDTH			GENMASK(12, 8)
+#define RG_CSI0_CPHY_T1_CDR_CA_WIDTH			GENMASK(20, 16)
+#define RG_CSI0_CPHY_T1_CDR_CK_DELAY			GENMASK(28, 24)
+
+#define CDPHY_RX_ANA_8					0x0020
+#define RG_CSI0_RESERVE					GENMASK(15, 0)
+
+#define CDPHY_RX_ANA_14					0x0038
+#define RG_CSI0_CDPHY_EQ_OS_IS				BIT(8)
+#define RG_CSI0_LDO_LP_EN				BIT(24)
+
+/* read-only analog lane state (debug dump) */
+#define CDPHY_RX_ANA_AD_0				0x0048
