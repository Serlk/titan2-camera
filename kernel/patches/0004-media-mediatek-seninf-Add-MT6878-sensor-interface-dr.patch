+
+#define CSIRX_MAC_CSI2_DT0				0x0104
+#define RG_CSI2_RAW10_DT				GENMASK(5, 0)
+#define RG_CSI2_RAW12_DT				GENMASK(13, 8)
+#define RG_CSI2_RAW14_DT				GENMASK(21, 16)
+#define RG_CSI2_RAW16_DT				GENMASK(29, 24)
+
+#define CSIRX_MAC_CSI2_FORCEDT0				0x0110
