+/* clock lanes 0..1 */
+#define DPHY_RX_CLOCK_LANE_HS_PARAMETER(n)		(0x0010 + (n) * 4)
+#define DPHY_RX_LC_HS_PREPARE_PARAMETER			GENMASK(7, 0)
