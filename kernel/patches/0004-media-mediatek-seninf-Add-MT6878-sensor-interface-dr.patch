+/* ------------------------------------------------------------------ */
+/* Analog PHY                                                          */
+
+/* csirx_phyA_power_on() */
+static void seninf_phya_power(void __iomem *ana, bool on)
+{
+	SENINF_SET_ALL(ana, CDPHY_RX_ANA_8, SENINF_EQ_OS_CAL_EN_ALL, false);
+	SENINF_SET(ana, CDPHY_RX_ANA_0, RG_CSI0_BG_LPF_EN, 0);
+	SENINF_SET(ana, CDPHY_RX_ANA_0, RG_CSI0_BG_CORE_EN, 0);
+	fsleep(200);
+
+	if (!on)
+		return;
+
+	SENINF_SET(ana, CDPHY_RX_ANA_0, RG_CSI0_BG_CORE_EN, 1);
+	fsleep(30);
+	SENINF_SET(ana, CDPHY_RX_ANA_0, RG_CSI0_BG_LPF_EN, 1);
+	udelay(1);
+	SENINF_SET_ALL(ana, CDPHY_RX_ANA_8, SENINF_EQ_OS_CAL_EN_ALL, true);
+	udelay(1);
+}
+
+/* csirx_phyA_init(), one half */
+static void seninf_phya_init_half(void __iomem *ana)
+{
+	SENINF_SET(ana, CDPHY_RX_ANA_1, RG_CSI0_BG_LPRX_VTL_SEL, 0x4);
+	SENINF_SET(ana, CDPHY_RX_ANA_1, RG_CSI0_BG_LPRX_VTH_SEL, 0x4);
+	SENINF_SET(ana, CDPHY_RX_ANA_2, RG_CSI0_BG_ALP_RX_VTL_SEL, 0x4);
+	SENINF_SET(ana, CDPHY_RX_ANA_2, RG_CSI0_BG_ALP_RX_VTH_SEL, 0x4);
+	SENINF_SET(ana, CDPHY_RX_ANA_1, RG_CSI0_BG_VREF_SEL, 0x8);
+	SENINF_SET(ana, CDPHY_RX_ANA_1, RG_CSI0_CDPHY_EQ_DES_VREF_SEL, 0x2);
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_CDPHY_EQ_BW, 0x1);
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_CDPHY_EQ_IS, 0x1);
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_CDPHY_EQ_DG0_EN, 0x0);
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_CDPHY_EQ_SR0, 0x0);
+
+	SENINF_SET(ana, CDPHY_RX_ANA_2, RG_CSI0_L0P_T0A_HSRT_CODE, 0x10);
+	SENINF_SET(ana, CDPHY_RX_ANA_2, RG_CSI0_L0N_T0B_HSRT_CODE, 0x10);
+	SENINF_SET(ana, CDPHY_RX_ANA_3, RG_CSI0_L1P_T0C_HSRT_CODE, 0x10);
+	SENINF_SET(ana, CDPHY_RX_ANA_3, RG_CSI0_L1N_T1A_HSRT_CODE, 0x10);
+	SENINF_SET(ana, CDPHY_RX_ANA_4, RG_CSI0_L2P_T1B_HSRT_CODE, 0x10);
+	SENINF_SET(ana, CDPHY_RX_ANA_4, RG_CSI0_L2N_T1C_HSRT_CODE, 0x10);
+	SENINF_SET(ana, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T0_CDR_FIRST_EDGE_EN, 0x0);
+	SENINF_SET(ana, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T1_CDR_FIRST_EDGE_EN, 0x0);
+	SENINF_SET(ana, CDPHY_RX_ANA_2, RG_CSI0_CPHY_T0_CDR_SELF_CAL_EN, 0x0);
+	SENINF_SET(ana, CDPHY_RX_ANA_2, RG_CSI0_CPHY_T1_CDR_SELF_CAL_EN, 0x0);
+
+	SENINF_SET(ana, CDPHY_RX_ANA_6, RG_CSI0_CPHY_T0_CDR_CK_DELAY, 0x4);
+	SENINF_SET(ana, CDPHY_RX_ANA_7, RG_CSI0_CPHY_T1_CDR_CK_DELAY, 0x4);
+	SENINF_SET(ana, CDPHY_RX_ANA_6, RG_CSI0_CPHY_T0_CDR_AB_WIDTH, 0xa);
+	SENINF_SET(ana, CDPHY_RX_ANA_6, RG_CSI0_CPHY_T0_CDR_BC_WIDTH, 0xa);
+	SENINF_SET(ana, CDPHY_RX_ANA_6, RG_CSI0_CPHY_T0_CDR_CA_WIDTH, 0xa);
+	SENINF_SET(ana, CDPHY_RX_ANA_7, RG_CSI0_CPHY_T1_CDR_AB_WIDTH, 0xa);
+	SENINF_SET(ana, CDPHY_RX_ANA_7, RG_CSI0_CPHY_T1_CDR_BC_WIDTH, 0xa);
+	SENINF_SET(ana, CDPHY_RX_ANA_7, RG_CSI0_CPHY_T1_CDR_CA_WIDTH, 0xa);
+
+	/* non-ULPS mode */
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_ULPS_IGNORE_EN, 0x1);
+	/* LDO low power mode on */
+	SENINF_SET(ana, CDPHY_RX_ANA_14, RG_CSI0_LDO_LP_EN, 0x1);
+	/* EQ latch enable (reserve bit 8) */
+	SENINF_SET(ana, CDPHY_RX_ANA_8, RG_CSI0_RESERVE, BIT(8));
+}
+
+/* apply_efuse_data(), full port: A and B halves */
+static void seninf_phya_efuse(struct mtk_seninf_port *port)
+{
+	void __iomem *a = ana_rx(port->priv, port->id, 0);
+	void __iomem *b = ana_rx(port->priv, port->id, 1);
+	u32 e = port->efuse;
+
+	if (!e)
+		return;
+
+	SENINF_SET(a, CDPHY_RX_ANA_2, RG_CSI0_L0P_T0A_HSRT_CODE, (e >> 27) & 0x1f);
+	SENINF_SET(a, CDPHY_RX_ANA_2, RG_CSI0_L0N_T0B_HSRT_CODE, (e >> 27) & 0x1f);
+	SENINF_SET(a, CDPHY_RX_ANA_3, RG_CSI0_L1P_T0C_HSRT_CODE, (e >> 22) & 0x1f);
+	SENINF_SET(a, CDPHY_RX_ANA_3, RG_CSI0_L1N_T1A_HSRT_CODE, (e >> 22) & 0x1f);
+	SENINF_SET(a, CDPHY_RX_ANA_4, RG_CSI0_L2P_T1B_HSRT_CODE, (e >> 17) & 0x1f);
+	SENINF_SET(a, CDPHY_RX_ANA_4, RG_CSI0_L2N_T1C_HSRT_CODE, (e >> 17) & 0x1f);
+
+	SENINF_SET(b, CDPHY_RX_ANA_2, RG_CSI0_L0P_T0A_HSRT_CODE, (e >> 12) & 0x1f);
+	SENINF_SET(b, CDPHY_RX_ANA_2, RG_CSI0_L0N_T0B_HSRT_CODE, (e >> 12) & 0x1f);
+	SENINF_SET(b, CDPHY_RX_ANA_3, RG_CSI0_L1P_T0C_HSRT_CODE, (e >> 7) & 0x1f);
+	SENINF_SET(b, CDPHY_RX_ANA_3, RG_CSI0_L1N_T1A_HSRT_CODE, (e >> 7) & 0x1f);
+	SENINF_SET(b, CDPHY_RX_ANA_4, RG_CSI0_L2P_T1B_HSRT_CODE, (e >> 2) & 0x1f);
+	SENINF_SET(b, CDPHY_RX_ANA_4, RG_CSI0_L2N_T1C_HSRT_CODE, (e >> 2) & 0x1f);
+}
+
+/* ------------------------------------------------------------------ */
+/* Digital PHY timing (csirx_dphy_init(), csirx_cphy_init())           */
+
+#define SENINF_DPHY_SETTLE_DEF_NS	100
+#define SENINF_CPHY_SETTLE_DEF_NS	70
+
+/* settle_formula(): CSI clock cycles minus the fixed 6-cycle latency */
+static u32 seninf_settle_formula(u64 ns, unsigned long clk)
+{
+	return DIV_ROUND_UP_ULL(ns * clk, NSEC_PER_SEC) - 6;
+}
+
+static void seninf_dphy_timing(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf_stream *cfg = &port->cfg;
+	void __iomem *dphy = ana_dphy(port->priv, port->id);
+	u32 settle_dt, settle_ck;
+	unsigned int i;
+
+	if (port->cphy) {
+		/* fixed per-mode value of the sensor, else the default */
+		if (cfg->settle_ns)
+			settle_dt = DIV_ROUND_UP_ULL((u64)cfg->settle_ns *
+						     cfg->csi_clk, NSEC_PER_SEC);
+		else
+			settle_dt = seninf_settle_formula(SENINF_CPHY_SETTLE_DEF_NS,
+							  cfg->csi_clk);
+		settle_ck = settle_dt;
+	} else {
+		/*
+		 * The GPL code takes the D-PHY settle from the sensor only
+		 * when the sensor sets "not_fixed_dphy_settle"; none of the
+		 * factory sensors does, so the data settle is always the
+		 * default and the clock settle 0.
+		 */
+		settle_dt = seninf_settle_formula(SENINF_DPHY_SETTLE_DEF_NS,
+						  cfg->csi_clk);
+		settle_ck = 0;
+	}
+
+	dev_dbg(port->priv->dev, "csi%u: settle %u/%u at %lu Hz\n", port->id,
+		settle_dt, settle_ck, cfg->csi_clk);
+
+	for (i = 0; i < 4; i++)
+		SENINF_SET(dphy, DPHY_RX_DATA_LANE_HS_PARAMETER(i),
+			   DPHY_RX_LD_HS_SETTLE_PARAMETER, settle_dt);
+	for (i = 0; i < 2; i++)
+		SENINF_SET(dphy, DPHY_RX_CLOCK_LANE_HS_PARAMETER(i),
+			   DPHY_RX_LC_HS_SETTLE_PARAMETER, settle_ck);
+	for (i = 0; i < 4; i++)
+		SENINF_SET(dphy, DPHY_RX_DATA_LANE_HS_PARAMETER(i),
+			   DPHY_RX_LD_HS_PREPARE_PARAMETER, 0);
+
+	/*
+	 * HS trail: the sensors give no fixed trail (dphy_trail = 0), for
+	 * which the GPL rule programs 0 and keeps the trail check off.
+	 */
+	for (i = 0; i < 4; i++)
+		SENINF_SET(dphy, DPHY_RX_DATA_LANE_HS_PARAMETER(i),
+			   DPHY_RX_LD_HS_TRAIL_PARAMETER, 0);
+
+	if (!port->cphy) {
+		for (i = 0; i < 4; i++)
+			SENINF_SET(dphy, DPHY_RX_DATA_LANE_HS_PARAMETER(i),
+				   DPHY_RX_LD_HS_TRAIL_EN, 0);
+
+		/* rx deskew on, deskew delay off for lanes 0..3 */
+		SENINF_SET(dphy, DPHY_RX_DESKEW_CTRL, RG_DPHY_RX_DESKEW_EN, 1);
+		for (i = 0; i < 4; i++)
+			SENINF_SET(dphy, DPHY_RX_DESKEW_LANE_CTRL(i),
+				   DPHY_RX_DESKEW_L_DELAY_EN, 0);
+
+		for (i = 0; i < 4; i++)
+			SENINF_SET(dphy, DPHY_RX_DATA_LANE_HS_PARAMETER(i),
+				   DPHY_RX_LD_HS_PREPARE_EN, 1);
+		for (i = 0; i < 2; i++) {
+			SENINF_SET(dphy, DPHY_RX_CLOCK_LANE_HS_PARAMETER(i),
+				   DPHY_RX_LC_HS_PREPARE_PARAMETER, 0);
+			SENINF_SET(dphy, DPHY_RX_CLOCK_LANE_HS_PARAMETER(i),
+				   DPHY_RX_LC_HS_PREPARE_EN, 1);
+		}
+	} else {
+		for (i = 0; i < 4; i++)
+			SENINF_SET(dphy, DPHY_RX_DATA_LANE_HS_PARAMETER(i),
+				   DPHY_RX_LD_HS_TRAIL_EN, 0);
+		for (i = 0; i < 2; i++)
+			SENINF_SET(dphy, DPHY_RX_CLOCK_LANE_HS_PARAMETER(i),
+				   DPHY_RX_LC_HS_PREPARE_EN, 0);
+	}
+}
+
+/* csirx_phy_init() */
+static void seninf_phy_init(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+
+	seninf_phya_init_half(ana_rx(priv, port->id, 0));
+	seninf_phya_init_half(ana_rx(priv, port->id, 1));
+	seninf_phya_efuse(port);
+
+	seninf_dphy_timing(port);
+
+	SENINF_SET(ana_cphy(priv, port->id), CPHY_RX_DETECT_CTRL_POST,
+		   RG_CPHY_RX_DATA_VALID_POST_EN, 1);
+}
+
+/* ------------------------------------------------------------------ */
+/* CSI-2 MAC                                                           */
+
+/* csirx_mac_top_setting() */
+static void seninf_mac_top(struct mtk_seninf_port *port)
+{
+	void __iomem *top = mac_top(port->priv, port->id);
+
+	/* full port: no 8/16 pixel bus sharing, no split mode */
+	SENINF_SET(top, CSIRX_MAC_TOP_CTRL, RG_8PIX_SHARE_16PIX_DATA, 0);
+
+	if (port->cphy) {
+		SENINF_SET(top, CSIRX_MAC_TOP_PHY_CTRL_CSI0,
+			   PHY_SENINF_MUX0_DPHY_EN, 0);
+		SENINF_SET(top, CSIRX_MAC_TOP_PHY_CTRL_CSI0,
+			   PHY_SENINF_MUX0_CPHY_EN, 1);
+	} else {
+		SENINF_SET(top, CSIRX_MAC_TOP_PHY_CTRL_CSI0,
+			   PHY_SENINF_MUX0_CPHY_EN, 0);
+		SENINF_SET(top, CSIRX_MAC_TOP_PHY_CTRL_CSI0,
+			   PHY_SENINF_MUX0_DPHY_EN, 1);
+	}
+	SENINF_SET(top, CSIRX_MAC_TOP_PHY_CTRL_CSI0,
+		   RG_PHY_SENINF_MUX0_CPHY_MODE, 0);
+}
+
+/* the options common to csirx_mac_csi_fixed_setting() and _setting() */
+static void seninf_mac_csi_opt(void __iomem *mac)
+{
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_ECC_EN, 1);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_B2P_EN, 1);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_IMG_PACKET_EN, 1);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_SPEC_V2P0_SEL, 1);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_MULTI_FRAME_VLD_EN, 1);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_VS_OUTPUT_MODE, 0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_VS_OUTPUT_LEN_SEL, 0);
+}
+
+/* csirx_mac_csi_fixed_setting(), one half */
+static void seninf_mac_csi_fixed(void __iomem *mac)
+{
+	seninf_mac_csi_opt(mac);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_DMY_EN, 0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_CYCLE_CNT_OPT, 1);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_CYCLE_CNT, 0x1f);
+
+	SENINF_SET_ALL(mac, CSIRX_MAC_CSI2_IRQ_G1_EN,
+		       SENINF_DESKEW_FIFO_OVF_IRQ_EN_ALL, true);
+
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_RAW8_PIXEL_DOUBLE, 0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL2,
+		   RG_CSI2_DESKEW_BYPASS, 0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL2,
+		   RG_CSI2_SYNC_INIT_DESKEW_EN, 0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_SPARE, RG_CSI2_SPARE_0, 0);
+}
+
+/* csirx_mac_csi_setting(), full port */
+static void seninf_mac_csi(struct mtk_seninf_port *port)
+{
+	/* C-PHY header length by trio count */
+	static const u8 cphy_hdr_len[] = { 0, 1, 2, 4, 5 };
+	void __iomem *mac = mac_csi(port->priv, port->id, 0);
+
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_CPHY_SEL, port->cphy);
+
+	/* lanes (D-PHY) or trios (C-PHY) in use */
+	SENINF_SET(mac, CSIRX_MAC_CSI2_EN, CSI2_LANE0_EN, port->num_lanes >= 1);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_EN, CSI2_LANE1_EN, port->num_lanes >= 2);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_EN, CSI2_LANE2_EN, port->num_lanes >= 3);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_EN, CSI2_LANE3_EN, port->num_lanes >= 4);
+
+	/* full port: 8 pixel output */
+	SENINF_SET(mac, CSIRX_MAC_CSI2_OPT, RG_CSI2_8_16_PIXEL_SEL, 0);
+
+	seninf_mac_csi_opt(mac);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_CYCLE_CNT, 0x1f);
+
+	/* MAC size checkers */
+	writel(0x002b0011, mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL0);
+	writel(0x002b0111, mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL1);
+	writel(0x002b0211, mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL2);
+	writel(0x002c0011, mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL3);
+	writel(0x002d0011, mac + CSIRX_MAC_CSI2_SIZE_CHK_CTRL4);
+
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_CYCLE_CNT_OPT, 1);
+
+	writel(0x80000000, mac + CSIRX_MAC_CSI2_IRQ_EN);
+
+	SENINF_SET(mac, CSIRX_MAC_CSI2_DBG_CTRL, RG_CSI2_DBG_PACKET_CNT_EN, 1);
+
+	if (port->cphy) {
+		SENINF_SET(mac, CSIRX_MAC_CSI2_HDR_MODE_0, RG_CSI2_HEADER_MODE, 2);
+		SENINF_SET(mac, CSIRX_MAC_CSI2_HDR_MODE_0, RG_CSI2_HEADER_LEN,
+			   cphy_hdr_len[port->num_lanes]);
+	} else {
+		SENINF_SET(mac, CSIRX_MAC_CSI2_HDR_MODE_0, RG_CSI2_HEADER_MODE, 0);
+		SENINF_SET(mac, CSIRX_MAC_CSI2_HDR_MODE_0, RG_CSI2_HEADER_LEN, 0);
+	}
+
+	/*
+	 * Resync dummy cycles stay off. The GPL code computes a dummy cycle
+	 * count but does not program it.
+	 */
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_DMY_CYCLE, 0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_DMY_CNT, 0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_DMY_EN, 0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_LRTE_EN, 0);
+
+	/* csirx_mac_csi_lrte_setting() without LRTE support: keep it off */
+	SENINF_SET(mac, CSIRX_MAC_CSI2_RESYNC_MERGE_CTRL,
+		   RG_CSI2_RESYNC_LRTE_EN, 0);
+	SENINF_SET(ana_cphy(port->priv, port->id), CPHY_RX_CAL_ALP_CTRL,
+		   RG_CPHY_ALP_EN, 0);
+}
+
+/* mtk_cam_seninf_set_seninf_top_ctrl2(): afifo pop split from 1T to 2T */
+static void seninf_top_afifo_pop_half(struct mtk_seninf_port *port, bool on)
+{
+	void __iomem *top = port->priv->base;
+	u32 bit = BIT(port->id);	/* full port n: A bit n */
+
+	seninf_rmw(top + SENINF_TOP_CTRL2, bit, on ? bit : 0);
+}
+
+/* seninf1_setting() */
+static void seninf_if_enable(struct mtk_seninf_port *port)
+{
+	void __iomem *ctrl = seninf_ctrl(port->priv, port->route.seninf);
+
+	seninf_top_afifo_pop_half(port, true);
+	SENINF_SET(ctrl, SENINF_CSI2_CTRL, RG_SENINF_CSI2_EN, 1);
+	SENINF_SET(ctrl, SENINF_CTRL, SENINF_EN, 1);
+}
+
+/* ------------------------------------------------------------------ */
+/* PHY setting (csirx_phyA_setting(), csirx_dphy/cphy_setting())       */
+
+struct seninf_eq {
+	u64 max_rate;
+	u8 bw, dg0, sr0, is, os_is, cdr_delay;
+};
+
+/* D-PHY non-split mode, by lane bit rate */
+static const struct seninf_eq seninf_dphy_eq[] = {
+	{ 1500000000ULL, 0x1, 0x0, 0x0, 0x2, 0x1, 0 },
+	{ 2500000000ULL, 0x1, 0x1, 0x0, 0x2, 0x1, 0 },
+	{ 4500000000ULL, 0x3, 0x1, 0x0, 0x1, 0x0, 0 },
+};
+
+/* C-PHY non-split mode, by trio symbol rate */
+static const struct seninf_eq seninf_cphy_eq[] = {
+	{ 1500000000ULL, 0x1, 0x0, 0x0, 0x2, 0x1, 0x14 },
+	{ 2500000000ULL, 0x1, 0x1, 0x0, 0x2, 0x1, 0x0c },
+	{ 4500000000ULL, 0x3, 0x1, 0x0, 0x1, 0x0, 0x05 },
+};
+
+static const struct seninf_eq *seninf_find_eq(const struct seninf_eq *t,
+					      unsigned int n, u64 rate)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		if (rate < t[i].max_rate)
+			return &t[i];
+	return NULL;
+}
+
+static void seninf_phya_eq(void __iomem *ana, const struct seninf_eq *eq,
+			   bool cphy)
+{
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_CDPHY_EQ_BW, eq->bw);
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_CDPHY_EQ_DG0_EN, eq->dg0);
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_CDPHY_EQ_SR0, eq->sr0);
+	if (cphy) {
+		SENINF_SET(ana, CDPHY_RX_ANA_6, RG_CSI0_CPHY_T0_CDR_CK_DELAY,
+			   eq->cdr_delay);
+		SENINF_SET(ana, CDPHY_RX_ANA_7, RG_CSI0_CPHY_T1_CDR_CK_DELAY,
+			   eq->cdr_delay);
+	}
+	SENINF_SET(ana, CDPHY_RX_ANA_5, RG_CSI0_CDPHY_EQ_IS, eq->is);
+	SENINF_SET(ana, CDPHY_RX_ANA_14, RG_CSI0_CDPHY_EQ_OS_IS, eq->os_is);
+}
+
+static int seninf_phya_dphy(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	void __iomem *a = ana_rx(priv, port->id, 0);
+	void __iomem *b = ana_rx(priv, port->id, 1);
+	u64 rate = port->cfg.data_rate;
+	const struct seninf_eq *eq;
+	u32 pn_swap, dummy;
+
+	eq = seninf_find_eq(seninf_dphy_eq, ARRAY_SIZE(seninf_dphy_eq), rate);
+	if (!eq) {
+		dev_err(priv->dev, "csi%u: D-PHY rate %llu bps not supported\n",
+			port->id, rate);
+		return -ERANGE;
+	}
+
+	pn_swap = SENINF_GET(ana_dphy(priv, port->id), DPHY_RX_HS_RX_EN_SW,
+			     RG_DPHY_PHY_PN_SWAP_EN);
+	dummy = port->num_lanes > 1 ? 0x3 : 0x5;
+
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_CSI0_ASYNC_OPTION,
+		   (!pn_swap && rate < 4000000000ULL) ? 0x4 : 0x0);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_NUM, dummy);
+	SENINF_SET(b, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_NUM, dummy);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_EN, 0x1);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_PREPARE_NUM, 0x4);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, AFIFO_DUMMY_VALID_GAP_NUM, 0x4);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_0, CSR_ASYNC_FIFO_GATING_SEL, 0x2);
+
+	/* non-split mode: clock on A lane 2, data on A/B lanes */
+	SENINF_SET(a, CDPHY_RX_ANA_0, RG_CSI0_CPHY_EN, 0);
+	SENINF_SET(b, CDPHY_RX_ANA_0, RG_CSI0_CPHY_EN, 0);
+	SENINF_SET_ALL(a, CDPHY_RX_ANA_0, SENINF_DPHY_CKMODE_EN_ALL, false);
+	SENINF_SET_ALL(b, CDPHY_RX_ANA_0, SENINF_DPHY_CKMODE_EN_ALL, false);
+	SENINF_SET_ALL(a, CDPHY_RX_ANA_0, SENINF_DPHY_CKSEL_ALL, true);
+	SENINF_SET_ALL(b, CDPHY_RX_ANA_0, SENINF_DPHY_CKSEL_ALL, true);
+	SENINF_SET(a, CDPHY_RX_ANA_0, RG_CSI0_DPHY_L2_CKMODE_EN, 1);
+
+	SENINF_SET(a, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T0_HSMODE_EN, 1);
+	SENINF_SET(a, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T1_HSMODE_EN, 1);
+	SENINF_SET(b, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T0_HSMODE_EN, 1);
+	SENINF_SET(b, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T1_HSMODE_EN, 1);
+
+	seninf_phya_eq(a, eq, false);
+	seninf_phya_eq(b, eq, false);
+	return 0;
+}
+
+static int seninf_phya_cphy(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	void __iomem *a = ana_rx(priv, port->id, 0);
+	void __iomem *b = ana_rx(priv, port->id, 1);
+	u64 rate = port->cfg.data_rate;
+	const struct seninf_eq *eq;
+	u32 ana5;
+
+	eq = seninf_find_eq(seninf_cphy_eq, ARRAY_SIZE(seninf_cphy_eq), rate);
+	if (!eq) {
+		dev_err(priv->dev, "csi%u: C-PHY rate %llu sps not supported\n",
+			port->id, rate);
+		return -ERANGE;
+	}
+
+	SENINF_SET(a, CDPHY_RX_ANA_0, RG_CSI0_CPHY_EN, 1);
+	SENINF_SET(b, CDPHY_RX_ANA_0, RG_CSI0_CPHY_EN, 1);
+	SENINF_SET(a, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T0_HSMODE_EN, 1);
+	SENINF_SET(a, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T1_HSMODE_EN, 1);
+	SENINF_SET(b, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T0_HSMODE_EN, 1);
+	SENINF_SET(b, CDPHY_RX_ANA_0, RG_CSI0_CPHY_T1_HSMODE_EN, 1);
+
+	ana5 = rate < 2500000000ULL ? 0x55 : 0x157;
+	writel(ana5, a + CDPHY_RX_ANA_5);
+	writel(ana5, b + CDPHY_RX_ANA_5);
+	writel(0x322, a + CDPHY_RX_ANA_SETTING_0);
+	writel(0x322, b + CDPHY_RX_ANA_SETTING_0);
+
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_EN, 0x1);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_CSI0_ASYNC_OPTION, 0xc);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_PREPARE_NUM,
+		   port->num_lanes > 1 ? 0x5 : 0x6);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_NUM,
+		   port->num_lanes > 1 ? 0x4 : 0x6);
+	SENINF_SET(b, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_NUM,
+		   port->num_lanes > 1 ? 0x4 : 0x6);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, AFIFO_DUMMY_VALID_GAP_NUM, 0x4);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_0, CSR_ASYNC_FIFO_GATING_SEL, 0x2);
+
+	SENINF_SET(a, CDPHY_RX_ANA_3, RG_CSI0_EQ_DES_VREF_SEL, 0x20);
+	SENINF_SET(b, CDPHY_RX_ANA_3, RG_CSI0_EQ_DES_VREF_SEL, 0x20);
+
+	seninf_phya_eq(a, eq, true);
+	seninf_phya_eq(b, eq, true);
+	return 0;
+}
+
+/* csirx_dphy_setting(), non-split mode */
+static int seninf_dphy_setting(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	void __iomem *dphy = ana_dphy(priv, port->id);
+	void __iomem *a = ana_rx(priv, port->id, 0);
+	void __iomem *b = ana_rx(priv, port->id, 1);
+	u32 dummy = port->num_lanes > 1 ? 3 : 5;
+	u32 reserve;
+
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_NUM, dummy);
+	SENINF_SET(b, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_NUM, dummy);
+
+	/*
+	 * Flush on all lanes. The GPL code writes the lane flush bits at
+	 * the C-PHY offset of the flush register (0x204) in the D-PHY block;
+	 * kept as is. TODO: whether DPHY_FSM_FLUSH_CTRL (0x370) is
+	 * meant.
+	 */
+	SENINF_SET_ALL(dphy, CPHY_FSM_FLUSH_CTRL, SENINF_DPHY_LN_FLUSH_EN_ALL,
+		       true);
+
+	/* only csi A: RG_CSI0_RESERVE[0] */
+	reserve = SENINF_GET(a, CDPHY_RX_ANA_8, RG_CSI0_RESERVE) | 0x1;
+	SENINF_SET(a, CDPHY_RX_ANA_8, RG_CSI0_RESERVE, reserve);
+
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, AFIFO_DUMMY_VALID_GAP_NUM, 0x3);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_PREPARE_NUM, 0x0);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, AFIFO_DUMMY_VALID_DESKEW_EN, 0x1);
+	SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_SPLIT_EN, 0x0);
+	SENINF_SET(b, CDPHY_RX_ANA_SETTING_1, AFIFO_DUMMY_VALID_GAP_NUM, 0x3);
+	SENINF_SET(b, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_PREPARE_NUM, 0x0);
+	SENINF_SET(b, CDPHY_RX_ANA_SETTING_1, AFIFO_DUMMY_VALID_DESKEW_EN, 0x1);
+
+	switch (port->num_lanes) {
+	case 2:	/* 2D1C-AB */
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LC0_EN, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LC1_EN, 0);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LD0_EN, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LD1_EN, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LD2_EN, 0);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LD3_EN, 0);
+
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LC0_SEL, 2);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LC1_SEL, 0);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LD0_SEL, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LD1_SEL, 3);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LD2_SEL, 0);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LD3_SEL, 0);
+
+		SENINF_SET(a, CDPHY_RX_ASYM_AFIFO_CTRL_0, L1_AFIFO_FLUSH_EN, 0x1);
+		SENINF_SET(b, CDPHY_RX_ASYM_AFIFO_CTRL_0, L0_AFIFO_FLUSH_EN, 0x1);
+		break;
+	case 4:	/* 4D1C */
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LC0_EN, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LC1_EN, 0);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LD0_EN, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LD1_EN, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LD2_EN, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_EN, DPHY_RX_LD3_EN, 1);
+
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LC0_SEL, 2);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LC1_SEL, 0);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LD0_SEL, 1);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LD1_SEL, 3);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LD2_SEL, 0);
+		SENINF_SET(dphy, DPHY_RX_LANE_SELECT, RG_DPHY_RX_LD3_SEL, 4);
+
+		SENINF_SET(a, CDPHY_RX_ASYM_AFIFO_CTRL_0, L0_AFIFO_FLUSH_EN, 0x1);
+		SENINF_SET(a, CDPHY_RX_ASYM_AFIFO_CTRL_0, L1_AFIFO_FLUSH_EN, 0x1);
+		SENINF_SET(b, CDPHY_RX_ASYM_AFIFO_CTRL_0, L0_AFIFO_FLUSH_EN, 0x1);
+		SENINF_SET(b, CDPHY_RX_ASYM_AFIFO_CTRL_0, L1_AFIFO_FLUSH_EN, 0x1);
+		break;
+	default:
+		/* one lane needs a split port */
+		return -EINVAL;
+	}
+
+	SENINF_SET(dphy, DPHY_RX_LANE_SELECT, DPHY_RX_CK_DATA_MUX_EN, 1);
+	SENINF_SET(dphy, DPHY_RX_HS_RX_EN_SW, RG_DPHY_PHY_PN_SWAP_EN, 0);
+	SENINF_SET(dphy, DPHY_DPHYV21_CTRL, RG_DPHY_RX_SYNC_METH_SEL, 1);
+	writel(0xf1, dphy + DPHY_RX_SPARE0);
+
+	/* csirx_dphy_init_deskew_setting() without init deskew */
+	SENINF_SET(dphy, DPHY_RX_DESKEW_LANE_CTRL(0), DPHY_RX_DESKEW_L_DELAY_EN, 0);
+	SENINF_SET(dphy, DPHY_RX_DESKEW_LANE_CTRL(1), DPHY_RX_DESKEW_L_DELAY_EN, 0);
+	SENINF_SET(dphy, DPHY_RX_DESKEW_LANE_CTRL(2), DPHY_RX_DESKEW_L_DELAY_EN, 0);
+	SENINF_SET(dphy, DPHY_RX_DESKEW_LANE_CTRL(3), DPHY_RX_DESKEW_L_DELAY_EN, 0);
+
+	writel(0xf, dphy + DPHY_RX_IRQ_EN);
+	return 0;
+}
+
+/* csirx_cphy_setting(), full port */
+static int seninf_cphy_setting(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	void __iomem *cphy = ana_cphy(priv, port->id);
+	void __iomem *dphy = ana_dphy(priv, port->id);
+	void __iomem *a = ana_rx(priv, port->id, 0);
+	void __iomem *b = ana_rx(priv, port->id, 1);
+	u32 dummy = port->num_lanes > 1 ? 0x4 : 0x6;
+	unsigned int i;
+
+	for (i = 0; i < 2; i++) {
+		void __iomem *h = i ? b : a;
+
+		SENINF_SET(h, CDPHY_RX_ANA_SETTING_1, RG_CSI0_ASYNC_OPTION, 0xc);
+		SENINF_SET(h, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_EN, 0x1);
+		SENINF_SET(h, CDPHY_RX_ANA_SETTING_1, RG_AFIFO_DUMMY_VALID_NUM, dummy);
+		SENINF_SET(h, CDPHY_RX_ANA_SETTING_1, AFIFO_DUMMY_VALID_GAP_NUM, 0x1);
+		SENINF_SET(h, CDPHY_RX_ANA_SETTING_1,
+			   RG_AFIFO_DUMMY_VALID_PREPARE_NUM, 0x0);
+		SENINF_SET(h, CDPHY_RX_ANA_SETTING_1, AFIFO_DUMMY_VALID_DESKEW_EN,
+			   i ? 0x0 : 0x1);
+		if (!i)
+			SENINF_SET(h, CDPHY_RX_ANA_SETTING_1, RG_SPLIT_EN, 0x0);
+	}
+
+	switch (port->num_lanes) {
+	case 3:
+		SENINF_SET(a, CDPHY_RX_ASYM_AFIFO_CTRL_0, L0_AFIFO_FLUSH_EN, 0x1);
+		SENINF_SET(a, CDPHY_RX_ASYM_AFIFO_CTRL_0, L2_AFIFO_FLUSH_EN, 0x1);
+		SENINF_SET(b, CDPHY_RX_ASYM_AFIFO_CTRL_0, L0_AFIFO_FLUSH_EN, 0x1);
+
+		SENINF_SET(cphy, CPHY_VALID_PIPE_EN, CPHY_TRIO0_VALID_PIPE_EN, 1);
+		SENINF_SET(cphy, CPHY_VALID_PIPE_EN, CPHY_TRIO1_VALID_PIPE_EN, 1);
+		SENINF_SET(cphy, CPHY_VALID_PIPE_EN, CPHY_TRIO2_VALID_PIPE_EN, 1);
+		SENINF_SET(cphy, CPHY_RX_CTRL, CPHY_RX_TR0_LPRX_EN, 1);
+		SENINF_SET(cphy, CPHY_RX_CTRL, CPHY_RX_TR1_LPRX_EN, 1);
+		SENINF_SET(cphy, CPHY_RX_CTRL, CPHY_RX_TR2_LPRX_EN, 1);
+		SENINF_SET(cphy, CPHY_RX_CTRL, CPHY_RX_TR3_LPRX_EN, 0);
+		break;
+	case 2:
+		SENINF_SET(a, CDPHY_RX_ASYM_AFIFO_CTRL_0, L0_AFIFO_FLUSH_EN, 0x1);
+		SENINF_SET(a, CDPHY_RX_ASYM_AFIFO_CTRL_0, L2_AFIFO_FLUSH_EN, 0x1);
+
+		SENINF_SET(cphy, CPHY_VALID_PIPE_EN, CPHY_TRIO0_VALID_PIPE_EN, 1);
+		SENINF_SET(cphy, CPHY_VALID_PIPE_EN, CPHY_TRIO1_VALID_PIPE_EN, 1);
+		SENINF_SET(cphy, CPHY_RX_CTRL, CPHY_RX_TR0_LPRX_EN, 1);
+		SENINF_SET(cphy, CPHY_RX_CTRL, CPHY_RX_TR1_LPRX_EN, 1);
+		break;
+	case 1:
+		SENINF_SET(a, CDPHY_RX_ANA_SETTING_1, RG_SPLIT_EN, 0x1);
+		SENINF_SET(a, CDPHY_RX_ASYM_AFIFO_CTRL_0, L0_AFIFO_FLUSH_EN, 0x1);
+
+		SENINF_SET(cphy, CPHY_VALID_PIPE_EN, CPHY_TRIO0_VALID_PIPE_EN, 1);
+		SENINF_SET(cphy, CPHY_RX_CTRL, CPHY_RX_TR0_LPRX_EN, 1);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* not a legacy PHY */
+	writel(0xf1, dphy + DPHY_RX_SPARE0);
+
+	writel(0xf, cphy + CPHY_RX_IRQ_EN);
+	writel(0xff0000, cphy + CPHY_RX_IRQ_CLR);
+	return 0;
+}
+
+/* csirx_phy_setting() */
+static int seninf_phy_setting(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	int ret;
+
+	ret = port->cphy ? seninf_phya_cphy(port) : seninf_phya_dphy(port);
+	if (ret)
+		return ret;
+
+	seninf_phya_power(ana_rx(priv, port->id, 0), true);
+	seninf_phya_power(ana_rx(priv, port->id, 1), true);
+
+	return port->cphy ? seninf_cphy_setting(port) :
+			    seninf_dphy_setting(port);
+}
+
+/* mtk_cam_seninf_poweroff() */
+static void seninf_csi_poweroff(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+
+	writel(0, seninf_csi2(priv, port->route.seninf) + SENINF_CSI2_EN);
+	seninf_phya_power(ana_rx(priv, port->id, 0), false);
+	seninf_phya_power(ana_rx(priv, port->id, 1), false);
+}
+
+/* ------------------------------------------------------------------ */
+/* seninf interface, VC/DT filter                                      */
+
+static unsigned int seninf_top_mux_src(struct mtk_seninf *priv,
+				       unsigned int mux)
+{
+	return field_get(SENINF_TOP_MUX_SRC_SEL(mux),
+			 readl(priv->base + SENINF_TOP_MUX_CTRL(mux)));
+}
+
+/* mtk_cam_seninf_set_top_mux_ctrl() */
+static void seninf_set_top_mux(struct mtk_seninf *priv, unsigned int mux,
+			       unsigned int seninf)
+{
+	u32 mask = SENINF_TOP_MUX_SRC_SEL(mux);
+
+	seninf_rmw(priv->base + SENINF_TOP_MUX_CTRL(mux), mask,
+		   field_prep(mask, seninf));
+}
+
+/* mtk_cam_seninf_reset() */
+static void seninf_reset(struct mtk_seninf_port *port, unsigned int seninf)
+{
+	struct mtk_seninf *priv = port->priv;
+	void __iomem *ctrl = seninf_ctrl(priv, seninf);
+	void __iomem *top = mac_top(priv, port->id);
+	unsigned int i;
+
+	SENINF_SET(ctrl, SENINF_CSI2_CTRL, SENINF_CSI2_SW_RST, 1);
+	udelay(1);
+	SENINF_SET(ctrl, SENINF_CSI2_CTRL, SENINF_CSI2_SW_RST, 0);
+
+	SENINF_SET(top, CSIRX_MAC_TOP_CTRL, CSIRX_MAC_TOP_SW_RST, 1);
+	udelay(1);
+	SENINF_SET(top, CSIRX_MAC_TOP_CTRL, CSIRX_MAC_TOP_SW_RST, 0);
+
+	for (i = 0; i < SENINF_NUM_MUX; i++) {
+		void __iomem *mux = seninf_mux(priv, i);
+
+		if (seninf_top_mux_src(priv, i) != seninf ||
+		    !SENINF_GET(mux, SENINF_MUX_CTRL_0, SENINF_MUX_EN))
+			continue;
+
+		SENINF_SET(mux, SENINF_MUX_CTRL_0, SENINF_MUX_SW_RST, 1);
+		udelay(1);
+		SENINF_SET(mux, SENINF_MUX_CTRL_0, SENINF_MUX_SW_RST, 0);
+	}
+}
+
+/* mtk_cam_seninf_reset_dt_remap() */
+static void seninf_reset_dt_remap(void __iomem *mac)
+{
+	writel(0, mac + CSIRX_MAC_CSI2_FORCEDT0);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_DT0, RG_CSI2_RAW16_DT, 0x2e);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_DT0, RG_CSI2_RAW14_DT, 0x2d);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_DT0, RG_CSI2_RAW12_DT, 0x2c);
+	SENINF_SET(mac, CSIRX_MAC_CSI2_DT0, RG_CSI2_RAW10_DT, 0x2b);
+}
+
+/* mtk_cam_seninf_set_vc() for a single VC/DT in slot 0 */
+static void seninf_set_vc(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	struct mtk_seninf_stream *cfg = &port->cfg;
+	void __iomem *csi2 = seninf_csi2(priv, port->route.seninf);
+	unsigned int i;
+
+	for (i = 0; i < 8; i++)
+		writel(0, csi2 + SENINF_CSI2_DI_CTRL(i));
+	for (i = 0; i < 4; i++)
+		writel(0, csi2 + SENINF_CSI2_CH_CTRL(i));
+
+	seninf_reset_dt_remap(mac_csi(priv, port->id, 0));
+
+	SENINF_SET(csi2, SENINF_CSI2_DI_CTRL(0), SENINF_CSI2_DT_SEL, cfg->dt);
+	SENINF_SET(csi2, SENINF_CSI2_DI_CTRL(0), SENINF_CSI2_VC_SEL, cfg->vc);
+	SENINF_SET(csi2, SENINF_CSI2_DI_CTRL(0), SENINF_CSI2_DT_INTERLEAVE_MODE, 1);
+	SENINF_SET(csi2, SENINF_CSI2_DI_CTRL(0), SENINF_CSI2_VC_INTERLEAVE_EN, 1);
+
+	/* slot 0 in channel group 0 (VC_CH_GROUP_ALL) */
+	SENINF_SET(csi2, SENINF_CSI2_CH_CTRL(0), SENINF_CSI2_CH_S_GRP_EN(0), 1);
+}
+
+/* ------------------------------------------------------------------ */
+/* seninf mux                                                          */
+
+#define SENINF_SRC_TEST_MODEL		0x1
+#define SENINF_SRC_MIPI_SENSOR		0x8
+#define SENINF_CAM_MUX_IDLE_SRC		0x7f
+
+/* mtk_cam_seninf_set_mux_ctrl() */
+static void seninf_set_mux_ctrl(struct mtk_seninf *priv, unsigned int idx,
+				unsigned int src, unsigned int pix_mode)
+{
+	void __iomem *mux = seninf_mux(priv, idx);
+	u32 ctrl0;
+
+	SENINF_SET(mux, SENINF_MUX_CTRL_1, RG_SENINF_MUX_SRC_SEL, src);
+	SENINF_SET(mux, SENINF_MUX_CTRL_1, RG_SENINF_MUX_PIX_MODE_SEL, pix_mode);
+
+	SENINF_SET(mux, SENINF_MUX_OPT, RG_SENINF_MUX_VS_SPLIT_EN, 1);
+	SENINF_SET(mux, SENINF_MUX_OPT, RG_SENINF_MUX_HSYNC_POL, 0);
+	SENINF_SET(mux, SENINF_MUX_OPT, RG_SENINF_MUX_VSYNC_POL, 0);
+
+	/* pulse the mux and mux IRQ resets */
+	ctrl0 = readl(mux + SENINF_MUX_CTRL_0);
+	writel(ctrl0 | SENINF_MUX_IRQ_SW_RST | SENINF_MUX_SW_RST,
+	       mux + SENINF_MUX_CTRL_0);
+	writel(ctrl0 & ~(SENINF_MUX_IRQ_SW_RST | SENINF_MUX_SW_RST),
+	       mux + SENINF_MUX_CTRL_0);
+}
+
+static void seninf_mux_enable(struct mtk_seninf *priv, unsigned int idx)
+{
+	SENINF_SET(seninf_mux(priv, idx), SENINF_MUX_CTRL_0, SENINF_MUX_EN, 1);
+}
+
+/* get_mux() of seninf-route.c for one VC toward a CAMSV engine */
+static void seninf_setup_mux(struct mtk_seninf_port *port, unsigned int src,
+			     unsigned int seninf)
+{
+	struct mtk_seninf *priv = port->priv;
+	struct mtk_seninf_route *r = &port->route;
+
+	seninf_mux_enable(priv, r->mux);
+	seninf_set_mux_ctrl(priv, r->mux, src, SENINF_PIXEL_MODE);
+	seninf_set_top_mux(priv, r->mux, seninf);
+
+	/* mtk_cam_seninf_set_mux_vc_split_all(): SAT type, VC offset 0 */
+	if (r->sat) {
+		void __iomem *mux = seninf_mux(priv, r->mux);
+
+		SENINF_SET(mux, SENINF_MUX_VC_SEL0, RG_SENINF_MUX_B0_VC_SEL,
+			   port->cfg.vc);
+		SENINF_SET(mux, SENINF_MUX_VC_SEL0, RG_SENINF_MUX_B0_VC_REF_EN, 1);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* cam mux                                                             */
+
+static void seninf_cam_mux_page(struct mtk_seninf *priv, bool inner)
+{
+	SENINF_SET(cam_mux_gcsr(priv), SENINF_CAM_MUX_GCSR_DYN_CTRL,
+		   RG_SENINF_CAM_MUX_GCSR_DYN_PAGE_SEL, inner ? 0 : 1);
+}
+
+static void seninf_cam_mux_clear_irq(void __iomem *cm)
+{
+	writel(RO_SENINF_CAM_MUX_PCSR_HSIZE_ERR_IRQ |
+	       RO_SENINF_CAM_MUX_PCSR_VSIZE_ERR_IRQ |
+	       RO_SENINF_CAM_MUX_PCSR_VSYNC_IRQ,
+	       cm + SENINF_CAM_MUX_PCSR_IRQ_STATUS);
+}
+
+/* mtk_cam_seninf_disable_cammux() */
+static void seninf_cam_mux_disable(struct mtk_seninf *priv, unsigned int idx)
+{
+	void __iomem *gcsr = cam_mux_gcsr(priv);
+	void __iomem *cm = cam_mux(priv, idx);
+	unsigned int i;
+
+	/* vsync IRQ of this cam mux and the global drop IRQs off */
+	if (idx < 32)
+		seninf_rmw(gcsr + SENINF_CAM_MUX_GCSR_VSYNC_IRQ_EN, BIT(idx), 0);
+	else
+		seninf_rmw(gcsr + SENINF_CAM_MUX_GCSR_VSYNC_IRQ_EN_H,
+			   BIT(idx - 32), 0);
+	SENINF_SET(gcsr, SENINF_CAM_MUX_GCSR_IRQ_EN,
+		   RG_SENINF_CAM_MUX_GCSR_SKIP_NEXT_FRAME_IRQ_EN, 0);
+
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CTRL, CAM_MUX_PCSR_NEXT_SRC_SEL,
+		   SENINF_CAM_MUX_IDLE_SRC);
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CTRL, RG_SENINF_CAM_MUX_PCSR_SRC_SEL,
+		   SENINF_CAM_MUX_IDLE_SRC);
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CTRL, RG_SENINF_CAM_MUX_PCSR_EN, 0);
+
+	/* clear the tags of all pages */
+	for (i = 0; i < 4; i++) {
+		SENINF_SET(cm, SENINF_CAM_MUX_PCSR_OPT,
+			   RG_SENINF_CAM_MUX_PCSR_TAG_VC_DT_PAGE_SEL, i);
+		writel(0, cm + SENINF_CAM_MUX_PCSR_TAG_VC_SEL);
+		writel(0, cm + SENINF_CAM_MUX_PCSR_TAG_DT_SEL);
+	}
+
+	seninf_cam_mux_clear_irq(cm);
+}
+
+/* mtk_cam_seninf_disable_mux(): also its cam muxes */
+static void seninf_mux_disable(struct mtk_seninf *priv, unsigned int idx)
+{
+	unsigned int i, src;
+
+	SENINF_SET(seninf_mux(priv, idx), SENINF_MUX_CTRL_0, SENINF_MUX_EN, 0);
+
+	for (i = 0; i < SENINF_NUM_CAM_MUX; i++) {
+		src = SENINF_GET(cam_mux(priv, i), SENINF_CAM_MUX_PCSR_CTRL,
+				 RG_SENINF_CAM_MUX_PCSR_SRC_SEL);
+		if (seninf_mux_vr_to_mux(src) == idx)
+			seninf_cam_mux_disable(priv, i);
+	}
+}
+
+/*
+ * One page of the cam mux setup of mtk_cam_seninf_s_stream_mux():
+ * VC/DT filter, tag, source and size check, pixel mode, enable, next
+ * source.
+ */
+static void seninf_cam_mux_program(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf_route *r = &port->route;
+	struct mtk_seninf_stream *cfg = &port->cfg;
+	void __iomem *cm = cam_mux(port->priv, r->cam_mux);
+	unsigned int sel = r->tag % 4;
+	bool dt_en = cfg->dt != 0;
+	/*
+	 * The test model sends its own frame size (SENINF_TM_PIXELS x
+	 * SENINF_TM_LINES), not the pad format: mtk_cam_seninf_set_test_model()
+	 * leaves the expected size of the size checker at 0 then.
+	 */
+	u16 hsize = cfg->test_model ? 0 : cfg->hsize;
+	u16 vsize = cfg->test_model ? 0 : cfg->vsize;
+
+	/* mtk_cam_seninf_set_cammux_vc() */
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_OPT, RG_SENINF_CAM_MUX_PCSR_VC_SEL,
+		   cfg->vc);
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_OPT, RG_SENINF_CAM_MUX_PCSR_DT_SEL,
+		   cfg->dt);
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_OPT, RG_SENINF_CAM_MUX_PCSR_VC_SEL_EN,
+		   dt_en);
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_OPT, RG_SENINF_CAM_MUX_PCSR_DT_SEL_EN,
+		   dt_en);
+
+	/* mtk_cam_seninf_set_cammux_tag(), tags 0..31 */
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_OPT,
+		   RG_SENINF_CAM_MUX_PCSR_TAG_VC_DT_PAGE_SEL, r->tag / 4);
+	seninf_rmw(cm + SENINF_CAM_MUX_PCSR_TAG_VC_SEL,
+		   SENINF_CAM_MUX_TAG_VC_SEL(sel) | SENINF_CAM_MUX_TAG_SEL_EN(sel),
+		   field_prep(SENINF_CAM_MUX_TAG_VC_SEL(sel), cfg->vc) |
+		   SENINF_CAM_MUX_TAG_SEL_EN(sel));
+	seninf_rmw(cm + SENINF_CAM_MUX_PCSR_TAG_DT_SEL,
+		   SENINF_CAM_MUX_TAG_DT_SEL(sel) | SENINF_CAM_MUX_TAG_SEL_EN(sel),
+		   field_prep(SENINF_CAM_MUX_TAG_DT_SEL(sel), cfg->dt) |
+		   SENINF_CAM_MUX_TAG_SEL_EN(sel));
+
+	/* mtk_cam_seninf_set_cammux_src() (raw data: no YUV doubling) */
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CTRL, RG_SENINF_CAM_MUX_PCSR_SRC_SEL,
+		   r->mux_vr);
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CHK_CTL,
+		   RG_SENINF_CAM_MUX_PCSR_EXP_HSIZE, hsize);
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CHK_CTL,
+		   RG_SENINF_CAM_MUX_PCSR_EXP_VSIZE, vsize);
+
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CTRL,
+		   RG_SENINF_CAM_MUX_PCSR_CHK_PIX_MODE, SENINF_PIXEL_MODE);
+
+	/* mtk_cam_seninf_cammux() */
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CTRL, RG_SENINF_CAM_MUX_PCSR_EN, 1);
+	seninf_cam_mux_clear_irq(cm);
+
+	/* mtk_cam_seninf_set_cammux_next_ctrl() */
+	SENINF_SET(cm, SENINF_CAM_MUX_PCSR_CTRL, CAM_MUX_PCSR_NEXT_SRC_SEL,
+		   r->mux_vr);
+}
+
+/* mtk_cam_seninf_s_stream_mux(): outer page, then the active page */
+static void seninf_cam_mux_start(struct mtk_seninf_port *port)
+{
+	seninf_cam_mux_page(port->priv, false);
+	seninf_cam_mux_program(port);
+	seninf_cam_mux_page(port->priv, true);
+	seninf_cam_mux_program(port);
+}
+
+/* ------------------------------------------------------------------ */
+/* Test model (mtk_cam_seninf_set_test_model())                        */
+
+/*
+ * TODO: the meaning of the TM_SIZE fields and of the TM_PAT
+ * codes is not documented; these are the GPL values (5632 pixels by
+ * 4224 lines, pattern 0xc). The CAMSV engine crops the frame to its own
+ * size.
+ */
+#define SENINF_TM_PIXELS		5632
+#define SENINF_TM_LINES			4224
+#define SENINF_TM_CLK_CNT		7
+#define SENINF_TM_DUMMY			100
+#define SENINF_TM_PATTERN		0xc
+#define SENINF_TM_VSYNC_DELAY		0xa
+
+static void seninf_test_model_start(struct mtk_seninf_port *port)
+{
+	struct mtk_seninf *priv = port->priv;
+	struct mtk_seninf_stream *cfg = &port->cfg;
+	void __iomem *ctrl = seninf_ctrl(priv, port->route.tm_seninf);
+
+	seninf_reset(port, port->route.tm_seninf);
+	seninf_setup_mux(port, SENINF_SRC_TEST_MODEL, port->route.tm_seninf);
+	seninf_cam_mux_start(port);
+
+	SENINF_SET(ctrl, SENINF_TESTMDL_CTRL, RG_SENINF_TESTMDL_EN, 1);
+	SENINF_SET(ctrl, SENINF_CTRL, SENINF_EN, 1);
+
+	SENINF_SET(ctrl, TM_SIZE, TM_LINE, SENINF_TM_LINES);
+	SENINF_SET(ctrl, TM_SIZE, TM_PXL, SENINF_TM_PIXELS);
+	SENINF_SET(ctrl, TM_CLK, TM_CLK_CNT, SENINF_TM_CLK_CNT);
+	SENINF_SET(ctrl, TM_DUM, TM_VSYNC, SENINF_TM_DUMMY);
+	SENINF_SET(ctrl, TM_DUM, TM_DUMMYPXL, SENINF_TM_DUMMY);
+	SENINF_SET(ctrl, TM_CTL, TM_PAT, SENINF_TM_PATTERN);
+	SENINF_SET(ctrl, TM_CTL, TM_EN, 1);
+
+	/* VC/DT tagged output, one exposure */
+	SENINF_SET(ctrl, TM_STAGGER_CTL, TM_EXP_NUM, 0);
+	SENINF_SET(ctrl, TM_STAGGER_CTL, TM_VSYNC_DELAY, SENINF_TM_VSYNC_DELAY);
+	SENINF_SET(ctrl, TM_STAGGER_CTL, TM_STAGGER_MODE_EN, 1);
+	SENINF_SET(ctrl, TM_STAGGER_CON0, TM_EXP_DT0, cfg->dt);
+	SENINF_SET(ctrl, TM_STAGGER_CON0, TM_EXP_VSYNC_VC0, cfg->vc);
+	SENINF_SET(ctrl, TM_STAGGER_CON0, TM_EXP_HSYNC_VC0, cfg->vc);
+}
+
+static void seninf_test_model_stop(struct mtk_seninf_port *port)
+{
+	void __iomem *ctrl = seninf_ctrl(port->priv, port->route.tm_seninf);
+
+	SENINF_SET(ctrl, TM_CTL, TM_EN, 0);
+	SENINF_SET(ctrl, SENINF_TESTMDL_CTRL, RG_SENINF_TESTMDL_EN, 0);
+}
