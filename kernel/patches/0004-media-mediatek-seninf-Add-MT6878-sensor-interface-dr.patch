+
+/* C-PHY digital (ana + port + SENINF_ANA_CPHY_TOP) */
+#define CPHY_RX_CTRL					0x0000
+#define CPHY_RX_TR0_LPRX_EN				BIT(0)
+#define CPHY_RX_TR1_LPRX_EN				BIT(1)
+#define CPHY_RX_TR2_LPRX_EN				BIT(2)
+#define CPHY_RX_TR3_LPRX_EN				BIT(3)
+
+#define CPHY_RX_DETECT_CTRL_POST			0x0018
+#define RG_CPHY_RX_DATA_VALID_POST_EN			BIT(4)
+
+#define CPHY_RX_IRQ_EN					0x00f0
+
+#define CPHY_RX_IRQ_CLR					0x00f4
+
+#define CPHY_RX_CAL_ALP_CTRL				0x0130
+#define RG_CPHY_ALP_EN					BIT(1)
+
+#define CPHY_VALID_PIPE_EN				0x0168
+#define CPHY_TRIO0_VALID_PIPE_EN			BIT(0)
