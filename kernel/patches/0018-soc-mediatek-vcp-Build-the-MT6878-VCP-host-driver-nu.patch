+/*
+ * Optional "mediatek,smi": the SMI (sub-)common the VCP's memory port goes
+ * through. Linked as a runtime PM supplier, it is powered and clocked
+ * whenever the VCP is.
+ */
+static void vcp_unlink_smi(struct device *dev)
+{
+	unsigned int i;
+
+	for (i = 0; i < VCP_MAX_SMI; i++) {
+		if (vcp_smi_devs[i])
+			device_link_remove(dev, vcp_smi_devs[i]);
+		vcp_smi_devs[i] = NULL;
+	}
+}
+
+static int vcp_link_smi(struct device *dev)
+{
+	struct platform_device *smi_pdev;
+	struct device_node *np;
+	struct device_link *link;
+	unsigned int i;
+
+	for (i = 0; i < VCP_MAX_SMI; i++) {
+		np = of_parse_phandle(dev->of_node, "mediatek,smi", i);
+		if (!np)
+			break;
+		smi_pdev = of_find_device_by_node(np);
+		of_node_put(np);
+		if (!smi_pdev || !platform_get_drvdata(smi_pdev)) {
+			if (smi_pdev)
+				put_device(&smi_pdev->dev);
+			vcp_unlink_smi(dev);
+			return -EPROBE_DEFER;
+		}
+		link = device_link_add(dev, &smi_pdev->dev,
+				       DL_FLAG_PM_RUNTIME | DL_FLAG_STATELESS);
+		put_device(&smi_pdev->dev);
+		if (!link) {
+			vcp_unlink_smi(dev);
+			return dev_err_probe(dev, -ENODEV,
+					     "cannot link to the smi\n");
+		}
+		vcp_smi_devs[i] = &smi_pdev->dev;
+	}
+	return 0;
+}
