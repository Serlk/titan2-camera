+/*
+ * The mailbox copies msg_size words into the buffer given here, so a pin
+ * is only registered when the table gives it the size of its buffer. A
+ * start cannot succeed without the ready pin and the interrupt of its
+ * mailbox; the others are reported.
+ */
+static int vcp_register_pin(struct device *dev, int ipi_id, mbox_pin_cb_t cb,
+			    void *buf, unsigned int words, const char *name)
+{
+	struct mtk_mbox_pin_recv *pin = vcp_ipidev.table[ipi_id].pin_recv;
+	int ret;
+
+	if (!pin) {
+		dev_notice(dev, "%s pin %d: not in the receive table\n", name, ipi_id);
+		return -ENOENT;
+	}
+	if (!buf) {
+		/* no fixed size: take what the table says */
+		words = pin->msg_size;
+		buf = devm_kcalloc(dev, words, sizeof(u32), GFP_KERNEL);
+		if (!buf)
+			return -ENOMEM;
+	}
+	if (pin->msg_size != words) {
+		dev_err(dev, "%s pin %d: %u words in the table, %u expected\n",
+			name, ipi_id, pin->msg_size, words);
+		return -EMSGSIZE;
+	}
+	if (pin->mbox >= vcp_mboxdev.count ||
+	    vcp_mboxdev.info_table[pin->mbox].irq_num <= 0) {
+		dev_err(dev, "%s pin %d: mailbox %u has no interrupt\n",
+			name, ipi_id, pin->mbox);
+		return -ENXIO;
+	}
+	ret = mtk_ipi_register(&vcp_ipidev, ipi_id, cb, (void *)name, buf);
+	if (ret != IPI_ACTION_DONE) {
+		dev_err(dev, "%s pin %d: register: %d\n", name, ipi_id, ret);
+		return -EIO;
+	}
+	dev_dbg(dev, "%s pin %d: mailbox %u irq %d bit %u\n", name, ipi_id,
+		pin->mbox, vcp_mboxdev.info_table[pin->mbox].irq_num,
+		pin->pin_index);
+	return 0;
+}
