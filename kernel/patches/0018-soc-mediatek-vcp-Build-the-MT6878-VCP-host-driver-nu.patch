+		return -EINVAL;
+
+	mem = memremap(res.start, resource_size(&res), MEMREMAP_WB);
+	if (!mem)
+		return -ENOMEM;
+	hdr = mem;
+	size = le32_to_cpu(hdr[1]);
+	off = le32_to_cpu(hdr[5]);
+	len = le32_to_cpu(hdr[6]);
+	if (le32_to_cpu(hdr[0]) != LOG_STORE_SIG) {
+		out = sysfs_emit(buf, "no boot loader log at %pa: signature 0x%x\n",
+				 &res.start, le32_to_cpu(hdr[0]));
+		goto out;
+	}
+	if (off >= resource_size(&res) || len > resource_size(&res) - off) {
+		out = sysfs_emit(buf, "boot loader log header out of range: size 0x%x offset 0x%x length 0x%x\n",
+				 size, off, len);
+		goto out;
+	}
+
+	out = sysfs_emit(buf, "log_store %pa: buffer 0x%x, second stage log at 0x%x, 0x%x bytes\n",
+			 &res.start, size, off, len);
+	text = mem + off;
+	end = text + len;
+	for (line = text; line < end; line = eol + 1) {
+		eol = memchr(line, '\n', end - line);
+		if (!eol)
+			eol = end;
+		if ((strnstr(line, "vcp", eol - line) ||
+		     strnstr(line, "VCP", eol - line)) && out < PAGE_SIZE - 160)
+			out += sysfs_emit_at(buf, out, "%.*s\n",
+					     (int)min_t(size_t, eol - line, 150), line);
+	}
+out:
+	memunmap(mem);
+	return out;
+}
