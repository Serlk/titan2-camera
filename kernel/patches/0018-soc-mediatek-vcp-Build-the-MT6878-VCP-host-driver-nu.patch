+			break;
+	}
+	vcp_diag.clk_parent = parent ? __clk_get_name(parent) : "none";
+	dev_info(vcp_dev, "start %u: mmup %lu Hz from %s after %u switch(es)\n",
+		 vcp_start_seq, vcp_diag.clk_rate, vcp_diag.clk_parent,
+		 vcp_diag.clk_tries);
