+	/* the sleep acknowledge and the second hart's ready are not waited for */
+	vcp_register_pin(dev, IPI_OUT_C_SLEEP_0, NULL, &slp_ipi_ack_data, 1,
+			 "sleep ack");
+	vcp_register_pin(dev, IPI_IN_VCP_READY_1, vcp_ready_ipi_handler,
+			 &msg_vcp_ready1, PIN_IN_SIZE_VCP_READY_0, "ready 1");
+	for (i = 0; i < ARRAY_SIZE(vcp_unhandled_pins); i++)
+		vcp_register_pin(dev, vcp_unhandled_pins[i].ipi_id,
+				 vcp_unhandled_ipi_handler, NULL, 0,
+				 vcp_unhandled_pins[i].name);
+	return 0;
+}
