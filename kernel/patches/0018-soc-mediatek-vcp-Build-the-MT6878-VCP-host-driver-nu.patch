+/*
+ * A request that needs no codec: the sleep channel's status command for
+ * the RTOS feature. There is no data in the answer; the firmware taking
+ * the message within the timeout is the result.
+ */
+static int vcp_send_request(void)
+{
+	struct slp_ctrl_data msg = {
+		.feature = RTOS_FEATURE_ID,
+		.cmd = SLP_STATUS_DBG,
+	};
+	int ret;
+
+	mutex_lock(&vcp_pw_clk_mutex);
+	if (!is_vcp_ready(VCP_A_ID)) {
+		ret = -ENODEV;
+	} else {
+		ret = mtk_ipi_send_compl(&vcp_ipidev, IPI_OUT_C_SLEEP_0,
+					 IPI_SEND_WAIT, &msg,
+					 PIN_OUT_C_SIZE_SLEEP_0,
+					 VCP_REQUEST_TIMEOUT_MS);
+		dev_info(vcp_dev, "request on the sleep channel: ipi result %d\n", ret);
+		switch (ret) {
+		case IPI_ACTION_DONE:
+			break;
+		case IPI_COMPL_TIMEOUT:
+			ret = -ETIMEDOUT;
+			break;
+		case IPI_PIN_BUSY:
+			ret = -EBUSY;
+			break;
+		default:
+			ret = -EIO;
+		}
+	}
+	vcp_request_result = ret;
+	mutex_unlock(&vcp_pw_clk_mutex);
+	return ret;
+}
