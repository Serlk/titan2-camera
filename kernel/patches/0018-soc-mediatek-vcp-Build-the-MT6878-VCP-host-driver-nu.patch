+		vcp_set_clk();
+		parent = clk_get_parent(vcpsel);
+		vcp_diag.clk_rate = clk_get_rate(vcpsel);
+		if (vcp_diag.clk_rate > VCP_CLK_MIN_RATE &&
+		    (IS_ERR_OR_NULL(vcpclk) || clk_is_match(parent, vcpclk)))
+			break;
