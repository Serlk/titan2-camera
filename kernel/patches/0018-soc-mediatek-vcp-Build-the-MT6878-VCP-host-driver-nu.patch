+static int vcp_unhandled_ipi_handler(unsigned int id, void *prdata, void *data,
+				     unsigned int len)
+{
+	dev_warn_ratelimited(vcp_dev, "%s message, %u bytes: %*ph\n",
+			     (const char *)prdata, len, (int)min(len, 40U), data);
+	return 0;
