+static int vcp_register_pins(struct device *dev)
+{
+	unsigned int i;
+	int ret;
+
+	ret = vcp_register_pin(dev, IPI_IN_VCP_READY_0, vcp_ready_ipi_handler,
+			       &msg_vcp_ready0, PIN_IN_SIZE_VCP_READY_0, "ready");
+	if (ret)
