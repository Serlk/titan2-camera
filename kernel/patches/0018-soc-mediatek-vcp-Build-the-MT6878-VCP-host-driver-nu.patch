+/*
+ * Behind the MM IOMMU (an "iommus" property on the node) the VCP port is a
+ * larb-less master with the VDO_UP window above 4 GiB, so the DMA mask must
+ * allow the 34 bits the VCP can address (bits 35..32 travel in bits 3..0 of
+ * the packed address). Without the IOMMU the VCP sees physical addresses and
+ * the memory stays below 4 GiB, as long as the port is in bypass.
+ */
+static int vcp_set_dma_mask(struct device *dev)
+{
+	return dma_set_mask_and_coherent(dev, DMA_BIT_MASK(device_iommu_mapped(dev) ? 34 : 32));
+}
+
+/*
+ * The firmware gets the base as 32 bits with address bits 35..32 in bits
+ * 3..0, and reaches base + size. Check that the block the DMA API handed
+ * out survives that, and say through which device and IOMMU window it is
+ * mapped.
+ */
+static int vcp_check_shared_memory(struct device *dev)
+{
+	struct iommu_domain *dom = iommu_get_domain_for_dev(dev);
+	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+	u64 base = vcp_mem_dma;
+	u64 last = base + vcp_mem_size - 1;
+	u32 packed = VCP_PACK_IOVA(base);
+
+	if (dom && device_iommu_mapped(dev))
+		dev_info(dev,
+			 "shared memory %pad size 0x%zx packed 0x%08x: IOMMU port 0x%x, window 0x%llx..0x%llx\n",
+			 &vcp_mem_dma, vcp_mem_size, packed,
+			 fwspec && fwspec->num_ids ? fwspec->ids[0] : ~0U,
+			 (u64)dom->geometry.aperture_start,
+			 (u64)dom->geometry.aperture_end);
+	else
+		dev_info(dev,
+			 "shared memory %pad size 0x%zx packed 0x%08x: no IOMMU, bus address\n",
+			 &vcp_mem_dma, vcp_mem_size, packed);
+
+	if ((base & 0xf) || last >> 36 || VCP_UNPACK_IOVA(packed) != base) {
+		dev_err(dev, "shared memory %pad..0x%llx cannot be packed for the VCP\n",
+			&vcp_mem_dma, last);
+		return -ERANGE;
+	}
+	if (dom && device_iommu_mapped(dev) && dom->geometry.force_aperture &&
+	    (base < dom->geometry.aperture_start ||
+	     last > dom->geometry.aperture_end)) {
+		dev_err(dev, "shared memory outside the IOMMU window\n");
+		return -ERANGE;
+	}
+	return 0;
+}
