From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Thu, 26 Nov 2026 13:50:47 +0300
Subject: [PATCH 24/35] media: mediatek: jpeg: Size the encoder's JPEG buffer
 by the frame

The JPEG (capture) buffer of the encoder gets the size the client asks
for, or 1 MiB if it asks for nothing. A buffer that is too small for the
frame makes the encoder stop before the end of the frame and the frame is
lost.

Give the JPEG buffer at least about one byte per pixel of the larger of
the capture and the source frame size, which leaves room for the highest
quality setting, and never less than 1 MiB or than the client asked for.
For 1920x1080 that is 2073600 bytes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../platform/mediatek/jpeg/mtk_jpeg_core.c    | 29 ++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/mediatek/jpeg/mtk_jpeg_core.c b/drivers/media/platform/mediatek/jpeg/mtk_jpeg_core.c
index a30c04309efe..fc7c883e4b67 100644
--- a/drivers/media/platform/mediatek/jpeg/mtk_jpeg_core.c
+++ b/drivers/media/platform/mediatek/jpeg/mtk_jpeg_core.c
@@ -343,6 +343,28 @@ static int mtk_jpeg_g_fmt_vid_mplane(struct file *file, void *priv,
 	return 0;
 }
 
+/*
+ * The encoder stops with an interrupt without DONE when the bitstream buffer
+ * fills up before the end of the frame, and the frame is lost. Give the
+ * JPEG buffer about one byte per pixel of the larger of the capture and the
+ * source size, which is room for the highest quality, and at least the
+ * default size.
+ */
+static void mtk_jpeg_enc_bs_size(struct mtk_jpeg_ctx *ctx,
+				 struct v4l2_pix_format_mplane *pix_mp)
+{
+	struct v4l2_plane_pix_format *pfmt = &pix_mp->plane_fmt[0];
+	const struct v4l2_pix_format_mplane *src = &ctx->out_q.pix_mp;
+	u64 size;
+
+	size = max3((u64)pix_mp->width * pix_mp->height,
+		    (u64)src->width * src->height,
+		    (u64)MTK_JPEG_DEFAULT_SIZEIMAGE);
+	size = max_t(u64, size, pfmt->sizeimage);
+	pfmt->sizeimage = min_t(u64, round_up(size, 128),
+				round_down(U32_MAX, 128));
+}
+
 static int mtk_jpeg_try_fmt_vid_cap_mplane(struct file *file, void *priv,
 					   struct v4l2_format *f)
 {
@@ -369,7 +391,12 @@ static int mtk_jpeg_try_fmt_vid_cap_mplane(struct file *file, void *priv,
 		return 0;
 	}
 
-	return mtk_jpeg_try_fmt_mplane(&f->fmt.pix_mp, fmt);
+	mtk_jpeg_try_fmt_mplane(&f->fmt.pix_mp, fmt);
+	/* only the encoder captures JPEG */
+	if (fmt->fourcc == V4L2_PIX_FMT_JPEG)
+		mtk_jpeg_enc_bs_size(ctx, &f->fmt.pix_mp);
+
+	return 0;
 }
 
 static int mtk_jpeg_try_fmt_vid_out_mplane(struct file *file, void *priv,
