+static void camraw_show_counters(struct mtk_camraw *raw, struct seq_file *m,
+				 const char *when)
+{
+	static const char * const names[CAMRAW_NUM_IRQS] = { "RAW", "YUV" };
+	struct mtk_camraw_irq q[CAMRAW_NUM_IRQS];
+	unsigned int n_sof, n_main, n_sub, n_p1, n_yuvo, n_err, i;
+	unsigned long flags;
+	u32 err_bits;
+
+	spin_lock_irqsave(&raw->irq_lock, flags);
+	memcpy(q, raw->irqs, sizeof(q));
+	n_sof = raw->n_sof;
+	n_main = raw->n_cq_main;
+	n_sub = raw->n_cq_sub;
+	n_p1 = raw->n_pass1;
+	n_yuvo = raw->n_yuvo;
+	n_err = raw->n_err;
+	err_bits = raw->err_bits;
+	spin_unlock_irqrestore(&raw->irq_lock, flags);
+
+	CAMRAW_OUT("lists started %u (per-frame request %u times), main list done %u, sub list done %u, start of frame %u, pass 1 done %u, YUVO_R1 done %u, frames delivered %u, without a buffer %u",
+		   raw->n_applied, raw->n_frame_applied, n_main, n_sub, n_sof,
+		   n_p1, n_yuvo, raw->n_frames, raw->n_no_buffer);
+	CAMRAW_OUT("error interrupts %u, bits seen 0x%08x (6 overrun 7 grab 10 SOF drop 14-15 list start delay 16-17 main list 18 trigger delay 19-20 sub list 25 DMA)",
+		   n_err, err_bits);
+	for (i = 0; i < CAMRAW_NUM_IRQS; i++)
+		CAMRAW_OUT("%s-A interrupt: %u taken, %u with no status; status read again: %u clear, %u still set => read to clear %s%s%s",
+			   names[i], q[i].count, q[i].empty, q[i].reread_clear,
+			   q[i].reread_set,
+			   q[i].reread_set ? "DOES NOT HOLD" :
+			   q[i].reread_clear ? "holds" : "not seen yet",
+			   q[i].w1c_tried ? ", burst: status written back" : "",
+			   q[i].storm ? ", LINE SWITCHED OFF" : "");
+	for (i = 0; i < min(raw->n_sof_log, CAMRAW_SOF_LOG); i++)
+		CAMRAW_OUT("start of frame %u: %u us after viewfinder on, after %u per-frame applications, frame number 0x%x latched 0x%x, frame size 0x%08x",
+			   i + 1, raw->sof_log[i].t_us, raw->sof_log[i].applied,
+			   raw->sof_log[i].seq, raw->sof_log[i].seq_inner,
+			   raw->sof_log[i].frmsize);
+	if (raw->err_us)
+		CAMRAW_OUT("first error interrupt %u us after viewfinder on", raw->err_us);
+}
