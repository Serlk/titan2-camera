+/*
+ * The device a phandle names, once its driver has bound (drvdata set). A
+ * managed link keeps it bound while this one is; with @pm_link it is also
+ * powered whenever this one is.
+ */
+static void *camraw_get_linked(struct device *dev, const char *prop,
+			       bool pm_link, struct device **linked)
+{
+	struct platform_device *pdev;
+	struct device_node *np;
+	u32 flags = DL_FLAG_AUTOREMOVE_CONSUMER;
+	void *data;
+
+	np = of_parse_phandle(dev->of_node, prop, 0);
+	if (!np)
+		return ERR_PTR(-ENOENT);
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+	data = platform_get_drvdata(pdev);
+	if (!data) {
+		put_device(&pdev->dev);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+	if (pm_link)
+		flags |= DL_FLAG_PM_RUNTIME;
+	if (!device_link_add(dev, &pdev->dev, flags)) {
+		put_device(&pdev->dev);
+		return ERR_PTR(-ENODEV);
+	}
+	*linked = &pdev->dev;
+	put_device(&pdev->dev);
+	return data;
+}
+
+/* every engine of the frame must translate the same addresses */
+static int camraw_check_domain(struct mtk_camraw *raw, struct device *other)
+{
+	if (iommu_get_domain_for_dev(other) == iommu_get_domain_for_dev(raw->dev))
+		return 0;
+	return dev_err_probe(raw->dev, -EINVAL,
+			     "%s is in another IOMMU domain: one buffer address would not do for both\n",
+			     dev_name(other));
+}
+
+static int camraw_video_register(struct mtk_camraw *raw)
+{
+	struct video_device *vdev = &raw->vdev;
+	struct vb2_queue *q = &raw->vq;
+	int ret;
+
+	ret = v4l2_device_register(raw->dev, &raw->v4l2_dev);
+	if (ret)
+		return ret;
+
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_MMAP;
+	q->drv_priv = raw;
+	q->buf_struct_size = sizeof(struct mtk_camraw_buffer);
+	q->ops = &camraw_vb2_ops;
+	q->mem_ops = &vb2_vmalloc_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC |
+			     V4L2_BUF_FLAG_TSTAMP_SRC_SOE;
+	q->lock = &raw->vlock;
+	q->dev = raw->dev;
+	ret = vb2_queue_init(q);
+	if (ret)
+		goto err_v4l2;
+
+	strscpy(vdev->name, "mtk-camraw-a", sizeof(vdev->name));
+	vdev->fops = &camraw_fops;
+	vdev->ioctl_ops = &camraw_ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &raw->vlock;
+	vdev->v4l2_dev = &raw->v4l2_dev;
+	vdev->queue = q;
+	vdev->vfl_dir = VFL_DIR_RX;
+	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING;
+	video_set_drvdata(vdev, raw);
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_v4l2;
+	return 0;
+
+err_v4l2:
+	v4l2_device_unregister(&raw->v4l2_dev);
+	return ret;
+}
+
+/* RAW-A: interrupts, the second engine, the video node */
+static int camraw_probe_master(struct mtk_camraw *raw)
+{
+	struct device *dev = raw->dev;
+	struct device *linked;
+	int ret;
+
+	raw->twin = camraw_get_linked(dev, "mediatek,twin", false, &linked);
+	if (IS_ERR(raw->twin)) {
+		ret = PTR_ERR(raw->twin);
+		raw->twin = NULL;
+		if (ret != -ENOENT)
+			return dev_err_probe(dev, ret, "second RAW engine\n");
+	}
+	ret = camraw_check_domain(raw, raw->yuv->dev);
+	if (!ret && raw->twin)
+		ret = camraw_check_domain(raw, raw->twin->dev);
+	if (!ret && raw->twin)
+		ret = camraw_check_domain(raw, raw->twin->yuv->dev);
+	if (ret)
+		return ret;
+
+	spin_lock_init(&raw->irq_lock);
+	spin_lock_init(&raw->buf_lock);
+	INIT_LIST_HEAD(&raw->bufs);
+	init_completion(&raw->cq_done);
+	INIT_DELAYED_WORK(&raw->watchdog, camraw_watchdog);
+	ret = devm_mutex_init(dev, &raw->lock);
+	if (ret)
+		return ret;
+	ret = devm_mutex_init(dev, &raw->vlock);
+	if (ret)
+		return ret;
+
+	/* enabled for a stream only */
+	raw->irq = platform_get_irq(to_platform_device(dev), 0);
+	if (raw->irq < 0)
+		return raw->irq;
+	ret = devm_request_threaded_irq(dev, raw->irq, camraw_raw_irq,
+					camraw_raw_thread, IRQF_NO_AUTOEN,
+					"mtk-camraw-a", raw);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request the RAW IRQ\n");
+	ret = devm_request_threaded_irq(dev, raw->yuv->irq, camraw_yuv_irq,
+					camraw_yuv_thread, IRQF_NO_AUTOEN,
+					"mtk-camyuv-a", raw);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request the YUV IRQ\n");
+
+	raw->debugfs = debugfs_create_dir("mtk-camraw-a", NULL);
+	debugfs_create_file("status", 0400, raw->debugfs, raw, &camraw_status_fops);
+	debugfs_create_file("load", 0200, raw->debugfs, raw, &camraw_load_fops);
+
+	ret = camraw_video_register(raw);
+	if (ret) {
+		debugfs_remove_recursive(raw->debugfs);
+		return ret;
+	}
+	dev_info(dev, "video node %s, requests \"%s\" + \"%s\", second RAW engine %s\n",
+		 video_device_node_name(&raw->vdev), start_fw, frame_fw,
+		 raw->twin ? dev_name(raw->twin->dev) : "none");
+	return 0;
+}
+
+static int camraw_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device *linked;
+	struct mtk_camraw *raw;
+	unsigned int i;
+	int ret;
+
+	raw = devm_kzalloc(dev, sizeof(*raw), GFP_KERNEL);
+	if (!raw)
+		return -ENOMEM;
+	raw->dev = dev;
+	of_property_read_u32(dev->of_node, "mediatek,raw-id", &raw->raw_id);
+	if (raw->raw_id > 1)
+		return dev_err_probe(dev, -EINVAL, "mediatek,raw-id %u\n",
+				     raw->raw_id);
+
+	/* the YUV engine, its clocks and its larb are on whenever RAW is */
+	raw->yuv = camraw_get_linked(dev, "mediatek,yuv", true, &linked);
+	if (IS_ERR(raw->yuv))
+		return dev_err_probe(dev, PTR_ERR(raw->yuv), "YUV engine\n");
+
+	raw->base = devm_platform_ioremap_resource_byname(pdev, "base");
+	if (IS_ERR(raw->base))
+		return PTR_ERR(raw->base);
+	raw->inner = devm_platform_ioremap_resource_byname(pdev, "inner");
+	if (IS_ERR(raw->inner))
+		return PTR_ERR(raw->inner);
+	raw->camsys = syscon_regmap_lookup_by_phandle(dev->of_node,
+						      "mediatek,camsys");
+	if (IS_ERR(raw->camsys))
+		return dev_err_probe(dev, PTR_ERR(raw->camsys),
+				     "no camsys main syscon\n");
+
+	raw->num_clks = devm_clk_bulk_get_all(dev, &raw->clks);
+	if (raw->num_clks < 0)
+		return dev_err_probe(dev, raw->num_clks, "failed to get clocks\n");
+	for (i = 0; i < raw->num_clks; i++)
+		if (raw->clks[i].id && !strcmp(raw->clks[i].id, "cam-sel"))
+			raw->cam_sel = raw->clks[i].clk;
+
+	/* the command queue is fetched through the larb, like everything else */
+	if (!device_iommu_mapped(dev))
+		return dev_err_probe(dev, -ENODEV,
+				     "not behind the MM IOMMU: the command queue and the statistics need their larb ports in \"iommus\"\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(34));
+	if (ret)
+		return ret;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	if (raw->raw_id) {
+		/* RAW-B: powered, reset and initialised by RAW-A */
+		platform_set_drvdata(pdev, raw);
+		dev_info(dev, "RAW-%c, second engine of a two-engine frame\n",
+			 raw_name(raw));
+		return 0;
+	}
+	platform_set_drvdata(pdev, raw);
+	ret = camraw_probe_master(raw);
+	if (ret)
+		platform_set_drvdata(pdev, NULL);
+	return ret;
+}
+
+static void camraw_remove(struct platform_device *pdev)
+{
+	struct mtk_camraw *raw = platform_get_drvdata(pdev);
+
+	if (raw->raw_id)
+		return;
+	vb2_video_unregister_device(&raw->vdev);
+	v4l2_device_unregister(&raw->v4l2_dev);
+	debugfs_remove_recursive(raw->debugfs);
+	raw->debugfs_bufs = NULL;
+	mutex_lock(&raw->lock);
+	camraw_unload(raw);
+	mutex_unlock(&raw->lock);
+}
+
+static int camraw_runtime_suspend(struct device *dev)
+{
+	struct mtk_camraw *raw = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(raw->num_clks, raw->clks);
+	return 0;
+}
+
+static int camraw_runtime_resume(struct device *dev)
+{
+	struct mtk_camraw *raw = dev_get_drvdata(dev);
+
+	return clk_bulk_prepare_enable(raw->num_clks, raw->clks);
+}
+
+/* system sleep is refused while a stream runs */
+static int camraw_suspend(struct device *dev)
+{
+	struct mtk_camraw *raw = dev_get_drvdata(dev);
+
+	if (!raw->raw_id && READ_ONCE(raw->streaming))
+		return -EBUSY;
+	return pm_runtime_force_suspend(dev);
+}
+
+static const struct dev_pm_ops camraw_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(camraw_suspend, pm_runtime_force_resume)
+	RUNTIME_PM_OPS(camraw_runtime_suspend, camraw_runtime_resume, NULL)
+};
+
+static const struct of_device_id camraw_of_match[] = {
+	{ .compatible = "mediatek,mt6878-cam-raw" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, camraw_of_match);
+
+static struct platform_driver camraw_driver = {
+	.probe = camraw_probe,
+	.remove = camraw_remove,
+	.driver = {
+		.name = CAMRAW_DRV_NAME,
+		.of_match_table = camraw_of_match,
+		.pm = pm_ptr(&camraw_pm_ops),
+	},
+};
+
+static struct platform_driver * const camraw_drivers[] = {
+	&camyuv_driver,
+	&camraw_driver,
+};
+
+static int __init camraw_init(void)
+{
+	return platform_register_drivers(camraw_drivers,
+					 ARRAY_SIZE(camraw_drivers));
+}
+module_init(camraw_init);
+
+static void __exit camraw_exit(void)
+{
+	platform_unregister_drivers(camraw_drivers, ARRAY_SIZE(camraw_drivers));
+}
+module_exit(camraw_exit);
+
+MODULE_DESCRIPTION("MediaTek MT6878 RAW/YUV engine, replay of a captured command queue");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/mediatek/camraw/mtk-camraw-regs.h b/drivers/media/platform/mediatek/camraw/mtk-camraw-regs.h
new file mode 100644
index 000000000000..ae5f88efa74e
--- /dev/null
+++ b/drivers/media/platform/mediatek/camraw/mtk-camraw-regs.h
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MediaTek MT6878 RAW / YUV engine registers, as far as the kernel side of
+ * a replayed frame needs them. Offsets are relative to the RAW engine base
+ * unless the name starts with YUV_. The inner (latched) copy of an engine
+ * is CAMRAW_INNER above its base.
+ *
+ * Copyright (c) 2026 serlk
+ */
+
+#ifndef _MTK_CAMRAW_REGS_H
+#define _MTK_CAMRAW_REGS_H
+
+#include <linux/bits.h>
+
+#define CAMRAW_WIN_SIZE			0x8000
+#define CAMRAW_INNER			0x8000
+
+/* bus addresses the command queue descriptors carry */
+#define CAMRAW_RAW_A_BASE		0x1a030000
+#define CAMRAW_RMS_A_BASE		0x1a040000
+#define CAMRAW_YUV_A_BASE		0x1a050000
+#define CAMRAW_RAW_B_BASE		0x1a070000
+#define CAMRAW_RMS_B_BASE		0x1a080000
+#define CAMRAW_YUV_B_BASE		0x1a090000
+#define CAMRAW_ENGINE_SPAN		0x10000		/* base + inner */
+
+#define CAMCTL_MOD5_EN			0x010
+#define  CAMCTL_MOD5_IMGO_R1		BIT(0)
+#define  CAMCTL_MOD5_UFEO_R1		BIT(1)
+#define  CAMCTL_MOD5_PDO_R1		BIT(2)
+#define  CAMCTL_MOD5_FLKO_R1		BIT(3)
+#define  CAMCTL_MOD5_TSFSO_R1		BIT(4)
+#define  CAMCTL_MOD5_AAO_R1		BIT(5)
+#define  CAMCTL_MOD5_AAHO_R1		BIT(6)
+#define  CAMCTL_MOD5_AFO_R1		BIT(7)
+#define  CAMCTL_MOD5_LTMSO_R1		BIT(8)
+#define  CAMCTL_MOD5_LTMSHO_R1		BIT(9)
+#define  CAMCTL_MOD5_FHO_R1		BIT(10)
+/* the statistics writers that can be switched off for a picture */
+#define  CAMCTL_MOD5_STATS		GENMASK(9, 3)
+#define CAMCTL_MOD6_EN			0x014
+#define  CAMCTL_MOD6_CQI_ALL		GENMASK(11, 8)
+#define CAMCTL_MISC			0x060
+#define  CAMCTL_MISC_DB_EN		BIT(4)
+#define CAMCTL_START			0x0b0
+#define  CAMCTL_CQ_THR0_START		BIT(0)
+#define CAMCTL_SW_CTL			0x0c4
+#define  CAMCTL_SW_RST_TRIG		BIT(0)
+#define  CAMCTL_SW_RST_ST		BIT(1)
+#define  CAMCTL_HW_RST			BIT(2)
+#define CAMCTL_SW_PASS1_DONE		0x0c8
+#define CAMCTL_DC_STAG_CTL		0x0dc	/* frame done tolerance, counter ticks */
+#define CAMCTL_SW_SUB_CTL		0x0cc
+
+/* interrupt groups 1..9: enable, status (read to clear), status mirror */
+#define CAMCTL_INT_EN(n)		(0x100 + ((n) - 1) * 0x10)
+#define CAMCTL_INT_STATUS(n)		(0x104 + ((n) - 1) * 0x10)
+#define CAMCTL_INT_STATUSX(n)		(0x108 + ((n) - 1) * 0x10)
+#define CAMRAW_NUM_INT			9
+
+/* group 1 */
+#define  CAMCTL_INT_TG_OVRUN		BIT(6)
+#define  CAMCTL_INT_TG_GRABERR		BIT(7)
+#define  CAMCTL_INT_TG_SOF		BIT(8)
+#define  CAMCTL_INT_TG_SOF_DROP		BIT(10)
+#define  CAMCTL_INT_CQ_DB_LOAD_ERR	BIT(13)
+#define  CAMCTL_INT_CQ_START_DLY	GENMASK(15, 14)
+#define  CAMCTL_INT_CQ_MAIN_ERR		GENMASK(17, 16)
+#define  CAMCTL_INT_CQ_TRIG_DLY		BIT(18)
+#define  CAMCTL_INT_CQ_SUB_ERR		GENMASK(20, 19)
+#define  CAMCTL_INT_PASS1_DONE		BIT(21)
+#define  CAMCTL_INT_RAW_PASS1_DONE	BIT(22)
+#define  CAMCTL_INT_DMA_ERR		BIT(25)
+#define  CAMCTL_INT_ERRORS		(CAMCTL_INT_TG_OVRUN | \
+					 CAMCTL_INT_TG_GRABERR | \
+					 CAMCTL_INT_TG_SOF_DROP | \
+					 CAMCTL_INT_CQ_START_DLY | \
+					 CAMCTL_INT_CQ_MAIN_ERR | \
+					 CAMCTL_INT_CQ_TRIG_DLY | \
+					 CAMCTL_INT_CQ_SUB_ERR | \
+					 CAMCTL_INT_DMA_ERR)
+/* group 6 */
+#define  CAMCTL_INT6_CQ_THR0_DONE	BIT(0)
+#define  CAMCTL_INT6_CQ_THRSUB_DONE	BIT(4)
+#define  CAMCTL_INT6_CQ_BOTH		(CAMCTL_INT6_CQ_THR0_DONE | \
+					 CAMCTL_INT6_CQ_THRSUB_DONE)
+/* YUV engine, group 2 */
+#define  YUV_INT2_YUVO_R1_DONE		BIT(9)
+
+#define CAMCTL_MOD5_DCM_DIS		0x310
+#define CAMCTL_MOD6_DCM_DIS		0x314
+
+#define CAMCQ_CQ_EN			0x400
+#define  CAMCQ_CQ_EN_INIT		0x16	/* default 0x14 + drop frame */
+#define CAMCQ_SCQ_START_PERIOD		0x408
+#define CAMCQ_CQ_THR0_CTL		0x410
+#define  CAMCQ_THR_CTL_INIT		0x11	/* enable, mode 1 */
+#define CAMCQ_CQ_THR0_BASEADDR		0x414
+#define CAMCQ_CQ_THR0_BASEADDR_MSB	0x418
+#define CAMCQ_CQ_THR0_DESC_SIZE		0x41c
+#define CAMCQ_CQ_SUB_THR0_CTL		0x440
+#define CAMCQ_CQ_SUB_THR0_BASEADDR	0x44c
+#define CAMCQ_CQ_SUB_THR0_BASEADDR_MSB	0x450
+#define CAMCQ_CQ_SUB_THR0_DESC_SIZE	0x458
+
+#define TG_SEN_MODE			0x700
+#define TG_VF_CON			0x704
+#define  TG_VFDATA_EN			BIT(0)
+#define TG_SEN_GRAB_PXL			0x708
+#define TG_SEN_GRAB_LIN			0x70c
+#define TG_PATH_CFG			0x710
+#define  TG_DB_LOAD_DIS			BIT(8)
+#define TG_FRMSIZE_ST			0x738
+#define TG_INTER_ST			0x73c
+#define TG_TIME_STAMP_CNT		0x77c
+/* columns of the frame this RAW engine takes: start b15:0, end b31:16 */
+#define CAMRAW_SPLIT_COLS		0x7c4
+
+#define CAMRAW_LTM_RESET		0x2350
+#define CAMRAW_FRAME_SEQ_NUM		0x2c40
+
+/* DMA ports: FIFO words at +0x20..+0x30, error status at +0x34 */
+#define CAMRAW_DMA_CON0			0x20
+#define CAMRAW_DMA_ERR_STAT		0x34
+#define CAMRAW_DMA_ADDR_WORDS		0x20	/* address, size, stride: below CON0 */
+#define CAMRAW_LOW_LATENCY		0x4090
+#define CAMRAW_CQI_R1			0x4100
+#define CAMRAW_CQI_R2			0x4170
+#define CAMRAW_CQI_R3			0x41e0
+#define CAMRAW_CQI_R4			0x4250
+/*
+ * Ports whose error reporting the kernel masks. These are the port bases:
+ * the lists write the address words there (AAO and AAHO read back as
+ * addresses), the error status word is at +CAMRAW_DMA_ERR_STAT.
+ */
+#define CAMRAW_UFEO_R1			0x48c0
+#define CAMRAW_FLKO_R1			0x4900
+#define CAMRAW_PDO_R1			0x4940
+#define CAMRAW_AAO_R1			0x4980
+#define CAMRAW_AAHO_R1			0x49c0
+#define  CAMRAW_ERR_STAT_MASKED		0xfffe0000
+
+#define YUV_CAMCTL2_MOD5_EN		0x010
+#define  YUV_MOD5_TCYSO_R1		BIT(0)
+#define  YUV_MOD5_DRZS4NO_R3		BIT(2)
+#define  YUV_MOD5_RZH1N2TO_R2		BIT(6)
+#define  YUV_MOD5_YUVO_R1		BIT(9)
+#define  YUV_MOD5_YUVBO_R1		BIT(10)
+#define  YUV_MOD5_YUVO_R2		BIT(13)
+#define  YUV_MOD5_YUVBO_R2		BIT(14)
+#define  YUV_MOD5_STATS			YUV_MOD5_TCYSO_R1
+#define  YUV_MOD5_EXTRA			(YUV_MOD5_DRZS4NO_R3 | YUV_MOD5_RZH1N2TO_R2 | \
+					 YUV_MOD5_YUVO_R2 | YUV_MOD5_YUVBO_R2)
+#define YUV_CAMCTL2_FMT3_SEL		0x078
+#define YUV_LOW_LATENCY0		0x4090
+#define YUV_LOW_LATENCY1		0x4098
+#define YUV_LOW_LATENCY2		0x40a0
+#define YUV_YUVO_R1			0x4200	/* first plane */
+#define YUV_YUVBO_R1			0x42b0	/* second plane */
+#define YUV_YUVCO_R1			0x4360
+#define YUV_YUVDO_R1			0x4410
+
+/* camsys main block (syscon) */
+#define CAM_MAIN_HALT1			0x0c4
+#define CAM_MAIN_HALT2			0x0c8
+#define CAM_MAIN_HALT3			0x0cc
+#define CAM_MAIN_HALT4			0x0d0
+#define CAM_MAIN_HALT5			0x0d4
+#define CAM_MAIN_HALT6			0x0d8
+#define CAM_MAIN_HALT7			0x0dc	/* HALT7/8: the pair of side B */
+#define CAM_MAIN_HALT8			0x0e0
+#define CAM_MAIN_HALT13			0x0f4
+
+#endif /* _MTK_CAMRAW_REGS_H */
diff --git a/drivers/media/platform/mediatek/camraw/mtk-camraw-replay.c b/drivers/media/platform/mediatek/camraw/mtk-camraw-replay.c
new file mode 100644
index 000000000000..b009ce8ef959
--- /dev/null
+++ b/drivers/media/platform/mediatek/camraw/mtk-camraw-replay.c
@@ -0,0 +1,669 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * MediaTek MT6878 RAW engine: replay of a captured command queue.
+ *
+ * A request dump is one file, all offsets from its start, little-endian:
+ *
+ *   0    description, 64 bytes
+ *   80   u32 sequence
+ *   84   u32 header size, u32 payload offset, u32 payload size
+ *   104  command queue slot: u32 offset, u32 size, u64 address,
+ *        u32 main list offset, u32 main list size,
+ *        u32 sub list offset, u32 sub list size (list offsets in the slot)
+ *   136  settings buffer of the request: u32 offset, u32 size, u64 address
+ *   208  frame parameters: u32 offset, u32 size
+ *   216  configuration parameters: u32 offset, u32 size
+ *
+ * A list is a sequence of 12 byte descriptors, a control word and the
+ * 64-bit address of the values: register address bits 15..0 in bits 15..0
+ * and bits 20..16 in bits 31..27 (window 0x1a000000), number of values
+ * minus one in bits 24..16, operation in bits 26..25 (0 write, 3 end). The
+ * values of a descriptor lie in the slot or in the settings buffer. The
+ * list sizes count the end descriptor.
+ *
+ * The lists of RAW-A program six blocks: RAW, RMS and YUV of side A and of
+ * side B, the two halves of a frame split between two RAW engines.
+ *
+ * The frame parameters (packed, 0x16883 bytes) name the buffers: sixteen
+ * image outputs of 0x81a bytes at 0xe593 (u8 pipe, u8 id, u32 format, u16
+ * width, u16 height, u16 pitch[4], then per plane u64 address, u32 fd, u32
+ * size), four statistics outputs of 18 bytes at 0x16733 (u8 pipe, u8 id,
+ * u64 address, u32 fd, u32 size). The configuration parameters give the
+ * input: format at 1, pixel id at 5, pixel mode in front of RAW at 8, crop
+ * (four u16) at 0xa, engines mask (u16) at 0x208.
+ *
+ * A buffer address is written as two consecutive registers of a DMA port,
+ * low 32 bits then the upper bits. Every such pair must lie inside one of
+ * the buffers of the request: slot, settings, an image plane or a
+ * statistics buffer. The slot itself is one of them: the frame header
+ * writer stores into its last 64 bytes.
+ *
+ * The first request of a stream carries a one-time block (timing
+ * generator, grab window, time stamp counter, interrupt enables); it is
+ * recognised by the grab window. A steady request has the picture output.
+ *
+ * Copyright (c) 2026 serlk
+ */
+
+#include <linux/bits.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "mtk-camraw-regs.h"
+#include "mtk-camraw-replay.h"
+
+#define DUMP_SEQUENCE		80
+#define DUMP_SLOT		104
+#define DUMP_SLOT_IOVA		112
+#define DUMP_MAIN		120
+#define DUMP_SUB		128
+#define DUMP_SETTINGS		136
+#define DUMP_SETTINGS_IOVA	144
+#define DUMP_FRAME_PARAM	208
+#define DUMP_CONFIG_PARAM	216
+#define DUMP_MIN_HEADER		228
+
+#define FP_SIZE			0x16883
+#define FP_IMG			0xe593
+#define FP_IMG_NUM		16
+#define FP_IMG_SIZE		0x81a
+#define FP_IMG_PLANES		18
+#define FP_IMG_NUM_PLANES	4
+#define FP_META_OUT		0x16733
+#define FP_META_OUT_NUM		4
+#define FP_META_SIZE		18
+
+#define CP_MIN_SIZE		0x20a
+
+/* an address-like pair below this is a count next to a small number */
+#define CAMRAW_MIN_IOVA		0x100000
+
+static const u32 camraw_block_base[CAMRAW_NUM_BLOCKS] = {
+	CAMRAW_RAW_A_BASE, CAMRAW_RMS_A_BASE, CAMRAW_YUV_A_BASE,
+	CAMRAW_RAW_B_BASE, CAMRAW_RMS_B_BASE, CAMRAW_YUV_B_BASE,
+};
+
+static const char * const camraw_block_names[CAMRAW_NUM_BLOCKS] = {
+	"RAW-A", "RMS-A", "YUV-A", "RAW-B", "RMS-B", "YUV-B",
+};
+
+static const char * const camraw_kind_names[] = {
+	"queue slot", "settings", "image", "statistics",
+};
+
+static int camraw_block(u32 reg)
+{
+	unsigned int i;
+
+	for (i = 0; i < CAMRAW_NUM_BLOCKS; i++)
+		if (reg >= camraw_block_base[i] &&
+		    reg < camraw_block_base[i] + CAMRAW_ENGINE_SPAN)
+			return i;
+	return -1;
+}
+
+static bool camraw_get_section(const u8 *data, size_t len, unsigned int hdr_off,
+			       const u8 **p, u32 *size)
+{
+	u32 off = get_unaligned_le32(data + hdr_off);
+
+	*size = get_unaligned_le32(data + hdr_off + 4);
+	*p = data + off;
+	return *size && (u64)off + *size <= len;
+}
+
+static u32 camraw_desc_reg(u32 ctrl)
+{
+	return CAMRAW_CQ_REG_PREFIX | ((ctrl >> 27) & 0x1f) << 16 |
+	       (ctrl & 0xffff);
+}
+
+static bool camraw_is_dma_reg(u32 reg)
+{
+	/* the DMA ports lie in the upper half of an engine window */
+	return (reg & (CAMRAW_WIN_SIZE - 1)) >= 0x4000;
+}
+
+static struct camraw_capbuf *camraw_add_buf(struct camraw_replay *rp, u64 iova,
+					    u32 size, u8 kind, u8 id, u8 plane)
+{
+	struct camraw_capbuf *b;
+
+	if (rp->num_bufs == CAMRAW_MAX_BUFS)
+		return NULL;
+	b = &rp->bufs[rp->num_bufs++];
+	b->iova = iova;
+	b->size = size;
+	b->kind = kind;
+	b->id = id;
+	b->plane = plane;
+	return b;
+}
+
+static int camraw_parse_params(struct camraw_replay *rp, const u8 *fp,
+			       u32 fp_size, const u8 *cp, u32 cp_size)
+{
+	unsigned int i, p;
+
+	if (fp_size != FP_SIZE) {
+		dev_err(rp->dev,
+			"replay: %s: frame parameters of 0x%x bytes, the known layout has 0x%x\n",
+			rp->name, fp_size, FP_SIZE);
+		return -EINVAL;
+	}
+	if (cp_size < CP_MIN_SIZE) {
+		dev_err(rp->dev, "replay: %s: configuration parameters of 0x%x bytes\n",
+			rp->name, cp_size);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < FP_IMG_NUM; i++) {
+		const u8 *e = fp + FP_IMG + i * FP_IMG_SIZE;
+
+		for (p = 0; p < FP_IMG_NUM_PLANES; p++) {
+			u64 iova = get_unaligned_le64(e + FP_IMG_PLANES + 16 * p);
+			u32 size = get_unaligned_le32(e + FP_IMG_PLANES + 16 * p + 12);
+
+			if (!iova || !size)
+				continue;
+			if (!camraw_add_buf(rp, iova, size, CAMRAW_BUF_IMAGE,
+					    e[1], p))
+				return -E2BIG;
+			if (e[1] == CAMRAW_OUT_PICTURE &&
+			    p < CAMRAW_PICTURE_PLANES)
+				rp->out_plane[p] = rp->num_bufs - 1;
+		}
+		if (e[1] == CAMRAW_OUT_PICTURE && rp->out_plane[0] >= 0) {
+			rp->fmt_id = get_unaligned_le32(e + 2);
+			rp->width = get_unaligned_le16(e + 6);
+			rp->height = get_unaligned_le16(e + 8);
+			rp->stride = get_unaligned_le16(e + 10);
+		}
+	}
+	for (i = 0; i < FP_META_OUT_NUM; i++) {
+		const u8 *e = fp + FP_META_OUT + i * FP_META_SIZE;
+		u64 iova = get_unaligned_le64(e + 2);
+		u32 size = get_unaligned_le32(e + 14);
+
+		if (iova && size &&
+		    !camraw_add_buf(rp, iova, size, CAMRAW_BUF_STATS, e[1], 0))
+			return -E2BIG;
+	}
+
+	rp->in_fmt = cp[1];
+	rp->pixel_id = cp[5];
+	rp->pixel_mode = cp[8];
+	rp->in_width = get_unaligned_le16(cp + 0xe);
+	rp->in_height = get_unaligned_le16(cp + 0x10);
+	rp->dev_mask = get_unaligned_le16(cp + 0x208);
+	return 0;
+}
+
+static int camraw_find_buf(const struct camraw_replay *rp, u64 addr)
+{
+	unsigned int i;
+
+	for (i = 0; i < rp->num_bufs; i++)
+		if (addr >= rp->bufs[i].iova &&
+		    addr < rp->bufs[i].iova + rp->bufs[i].size)
+			return i;
+	return -1;
+}
+
+static void camraw_note_write(struct camraw_replay *rp, int blk, u32 reg,
+			      u32 val, u32 off, bool in_slot)
+{
+	u32 rel = reg - camraw_block_base[blk];
+
+	if (rel == CAMCTL_MOD5_EN && blk != CAMRAW_BLK_RMS_A &&
+	    blk != CAMRAW_BLK_RMS_B) {
+		rp->mod5_off[blk] = in_slot ? off : CAMRAW_NO_OFFSET;
+		rp->mod5[blk] = val;
+	}
+	if ((blk == CAMRAW_BLK_RAW_A || blk == CAMRAW_BLK_RAW_B) &&
+	    rel == CAMRAW_SPLIT_COLS) {
+		rp->split[blk == CAMRAW_BLK_RAW_B] = val;
+		rp->has_split[blk == CAMRAW_BLK_RAW_B] = true;
+	}
+	if (blk != CAMRAW_BLK_RAW_A)
+		return;
+
+	switch (rel) {
+	case TG_SEN_GRAB_PXL:
+		rp->grab_pxl = val;
+		rp->onetime = true;
+		break;
+	case TG_SEN_GRAB_LIN:
+		rp->grab_lin = val;
+		break;
+	case TG_TIME_STAMP_CNT:
+		rp->time_stamp_cnt = val;
+		break;
+	case CAMCTL_INT_EN(1):
+		rp->int_en = val;
+		break;
+	case CAMRAW_FRAME_SEQ_NUM:
+		rp->frame_seq = val;
+		rp->has_frame_seq = true;
+		rp->frame_seq_off = in_slot ? off : CAMRAW_NO_OFFSET;
+		break;
+	}
+}
+
+/* the values of one write descriptor: address words and registers of interest */
+static int camraw_walk_values(struct camraw_replay *rp, int blk, u32 reg,
+			      const u8 *vals, u32 count, u32 voff, bool in_slot)
+{
+	u32 upper = upper_32_bits(rp->slot_iova);
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		u32 val = get_unaligned_le32(vals + 4 * i);
+		struct camraw_reloc *r;
+		u64 addr;
+		int buf;
+
+		camraw_note_write(rp, blk, reg + 4 * i, val, voff + 4 * i,
+				  in_slot);
+		/* low word of an address, the upper bits follow? */
+		if (i + 1 >= count || !val || !camraw_is_dma_reg(reg + 4 * i) ||
+		    get_unaligned_le32(vals + 4 * i + 4) != upper)
+			continue;
+		addr = (u64)upper << 32 | val;
+		buf = camraw_find_buf(rp, addr);
+		if (buf < 0) {
+			if (val < CAMRAW_MIN_IOVA)
+				continue;
+			if (!rp->loose_addr++)
+				dev_err(rp->dev,
+					"replay: %s: address 0x%llx at register 0x%08x is in no buffer of the request\n",
+					rp->name, addr, reg + 4 * i);
+			i++;
+			continue;
+		}
+		if (!in_slot) {
+			/* only values inside the slot are patched */
+			if (!rp->settings_addr++)
+				dev_err(rp->dev,
+					"replay: %s: the address word of register 0x%08x lies in the settings buffer\n",
+					rp->name, reg + 4 * i);
+			i++;
+			continue;
+		}
+		if (rp->num_relocs == CAMRAW_MAX_RELOCS) {
+			dev_err(rp->dev, "replay: %s: more than %u address words\n",
+				rp->name, CAMRAW_MAX_RELOCS);
+			return -E2BIG;
+		}
+		r = &rp->relocs[rp->num_relocs++];
+		r->reg = reg + 4 * i;
+		r->off = voff + 4 * i;
+		r->msb_off = r->off + 4;
+		r->addend = addr - rp->bufs[buf].iova;
+		r->buf = buf;
+		if (!rp->bufs[buf].hits++)
+			rp->bufs[buf].first_reg = r->reg;
+		if (!CAMRAW_BLK_IS_B(blk))
+			rp->bufs[buf].hits_a++;
+		i++;
+	}
+	return 0;
+}
+
+/* decode both lists: count, note the registers of interest, find addresses */
+static int camraw_walk(struct camraw_replay *rp)
+{
+	unsigned int list;
+	int ret;
+
+	for (list = 0; list < CAMRAW_NUM_LISTS; list++) {
+		u32 pos = rp->list_off[list];
+		u32 end = pos + rp->list_size[list];
+		bool has_end = false;
+
+		for (; pos + CAMRAW_CQ_DESC_SIZE <= end; pos += CAMRAW_CQ_DESC_SIZE) {
+			u32 ctrl = get_unaligned_le32(rp->slot + pos);
+			u64 ptr = get_unaligned_le64(rp->slot + pos + 4);
+			u32 op = (ctrl >> 25) & 3;
+			u32 count = ((ctrl >> 16) & 0x1ff) + 1;
+			u32 reg = camraw_desc_reg(ctrl);
+			int blk = camraw_block(reg);
+			const u8 *vals;
+			bool in_slot = false;
+			u32 voff = 0;
+
+			if (op == CAMRAW_CQ_OP_END) {
+				has_end = true;
+				break;
+			}
+			rp->num_desc[list]++;
+			if (ptr >= rp->slot_iova &&
+			    ptr + 4ULL * count <= rp->slot_iova + rp->slot_size) {
+				in_slot = true;
+				voff = ptr - rp->slot_iova;
+				vals = rp->slot + voff;
+			} else if (ptr >= rp->settings_iova &&
+				   ptr + 4ULL * count <=
+				   rp->settings_iova + rp->settings_size) {
+				voff = ptr - rp->settings_iova;
+				vals = rp->settings + voff;
+				rp->values_settings += count;
+			} else {
+				vals = NULL;
+			}
+			if (op != CAMRAW_CQ_OP_WRITE || !vals || blk < 0 ||
+			    camraw_block(reg + 4 * (count - 1)) != blk) {
+				if (!rp->bad_desc++)
+					dev_err(rp->dev,
+						"replay: %s: list %u descriptor at 0x%x: operation %u, register 0x%08x, %u values at 0x%llx: not a write of slot or settings values into one of the six blocks\n",
+						rp->name, list, pos, op, reg, count,
+						ptr);
+				continue;
+			}
+			rp->values[blk] += count;
+			if (CAMRAW_BLK_IS_B(blk))
+				rp->twin = true;
+			ret = camraw_walk_values(rp, blk, reg, vals, count, voff,
+						 in_slot);
+			if (ret)
+				return ret;
+		}
+		if (!has_end) {
+			dev_err(rp->dev, "replay: %s: list %u has no end\n",
+				rp->name, list);
+			rp->bad_desc++;
+		}
+	}
+	return 0;
+}
+
+static const char *camraw_kind(const struct camraw_replay *rp)
+{
+	if (rp->onetime)
+		return "start request with the one-time block";
+	if (camraw_replay_has_picture(rp))
+		return "steady request";
+	return "start-up request without the one-time block";
+}
+
+static void camraw_report(struct camraw_replay *rp)
+{
+	unsigned int i;
+
+	dev_info(rp->dev,
+		 "replay: %s: request %u, %s; slot 0x%x bytes at 0x%llx, main 0x%x+0x%x %u writes, sub 0x%x+0x%x %u writes, settings 0x%x bytes at 0x%llx (%u list values)\n",
+		 rp->name, rp->sequence, camraw_kind(rp),
+		 rp->slot_size, rp->slot_iova,
+		 rp->list_off[0], rp->list_size[0], rp->num_desc[0],
+		 rp->list_off[1], rp->list_size[1], rp->num_desc[1],
+		 rp->settings_size, rp->settings_iova, rp->values_settings);
+	dev_info(rp->dev,
+		 "replay: %s: values to RAW-A %u RMS-A %u YUV-A %u RAW-B %u RMS-B %u YUV-B %u; %u bad descriptors, %u addresses in no buffer, %u in the settings\n",
+		 rp->name, rp->values[0], rp->values[1], rp->values[2],
+		 rp->values[3], rp->values[4], rp->values[5], rp->bad_desc,
+		 rp->loose_addr, rp->settings_addr);
+	dev_info(rp->dev,
+		 "replay: %s: input %ux%u format %u pixel id %u pixel mode %u engines 0x%x; columns RAW-A %u-%u RAW-B %u-%u; writer enables RAW 0x%x/0x%x YUV 0x%x/0x%x\n",
+		 rp->name, rp->in_width, rp->in_height, rp->in_fmt,
+		 rp->pixel_id, rp->pixel_mode, rp->dev_mask,
+		 rp->split[0] & 0xffff, rp->split[0] >> 16,
+		 rp->split[1] & 0xffff, rp->split[1] >> 16,
+		 rp->mod5[CAMRAW_BLK_RAW_A], rp->mod5[CAMRAW_BLK_RAW_B],
+		 rp->mod5[CAMRAW_BLK_YUV_A], rp->mod5[CAMRAW_BLK_YUV_B]);
+	if (rp->onetime)
+		dev_info(rp->dev,
+			 "replay: %s: one-time block: grab window pixels %u-%u lines %u-%u, time stamp counter %u, RAW interrupt enable 0x%08x\n",
+			 rp->name, rp->grab_pxl & 0xffff, rp->grab_pxl >> 16,
+			 rp->grab_lin & 0xffff, rp->grab_lin >> 16,
+			 rp->time_stamp_cnt, rp->int_en);
+	if (camraw_replay_has_picture(rp))
+		dev_info(rp->dev,
+			 "replay: %s: picture %ux%u pitch %u format id %u, planes in buffers %d and %d\n",
+			 rp->name, rp->width, rp->height, rp->stride, rp->fmt_id,
+			 rp->out_plane[0], rp->out_plane[1]);
+	for (i = 0; i < rp->num_bufs; i++) {
+		const struct camraw_capbuf *b = &rp->bufs[i];
+
+		dev_info(rp->dev,
+			 "replay: %s: buffer %u: %s id %u plane %u, 0x%llx size 0x%x, %u address word(s), %u on side A\n",
+			 rp->name, i, camraw_kind_names[b->kind], b->id,
+			 b->plane, b->iova, b->size, b->hits, b->hits_a);
+	}
+	for (i = 0; i < rp->num_relocs; i++) {
+		const struct camraw_reloc *r = &rp->relocs[i];
+		int blk = camraw_block(r->reg);
+
+		dev_dbg(rp->dev, "replay: %s: address %s +0x%04x -> buffer %u + 0x%x\n",
+			rp->name, camraw_block_names[blk],
+			r->reg - camraw_block_base[blk], r->buf, r->addend);
+	}
+	if (rp->blocker)
+		dev_warn(rp->dev, "replay: %s: not to be run: %s\n", rp->name,
+			 rp->blocker);
+}
+
+void camraw_replay_free(struct camraw_replay *rp)
+{
+	kvfree(rp->settings);
+	kvfree(rp->slot);
+	memset(rp, 0, sizeof(*rp));
+}
+
+int camraw_replay_parse(struct camraw_replay *rp, struct device *dev,
+			const char *name, const u8 *data, size_t len)
+{
+	const u8 *slot, *settings, *fp, *cp;
+	struct camraw_capbuf *b;
+	u32 fp_size, cp_size;
+	unsigned int i;
+	int ret;
+
+	memset(rp, 0, sizeof(*rp));
+	rp->dev = dev;
+	rp->name = name;
+	rp->frame_seq_off = CAMRAW_NO_OFFSET;
+	for (i = 0; i < CAMRAW_PICTURE_PLANES; i++)
+		rp->out_plane[i] = -1;
+	for (i = 0; i < CAMRAW_NUM_BLOCKS; i++)
+		rp->mod5_off[i] = CAMRAW_NO_OFFSET;
+
+	if (len < DUMP_MIN_HEADER) {
+		dev_err(dev, "replay: %s: %zu bytes, shorter than the header\n",
+			name, len);
+		return -EINVAL;
+	}
+	if (!camraw_get_section(data, len, DUMP_SLOT, &slot, &rp->slot_size) ||
+	    !camraw_get_section(data, len, DUMP_SETTINGS, &settings,
+				&rp->settings_size) ||
+	    !camraw_get_section(data, len, DUMP_FRAME_PARAM, &fp, &fp_size) ||
+	    !camraw_get_section(data, len, DUMP_CONFIG_PARAM, &cp, &cp_size)) {
+		dev_err(dev, "replay: %s: a section of the dump is empty or outside the file\n",
+			name);
+		return -EINVAL;
+	}
+	rp->sequence = get_unaligned_le32(data + DUMP_SEQUENCE);
+	rp->slot_iova = get_unaligned_le64(data + DUMP_SLOT_IOVA);
+	rp->settings_iova = get_unaligned_le64(data + DUMP_SETTINGS_IOVA);
+	rp->list_off[0] = get_unaligned_le32(data + DUMP_MAIN);
+	rp->list_size[0] = get_unaligned_le32(data + DUMP_MAIN + 4);
+	rp->list_off[1] = get_unaligned_le32(data + DUMP_SUB);
+	rp->list_size[1] = get_unaligned_le32(data + DUMP_SUB + 4);
+	for (i = 0; i < CAMRAW_NUM_LISTS; i++) {
+		if ((u64)rp->list_off[i] + rp->list_size[i] > rp->slot_size ||
+		    rp->list_size[i] % CAMRAW_CQ_DESC_SIZE) {
+			dev_err(dev, "replay: %s: list %u (0x%x + 0x%x) outside the slot or not whole descriptors\n",
+				name, i, rp->list_off[i], rp->list_size[i]);
+			return -EINVAL;
+		}
+	}
+
+	rp->slot = kvmemdup(slot, rp->slot_size, GFP_KERNEL);
+	rp->settings = kvmemdup(settings, rp->settings_size, GFP_KERNEL);
+	if (!rp->slot || !rp->settings) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	/* buffers 0 and 1: the slot and the settings, with their content */
+	b = camraw_add_buf(rp, rp->slot_iova, rp->slot_size, CAMRAW_BUF_SLOT,
+			   0, 0);
+	b->content = rp->slot;
+	b = camraw_add_buf(rp, rp->settings_iova, rp->settings_size,
+			   CAMRAW_BUF_SETTINGS, 0, 0);
+	b->content = rp->settings;
+	ret = camraw_parse_params(rp, fp, fp_size, cp, cp_size);
+	if (ret)
+		goto err;
+	ret = camraw_walk(rp);
+	if (ret)
+		goto err;
+
+	if (!rp->list_size[0] || !rp->list_size[1])
+		rp->blocker = "an empty list hangs the command queue";
+	else if (rp->bad_desc)
+		rp->blocker = "a descriptor is not in the known format";
+	else if (rp->loose_addr)
+		rp->blocker = "an address of the lists is in no buffer of the request: its port would use the captured address";
+	else if (rp->settings_addr)
+		rp->blocker = "an address of the lists lies in the settings buffer, where it is not patched";
+	else if (!rp->values[CAMRAW_BLK_RAW_A])
+		rp->blocker = "the lists write nothing to RAW-A";
+
+	camraw_report(rp);
+	return 0;
+
+err:
+	camraw_replay_free(rp);
+	return ret;
+}
+
+/*
+ * Can @start be applied before the stream starts and @frame for every
+ * frame after it? Each is applied whole; registers of the two are never
+ * combined. Returns NULL or the reason.
+ */
+const char *camraw_replay_pair_check(const struct camraw_replay *start,
+				     const struct camraw_replay *frame)
+{
+	if (start->blocker || frame->blocker)
+		return "one of the two requests has an objection of its own";
+	if (!start->onetime)
+		return "the start request has no one-time block (grab window, time stamp counter, interrupt enables)";
+	if (frame->onetime)
+		return "the per-frame request carries the one-time block";
+	if (!camraw_replay_has_picture(frame))
+		return "the per-frame request has no picture output";
+	if (start->in_fmt != frame->in_fmt ||
+	    start->pixel_id != frame->pixel_id ||
+	    start->pixel_mode != frame->pixel_mode ||
+	    start->in_width != frame->in_width ||
+	    start->in_height != frame->in_height ||
+	    start->dev_mask != frame->dev_mask)
+		return "the two requests are for different sensor input or engines";
+	if (start->twin != frame->twin)
+		return "one request is for two RAW engines, the other for one";
+	return NULL;
+}
+
+/* copy the descriptors of one list, close it; returns its size with the end */
+static u32 camraw_emit_list(const struct camraw_replay *rp, u8 *dst,
+			    unsigned int list, u64 slot_base, u64 settings_base,
+			    bool a_only)
+{
+	u32 pos = rp->list_off[list];
+	u32 end = pos + rp->list_size[list];
+	u32 out = pos;
+
+	for (; pos + CAMRAW_CQ_DESC_SIZE <= end; pos += CAMRAW_CQ_DESC_SIZE) {
+		u32 ctrl = get_unaligned_le32(rp->slot + pos);
+		u64 ptr = get_unaligned_le64(rp->slot + pos + 4);
+
+		if (((ctrl >> 25) & 3) == CAMRAW_CQ_OP_END)
+			break;
+		if (a_only && CAMRAW_BLK_IS_B(camraw_block(camraw_desc_reg(ctrl))))
+			continue;
+		if (ptr >= rp->slot_iova && ptr < rp->slot_iova + rp->slot_size)
+			ptr = ptr - rp->slot_iova + slot_base;
+		else
+			ptr = ptr - rp->settings_iova + settings_base;
+		put_unaligned_le32(ctrl, dst + out);
+		put_unaligned_le64(ptr, dst + out + 4);
+		out += CAMRAW_CQ_DESC_SIZE;
+	}
+	put_unaligned_le32(CAMRAW_CQ_END_CTRL, dst + out);
+	put_unaligned_le64(0, dst + out + 4);
+	out += CAMRAW_CQ_DESC_SIZE;
+	/* what is left of the captured list is not part of it any more */
+	if (out < end)
+		memset(dst + out, 0, end - out);
+	return out - rp->list_off[list];
+}
+
+/*
+ * Write the slot for the address @slot_base into @dst (slot_size bytes):
+ * value pointers moved with the slot and with the settings buffer, every
+ * address pointing into the replacement buffers, the picture planes into
+ * @picture[] if given. @emit_size gets the sizes of the two lists to
+ * program. Every buffer an address word points into must have a
+ * replacement (cpu set); the slot is @dst itself.
+ */
+int camraw_replay_emit(const struct camraw_replay *rp, u8 *dst, u64 slot_base,
+		       unsigned int flags, const dma_addr_t *picture,
+		       u32 emit_size[CAMRAW_NUM_LISTS])
+{
+	const struct camraw_capbuf *settings = &rp->bufs[CAMRAW_BUFIDX_SETTINGS];
+	bool a_only = flags & CAMRAW_EMIT_A_ONLY;
+	unsigned int i, p;
+
+	if (rp->bad_desc || !settings->cpu)
+		return -EINVAL;
+
+	memcpy(dst, rp->slot, rp->slot_size);
+	for (i = 0; i < CAMRAW_NUM_LISTS; i++)
+		emit_size[i] = camraw_emit_list(rp, dst, i, slot_base,
+						settings->dma, a_only);
+
+	for (i = 0; i < rp->num_relocs; i++) {
+		const struct camraw_reloc *r = &rp->relocs[i];
+		const struct camraw_capbuf *b = &rp->bufs[r->buf];
+		u64 addr;
+
+		if (a_only && CAMRAW_BLK_IS_B(camraw_block(r->reg)))
+			continue;
+		if (r->buf == CAMRAW_BUFIDX_SLOT)
+			addr = slot_base;
+		else if (b->cpu)
+			addr = b->dma;
+		else
+			return -ENOBUFS;
+		for (p = 0; picture && p < CAMRAW_PICTURE_PLANES; p++)
+			if (r->buf == rp->out_plane[p])
+				addr = picture[p];
+		addr += r->addend;
+		put_unaligned_le32(lower_32_bits(addr), dst + r->off);
+		put_unaligned_le32(upper_32_bits(addr), dst + r->msb_off);
+	}
+
+	for (i = 0; i < CAMRAW_NUM_BLOCKS; i++) {
+		u32 clear = 0, val;
+
+		if (rp->mod5_off[i] == CAMRAW_NO_OFFSET)
+			continue;
+		if (i == CAMRAW_BLK_RAW_A || i == CAMRAW_BLK_RAW_B) {
+			if (flags & CAMRAW_EMIT_STATS_OFF)
+				clear = CAMCTL_MOD5_STATS;
+		} else {
+			if (flags & CAMRAW_EMIT_STATS_OFF)
+				clear |= YUV_MOD5_STATS;
+			if (flags & CAMRAW_EMIT_EXTRA_OFF)
+				clear |= YUV_MOD5_EXTRA;
+		}
+		val = get_unaligned_le32(dst + rp->mod5_off[i]);
+		put_unaligned_le32(val & ~clear, dst + rp->mod5_off[i]);
+	}
+	return 0;
+}
diff --git a/drivers/media/platform/mediatek/camraw/mtk-camraw-replay.h b/drivers/media/platform/mediatek/camraw/mtk-camraw-replay.h
new file mode 100644
index 000000000000..eb19ded5b28d
--- /dev/null
+++ b/drivers/media/platform/mediatek/camraw/mtk-camraw-replay.h
@@ -0,0 +1,200 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MediaTek MT6878 RAW engine: replay of a captured command queue.
+ *
+ * Pure data code. It reads one request dump (header, the 64 KiB command
+ * queue slot, the per-request settings buffer, frame and configuration
+ * parameters), decodes both descriptor lists and finds the words that
+ * carry buffer addresses, so that a copy of the slot can be placed at
+ * another address with other buffers. It never touches hardware.
+ *
+ * Copyright (c) 2026 serlk
+ */
+
+#ifndef _MTK_CAMRAW_REPLAY_H
+#define _MTK_CAMRAW_REPLAY_H
+
+#include <linux/bits.h>
+#include <linux/types.h>
+
+struct device;
+
+#define CAMRAW_MAX_BUFS			24
+#define CAMRAW_MAX_RELOCS		64
+#define CAMRAW_NO_OFFSET		0xffffffff
+
+#define CAMRAW_CQ_DESC_SIZE		12
+#define CAMRAW_CQ_OP_WRITE		0
+#define CAMRAW_CQ_OP_END		3
+#define CAMRAW_CQ_END_CTRL		0x06000000
+#define CAMRAW_CQ_REG_PREFIX		0x1a000000
+
+enum camraw_list {
+	CAMRAW_LIST_MAIN,
+	CAMRAW_LIST_SUB,
+	CAMRAW_NUM_LISTS,
+};
+
+/* the register blocks the lists of a two-engine frame address */
+enum camraw_block {
+	CAMRAW_BLK_RAW_A,
+	CAMRAW_BLK_RMS_A,
+	CAMRAW_BLK_YUV_A,
+	CAMRAW_BLK_RAW_B,
+	CAMRAW_BLK_RMS_B,
+	CAMRAW_BLK_YUV_B,
+	CAMRAW_NUM_BLOCKS,
+};
+
+#define CAMRAW_BLK_IS_B(b)		((b) >= CAMRAW_BLK_RAW_B)
+
+enum camraw_buf_kind {
+	CAMRAW_BUF_SLOT,	/* the command queue slot itself */
+	CAMRAW_BUF_SETTINGS,	/* per-request settings: list values, shading table */
+	CAMRAW_BUF_IMAGE,
+	CAMRAW_BUF_STATS,
+};
+
+/* the slot and the settings buffer are always the first two buffers */
+#define CAMRAW_BUFIDX_SLOT		0
+#define CAMRAW_BUFIDX_SETTINGS		1
+
+/* the picture: image output 6 of the frame parameters, two planes */
+#define CAMRAW_OUT_PICTURE		6
+#define CAMRAW_PICTURE_PLANES		2
+/* its format identifier for two planes, V before U (NV21) */
+#define CAMRAW_FMT_YVU420_2P		24
+
+/* emit flags */
+#define CAMRAW_EMIT_A_ONLY		BIT(0)	/* leave out the side B descriptors */
+#define CAMRAW_EMIT_STATS_OFF		BIT(1)	/* statistics writers disabled */
+#define CAMRAW_EMIT_EXTRA_OFF		BIT(2)	/* outputs other than the picture disabled */
+
+/**
+ * struct camraw_capbuf - a buffer the captured request used
+ * @iova: its address in the capture
+ * @size: its size in bytes
+ * @kind: what it is
+ * @id: output or statistics identifier of the frame parameters
+ * @plane: plane number of an image
+ * @content: its captured content (slot and settings), or NULL
+ * @hits: number of address words that point into it
+ * @hits_a: those written to side A registers
+ * @first_reg: register of the first address word
+ * @cpu: replacement buffer (set by the user of the parser)
+ * @dma: its address for the engines
+ * @dma_dev: the device it was allocated for
+ */
+struct camraw_capbuf {
+	u64 iova;
+	u32 size;
+	u8 kind;
+	u8 id;
+	u8 plane;
+	const u8 *content;
+	unsigned int hits;
+	unsigned int hits_a;
+	u32 first_reg;
+
+	void *cpu;
+	dma_addr_t dma;
+	struct device *dma_dev;
+};
+
+/**
+ * struct camraw_reloc - an address of the lists: two consecutive registers
+ * @reg: register of the low 32 bits; the upper bits go to @reg + 4
+ * @off: offset in the slot of the low word
+ * @msb_off: offset in the slot of the upper word
+ * @addend: distance of the address from the start of the buffer
+ * @buf: index of the buffer
+ */
+struct camraw_reloc {
+	u32 reg;
+	u32 off;
+	u32 msb_off;
+	u32 addend;
+	u8 buf;
+};
+
+/**
+ * struct camraw_replay - one request dump, decoded
+ */
+struct camraw_replay {
+	struct device *dev;
+	const char *name;
+
+	u8 *slot;
+	u32 slot_size;
+	u64 slot_iova;
+	u8 *settings;
+	u32 settings_size;
+	u64 settings_iova;
+	u32 list_off[CAMRAW_NUM_LISTS];
+	u32 list_size[CAMRAW_NUM_LISTS];
+	u32 sequence;
+
+	struct camraw_capbuf bufs[CAMRAW_MAX_BUFS];
+	unsigned int num_bufs;
+	struct camraw_reloc relocs[CAMRAW_MAX_RELOCS];
+	unsigned int num_relocs;
+
+	/* what the decoding showed */
+	unsigned int num_desc[CAMRAW_NUM_LISTS];
+	unsigned int values[CAMRAW_NUM_BLOCKS];
+	unsigned int values_settings;
+	unsigned int bad_desc;
+	unsigned int loose_addr;
+	unsigned int settings_addr;
+	bool twin;
+
+	/* the one-time block of the first request of a stream */
+	bool onetime;
+	u32 grab_pxl;
+	u32 grab_lin;
+	u32 time_stamp_cnt;
+	u32 int_en;
+
+	/* values of interest, and where the writer enables lie in the slot */
+	bool has_frame_seq;
+	u32 frame_seq;
+	u32 frame_seq_off;
+	bool has_split[2];
+	u32 split[2];
+	u32 mod5_off[CAMRAW_NUM_BLOCKS];
+	u32 mod5[CAMRAW_NUM_BLOCKS];
+
+	/* configuration parameters */
+	u8 in_fmt;
+	u8 pixel_id;
+	u8 pixel_mode;
+	u16 in_width;
+	u16 in_height;
+	u16 dev_mask;
+
+	/* the picture: output 6 of the frame parameters, -1 if there is none */
+	int out_plane[CAMRAW_PICTURE_PLANES];
+	u32 width;
+	u32 height;
+	u32 stride;
+	u32 fmt_id;
+
+	/* why the request must not be run, NULL if nothing is known */
+	const char *blocker;
+};
+
+static inline bool camraw_replay_has_picture(const struct camraw_replay *rp)
+{
+	return rp->out_plane[0] >= 0 && rp->out_plane[1] >= 0;
+}
+
+int camraw_replay_parse(struct camraw_replay *rp, struct device *dev,
+			const char *name, const u8 *data, size_t len);
+void camraw_replay_free(struct camraw_replay *rp);
+const char *camraw_replay_pair_check(const struct camraw_replay *start,
+				     const struct camraw_replay *frame);
+int camraw_replay_emit(const struct camraw_replay *rp, u8 *dst, u64 slot_base,
+		       unsigned int flags, const dma_addr_t *picture,
+		       u32 emit_size[CAMRAW_NUM_LISTS]);
+
+#endif /* _MTK_CAMRAW_REPLAY_H */
diff --git a/drivers/media/platform/mediatek/camraw/mtk-camraw.h b/drivers/media/platform/mediatek/camraw/mtk-camraw.h
new file mode 100644
index 000000000000..62e45624be93
--- /dev/null
+++ b/drivers/media/platform/mediatek/camraw/mtk-camraw.h
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MediaTek MT6878 RAW / YUV engine pair driven by a replayed command queue.
+ *
+ * Copyright (c) 2026 serlk
+ */
+
+#ifndef _MTK_CAMRAW_H
+#define _MTK_CAMRAW_H
+
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+#include <media/v4l2-device.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "mtk-camraw-regs.h"
+#include "mtk-camraw-replay.h"
+
+#define CAMRAW_DRV_NAME			"mtk-camraw-mt6878"
+#define CAMYUV_DRV_NAME			"mtk-camyuv-mt6878"
+
+#define CAMYUV_NUM_CLKS			3
+/* two copies of the per-frame request, each with its own picture planes */
+#define CAMRAW_NUM_SETS			2
+#define CAMRAW_SOF_LOG			16
+/* register snapshot of one engine pair: ranges, then the port error words */
+#define CAMRAW_SNAP_WORDS		200
+#define CAMRAW_SNAP_PORTS		40
+
+/* interrupt lines of side A */
+enum {
+	CAMRAW_IRQ_RAW,
+	CAMRAW_IRQ_YUV,
+	CAMRAW_NUM_IRQS,
+};
+
+/**
+ * struct mtk_camyuv - the YUV engine: the writers of the processed picture
+ * @dev: device
+ * @base: registers
+ * @irq: interrupt line
+ * @clks: gates of the engine
+ */
+struct mtk_camyuv {
+	struct device *dev;
+	void __iomem *base;
+	int irq;
+	struct clk_bulk_data clks[CAMYUV_NUM_CLKS];
+};
+
+struct mtk_camraw_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+};
+
+/**
+ * struct mtk_camraw_irq - what one interrupt line has reported
+ * @pend: status bits per group since the thread last looked
+ * @count: interrupts taken
+ * @empty: interrupts with no status bit in any group
+ * @reread_set: second reads of a status word that still showed a bit of
+ *		the first (read to clear does not hold)
+ * @reread_clear: second reads that showed none
+ * @burst: interrupts within the current jiffy
+ * @burst_jiffies: that jiffy
+ * @w1c_tried: the status was written back once to stop a burst
+ * @storm: the line was switched off because it would not go quiet
+ * @enabled: the line is enabled
+ */
+struct mtk_camraw_irq {
+	u32 pend[CAMRAW_NUM_INT + 1];
+	unsigned int count;
+	unsigned int empty;
+	unsigned int reread_set;
+	unsigned int reread_clear;
+	unsigned int burst;
+	unsigned long burst_jiffies;
+	bool w1c_tried;
+	bool storm;
+	bool enabled;
+};
+
+/* a DMA buffer of the driver */
+struct mtk_camraw_dma {
+	void *cpu;
+	dma_addr_t dma;
+	size_t size;
+};
+
+/* what the first start-of-frame interrupts saw */
+struct mtk_camraw_snap {
+	bool taken;
+	u32 t_us;
+	u32 val[CAMRAW_SNAP_WORDS];
+	u32 port[CAMRAW_SNAP_PORTS];
+	u32 port_reg[CAMRAW_SNAP_PORTS];
+	unsigned int num_ports;
+};
+
+struct mtk_camraw_sof {
+	u32 t_us;		/* time since viewfinder on */
+	u32 applied;		/* number of per-frame requests applied before */
+	u32 seq;		/* frame number register */
+	u32 seq_inner;		/* its latched copy */
+	u32 frmsize;		/* frame size the timing generator measured */
+};
+
+/**
+ * struct mtk_camraw - a RAW engine; RAW-A also has the video node
+ * @twin: RAW-B, the second engine of a two-engine frame (RAW-A only)
+ * @raw_id: 0 for RAW-A, 1 for RAW-B
+ * @lock: serializes loading, starting and stopping
+ * @irq_lock: interrupt bookkeeping
+ * @buf_lock: the list of queued buffers
+ */
+struct mtk_camraw {
+	struct device *dev;
+	struct mtk_camyuv *yuv;
+	struct mtk_camraw *twin;
+	u32 raw_id;
+	void __iomem *base;
+	void __iomem *inner;
+	struct regmap *camsys;
+	int irq;
+	struct clk_bulk_data *clks;
+	int num_clks;
+	struct clk *cam_sel;
+	unsigned long cam_rate_saved;
+
+	struct v4l2_device v4l2_dev;
+	struct video_device vdev;
+	struct vb2_queue vq;
+	struct mutex vlock;
+	struct mutex lock;
+	spinlock_t buf_lock;
+	struct list_head bufs;
+
+	/* the two loaded requests: the start request and the per-frame one */
+	struct camraw_replay start;
+	struct camraw_replay frame;
+	bool loaded;
+	const char *pair_problem;
+	struct mtk_camraw_dma slot_start;
+	struct mtk_camraw_dma slot_frame[CAMRAW_NUM_SETS];
+	/* picture planes of set 1; set 0 are the frame request's own buffers */
+	struct mtk_camraw_dma pic1[CAMRAW_PICTURE_PLANES];
+	dma_addr_t pic_dma[CAMRAW_NUM_SETS][CAMRAW_PICTURE_PLANES];
+	void *pic_cpu[CAMRAW_NUM_SETS][CAMRAW_PICTURE_PLANES];
+	u32 pic_size[CAMRAW_PICTURE_PLANES];
+	u32 start_size[CAMRAW_NUM_LISTS];
+	u32 frame_size[CAMRAW_NUM_LISTS];
+	u32 pixfmt;
+	u32 width;
+	u32 height;
+	u32 stride;
+	u32 sizeimage;
+
+	/* the running stream */
+	struct v4l2_subdev *source;
+	unsigned int source_pad;
+	bool source_on;
+	bool streaming;
+	bool twin_on;
+	unsigned int emit_flags;
+	unsigned int sequence;
+	unsigned int n_frame_applied;
+	struct completion cq_done;
+	struct delayed_work watchdog;
+	struct mtk_camraw_sof sof_log[CAMRAW_SOF_LOG];
+	unsigned int n_sof_log;
+	u64 vf_ns;
+	u32 err_us;
+	/* snapshots at the first start of frame and the first error, A and B */
+	struct mtk_camraw_snap snap[2][2];
+
+	spinlock_t irq_lock;
+	struct mtk_camraw_irq irqs[CAMRAW_NUM_IRQS];
+	u32 cq_seen;
+	u64 sof_ns;
+	unsigned int n_sof;
+	unsigned int n_cq_main;
+	unsigned int n_cq_sub;
+	unsigned int n_pass1;
+	unsigned int n_yuvo;
+	unsigned int n_frames;
+	unsigned int n_no_buffer;
+	unsigned int n_applied;
+	u32 err_bits;
+	unsigned int n_err;
+
+	struct dentry *debugfs;
+	struct dentry *debugfs_bufs;
+};
+
+#endif /* _MTK_CAMRAW_H */
