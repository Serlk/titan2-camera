+static int camyuv_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mtk_camyuv *yuv;
+	unsigned int i;
+	int ret;
+
+	yuv = devm_kzalloc(dev, sizeof(*yuv), GFP_KERNEL);
+	if (!yuv)
+		return -ENOMEM;
+	yuv->dev = dev;
+
+	yuv->base = devm_platform_ioremap_resource_byname(pdev, "base");
+	if (IS_ERR(yuv->base))
+		return PTR_ERR(yuv->base);
+	yuv->irq = platform_get_irq(pdev, 0);
+	if (yuv->irq < 0)
+		return yuv->irq;
+	for (i = 0; i < CAMYUV_NUM_CLKS; i++)
+		yuv->clks[i].id = camyuv_clk_names[i];
+	ret = devm_clk_bulk_get(dev, CAMYUV_NUM_CLKS, yuv->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	if (!device_iommu_mapped(dev))
+		return dev_err_probe(dev, -ENODEV,
+				     "not behind the MM IOMMU: the writers need their larb ports in \"iommus\"\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(34));
+	if (ret)
+		return ret;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, yuv);
+	return 0;
+}
+
+static int camyuv_runtime_suspend(struct device *dev)
+{
+	struct mtk_camyuv *yuv = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(CAMYUV_NUM_CLKS, yuv->clks);
+	return 0;
+}
+
+static int camyuv_runtime_resume(struct device *dev)
+{
+	struct mtk_camyuv *yuv = dev_get_drvdata(dev);
+
+	return clk_bulk_prepare_enable(CAMYUV_NUM_CLKS, yuv->clks);
+}
+
+static const struct dev_pm_ops camyuv_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+	RUNTIME_PM_OPS(camyuv_runtime_suspend, camyuv_runtime_resume, NULL)
+};
