+#undef CAMRAW_OUT
+
+/* ------------------------------------------------------------------ */
+/* Register snapshots at the first start of frame and the first error  */
+
+static const struct {
+	bool yuv;
+	u16 off;
+	u16 num;
+} camraw_snap_ranges[] = {
+	{ false, 0x000, 64 },	/* control: enables, selects, misc, start */
+	{ false, 0x100, 36 },	/* interrupt groups 1..9 */
+	{ false, 0x700, 32 },	/* timing generator */
+	{ true, 0x000, 32 },	/* YUV control */
+	{ true, 0x100, 36 },	/* YUV interrupt groups */
+};
+
+static const char * const camraw_snap_names[] = {
+	"first start of frame", "first error interrupt",
+};
+
+/* the register window of a list address on the side of @eng, or NULL */
+static void __iomem *camraw_port_base(struct mtk_camraw *eng, u32 reg)
+{
+	u32 blk = reg & 0xffff0000;
+	u32 raw_blk = eng->raw_id ? CAMRAW_RAW_B_BASE : CAMRAW_RAW_A_BASE;
+	u32 yuv_blk = eng->raw_id ? CAMRAW_YUV_B_BASE : CAMRAW_YUV_A_BASE;
+
+	if ((reg & 0xffff) >= CAMRAW_WIN_SIZE)
+		return NULL;
+	if (blk == raw_blk)
+		return eng->base;
+	if (blk == yuv_blk)
+		return eng->yuv->base;
+	return NULL;	/* RMS: not mapped */
+}
+
+static void camraw_snap_take(struct mtk_camraw *raw, struct mtk_camraw *eng,
+			     struct mtk_camraw_snap *s, u32 t_us)
+{
+	const struct camraw_replay *rp = &raw->frame;
+	unsigned int i, j, n = 0;
+	void __iomem *base;
+
+	if (s->taken)
+		return;
+	for (i = 0; i < ARRAY_SIZE(camraw_snap_ranges); i++) {
+		base = camraw_snap_ranges[i].yuv ? eng->yuv->base : eng->base;
+		for (j = 0; j < camraw_snap_ranges[i].num; j++)
+			s->val[n++] = readl(base + camraw_snap_ranges[i].off + 4 * j);
+	}
+	s->num_ports = 0;
+	for (i = 0; i < rp->num_relocs && s->num_ports < CAMRAW_SNAP_PORTS; i++) {
+		base = camraw_port_base(eng, rp->relocs[i].reg);
+		if (!base)
+			continue;
+		s->port_reg[s->num_ports] = rp->relocs[i].reg;
+		s->port[s->num_ports++] =
+			readl(base + (rp->relocs[i].reg & 0xffff) + CAMRAW_DMA_ERR_STAT);
+	}
+	s->t_us = t_us;
+	s->taken = true;
+}
+
+static void camraw_snap_show(struct mtk_camraw *raw, struct mtk_camraw *eng,
+			     const struct mtk_camraw_snap *s, const char *what,
+			     struct seq_file *m)
+{
+	char line[160];
+	unsigned int i, j, k, n = 0;
+	int len;
+
+	if (!s->taken)
+		return;
+	for (i = 0; i < ARRAY_SIZE(camraw_snap_ranges); i++) {
+		for (j = 0; j < camraw_snap_ranges[i].num; j += 8) {
+			len = 0;
+			for (k = j; k < j + 8 && k < camraw_snap_ranges[i].num; k++)
+				len += scnprintf(line + len, sizeof(line) - len,
+						 " %08x", s->val[n + k]);
+			if (m)
+				seq_printf(m, "snapshot %s (%u us) %s-%c +0x%03x:%s\n",
+					   what, s->t_us,
+					   camraw_snap_ranges[i].yuv ? "YUV" : "RAW",
+					   'A' + eng->raw_id,
+					   camraw_snap_ranges[i].off + 4 * j, line);
+			else
+				dev_info(raw->dev, "snapshot %s (%u us) %s-%c +0x%03x:%s\n",
+					 what, s->t_us,
+					 camraw_snap_ranges[i].yuv ? "YUV" : "RAW",
+					 'A' + eng->raw_id,
+					 camraw_snap_ranges[i].off + 4 * j, line);
+		}
+		n += camraw_snap_ranges[i].num;
+	}
+	for (i = 0; i < s->num_ports; i += 6) {
+		len = 0;
+		for (k = i; k < i + 6 && k < s->num_ports; k++)
+			len += scnprintf(line + len, sizeof(line) - len,
+					 " %05x:%08x", s->port_reg[k] & 0xfffff,
+					 s->port[k]);
+		if (m)
+			seq_printf(m, "snapshot %s side %c port error status:%s\n",
+				   what, 'A' + eng->raw_id, line);
+		else
+			dev_info(raw->dev, "snapshot %s side %c port error status:%s\n",
+				 what, 'A' + eng->raw_id, line);
+	}
+}
+
+static void camraw_snaps_show(struct mtk_camraw *raw, struct seq_file *m)
+{
+	unsigned int ev;
+
+	for (ev = 0; ev < 2; ev++) {
+		camraw_snap_show(raw, raw, &raw->snap[ev][0],
+				 camraw_snap_names[ev], m);
+		if (raw->twin)
+			camraw_snap_show(raw, raw->twin, &raw->snap[ev][1],
+					 camraw_snap_names[ev], m);
+	}
+}
+
+static u32 camraw_us_since_vf(struct mtk_camraw *raw)
+{
+	return raw->vf_ns ? div_u64(ktime_get_ns() - raw->vf_ns, 1000) : 0;
+}
+
+static void camraw_snap_event(struct mtk_camraw *raw, unsigned int ev)
+{
+	u32 t = camraw_us_since_vf(raw);
+
+	camraw_snap_take(raw, raw, &raw->snap[ev][0], t);
+	if (raw->twin_on)
+		camraw_snap_take(raw, raw->twin, &raw->snap[ev][1], t);
+}
+
+/* ------------------------------------------------------------------ */
+/* Interrupts                                                          */
+
+static irqreturn_t camraw_irq_common(struct mtk_camraw *raw, unsigned int line,
+				     void __iomem *base, int irq)
+{
+	struct mtk_camraw_irq *q = &raw->irqs[line];
+	u32 st[CAMRAW_NUM_INT + 1];
+	u32 any = 0, again;
+	unsigned int n;
+
+	for (n = 1; n <= CAMRAW_NUM_INT; n++) {
+		st[n] = readl(base + CAMCTL_INT_STATUS(n));
+		any |= st[n];
+	}
+
+	spin_lock(&raw->irq_lock);
+	q->count++;
+	if (!any)
+		q->empty++;
+
+	/* is a status word cleared by reading it? look again, the first times */
+	if (any && q->reread_set + q->reread_clear < 16) {
+		for (n = 1; n <= CAMRAW_NUM_INT; n++) {
+			if (!st[n])
+				continue;
+			again = readl(base + CAMCTL_INT_STATUS(n));
+			if (again & st[n])
+				q->reread_set++;
+			else
+				q->reread_clear++;
+			st[n] |= again;
+		}
+	}
+
+	/*
+	 * A level interrupt that reading does not quiet would hold the CPU:
+	 * write the status back once, and switch the line off if that does
+	 * not help either.
+	 */
+	if (q->burst_jiffies != jiffies) {
+		q->burst_jiffies = jiffies;
+		q->burst = 0;
+	} else if (++q->burst > CAMRAW_IRQ_BURST) {
+		if (!q->w1c_tried) {
+			for (n = 1; n <= CAMRAW_NUM_INT; n++)
+				writel(st[n], base + CAMCTL_INT_STATUS(n));
+			q->w1c_tried = true;
+			q->burst = 0;
+		} else if (q->enabled) {
+			disable_irq_nosync(irq);
+			q->enabled = false;
+			q->storm = true;
+		}
+	}
+
+	for (n = 1; n <= CAMRAW_NUM_INT; n++)
+		q->pend[n] |= st[n];
+
+	if (line == CAMRAW_IRQ_RAW) {
+		if (st[1] & CAMCTL_INT_TG_SOF) {
+			raw->n_sof++;
+			raw->sof_ns = ktime_get_ns();
+		}
+		if (st[1] & (CAMCTL_INT_PASS1_DONE | CAMCTL_INT_RAW_PASS1_DONE))
+			raw->n_pass1++;
+		if (st[1] & CAMCTL_INT_ERRORS) {
+			raw->n_err++;
+			raw->err_bits |= st[1] & CAMCTL_INT_ERRORS;
+		}
+		if (st[6] & CAMCTL_INT6_CQ_THR0_DONE)
+			raw->n_cq_main++;
+		if (st[6] & CAMCTL_INT6_CQ_THRSUB_DONE)
+			raw->n_cq_sub++;
+	} else if (st[2] & YUV_INT2_YUVO_R1_DONE) {
+		raw->n_yuvo++;
+	}
+	spin_unlock(&raw->irq_lock);
+
+	return IRQ_WAKE_THREAD;
+}
+
+static irqreturn_t camraw_raw_irq(int irq, void *data)
+{
+	struct mtk_camraw *raw = data;
+
+	return camraw_irq_common(raw, CAMRAW_IRQ_RAW, raw->base, irq);
+}
+
+static irqreturn_t camraw_yuv_irq(int irq, void *data)
+{
+	struct mtk_camraw *raw = data;
+
+	return camraw_irq_common(raw, CAMRAW_IRQ_YUV, raw->yuv->base, irq);
+}
+
+static void camraw_take_pending(struct mtk_camraw *raw, unsigned int line,
+				u32 *pend, bool *storm)
+{
+	struct mtk_camraw_irq *q = &raw->irqs[line];
+	unsigned long flags;
+
+	spin_lock_irqsave(&raw->irq_lock, flags);
+	memcpy(pend, q->pend, sizeof(q->pend));
+	memset(q->pend, 0, sizeof(q->pend));
+	*storm = q->storm;
+	spin_unlock_irqrestore(&raw->irq_lock, flags);
+}
+
+/* how much of the fill pattern the first frame left, left and right */
+static void camraw_check_picture(struct mtk_camraw *raw, unsigned int set)
+{
+	static const char * const where[] = { "left", "right" };
+	unsigned int p, i, j, same;
+	u32 line, col[2];
+	const u8 *q;
+
+	for (p = 0; p < CAMRAW_PICTURE_PLANES; p++) {
+		line = (p ? raw->height / 2 : raw->height) / 2;
+		col[0] = CAMRAW_PROBE_BYTES;
+		col[1] = raw->width - 2 * CAMRAW_PROBE_BYTES;
+		for (i = 0; i < ARRAY_SIZE(col); i++) {
+			q = (const u8 *)raw->pic_cpu[set][p] + line * raw->stride +
+			    col[i];
+			for (same = 0, j = 0; j < CAMRAW_PROBE_BYTES; j++)
+				same += q[j] == CAMRAW_FILL;
+			dev_info(raw->dev,
+				 "first frame: plane %u line %u %s (column %u): %u of %u bytes still the fill pattern%s, first bytes %*ph\n",
+				 p, line, where[i], col[i], same,
+				 CAMRAW_PROBE_BYTES,
+				 same == CAMRAW_PROBE_BYTES ? " (NOT WRITTEN)" : "",
+				 8, q);
+		}
+	}
+}
+
+/* the picture of set @set is complete: copy it into the next buffer */
+static void camraw_deliver(struct mtk_camraw *raw, unsigned int set)
+{
+	struct mtk_camraw_buffer *buf;
+	unsigned long flags;
+	u8 *dst;
+
+	if (!raw->n_frames++)
+		camraw_check_picture(raw, set);
+
+	spin_lock_irqsave(&raw->buf_lock, flags);
+	buf = list_first_entry_or_null(&raw->bufs, struct mtk_camraw_buffer, list);
+	if (buf)
+		list_del(&buf->list);
+	spin_unlock_irqrestore(&raw->buf_lock, flags);
+	if (!buf) {
+		raw->n_no_buffer++;
+		return;
+	}
+
+	dst = vb2_plane_vaddr(&buf->vb.vb2_buf, 0);
+	memcpy(dst, raw->pic_cpu[set][0], raw->pic_size[0]);
+	memcpy(dst + raw->pic_size[0], raw->pic_cpu[set][1], raw->pic_size[1]);
+	vb2_set_plane_payload(&buf->vb.vb2_buf, 0, raw->sizeimage);
+	buf->vb.field = V4L2_FIELD_NONE;
+	buf->vb.sequence = raw->sequence++;
+	buf->vb.vb2_buf.timestamp = raw->sof_ns ? raw->sof_ns : ktime_get_ns();
+	vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_DONE);
+}
+
+/*
+ * Start of frame. Application j of the per-frame request, made after one
+ * start of frame, is taken for the next frame (double buffered registers),
+ * which writes the picture set j % 2. So at this start of frame the frame
+ * of application j - 1 has ended: deliver its set, then apply j + 1 from
+ * the copy of that same set (its frame starts one frame later).
+ */
+static void camraw_sof(struct mtk_camraw *raw)
+{
+	unsigned int j = raw->n_frame_applied, set;
+	struct mtk_camraw_sof *log;
+
+	if (!raw->n_sof_log)
+		camraw_snap_event(raw, 0);
+	if (raw->n_sof_log < CAMRAW_SOF_LOG) {
+		log = &raw->sof_log[raw->n_sof_log];
+		log->t_us = camraw_us_since_vf(raw);
+		log->applied = j;
+		log->seq = raw_rd(raw, CAMRAW_FRAME_SEQ_NUM);
+		log->seq_inner = readl(raw->inner + CAMRAW_FRAME_SEQ_NUM);
+		log->frmsize = raw_rd(raw, TG_FRMSIZE_ST);
+	}
+	raw->n_sof_log++;
+
+	if (j >= 2)
+		camraw_deliver(raw, (j - 1) % CAMRAW_NUM_SETS);
+	if (!reapply)
+		return;
+
+	if (apply_delay_us)
+		usleep_range(min(apply_delay_us, 30000U),
+			     min(apply_delay_us, 30000U) + 100);
+	j++;
+	set = j % CAMRAW_NUM_SETS;
+	if (raw->frame.frame_seq_off != CAMRAW_NO_OFFSET)
+		put_unaligned_le32(j, (u8 *)raw->slot_frame[set].cpu +
+				   raw->frame.frame_seq_off);
+	camraw_apply_cq(raw, raw->slot_frame[set].dma, &raw->frame,
+			raw->frame_size);
+	raw->n_frame_applied = j;
+	if (reapply > 1) {
+		camraw_toggle_db(raw);
+		if (raw->twin_on)
+			camraw_toggle_db(raw->twin);
+	}
+}
+
+static irqreturn_t camraw_raw_thread(int irq, void *data)
+{
+	struct mtk_camraw *raw = data;
+	u32 pend[CAMRAW_NUM_INT + 1];
+	bool storm;
+
+	camraw_take_pending(raw, CAMRAW_IRQ_RAW, pend, &storm);
+	if (storm)
+		dev_err_once(raw->dev,
+			     "RAW interrupt would not go quiet (status 1: 0x%x), line switched off\n",
+			     pend[1]);
+
+	if (pend[6] & CAMCTL_INT6_CQ_BOTH) {
+		raw->cq_seen |= pend[6] & CAMCTL_INT6_CQ_BOTH;
+		if (raw->cq_seen == CAMCTL_INT6_CQ_BOTH)
+			complete(&raw->cq_done);
+	}
+
+	if ((pend[1] & CAMCTL_INT_ERRORS) && !raw->err_us) {
+		raw->err_us = camraw_us_since_vf(raw) ? : 1;
+		camraw_snap_event(raw, 1);
+	}
+	if (pend[1] & CAMCTL_INT_ERRORS)
+		dev_warn_ratelimited(raw->dev,
+				     "error interrupt 0x%08x; DMA error status YUVO_R1 0x%x YUVBO_R1 0x%x AAO 0x%x CQI_R1 0x%x\n",
+				     (u32)(pend[1] & CAMCTL_INT_ERRORS),
+				     yuv_rd(raw, YUV_YUVO_R1 + CAMRAW_DMA_ERR_STAT),
+				     yuv_rd(raw, YUV_YUVBO_R1 + CAMRAW_DMA_ERR_STAT),
+				     raw_rd(raw, CAMRAW_AAO_R1 + CAMRAW_DMA_ERR_STAT),
+				     raw_rd(raw, CAMRAW_CQI_R1 + CAMRAW_DMA_ERR_STAT));
+
+	if ((pend[1] & CAMCTL_INT_TG_SOF) && READ_ONCE(raw->streaming))
+		camraw_sof(raw);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t camraw_yuv_thread(int irq, void *data)
+{
+	struct mtk_camraw *raw = data;
+	u32 pend[CAMRAW_NUM_INT + 1];
+	bool storm;
+
+	camraw_take_pending(raw, CAMRAW_IRQ_YUV, pend, &storm);
+	if (storm)
+		dev_err_once(raw->dev,
+			     "YUV interrupt would not go quiet (status 2: 0x%x), line switched off\n",
+			     pend[2]);
+	return IRQ_HANDLED;
+}
+
+static void camraw_irqs_on(struct mtk_camraw *raw)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&raw->irq_lock, flags);
+	memset(raw->irqs, 0, sizeof(raw->irqs));
+	raw->irqs[CAMRAW_IRQ_RAW].enabled = true;
+	raw->irqs[CAMRAW_IRQ_YUV].enabled = true;
+	raw->n_sof = 0;
+	raw->n_cq_main = 0;
+	raw->n_cq_sub = 0;
+	raw->n_pass1 = 0;
+	raw->n_yuvo = 0;
+	raw->n_err = 0;
+	raw->err_bits = 0;
+	raw->sof_ns = 0;
+	spin_unlock_irqrestore(&raw->irq_lock, flags);
+	enable_irq(raw->irq);
+	enable_irq(raw->yuv->irq);
+}
+
+static void camraw_irqs_off(struct mtk_camraw *raw)
+{
+	const int irqs[CAMRAW_NUM_IRQS] = { raw->irq, raw->yuv->irq };
+	unsigned long flags;
+	unsigned int i;
+	bool enabled;
+
+	for (i = 0; i < CAMRAW_NUM_IRQS; i++) {
+		spin_lock_irqsave(&raw->irq_lock, flags);
+		enabled = raw->irqs[i].enabled;
+		raw->irqs[i].enabled = false;
+		spin_unlock_irqrestore(&raw->irq_lock, flags);
+		if (enabled)
+			disable_irq(irqs[i]);
+		else
+			synchronize_irq(irqs[i]);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* The captured requests: load, buffers, format                        */
+
+static void camraw_free_dma(struct mtk_camraw *raw, struct mtk_camraw_dma *d)
+{
+	if (d->cpu)
+		dma_free_coherent(raw->dev, d->size, d->cpu, d->dma);
+	d->cpu = NULL;
+}
+
+static int camraw_alloc_dma(struct mtk_camraw *raw, struct mtk_camraw_dma *d,
+			    size_t size)
+{
+	d->size = PAGE_ALIGN(size);
+	d->cpu = dma_alloc_coherent(raw->dev, d->size, &d->dma, GFP_KERNEL);
+	return d->cpu ? 0 : -ENOMEM;
+}
+
+static void camraw_free_request(struct mtk_camraw *raw, struct camraw_replay *rp)
+{
+	unsigned int i;
+
+	for (i = 0; i < rp->num_bufs; i++) {
+		struct camraw_capbuf *b = &rp->bufs[i];
+
+		if (b->cpu)
+			dma_free_coherent(b->dma_dev, PAGE_ALIGN(b->size), b->cpu,
+					  b->dma);
+		b->cpu = NULL;
+	}
+	camraw_replay_free(rp);
+}
+
+static void camraw_unload(struct mtk_camraw *raw)
+{
+	unsigned int i;
+
+	debugfs_remove_recursive(raw->debugfs_bufs);
+	raw->debugfs_bufs = NULL;
+	camraw_free_request(raw, &raw->start);
+	camraw_free_request(raw, &raw->frame);
+	camraw_free_dma(raw, &raw->slot_start);
+	for (i = 0; i < CAMRAW_NUM_SETS; i++)
+		camraw_free_dma(raw, &raw->slot_frame[i]);
+	for (i = 0; i < CAMRAW_PICTURE_PLANES; i++)
+		camraw_free_dma(raw, &raw->pic1[i]);
+	raw->loaded = false;
+	raw->pair_problem = NULL;
+	raw->sizeimage = 0;
+}
+
+static void camraw_debugfs_blob(struct mtk_camraw *raw, const char *name,
+				void *data, size_t size)
+{
+	struct debugfs_blob_wrapper *blob;
+
+	blob = devm_kzalloc(raw->dev, sizeof(*blob), GFP_KERNEL);
+	if (!blob)
+		return;
+	blob->data = data;
+	blob->size = size;
+	debugfs_create_blob(name, 0400, raw->debugfs_bufs, blob);
+}
+
+/*
+ * Replacement buffers of one request: every buffer an address word points
+ * into, except the slot, which gets copies of its own. All engines of the
+ * frame are behind the same IOMMU domain (checked at probe), so one
+ * allocation is valid for every larb port.
+ */
+static int camraw_alloc_request(struct mtk_camraw *raw, struct camraw_replay *rp,
+				const char *tag)
+{
+	char name[24];
+	unsigned int i;
+
+	for (i = CAMRAW_BUFIDX_SETTINGS; i < rp->num_bufs; i++) {
+		struct camraw_capbuf *b = &rp->bufs[i];
+
+		if (!b->hits && i != CAMRAW_BUFIDX_SETTINGS)
+			continue;
+		b->dma_dev = raw->dev;
+		b->cpu = dma_alloc_coherent(b->dma_dev, PAGE_ALIGN(b->size),
+					    &b->dma, GFP_KERNEL);
+		if (!b->cpu) {
+			dev_err(raw->dev, "%s: no memory for buffer %u (0x%x bytes)\n",
+				tag, i, b->size);
+			return -ENOMEM;
+		}
+		if (b->content)
+			memcpy(b->cpu, b->content, b->size);
+		dev_dbg(raw->dev, "%s: buffer %u: 0x%x bytes at %pad\n", tag, i,
+			b->size, &b->dma);
+		snprintf(name, sizeof(name), "%s-%u", tag, i);
+		camraw_debugfs_blob(raw, name, b->cpu, b->size);
+	}
+	return 0;
+}
+
+static int camraw_set_format(struct mtk_camraw *raw)
+{
+	struct camraw_replay *rp = &raw->frame;
+	unsigned int p;
+
+	for (p = 0; p < CAMRAW_PICTURE_PLANES; p++) {
+		const struct camraw_capbuf *b = &rp->bufs[rp->out_plane[p]];
+
+		raw->pic_size[p] = b->size;
+		raw->pic_cpu[0][p] = b->cpu;
+		raw->pic_dma[0][p] = b->dma;
+		raw->pic_cpu[1][p] = raw->pic1[p].cpu;
+		raw->pic_dma[1][p] = raw->pic1[p].dma;
+	}
+	raw->width = rp->width;
+	raw->height = rp->height;
+	raw->stride = rp->stride;
+	raw->sizeimage = raw->pic_size[0] + raw->pic_size[1];
+	if (!raw->width || raw->width > raw->stride ||
+	    (u64)raw->stride * raw->height > raw->pic_size[0] ||
+	    (u64)raw->stride * raw->height / 2 > raw->pic_size[1]) {
+		dev_err(raw->dev, "picture %ux%u pitch %u does not fit its planes (0x%x, 0x%x bytes)\n",
+			raw->width, raw->height, raw->stride, raw->pic_size[0],
+			raw->pic_size[1]);
+		return -EINVAL;
+	}
+	if (rp->fmt_id == CAMRAW_FMT_YVU420_2P) {
+		raw->pixfmt = V4L2_PIX_FMT_NV21;
+	} else {
+		raw->pixfmt = V4L2_PIX_FMT_NV12;
+		dev_warn(raw->dev, "picture format id %u is not known, labelled NV12\n",
+			 rp->fmt_id);
+	}
+	dev_info(raw->dev, "video node: %p4cc %ux%u pitch %u, %u bytes\n",
+		 &raw->pixfmt, raw->width, raw->height, raw->stride,
+		 raw->sizeimage);
+	return 0;
+}
+
+static int camraw_load_one(struct mtk_camraw *raw, struct camraw_replay *rp,
+			   const char *file)
+{
+	const struct firmware *fw;
+	int ret;
+
+	ret = request_firmware(&fw, file, raw->dev);
+	if (ret) {
+		dev_err(raw->dev, "no request dump \"%s\" in the firmware directory: %d\n",
+			file, ret);
+		return ret;
+	}
+	ret = camraw_replay_parse(rp, raw->dev, file, fw->data, fw->size);
+	release_firmware(fw);
+	return ret;
+}
+
+static int camraw_load(struct mtk_camraw *raw)
+{
+	unsigned int i;
+	int ret;
+
+	lockdep_assert_held(&raw->lock);
+
+	camraw_unload(raw);
+	ret = camraw_load_one(raw, &raw->start, start_fw);
+	if (ret)
+		return ret;
+	ret = camraw_load_one(raw, &raw->frame, frame_fw);
+	if (ret) {
+		camraw_replay_free(&raw->start);
+		return ret;
+	}
+	raw->pair_problem = camraw_replay_pair_check(&raw->start, &raw->frame);
+	if (raw->pair_problem)
+		dev_err(raw->dev, "start request %u and per-frame request %u cannot be replayed together: %s\n",
+			raw->start.sequence, raw->frame.sequence,
+			raw->pair_problem);
+
+	raw->debugfs_bufs = debugfs_create_dir("buffers", raw->debugfs);
+	ret = camraw_alloc_request(raw, &raw->start, "start");
+	if (!ret)
+		ret = camraw_alloc_request(raw, &raw->frame, "frame");
+	if (!ret)
+		ret = camraw_alloc_dma(raw, &raw->slot_start,
+				       raw->start.slot_size);
+	for (i = 0; !ret && i < CAMRAW_NUM_SETS; i++)
+		ret = camraw_alloc_dma(raw, &raw->slot_frame[i],
+				       raw->frame.slot_size);
+	if (ret)
+		goto err;
+	camraw_debugfs_blob(raw, "slot-start", raw->slot_start.cpu,
+			    raw->start.slot_size);
+	camraw_debugfs_blob(raw, "slot-frame0", raw->slot_frame[0].cpu,
+			    raw->frame.slot_size);
+	camraw_debugfs_blob(raw, "slot-frame1", raw->slot_frame[1].cpu,
+			    raw->frame.slot_size);
+
+	if (camraw_replay_has_picture(&raw->frame)) {
+		for (i = 0; !ret && i < CAMRAW_PICTURE_PLANES; i++)
+			ret = camraw_alloc_dma(raw, &raw->pic1[i],
+					       raw->frame.bufs[raw->frame.out_plane[i]].size);
+		if (ret)
+			goto err;
+		camraw_debugfs_blob(raw, "picture1-0", raw->pic1[0].cpu,
+				    raw->frame.bufs[raw->frame.out_plane[0]].size);
+		camraw_debugfs_blob(raw, "picture1-1", raw->pic1[1].cpu,
+				    raw->frame.bufs[raw->frame.out_plane[1]].size);
+		ret = camraw_set_format(raw);
+		if (ret)
+			goto err;
+	}
+	if ((raw->slot_start.dma | raw->slot_frame[0].dma |
+	     raw->slot_frame[1].dma) & 0xf)
+		dev_warn(raw->dev, "a queue slot is not 16 byte aligned\n");
+	raw->loaded = true;
+	return 0;
+
+err:
+	camraw_unload(raw);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Stream                                                              */
+
+static int camraw_find_source(struct mtk_camraw *raw)
+{
+	struct fwnode_handle *ep, *remote;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(raw->dev), NULL);
+	if (!ep) {
+		dev_err(raw->dev, "no endpoint toward the sensor interface\n");
+		return -ENOLINK;
+	}
+	remote = fwnode_graph_get_remote_endpoint(ep);
+	fwnode_handle_put(ep);
+	if (!remote)
+		return -ENOLINK;
+	raw->source = mtk_seninf_raw_source(remote, &raw->source_pad);
+	fwnode_handle_put(remote);
+	if (!raw->source) {
+		dev_err(raw->dev, "the sensor interface has no RAW destination for this engine (not probed?)\n");
+		return -ENODEV;
+	}
+	return 0;
+}
+
+/* the sensor must run the mode of the capture */
+static void camraw_check_source_format(struct mtk_camraw *raw)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = raw->source_pad,
+	};
+	struct camraw_replay *rp = &raw->start;
+
+	if (v4l2_subdev_call_state_active(raw->source, pad, get_fmt, &fmt))
+		return;
+	dev_info(raw->dev,
+		 "sensor interface %ux%u code 0x%04x; captured input %ux%u, grab window pixels %u-%u lines %u-%u\n",
+		 fmt.format.width, fmt.format.height, fmt.format.code,
+		 rp->in_width, rp->in_height, rp->grab_pxl & 0xffff,
+		 rp->grab_pxl >> 16, rp->grab_lin & 0xffff, rp->grab_lin >> 16);
+	if (fmt.format.width != rp->in_width || fmt.format.height != rp->in_height)
+		dev_warn(raw->dev, "SENSOR MODE DIFFERS FROM THE CAPTURE\n");
+}
+
+static void camraw_watchdog(struct work_struct *work)
+{
+	struct mtk_camraw *raw = container_of(to_delayed_work(work),
+					      struct mtk_camraw, watchdog);
+
+	camraw_show_counters(raw, NULL, "1 s after viewfinder on");
+	camraw_show_all_hw(raw, NULL, "1 s after viewfinder on");
+}
+
+static int camraw_emit_all(struct mtk_camraw *raw)
+{
+	unsigned int i;
+	int ret;
+
+	raw->emit_flags = (raw->twin_on ? 0 : CAMRAW_EMIT_A_ONLY) |
+			  (stats_off ? CAMRAW_EMIT_STATS_OFF : 0) |
+			  (extra_off ? CAMRAW_EMIT_EXTRA_OFF : 0);
+	ret = camraw_replay_emit(&raw->start, raw->slot_start.cpu,
+				 raw->slot_start.dma, raw->emit_flags, NULL,
+				 raw->start_size);
+	for (i = 0; !ret && i < CAMRAW_NUM_SETS; i++)
+		ret = camraw_replay_emit(&raw->frame, raw->slot_frame[i].cpu,
+					 raw->slot_frame[i].dma, raw->emit_flags,
+					 raw->pic_dma[i], raw->frame_size);
+	if (ret) {
+		dev_err(raw->dev, "the queue slots cannot be written: %d\n", ret);
+		return ret;
+	}
+	for (i = 0; i < CAMRAW_NUM_SETS; i++) {
+		memset(raw->pic_cpu[i][0], CAMRAW_FILL, raw->pic_size[0]);
+		memset(raw->pic_cpu[i][1], CAMRAW_FILL, raw->pic_size[1]);
+	}
+	dev_info(raw->dev,
+		 "%s: start request %u lists 0x%x + 0x%x bytes, per-frame request %u lists 0x%x + 0x%x bytes%s%s\n",
+		 raw->twin_on ? "both RAW engines" : "side A only",
+		 raw->start.sequence, raw->start_size[0], raw->start_size[1],
+		 raw->frame.sequence, raw->frame_size[0], raw->frame_size[1],
+		 stats_off ? ", statistics writers off" : "",
+		 extra_off ? ", extra YUV outputs off" : "");
+	return 0;
+}
+
+/* start period and done tolerance in time stamp counter ticks */
+static void camraw_set_scq_period(struct mtk_camraw *raw)
+{
+	u32 div = raw_rd(raw, TG_TIME_STAMP_CNT);
+	u32 khz;
+
+	if (div != raw->start.time_stamp_cnt)
+		dev_warn(raw->dev, "time stamp counter divider reads %u, the start request writes %u: the start request was not taken\n",
+			 div, raw->start.time_stamp_cnt);
+	khz = CAMRAW_TS_CLK_KHZ / ((raw->start.time_stamp_cnt + 1) * 2);
+	raw_wr(raw, CAMCQ_SCQ_START_PERIOD, CAMRAW_SCQ_PERIOD_MS * khz);
+	raw_wr(raw, CAMCTL_DC_STAG_CTL, CAMRAW_DONE_TOLERANCE_MS * khz);
+	dev_info(raw->dev, "start period 0x%x, done tolerance 0x%x (counter %u kHz)\n",
+		 CAMRAW_SCQ_PERIOD_MS * khz, CAMRAW_DONE_TOLERANCE_MS * khz, khz);
+}
+
+/* the clock rates of the stream, and cam-sel set to cam_mhz */
+static void camraw_clocks(struct mtk_camraw *raw)
+{
+	char line[400];
+	unsigned int i;
+	int len = 0, ret;
+
+	raw->cam_rate_saved = 0;
+	if (cam_mhz && raw->cam_sel) {
+		raw->cam_rate_saved = clk_get_rate(raw->cam_sel);
+		ret = clk_set_rate(raw->cam_sel, cam_mhz * 1000000UL);
+		dev_info(raw->dev, "cam-sel %lu Hz -> asked %u MHz: %d, now %lu Hz\n",
+			 raw->cam_rate_saved, cam_mhz, ret,
+			 clk_get_rate(raw->cam_sel));
+	}
+	for (i = 0; i < raw->num_clks; i++)
+		len += scnprintf(line + len, sizeof(line) - len, " %s %lu",
+				 raw->clks[i].id, clk_get_rate(raw->clks[i].clk));
+	for (i = 0; i < CAMYUV_NUM_CLKS; i++)
+		len += scnprintf(line + len, sizeof(line) - len, " %s %lu",
+				 raw->yuv->clks[i].id,
+				 clk_get_rate(raw->yuv->clks[i].clk));
+	dev_info(raw->dev, "clock rates (Hz):%s\n", line);
+}
+
+static void camraw_clocks_restore(struct mtk_camraw *raw)
+{
+	if (raw->cam_rate_saved)
+		clk_set_rate(raw->cam_sel, raw->cam_rate_saved);
+	raw->cam_rate_saved = 0;
+}
+
+/* the per-frame request before the viewfinder: application 1, set 1 */
+static void camraw_prestart(struct mtk_camraw *raw)
+{
+	if (raw->frame.frame_seq_off != CAMRAW_NO_OFFSET)
+		put_unaligned_le32(1, (u8 *)raw->slot_frame[1].cpu +
+				   raw->frame.frame_seq_off);
+	raw->cq_seen = 0;
+	reinit_completion(&raw->cq_done);
+	camraw_apply_cq(raw, raw->slot_frame[1].dma, &raw->frame,
+			raw->frame_size);
+	raw->n_frame_applied = 1;
+	if (!wait_for_completion_timeout(&raw->cq_done,
+					 msecs_to_jiffies(CAMRAW_CQ_TIMEOUT_MS)))
+		dev_warn(raw->dev, "prestart: the per-frame request's lists did not both finish: done bits 0x%x\n",
+			 raw->cq_seen);
+	else
+		dev_info(raw->dev, "prestart: per-frame request applied before the viewfinder\n");
+}
+
+static int camraw_stream_start(struct mtk_camraw *raw)
+{
+	struct mtk_camraw *b = raw->twin;
+	int ret;
+
+	lockdep_assert_held(&raw->lock);
+
+	if (!raw->loaded || !raw->sizeimage)
+		return -ENODATA;
+	if (raw->pair_problem) {
+		dev_err(raw->dev, "not started: %s\n", raw->pair_problem);
+		return -EINVAL;
+	}
+	if (twin && !b) {
+		dev_err(raw->dev, "twin=1, but the board gives no second RAW engine (mediatek,twin)\n");
+		return -ENODEV;
+	}
+	if (twin != raw->start.twin)
+		dev_info(raw->dev, "twin=%d, the captured lists are for %s\n",
+			 twin, raw->start.twin ? "two RAW engines" : "one");
+
+	ret = camraw_find_source(raw);
+	if (ret)
+		return ret;
+
+	raw->twin_on = twin;
+	ret = camraw_emit_all(raw);
+	if (ret)
+		return ret;
+
+	ret = pm_runtime_resume_and_get(raw->dev);
+	if (ret)
+		return ret;
+	if (raw->twin_on) {
+		ret = pm_runtime_resume_and_get(b->dev);
+		if (ret)
+			goto err_pm;
+	}
+	camraw_clocks(raw);
+
+	/* reset, camsys settings, initialise, double buffer toggle: A and B */
+	camraw_hw_reset(raw);
+	if (raw->twin_on)
+		camraw_hw_reset(b);
+	camraw_camsys_init(raw, raw->twin_on);
+	camraw_hw_init(raw);
+	if (raw->twin_on)
+		camraw_hw_init(b);
+	camraw_toggle_db(raw);
+	if (raw->twin_on)
+		camraw_toggle_db(b);
+
+	raw->sequence = 0;
+	raw->n_frames = 0;
+	raw->n_no_buffer = 0;
+	raw->n_applied = 0;
+	raw->n_frame_applied = 0;
+	raw->n_sof_log = 0;
+	raw->vf_ns = 0;
+	raw->err_us = 0;
+	memset(raw->snap, 0, sizeof(raw->snap));
+	raw->cq_seen = 0;
+	reinit_completion(&raw->cq_done);
+	camraw_irqs_on(raw);
+
+	/* the start request, before the sensor streams */
+	camraw_apply_cq(raw, raw->slot_start.dma, &raw->start, raw->start_size);
+	if (!wait_for_completion_timeout(&raw->cq_done,
+					 msecs_to_jiffies(CAMRAW_CQ_TIMEOUT_MS))) {
+		dev_warn(raw->dev,
+			 "the start request's lists did not both finish within %u ms: done bits seen 0x%x (0 main, 4 sub); going on\n",
+			 CAMRAW_CQ_TIMEOUT_MS, raw->cq_seen);
+		camraw_show_counters(raw, NULL, "start request");
+		camraw_show_all_hw(raw, NULL, "start request");
+	} else {
+		dev_info(raw->dev,
+			 "start request done; frame number register 0x%x (latched 0x%x), the lists write 0x%x; grab window 0x%08x/0x%08x\n",
+			 raw_rd(raw, CAMRAW_FRAME_SEQ_NUM),
+			 readl(raw->inner + CAMRAW_FRAME_SEQ_NUM),
+			 raw->start.frame_seq, raw_rd(raw, TG_SEN_GRAB_PXL),
+			 raw_rd(raw, TG_SEN_GRAB_LIN));
+	}
+
+	if (prestart)
+		camraw_prestart(raw);
+
+	camraw_check_source_format(raw);
+	ret = v4l2_subdev_enable_streams(raw->source, raw->source_pad, BIT_ULL(0));
+	if (ret) {
+		dev_err(raw->dev, "sensor interface did not start: %d\n", ret);
+		goto err_irq;
+	}
+	raw->source_on = true;
+
+	camraw_set_scq_period(raw);
+
+	/* stream on: RAW-A only */
+	camraw_pulse_db_load(raw);
+	WRITE_ONCE(raw->streaming, true);
+	raw->vf_ns = ktime_get_ns();
+	raw_wr(raw, TG_VF_CON, raw_rd(raw, TG_VF_CON) | TG_VFDATA_EN);
+
+	schedule_delayed_work(&raw->watchdog,
+			      msecs_to_jiffies(CAMRAW_WATCHDOG_MS));
+	return 0;
+
+err_irq:
+	camraw_irqs_off(raw);
+	camraw_hw_reset(raw);
+	if (raw->twin_on) {
+		camraw_hw_reset(b);
+		pm_runtime_put(b->dev);
+	}
+err_pm:
+	camraw_clocks_restore(raw);
+	raw->twin_on = false;
+	pm_runtime_put(raw->dev);
+	return ret;
+}
+
+static void camraw_stream_stop(struct mtk_camraw *raw)
+{
+	lockdep_assert_held(&raw->lock);
+
+	cancel_delayed_work_sync(&raw->watchdog);
+
+	raw_wr(raw, TG_VF_CON, raw_rd(raw, TG_VF_CON) & ~TG_VFDATA_EN);
+	camraw_pulse_db_load(raw);
+	WRITE_ONCE(raw->streaming, false);
+	/* let the frame that is under way end */
+	msleep(50);
+
+	if (raw->source_on)
+		v4l2_subdev_disable_streams(raw->source, raw->source_pad,
+					    BIT_ULL(0));
+	raw->source_on = false;
+
+	camraw_show_counters(raw, NULL, "stop");
+	camraw_show_all_hw(raw, NULL, "stop");
+	camraw_snaps_show(raw, NULL);
+	camraw_irqs_off(raw);
+	camraw_hw_reset(raw);
+	if (raw->twin_on) {
+		camraw_hw_reset(raw->twin);
+		pm_runtime_put(raw->twin->dev);
+	}
+	raw->twin_on = false;
+	camraw_clocks_restore(raw);
+	pm_runtime_put(raw->dev);
+}
+
+/* ------------------------------------------------------------------ */
+/* Video node                                                          */
+
+static void camraw_return_bufs(struct mtk_camraw *raw,
+			       enum vb2_buffer_state state)
+{
+	struct mtk_camraw_buffer *buf, *tmp;
+	unsigned long flags;
+	LIST_HEAD(list);
+
+	spin_lock_irqsave(&raw->buf_lock, flags);
+	list_splice_init(&raw->bufs, &list);
+	spin_unlock_irqrestore(&raw->buf_lock, flags);
+	list_for_each_entry_safe(buf, tmp, &list, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+}
+
+static int camraw_queue_setup(struct vb2_queue *q, unsigned int *num_buffers,
+			      unsigned int *num_planes, unsigned int sizes[],
+			      struct device *alloc_devs[])
+{
+	struct mtk_camraw *raw = vb2_get_drv_priv(q);
+
+	if (!raw->sizeimage)
+		return -ENODATA;
+	if (*num_planes)
+		return sizes[0] < raw->sizeimage ? -EINVAL : 0;
+	*num_planes = 1;
+	sizes[0] = raw->sizeimage;
+	return 0;
+}
+
+static int camraw_buf_prepare(struct vb2_buffer *vb)
+{
+	struct mtk_camraw *raw = vb2_get_drv_priv(vb->vb2_queue);
+
+	return vb2_plane_size(vb, 0) < raw->sizeimage ? -EINVAL : 0;
+}
+
+static void camraw_buf_queue(struct vb2_buffer *vb)
+{
+	struct mtk_camraw *raw = vb2_get_drv_priv(vb->vb2_queue);
+	struct mtk_camraw_buffer *buf =
+		container_of(to_vb2_v4l2_buffer(vb), struct mtk_camraw_buffer, vb);
+	unsigned long flags;
+
+	spin_lock_irqsave(&raw->buf_lock, flags);
+	list_add_tail(&buf->list, &raw->bufs);
+	spin_unlock_irqrestore(&raw->buf_lock, flags);
+}
+
+static int camraw_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct mtk_camraw *raw = vb2_get_drv_priv(q);
+	int ret;
+
+	mutex_lock(&raw->lock);
+	ret = camraw_stream_start(raw);
+	mutex_unlock(&raw->lock);
+	if (ret)
+		camraw_return_bufs(raw, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void camraw_stop_streaming(struct vb2_queue *q)
+{
+	struct mtk_camraw *raw = vb2_get_drv_priv(q);
+
+	mutex_lock(&raw->lock);
+	camraw_stream_stop(raw);
+	mutex_unlock(&raw->lock);
+	camraw_return_bufs(raw, VB2_BUF_STATE_ERROR);
+}
