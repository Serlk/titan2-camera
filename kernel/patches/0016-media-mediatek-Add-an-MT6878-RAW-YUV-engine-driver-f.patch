+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_MEDIATEK_CAMRAW_REPLAY
+	tristate "MediaTek MT6878 RAW/YUV engine, replay of a captured command queue"
+	depends on V4L_PLATFORM_DRIVERS
+	depends on VIDEO_DEV
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on PM
+	depends on VIDEO_MEDIATEK_SENINF
+	depends on MFD_SYSCON
+	select FW_LOADER
+	select VIDEOBUF2_VMALLOC
+	help
+	  Bring-up driver for the RAW-A and YUV-A engines of the image
+	  signal processor of the MediaTek MT6878 SoC. The register
+	  settings of a frame are not made by this driver: it takes the
+	  command queue of a frame from a request dump loaded as a firmware
+	  file, places it at its own address with its own buffers and runs
+	  it, with the sensor in the mode of the capture. The processed
+	  picture is delivered by a V4L2 capture node.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mtk-camraw-mt6878.
