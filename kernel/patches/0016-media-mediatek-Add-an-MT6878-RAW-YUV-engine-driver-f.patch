+/* the requests are loaded when the node is first opened */
+static int camraw_open(struct file *file)
+{
+	struct mtk_camraw *raw = video_drvdata(file);
+	int ret;
+
+	ret = v4l2_fh_open(file);
+	if (ret)
+		return ret;
