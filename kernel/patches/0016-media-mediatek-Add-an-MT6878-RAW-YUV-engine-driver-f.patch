+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/firmware.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/seq_file.h>
+#include <linux/unaligned.h>
+
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-subdev.h>
+#include <media/videobuf2-vmalloc.h>
+
+#include "../seninf/mtk-seninf.h"
+#include "mtk-camraw.h"
+
+#define CAMRAW_CQ_TIMEOUT_MS		200
+#define CAMRAW_WATCHDOG_MS		1000
+#define CAMRAW_IRQ_BURST		500
+#define CAMRAW_FILL			0xa5
+#define CAMRAW_PROBE_BYTES		64
+
+/*
+ * Start period of the command queue and frame done tolerance, set after
+ * the start request has programmed the time stamp counter divider: the
+ * counter runs at 208 MHz / ((divider + 1) * 2).
+ */
+#define CAMRAW_TS_CLK_KHZ		208000
+#define CAMRAW_SCQ_PERIOD_MS		16
+#define CAMRAW_DONE_TOLERANCE_MS	12
+
+static char *start_fw = "titan2/camraw-start.bin";
+module_param(start_fw, charp, 0644);
+MODULE_PARM_DESC(start_fw, "Start request (request 1 of a stream), below the firmware directory");
+
+static char *frame_fw = "titan2/camraw-frame.bin";
+module_param(frame_fw, charp, 0644);
+MODULE_PARM_DESC(frame_fw, "Steady request applied for every frame, below the firmware directory");
+
+static bool twin;
+module_param(twin, bool, 0644);
+MODULE_PARM_DESC(twin, "Run both RAW engines as captured (1), or only the side A descriptors (0, left part of the picture)");
+
+static unsigned int reapply = 1;
+module_param(reapply, uint, 0644);
+MODULE_PARM_DESC(reapply,
+		 "At each start of frame: 0 nothing (start request only), 1 apply the per-frame request, 2 also toggle the double buffer enable");
+
+static bool stats_off;
+module_param(stats_off, bool, 0644);
+MODULE_PARM_DESC(stats_off, "Clear the statistics writers in the writer enables of the lists");
+
+static bool extra_off;
+module_param(extra_off, bool, 0644);
+MODULE_PARM_DESC(extra_off, "Clear the YUV writers other than the picture in the writer enables of the lists");
+
+static unsigned int cam_mhz;
+module_param(cam_mhz, uint, 0644);
+MODULE_PARM_DESC(cam_mhz, "Set the cam-sel clock to this rate in MHz while streaming (0: leave it; the captured stream ran 312)");
+
+static bool prestart;
+module_param(prestart, bool, 0644);
+MODULE_PARM_DESC(prestart, "Also apply the per-frame request before the viewfinder is switched on, after the start request");
+
+static unsigned int apply_delay_us;
+module_param(apply_delay_us, uint, 0644);
+MODULE_PARM_DESC(apply_delay_us, "Wait this long after a start of frame before applying the per-frame request (0..30000)");
+
+static unsigned int err_mask;
+module_param(err_mask, uint, 0644);
+MODULE_PARM_DESC(err_mask,
+		 "Error reporting mask 0xfffe0000 of FLKO/UFEO/PDO/AAO/AAHO: 0 written at the port bases (as before), 1 at the error status words (base + 0x34), 2 not written");
+
+static const char * const camyuv_clk_names[CAMYUV_NUM_CLKS] = {
+	"yuv-larbx", "yuv-cam", "yuv-camtg",
+};
+
+static inline u32 raw_rd(struct mtk_camraw *raw, u32 reg)
+{
+	return readl(raw->base + reg);
+}
+
+static inline void raw_wr(struct mtk_camraw *raw, u32 reg, u32 val)
+{
+	writel(val, raw->base + reg);
+}
+
+/* the few control registers that are written to both copies */
+static void raw_wr_both(struct mtk_camraw *raw, u32 reg, u32 val)
+{
+	writel(val, raw->base + reg);
+	writel(val, raw->inner + reg);
+}
+
+static inline u32 yuv_rd(struct mtk_camraw *raw, u32 reg)
+{
+	return readl(raw->yuv->base + reg);
+}
+
+static inline void yuv_wr(struct mtk_camraw *raw, u32 reg, u32 val)
+{
+	writel(val, raw->yuv->base + reg);
+}
+
+static char raw_name(struct mtk_camraw *raw)
+{
+	return 'A' + raw->raw_id;
+}
+
+/* ------------------------------------------------------------------ */
+/* Hardware                                                            */
+
+static void camraw_hw_reset(struct mtk_camraw *raw)
+{
+	u32 mod6, mod6_inner, val;
+
+	raw_wr(raw, CAMCTL_MOD5_DCM_DIS, ~0U);
+	raw_wr(raw, CAMCTL_MOD6_DCM_DIS, ~0U);
+	yuv_wr(raw, CAMCTL_MOD5_DCM_DIS, ~0U);
+	yuv_wr(raw, CAMCTL_MOD6_DCM_DIS, ~0U);
+
+	mod6 = readl(raw->base + CAMCTL_MOD6_EN);
+	mod6_inner = readl(raw->inner + CAMCTL_MOD6_EN);
+	writel(mod6 | CAMCTL_MOD6_CQI_ALL, raw->base + CAMCTL_MOD6_EN);
+	writel(mod6_inner | CAMCTL_MOD6_CQI_ALL, raw->inner + CAMCTL_MOD6_EN);
+
+	raw_wr(raw, CAMCTL_SW_CTL, 0);
+	raw_wr(raw, CAMCTL_SW_CTL, CAMCTL_SW_RST_TRIG);
+	if (readl_poll_timeout(raw->base + CAMCTL_SW_CTL, val,
+			       val & CAMCTL_SW_RST_ST, 50, 5000))
+		dev_warn(raw->dev, "RAW-%c reset: no reset state within 5 ms, SW_CTL 0x%x\n",
+			 raw_name(raw), val);
+	raw_wr(raw, CAMCTL_SW_CTL, CAMCTL_HW_RST);
+	raw_wr(raw, CAMCTL_SW_CTL, 0);
+
+	writel(mod6, raw->base + CAMCTL_MOD6_EN);
+	writel(mod6_inner, raw->inner + CAMCTL_MOD6_EN);
+
+	raw_wr(raw, CAMCTL_MOD5_DCM_DIS, 0);
+	raw_wr(raw, CAMCTL_MOD6_DCM_DIS, 0);
+	yuv_wr(raw, CAMCTL_MOD5_DCM_DIS, 0);
+	yuv_wr(raw, CAMCTL_MOD6_DCM_DIS, 0);
+
+	raw_wr(raw, CAMRAW_LTM_RESET, 1);
+	raw_wr(raw, CAMRAW_LTM_RESET, 0);
+}
+
+static void camraw_expect(struct mtk_camraw *raw, const char *name, u32 reg,
+			  u32 want)
+{
+	u32 val = raw_rd(raw, reg);
+
+	if (val != want)
+		dev_warn(raw->dev, "RAW-%c %s (0x%x) reads 0x%x, 0x%x was written\n",
+			 raw_name(raw), name, reg, val, want);
+}
+
+/* bus halt and urgent settings in the camsys main block, on the fly path */
+static void camraw_camsys_init(struct mtk_camraw *raw, bool side_b)
+{
+	regmap_write(raw->camsys, CAM_MAIN_HALT1, 0x6);
+	regmap_write(raw->camsys, CAM_MAIN_HALT2, 0x6);
+	regmap_write(raw->camsys, CAM_MAIN_HALT3, 0xc0a);
+	regmap_write(raw->camsys, CAM_MAIN_HALT4, 0xc0a);
+	regmap_write(raw->camsys, CAM_MAIN_HALT13, 0xf0);
+	regmap_write(raw->camsys, CAM_MAIN_HALT5, 0x2860);
+	regmap_write(raw->camsys, CAM_MAIN_HALT6, 0x3);
+	if (side_b) {
+		regmap_write(raw->camsys, CAM_MAIN_HALT7, 0x2860);
+		regmap_write(raw->camsys, CAM_MAIN_HALT8, 0x3);
+	}
+}
+
+/* the values the kernel side sets once per stream, on each RAW engine */
+static void camraw_hw_init(struct mtk_camraw *raw)
+{
+	static const u32 cqi_ports[] = {
+		CAMRAW_CQI_R1, CAMRAW_CQI_R2, CAMRAW_CQI_R3, CAMRAW_CQI_R4,
+	};
+	/* FIFO of 64 entries, thresholds at 20/10, 40/30, 60/50, 10/0 % */
+	static const u32 cqi_fifo[] = {
+		0x10000040, 0x100c0006, 0x10190013, 0x80260020, 0x80060000,
+	};
+	static const u32 masked_err[] = {
+		CAMRAW_FLKO_R1, CAMRAW_UFEO_R1, CAMRAW_PDO_R1, CAMRAW_AAO_R1,
+		CAMRAW_AAHO_R1,
+	};
+	unsigned int i, j;
+
+	raw_wr_both(raw, CAMCQ_CQ_EN, CAMCQ_CQ_EN_INIT);
+	raw_wr_both(raw, CAMCTL_SW_PASS1_DONE, 0);
+	raw_wr_both(raw, CAMCTL_SW_SUB_CTL, 0);
+	raw_wr(raw, CAMCQ_SCQ_START_PERIOD, ~0U);
+	raw_wr(raw, CAMCQ_CQ_THR0_CTL, CAMCQ_THR_CTL_INIT);
+	raw_wr(raw, CAMCQ_CQ_SUB_THR0_CTL, CAMCQ_THR_CTL_INIT);
+	raw_wr(raw, CAMCTL_INT_EN(6), CAMCTL_INT6_CQ_BOTH);
+
+	for (i = 0; i < ARRAY_SIZE(cqi_ports); i++)
+		for (j = 0; j < ARRAY_SIZE(cqi_fifo); j++)
+			raw_wr(raw, cqi_ports[i] + CAMRAW_DMA_CON0 + 4 * j,
+			       cqi_fifo[j]);
+
+	/* low latency off */
+	raw_wr(raw, CAMRAW_LOW_LATENCY, 0xffff);
+	yuv_wr(raw, YUV_LOW_LATENCY0, 0xffff);
+	yuv_wr(raw, YUV_LOW_LATENCY1, 0xffff);
+	yuv_wr(raw, YUV_LOW_LATENCY2, 0xffff);
+
+	/* these writers do not report DMA errors */
+	for (i = 0; err_mask < 2 && i < ARRAY_SIZE(masked_err); i++)
+		raw_wr(raw, masked_err[i] + (err_mask ? CAMRAW_DMA_ERR_STAT : 0),
+		       CAMRAW_ERR_STAT_MASKED);
+
+	camraw_expect(raw, "CQ_EN", CAMCQ_CQ_EN, CAMCQ_CQ_EN_INIT);
+	camraw_expect(raw, "THR0_CTL", CAMCQ_CQ_THR0_CTL, CAMCQ_THR_CTL_INIT);
+	camraw_expect(raw, "SUB_THR0_CTL", CAMCQ_CQ_SUB_THR0_CTL,
+		      CAMCQ_THR_CTL_INIT);
+	camraw_expect(raw, "INT6_EN", CAMCTL_INT_EN(6), CAMCTL_INT6_CQ_BOTH);
+}
+
+/* point RAW-A at both lists of a slot and start them */
+static void camraw_apply_cq(struct mtk_camraw *raw, dma_addr_t slot,
+			    const struct camraw_replay *rp, const u32 *size)
+{
+	u64 main = (u64)slot + rp->list_off[CAMRAW_LIST_MAIN];
+	u64 sub = (u64)slot + rp->list_off[CAMRAW_LIST_SUB];
+
+	raw_wr(raw, CAMCQ_CQ_THR0_BASEADDR, lower_32_bits(main));
+	raw_wr(raw, CAMCQ_CQ_THR0_BASEADDR_MSB, upper_32_bits(main));
+	raw_wr(raw, CAMCQ_CQ_THR0_DESC_SIZE, size[CAMRAW_LIST_MAIN]);
+	raw_wr(raw, CAMCQ_CQ_SUB_THR0_BASEADDR, lower_32_bits(sub));
+	raw_wr(raw, CAMCQ_CQ_SUB_THR0_BASEADDR_MSB, upper_32_bits(sub));
+	raw_wr(raw, CAMCQ_CQ_SUB_THR0_DESC_SIZE, size[CAMRAW_LIST_SUB]);
+	raw_wr(raw, CAMCTL_START, CAMCTL_CQ_THR0_START);
+	raw->n_applied++;
+}
+
+/* double buffer enable off and on, with a read between */
+static void camraw_toggle_db(struct mtk_camraw *raw)
+{
+	u32 misc = raw_rd(raw, CAMCTL_MISC);
+
+	raw_wr_both(raw, CAMCTL_MISC, misc & ~CAMCTL_MISC_DB_EN);
+	raw_rd(raw, CAMCTL_MISC);
+	raw_wr_both(raw, CAMCTL_MISC, misc | CAMCTL_MISC_DB_EN);
+}
+
+static void camraw_pulse_db_load(struct mtk_camraw *raw)
+{
+	u32 val = raw_rd(raw, TG_PATH_CFG);
+
+	raw_wr(raw, TG_PATH_CFG, val | TG_DB_LOAD_DIS);
+	raw_wr(raw, TG_PATH_CFG, val & ~TG_DB_LOAD_DIS);
+}
+
+#define CAMRAW_OUT(fmt, ...) do {					\
+	if (m)								\
+		seq_printf(m, fmt "\n", ##__VA_ARGS__);			\
+	else								\
+		dev_info(raw->dev, "%s: " fmt "\n", when, ##__VA_ARGS__); \
+} while (0)
+
+/* registers of one RAW engine and its YUV engine; only while powered */
+static void camraw_show_hw(struct mtk_camraw *raw, struct mtk_camraw *eng,
+			   struct seq_file *m, const char *when)
+{
+	char line[200];
+	char side = raw_name(eng);
+	int len = 0;
+	unsigned int n;
+
+	for (n = 1; n <= CAMRAW_NUM_INT; n++)
+		len += scnprintf(line + len, sizeof(line) - len, " %u:%08x/%08x",
+				 n, raw_rd(eng, CAMCTL_INT_EN(n)),
+				 raw_rd(eng, CAMCTL_INT_STATUSX(n)));
+	CAMRAW_OUT("RAW-%c interrupt groups, enable/status mirror:%s", side, line);
+	for (len = 0, n = 1; n <= CAMRAW_NUM_INT; n++)
+		len += scnprintf(line + len, sizeof(line) - len, " %u:%08x/%08x",
+				 n, yuv_rd(eng, CAMCTL_INT_EN(n)),
+				 yuv_rd(eng, CAMCTL_INT_STATUSX(n)));
+	CAMRAW_OUT("YUV-%c interrupt groups, enable/status mirror:%s", side, line);
+	CAMRAW_OUT("RAW-%c CQ_EN 0x%x start period 0x%x done tolerance 0x%x THR0 ctl 0x%x base 0x%x:%08x size 0x%x, SUB ctl 0x%x base 0x%x:%08x size 0x%x",
+		   side, raw_rd(eng, CAMCQ_CQ_EN),
+		   raw_rd(eng, CAMCQ_SCQ_START_PERIOD),
+		   raw_rd(eng, CAMCTL_DC_STAG_CTL),
+		   raw_rd(eng, CAMCQ_CQ_THR0_CTL),
+		   raw_rd(eng, CAMCQ_CQ_THR0_BASEADDR_MSB),
+		   raw_rd(eng, CAMCQ_CQ_THR0_BASEADDR),
+		   raw_rd(eng, CAMCQ_CQ_THR0_DESC_SIZE),
+		   raw_rd(eng, CAMCQ_CQ_SUB_THR0_CTL),
+		   raw_rd(eng, CAMCQ_CQ_SUB_THR0_BASEADDR_MSB),
+		   raw_rd(eng, CAMCQ_CQ_SUB_THR0_BASEADDR),
+		   raw_rd(eng, CAMCQ_CQ_SUB_THR0_DESC_SIZE));
+	CAMRAW_OUT("RAW-%c TG sensor mode 0x%x viewfinder 0x%x grab 0x%08x/0x%08x path 0x%x frame size 0x%08x state 0x%08x time stamp counter %u columns 0x%08x",
+		   side, raw_rd(eng, TG_SEN_MODE), raw_rd(eng, TG_VF_CON),
+		   raw_rd(eng, TG_SEN_GRAB_PXL), raw_rd(eng, TG_SEN_GRAB_LIN),
+		   raw_rd(eng, TG_PATH_CFG), raw_rd(eng, TG_FRMSIZE_ST),
+		   raw_rd(eng, TG_INTER_ST), raw_rd(eng, TG_TIME_STAMP_CNT),
+		   raw_rd(eng, CAMRAW_SPLIT_COLS));
+	CAMRAW_OUT("RAW-%c frame number register 0x%x (latched 0x%x); writer enables RAW 0x%x (latched 0x%x) YUV 0x%x, YUV format select 0x%x, misc 0x%x",
+		   side, raw_rd(eng, CAMRAW_FRAME_SEQ_NUM),
+		   readl(eng->inner + CAMRAW_FRAME_SEQ_NUM),
+		   raw_rd(eng, CAMCTL_MOD5_EN), readl(eng->inner + CAMCTL_MOD5_EN),
+		   yuv_rd(eng, YUV_CAMCTL2_MOD5_EN),
+		   yuv_rd(eng, YUV_CAMCTL2_FMT3_SEL), raw_rd(eng, CAMCTL_MISC));
+	CAMRAW_OUT("RAW-%c DMA error status: YUVO_R1 0x%x YUVBO_R1 0x%x AAO 0x%x AAHO 0x%x CQI_R1 0x%x",
+		   side, yuv_rd(eng, YUV_YUVO_R1 + CAMRAW_DMA_ERR_STAT),
+		   yuv_rd(eng, YUV_YUVBO_R1 + CAMRAW_DMA_ERR_STAT),
+		   raw_rd(eng, CAMRAW_AAO_R1 + CAMRAW_DMA_ERR_STAT),
+		   raw_rd(eng, CAMRAW_AAHO_R1 + CAMRAW_DMA_ERR_STAT),
+		   raw_rd(eng, CAMRAW_CQI_R1 + CAMRAW_DMA_ERR_STAT));
+}
