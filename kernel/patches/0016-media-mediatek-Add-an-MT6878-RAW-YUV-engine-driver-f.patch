+static void camraw_show_request(struct seq_file *m, const char *what,
+				const struct camraw_replay *rp)
+{
+	unsigned int i;
+
+	seq_printf(m, "%s request: \"%s\", request %u, %s; main 0x%x + 0x%x (%u writes), sub 0x%x + 0x%x (%u writes); values RAW-A %u RMS-A %u YUV-A %u RAW-B %u RMS-B %u YUV-B %u; %u address words\n",
+		   what, rp->name, rp->sequence,
+		   rp->onetime ? "one-time block" :
+		   camraw_replay_has_picture(rp) ? "steady" : "start-up",
+		   rp->list_off[0], rp->list_size[0], rp->num_desc[0],
+		   rp->list_off[1], rp->list_size[1], rp->num_desc[1],
+		   rp->values[0], rp->values[1], rp->values[2], rp->values[3],
+		   rp->values[4], rp->values[5], rp->num_relocs);
+	seq_printf(m, "  columns RAW-A %u-%u RAW-B %u-%u, writer enables RAW 0x%x/0x%x YUV 0x%x/0x%x, frame number 0x%x\n",
+		   rp->split[0] & 0xffff, rp->split[0] >> 16,
+		   rp->split[1] & 0xffff, rp->split[1] >> 16,
+		   rp->mod5[CAMRAW_BLK_RAW_A], rp->mod5[CAMRAW_BLK_RAW_B],
+		   rp->mod5[CAMRAW_BLK_YUV_A], rp->mod5[CAMRAW_BLK_YUV_B],
+		   rp->frame_seq);
+	if (rp->blocker)
+		seq_printf(m, "  objection: %s\n", rp->blocker);
+	for (i = 0; i < rp->num_bufs; i++) {
+		const struct camraw_capbuf *b = &rp->bufs[i];
+
+		seq_printf(m, "  buffer %u: kind %u id %u plane %u, captured 0x%llx size 0x%x, %u address word(s) (%u side A)",
+			   i, b->kind, b->id, b->plane, b->iova, b->size, b->hits,
+			   b->hits_a);
+		if (b->cpu)
+			seq_printf(m, ", now %pad", &b->dma);
+		seq_putc(m, '\n');
+	}
+}
+
+static int camraw_status_show(struct seq_file *m, void *unused)
+{
+	struct mtk_camraw *raw = m->private;
+
+	mutex_lock(&raw->lock);
+	seq_printf(m, "requests: %s; start_fw \"%s\", frame_fw \"%s\"\n",
+		   raw->loaded ? "loaded" : "not loaded", start_fw, frame_fw);
+	if (!raw->loaded)
+		goto out;
+	camraw_show_request(m, "start", &raw->start);
+	camraw_show_request(m, "per-frame", &raw->frame);
+	seq_printf(m, "pair: %s\n", raw->pair_problem ? raw->pair_problem :
+		   "consistent for replay");
+	seq_printf(m, "slots: start %pad, per-frame %pad and %pad; picture planes set 0 %pad/%pad, set 1 %pad/%pad\n",
+		   &raw->slot_start.dma, &raw->slot_frame[0].dma,
+		   &raw->slot_frame[1].dma, &raw->pic_dma[0][0],
+		   &raw->pic_dma[0][1], &raw->pic_dma[1][0], &raw->pic_dma[1][1]);
+	seq_printf(m, "video node: %p4cc %ux%u pitch %u, %u bytes\n",
+		   &raw->pixfmt, raw->width, raw->height, raw->stride,
+		   raw->sizeimage);
+	seq_printf(m, "second RAW engine: %s\n", raw->twin ?
+		   dev_name(raw->twin->dev) : "none on this board");
+	seq_printf(m, "stream: %s, %s, reapply %u, stats_off %d, extra_off %d, prestart %d, err_mask %u, cam_mhz %u, apply_delay_us %u\n",
+		   raw->streaming ? "running" : "stopped",
+		   twin ? "twin" : "side A only", reapply, stats_off, extra_off,
+		   prestart, err_mask, cam_mhz, apply_delay_us);
+	camraw_show_counters(raw, m, NULL);
+	camraw_snaps_show(raw, m);
+	if (raw->streaming)
+		camraw_show_all_hw(raw, m, NULL);
+out:
+	mutex_unlock(&raw->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(camraw_status);
