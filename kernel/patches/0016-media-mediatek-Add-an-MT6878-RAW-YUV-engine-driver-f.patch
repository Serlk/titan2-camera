+/* any write loads the requests again, e.g. after the files were replaced */
+static ssize_t camraw_load_write(struct file *file, const char __user *ubuf,
+				 size_t count, loff_t *ppos)
+{
+	struct mtk_camraw *raw = file->private_data;
+	int ret;
+
+	mutex_lock(&raw->vlock);
+	if (vb2_is_busy(&raw->vq)) {
+		ret = -EBUSY;
+	} else {
+		mutex_lock(&raw->lock);
+		ret = camraw_load(raw);
+		mutex_unlock(&raw->lock);
+	}
+	mutex_unlock(&raw->vlock);
+	return ret ? ret : count;
+}
+
+static const struct file_operations camraw_load_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = camraw_load_write,
+	.llseek = noop_llseek,
+};
