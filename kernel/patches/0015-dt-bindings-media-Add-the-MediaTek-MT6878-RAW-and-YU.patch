From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Thu, 26 Nov 2026 04:02:24 +0300
Subject: [PATCH 15/19] dt-bindings: media: Add the MediaTek MT6878 RAW and YUV
 engines

The RAW engine of the image signal processor and the YUV engine with the
writers of the processed picture, one node each because each sits behind
its own SMI larb. A frame can be split by columns between RAW-A and
RAW-B; RAW-A names RAW-B with mediatek,twin, and RAW-B has no input port.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../media/mediatek,mt6878-cam-raw.yaml        | 103 ++++++++++++++++++
 .../media/mediatek,mt6878-cam-yuv.yaml        |  61 +++++++++++
 2 files changed, 164 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/mediatek,mt6878-cam-raw.yaml
 create mode 100644 Documentation/devicetree/bindings/media/mediatek,mt6878-cam-yuv.yaml

diff --git a/Documentation/devicetree/bindings/media/mediatek,mt6878-cam-raw.yaml b/Documentation/devicetree/bindings/media/mediatek,mt6878-cam-raw.yaml
new file mode 100644
index 000000000000..cb5a133a0f1b
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek,mt6878-cam-raw.yaml
@@ -0,0 +1,103 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek,mt6878-cam-raw.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 RAW engine of the image signal processor
+
+maintainers:
+  - serlk <22211586+Serlk@users.noreply.github.com>
+
+description:
+  The RAW engine takes the Bayer stream of one CSI port from the sensor
+  interface, runs the first pass of the image signal processor and writes
+  statistics to memory. The processed picture is written by the YUV
+  engine it is paired with. Both are configured by command queues the RAW
+  engine fetches from memory.
+
+  A frame can be split between RAW-A and RAW-B by columns. Then the
+  command queue of RAW-A programs both engines and their YUV engines, and
+  RAW-B (mediatek,twin of RAW-A) has no input port of its own.
+
+properties:
+  compatible:
+    const: mediatek,mt6878-cam-raw
+
+  reg:
+    items:
+      - description: registers
+      - description: latched copy of the registers
+
+  reg-names:
+    items:
+      - const: base
+      - const: inner
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 11
+
+  clock-names:
+    items:
+      - const: cam
+      - const: camtg
+      - const: gals0
+      - const: gals1
+      - enum: [cam-suba, cam-subb]
+      - const: raw-larbx
+      - const: raw-cam
+      - const: raw-camtg
+      - const: cam-sel
+      - const: camtg-sel
+      - const: camtm-sel
+
+  iommus:
+    minItems: 1
+    maxItems: 16
+    description: The ports of the engine on its SMI larb.
+
+  power-domains:
+    maxItems: 1
+
+  mediatek,raw-id:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1]
+    description: Engine number, 0 for RAW-A and 1 for RAW-B.
+
+  mediatek,camsys:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The camsys main block (bus halt and urgent settings).
+
+  mediatek,yuv:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The YUV engine of the pair.
+
+  mediatek,twin:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      RAW-A only. The second RAW engine of a frame split between two
+      engines.
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description:
+      Input, connected to endpoint 1 of a sensor interface output. RAW-A
+      only.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - iommus
+  - power-domains
+  - mediatek,raw-id
+  - mediatek,camsys
+  - mediatek,yuv
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/media/mediatek,mt6878-cam-yuv.yaml b/Documentation/devicetree/bindings/media/mediatek,mt6878-cam-yuv.yaml
new file mode 100644
index 000000000000..f773c6ff1073
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek,mt6878-cam-yuv.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek,mt6878-cam-yuv.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 YUV engine of the image signal processor
+
+maintainers:
+  - serlk <22211586+Serlk@users.noreply.github.com>
+
+description:
+  The YUV engine holds the writers of the processed picture of the RAW
+  engine it is paired with (mediatek,yuv of that node). It is the DMA
+  device of the picture buffers.
+
+properties:
+  compatible:
+    const: mediatek,mt6878-cam-yuv
+
+  reg:
+    items:
+      - description: registers
+      - description: latched copy of the registers
+
+  reg-names:
+    items:
+      - const: base
+      - const: inner
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 3
+
+  clock-names:
+    items:
+      - const: yuv-larbx
+      - const: yuv-cam
+      - const: yuv-camtg
+
+  iommus:
+    minItems: 1
+    maxItems: 8
+    description: The ports of the engine on its SMI larb.
+
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - iommus
+  - power-domains
+
+additionalProperties: false
-- 
